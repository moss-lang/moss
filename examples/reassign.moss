#!/usr/bin/env moss

assume Base {
  fn main() {
    bind StdBase;
    let foo = char::a;
    var bar = foo;
    bar = char::c;
    let baz = bar;
    bar = char::b;
    putchar(foo);
    putchar(char::newline);
    putchar(bar);
    putchar(char::newline);
    putchar(baz);
    putchar(char::newline);
  }
}
