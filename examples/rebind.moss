#!/usr/bin/env moss

assume Std {
  val c: Char;

  fn hi() {
    bind c=char::i;
    print_it();
  }

  assume c {
    fn print_it() {
      putchar(c);
      putchar(char::newline);
    }

    fn hello_hi() {
      print_it();
      hi();
      print_it();
    }
  }

  fn main() {
    bind c=char::h;
    hello_hi();
  }
}
