#!/usr/bin/env moss

import "wasi.moss" use WasiStd;
import "wasistd.moss" use Branch;
import "wasm.moss" use Wasm;
import "wasip1.moss" use Wasi;

assume Std {

  val c: Char;

  fn hi() {
    bind c=char::i;
    print_it();
  }

  assume c {
    fn print_it() {
      putchar(c);
      putchar(char::newline);
    }

    fn hello_hi() {
      print_it();
      hi();
      print_it();
    }
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind c=char::h;
    hello_hi();
  }
}
