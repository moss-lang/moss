(module
 (rec
  (type $Literal (array (mut i8)))
  (type $Mutable (array (mut i8))))
 (memory (export "memory") 1)
 ;; extras
 (func $literal (result (ref $Literal))
  (local $a (ref $Literal))
  (local.set $a (array.new $Literal (i32.const 0) (i32.const 2)))
  (array.set $Literal (local.get $a) (i32.const 0) (i32.const 104))
  (array.set $Literal (local.get $a) (i32.const 1) (i32.const 105))
  (local.get $a))
 (func $dynamic (param $value i32) (result (ref $Literal))
  (array.new_fixed $Literal 2 (i32.const 33) (local.get $value)))
 (func (export "_start")
  (local $a (ref $Mutable))
  (i32.store (i32.const 0) (i32.const 123456))
  (local.set $a (array.new $Mutable (i32.const 0) (i32.const 2)))
  (array.set $Mutable (local.get $a) (i32.const 0) (i32.const 77))
  (if (i32.ne (array.get_u $Mutable (local.get $a) (i32.const 0)) (i32.const 77)) (then unreachable))
  (array.set $Mutable (local.get $a) (i32.const 1) (i32.const 88))
  (if (i32.ne (array.len (call $literal)) (i32.const 2)) (then unreachable))
  (if (i32.ne (array.get_u $Literal (call $literal) (i32.const 0)) (i32.const 104)) (then unreachable))
  (if (i32.ne (array.get_u $Literal (call $literal) (i32.const 1)) (i32.const 105)) (then unreachable))
  (if (i32.ne (array.get_u $Literal (call $dynamic (i32.const 255)) (i32.const 1)) (i32.const 255)) (then unreachable))
  (if (i32.ne (array.get_s $Literal (call $dynamic (i32.const 255)) (i32.const 1)) (i32.const -1)) (then unreachable))
  (if (i32.ne (i32.load (i32.const 0)) (i32.const 123456)) (then unreachable))
  (if (i32.ne (memory.size) (i32.const 1)) (then unreachable))
  ;; checks
 ))
