import "./access.moss" use Elem, .get, .set, .length, .begin, .more, .after;
import "./int.moss" use Int;
import "./size.moss" use Size;

# A fixed-size array of anything, in `Std`'s terms (D84, draft). An
# `Array[Item=X]` is a handle of whatever type the platform binds
# `ArrayHandle` to (`WasiStd`: the garbage collector's `ArrayRef`, D81),
# listed by what it holds (D73), so arrays of two element types are two
# types. Its accessors are access.moss's `.get`, `.set` and `.length`,
# provided at `Array[Item=X]` with `Elem=X` (D61), and indexed by `Size`
# (size.moss), not `Int`: access.moss's `Int` is applied to `Size` in
# each provision. So are its iteration methods, `.begin`, `.more` and
# `.after`, which `for x in xs` calls. Growable lists stay a program's
# business (D81).
type Item;
type ArrayHandle;

assume ArrayHandle, Item {
  tag Array[Item](ArrayHandle);
}

assume Size, ArrayHandle, Item {
  # `x.arrayed(n)` is n copies of `x`: detached and keyed by its receiver,
  # as D81's `.arrayed` is, so arrays of several types coexist in a scope.
  fn .arrayed(length: Size): Array;
}

# Arrays of every element type, from one binding (D84): `Arrays` is
# polymorphic in `Item`, which each application reads, and fixed in
# `Size` and `ArrayHandle`, which a binding captures where it is made.
# It is a family (D84 rule 7) — its result is methods only, each keyed
# by a receiver that names `Item` — so code that assumes `Arrays` (as
# everything under `Std` does) need not apply it: a call whose key is
# one of its items, at an `Item` nothing provides it at, gets that item
# from the binding of `Arrays` in force, applied at the `Item` the
# receiver names. So arrays follow a rebound `Float` with no line of
# their own, as long as `Size` and `ArrayHandle` still mean what they
# meant where `Arrays` was bound — which a rebinding of `Int` does not
# touch. `bind Item = X; bind Arrays;` still applies it by hand.
functor Arrays[Item]: Size, ArrayHandle ->
  Item.arrayed,
  Array.get[Elem=Item, Int=Size],
  Array.set[Elem=Item, Int=Size],
  Array.length[Int=Size],
  Array.begin[Int=Size],
  Array.more[Int=Size],
  Array.after[Int=Size];
