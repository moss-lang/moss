# Detached numeric/comparison methods. A context provides these per
# receiver type (`Int.add`, `Char.eq`, ...), which is how one context can
# offer the same operation at several types without the D43 merge
# collapsing them into one — see D47 in docs/design/semantics.md. When
# operators land (D33), they desugar to exactly these symbols.

import "./bool.moss" use Bool;

fn .add(rhs: This): This;
fn .sub(rhs: This): This;
fn .mul(rhs: This): This;
fn .div(rhs: This): This;
fn .rem(rhs: This): This;

fn .neg(): This;
fn .not(): This;

fn .and(rhs: This): This;
fn .or(rhs: This): This;
fn .xor(rhs: This): This;
fn .shl(rhs: This): This;
fn .shr(rhs: This): This;

fn .eq(rhs: This): Bool;
fn .ne(rhs: This): Bool;
fn .lt(rhs: This): Bool;
fn .gt(rhs: This): Bool;
fn .le(rhs: This): Bool;
fn .ge(rhs: This): Bool;
