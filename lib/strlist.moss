import "./access.moss" use .get, .length, .push;
import "./int.moss" use Int;
import "./string.moss" use String;

# A growable list of String with the same public accessors as IntList.
# WasiStd uses a typed GC vector, retaining immutable string values without
# copying their bytes. WasiRawStd is the linear-memory alternative, storing
# raw string addresses. The representation remains a contextual choice.
#
# Accessors are shared declarations from access.moss, provided here at
# StrList with Elem=String: one symbol per accessor, keyed by the receiver,
# so one scope can name IntList's, String's and this module's at once.

type StrList;

assume Int, String, StrList {
  fn str_list(): StrList;
}
