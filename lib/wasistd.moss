import "./wasm.moss" as w use Wasm, I32;
import "./wasip1.moss" use Wasi, fd_write, fd_read, fd_close,
  args_sizes_get, args_get, path_open;
import "./path.moss" as path use Path, pwd, .join, .read;
import "./bool.moss" use Bool;
import "./char.moss" as char use Char, .char;
import "./int.moss" as int use Int, zero, one;
import "./std.moss" use putchar;
import "./string.moss" as string use String, print, first_arg,
  .length, .get, .slice, .concat;

# `Std`, implemented in Moss over the primitive context (D52). This is the
# slice done so far; growing it is volume, not design — each further item
# is one implementation and one more bind in the functor below.
#
# Every Python shim this replaces stops being load-bearing for a program
# that applies `WasiConsole`: the compiler emits the shims regardless, but
# nothing here calls them.

# Not a Wasm instruction and not a WASI call, so it belongs to neither
# spec mirror: the coercion from a comparison result to something Moss can
# branch on. Every test instruction yields an I32 and `if` takes a `Bool`
# (D45), so without this there is no control flow here at all — no loops,
# so no strlen, so no strings.
assume I32 {
  fn i32_bool(n: I32): Bool;
}

context Branch = i32_bool;

context Console = Char, String, putchar, print, first_arg;

# Paths, which need i64 for path_open's rights masks (D57, now that D59
# has made i64 a scalar like any other).
context Files = Path, pwd, Path.join, Path.read;

# The numeric slice. `Int` binds to a nominal wrapper rather than to I32
# directly, because only an attached method can see its receiver and only
# a nominal type can carry one (D54) — so every Int is a boxed tag until
# the backend unboxes single-payload tags over scalars.
context Numerics =
  Int, zero, one,
  Int.add, Int.sub, Int.mul, Int.div, Int.rem, Int.neg,
  Int.and, Int.or, Int.xor, Int.shl, Int.shr,
  Int.eq, Int.ne, Int.lt, Int.gt, Int.le, Int.ge;

assume Wasm, Branch {
  # There are no literals (D4), so the addresses and sizes below are built
  # from `i32_one`. The scratch layout matches the backend's: an iovec at
  # 0, a byte at 8, a result word at 12, argv sizes at 24 and 28.
  fn two(): I32 { w::i32_add(w::i32_one, w::i32_one) }
  fn four(): I32 { w::i32_add(two(), two()) }
  fn eight(): I32 { w::i32_add(four(), four()) }
  fn twelve(): I32 { w::i32_add(eight(), four()) }
  fn sixteen(): I32 { w::i32_add(eight(), eight()) }
  fn twenty_four(): I32 { w::i32_add(sixteen(), eight()) }
  fn thirty_two(): I32 { w::i32_add(sixteen(), sixteen()) }
  fn chunk_size(): I32 { w::i32_shl(w::i32_one, twelve()) }
  fn slash(): Str { string_of(slash_byte(), w::i32_one) }
  # '/' written into scratch that nothing else is using at the time.
  fn slash_byte(): I32 {
    let at = twenty_four();
    w::i32_store8(at, w::i32_or(w::i32_shl(w::i32_one, five_()), fifteen()));
    at
  }
  fn five_(): I32 { w::i32_add(four(), w::i32_one) }
  fn fifteen(): I32 { w::i32_sub(sixteen(), w::i32_one) }
  fn twenty_eight(): I32 { w::i32_add(twenty_four(), four()) }

  # The bump allocator, in Moss. The heap pointer lives at address 16,
  # where `_start` leaves it, so this shares one heap with the backend's
  # own allocator rather than competing with it.
  fn alloc(n: I32): I32 {
    let base = w::i32_load(sixteen());
    let top = w::i32_and(
      w::i32_add(w::i32_add(base, n), w::i32_sub(four(), w::i32_one)),
      w::i32_sub(w::i32_zero, four())
    );
    w::i32_store(sixteen(), top);
    if i32_bool(w::i32_gt_u(top, w::i32_shl(w::memory_size(), sixteen()))) {
      let grown = w::memory_grow(
        w::i32_add(w::i32_sub(w::i32_shr_u(top, sixteen()), w::memory_size()), w::i32_one)
      );
    }
    base
  }

  # A String is [len | bytes], the same shape the backend uses. It is a
  # nominal wrapper rather than a bare I32 so that it can carry methods
  # (D54) — which costs nothing, since `Str` is in no union (D58).
  type Str I32;

  fn addr(s: Str): I32 { match s { Str a => a } }

  fn string_of(p: I32, n: I32): Str {
    let s = alloc(w::i32_add(four(), n));
    w::i32_store(s, n);
    var i = w::i32_zero;
    while i32_bool(w::i32_lt_u(i, n)) {
      w::i32_store8(w::i32_add(w::i32_add(s, four()), i), w::i32_load8_u(w::i32_add(p, i)));
      i = w::i32_add(i, w::i32_one);
    }
    Str (s)
  }

  fn Str.length(): Num { Num (w::i32_load(addr(this))) }

  fn Str.get(index: Num): I32 {
    w::i32_load8_u(w::i32_add(w::i32_add(addr(this), four()), raw(index)))
  }

  fn Str.slice(start: Num, len: Num): Str {
    string_of(w::i32_add(w::i32_add(addr(this), four()), raw(start)), raw(len))
  }

  # A Path is a name relative to the WASI preopen, so it is a String and
  # `pwd` is the empty one.
  type Loc Str;

  fn loc_str(l: Loc): Str { match l { Loc s => s } }

  fn Str.concat(other: Str): Str {
    let la = w::i32_load(addr(this));
    let lb = w::i32_load(addr(other));
    let s = alloc(w::i32_add(four(), w::i32_add(la, lb)));
    w::i32_store(s, w::i32_add(la, lb));
    var i = w::i32_zero;
    while i32_bool(w::i32_lt_u(i, la)) {
      w::i32_store8(
        w::i32_add(w::i32_add(s, four()), i),
        w::i32_load8_u(w::i32_add(w::i32_add(addr(this), four()), i))
      );
      i = w::i32_add(i, w::i32_one);
    }
    var j = w::i32_zero;
    while i32_bool(w::i32_lt_u(j, lb)) {
      w::i32_store8(
        w::i32_add(w::i32_add(w::i32_add(s, four()), la), j),
        w::i32_load8_u(w::i32_add(w::i32_add(addr(other), four()), j))
      );
      j = w::i32_add(j, w::i32_one);
    }
    Str (s)
  }

  assume Wasi {
    fn write_all(ptr: I32, len: I32) {
      w::i32_store(w::i32_zero, ptr);
      w::i32_store(four(), len);
      fd_write(w::i32_one, w::i32_zero, w::i32_one, twelve());
    }

    fn wasi_putchar(c: I32) {
      w::i32_store8(eight(), c);
      write_all(eight(), w::i32_one);
    }

    fn wasi_print(s: Str) {
      write_all(w::i32_add(addr(s), four()), w::i32_load(addr(s)));
    }

    fn wasi_pwd(): Loc { Loc (string_of(w::i32_zero, w::i32_zero)) }

    fn Loc.join(name: Str): Loc {
      let dir = loc_str(this);
      if i32_bool(w::i32_eqz(w::i32_load(addr(dir)))) {
        Loc (name)
      } else {
        Loc (dir.concat(slash()).concat(name))
      }
    }

    # path_open against the preopen, then fd_read in chunks straight onto
    # the top of the heap, which the bump allocator leaves contiguous.
    fn Loc.read(): Str {
      let p = addr(loc_str(this));
      let rights = w::i64_or(
        w::i64_extend_i32_u(w::i32_one), w::i64_extend_i32_u(two())
      );
      let err = path_open(
        w::i32_add(two(), w::i32_one), w::i32_zero,
        w::i32_add(p, four()), w::i32_load(p), w::i32_zero,
        rights, w::i64_extend_i32_u(w::i32_zero), w::i32_zero, thirty_two()
      );
      if i32_bool(err) { w::unreachable() } else { () }
      let fd = w::i32_load(thirty_two());
      let s = alloc(four());
      var total = w::i32_zero;
      loop {
        let chunk = alloc(chunk_size());
        w::i32_store(w::i32_zero, w::i32_add(w::i32_add(s, four()), total));
        w::i32_store(four(), chunk_size());
        fd_read(fd, w::i32_zero, w::i32_one, twelve());
        let got = w::i32_load(twelve());
        if i32_bool(w::i32_eqz(got)) { break; }
        total = w::i32_add(total, got);
      }
      w::i32_store(s, total);
      w::i32_store(sixteen(), w::i32_add(w::i32_add(s, four()), total));
      fd_close(fd);
      Str (s)
    }

    fn wasi_first_arg(): Str {
      args_sizes_get(twenty_four(), twenty_eight());
      let argc = w::i32_load(twenty_four());
      let argv = alloc(w::i32_mul(argc, four()));
      let buf = alloc(w::i32_load(twenty_eight()));
      args_get(argv, buf);
      if i32_bool(w::i32_lt_u(argc, two())) {
        return string_of(w::i32_zero, w::i32_zero);
      }
      let p = w::i32_load(w::i32_add(argv, four()));
      var n = w::i32_zero;
      while i32_bool(w::i32_load8_u(w::i32_add(p, n))) {
        n = w::i32_add(n, w::i32_one);
      }
      string_of(p, n)
    }
  }
}

assume Wasm, Branch {
  type Num I32;

  fn raw(n: Num): I32 { match n { Num v => v } }

  fn Num.add(rhs: Num): Num { Num (w::i32_add(raw(this), raw(rhs))) }
  fn Num.sub(rhs: Num): Num { Num (w::i32_sub(raw(this), raw(rhs))) }
  fn Num.mul(rhs: Num): Num { Num (w::i32_mul(raw(this), raw(rhs))) }
  fn Num.div(rhs: Num): Num { Num (w::i32_div_s(raw(this), raw(rhs))) }
  fn Num.rem(rhs: Num): Num { Num (w::i32_rem_s(raw(this), raw(rhs))) }
  fn Num.and(rhs: Num): Num { Num (w::i32_and(raw(this), raw(rhs))) }
  fn Num.or(rhs: Num): Num { Num (w::i32_or(raw(this), raw(rhs))) }
  fn Num.xor(rhs: Num): Num { Num (w::i32_xor(raw(this), raw(rhs))) }
  fn Num.shl(rhs: Num): Num { Num (w::i32_shl(raw(this), raw(rhs))) }
  fn Num.shr(rhs: Num): Num { Num (w::i32_shr_s(raw(this), raw(rhs))) }
  fn Num.neg(): Num { Num (w::i32_sub(w::i32_zero, raw(this))) }

  # `Int.char`: a Char is an I32 once Console is applied, so this is the
  # unwrap. Declared as I32 here because `Char` is not bound in this file.
  fn Num.to_char(): I32 { raw(this) }

  fn Num.lt(rhs: Num): Bool { i32_bool(w::i32_lt_s(raw(this), raw(rhs))) }
  fn Num.eq(rhs: Num): Bool { i32_bool(w::i32_eq(raw(this), raw(rhs))) }
  fn Num.ne(rhs: Num): Bool { i32_bool(w::i32_ne(raw(this), raw(rhs))) }
  fn Num.gt(rhs: Num): Bool { i32_bool(w::i32_gt_s(raw(this), raw(rhs))) }
  fn Num.le(rhs: Num): Bool { i32_bool(w::i32_le_s(raw(this), raw(rhs))) }
  fn Num.ge(rhs: Num): Bool { i32_bool(w::i32_ge_s(raw(this), raw(rhs))) }

  # Functions rather than defined vals: a defined val may not take
  # assumptions yet (D50), and these need `Wasm`. A bind's right-hand side
  # is an expression, so calling them costs nothing.
  fn wasi_zero(): Num { Num (w::i32_zero) }
  fn wasi_one(): Num { Num (w::i32_one) }
}

functor WasiNumerics: Wasm, Branch -> Numerics {
  bind int::Int = Num;
  bind int::zero = wasi_zero();
  bind int::one = wasi_one();
  bind Int.add = Num.add;
  bind Int.sub = Num.sub;
  bind Int.mul = Num.mul;
  bind Int.div = Num.div;
  bind Int.rem = Num.rem;
  bind Int.neg = Num.neg;
  bind Int.and = Num.and;
  bind Int.or = Num.or;
  bind Int.xor = Num.xor;
  bind Int.shl = Num.shl;
  bind Int.shr = Num.shr;
  bind Int.ne = Num.ne;
  bind Int.gt = Num.gt;
  bind Int.le = Num.le;
  bind Int.ge = Num.ge;
  bind Int.lt = Num.lt;
  bind Int.eq = Num.eq;
}

# The two together, plus the items whose signatures need both — the whole
# slice of Std that runs over Wasi so far. Applying a functor from inside
# a functor is just another bind (D55).
context Basics =
  Console, Numerics, Int.char,
  String.length, String.get, String.slice, String.concat;

functor WasiBasics: Wasm, Wasi, Branch -> Basics {
  bind WasiConsole;
  bind WasiNumerics;
  bind Int.char = Num.to_char;
  bind String.length = Str.length;
  bind String.get = Str.get;
  bind String.slice = Str.slice;
  bind String.concat = Str.concat;
}

functor WasiFiles: Wasm, Wasi, Branch -> Files {
  bind path::Path = Loc;
  bind path::pwd = wasi_pwd();
  bind Path.join = Loc.join;
  bind Path.read = Loc.read;
}

functor WasiConsole: Wasm, Wasi, Branch -> Console {
  bind char::Char = I32;
  bind string::String = Str;
  bind putchar = wasi_putchar;
  bind string::print = wasi_print;
  bind string::first_arg = wasi_first_arg;
}
