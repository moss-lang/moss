import "./bool.moss" use Bool;
import "./num.moss" use .not, .and, .or, .xor;
import "./std.moss" use Std;
import "./wasibyte.moss" use WasiByteConsts;
import "./wasichar.moss" use WasiCharConsts;
import "./wasistd.moss" use WasiBasics, WasiContainers, WasiOutput, WasiFiles,
  WasiFloats, Branch, GcArrays;
import "./wasm.moss" use Wasm, Gc, ArrayRef;
import "./array.moss" as array use ArrayHandle, Arrays;
import "./size.moss" as size use Size, .size, .int;
import "./int.moss" use Int;
import "./wasip1.moss" use WasiCore;

# Raw-memory standard bindings, shared by the compiler/bootstrap and the
# public WasiStd facade. Keep optional providers such as GC strings out of
# this module so the Rocq bootstrap does not load their implementation.
functor WasiRawStd: Wasm, Gc, WasiCore, Branch -> Std {
  bind WasiBasics;
  bind WasiContainers;
  bind WasiOutput;
  bind WasiFiles;
  bind WasiFloats;
  # Lengths and indices are the root `Int`, a generation of their own
  # (D72), so a later rebinding of `Int` leaves them, and the arrays,
  # where they are.
  bind size::Size = Int;
  bind Int.size = () => this;
  bind Size.int = () => this;
  # Arrays are GC arrays (D81), bound once here for every element type
  # (D84): code under `Std` gets them at any `Item` on demand.
  bind array::ArrayHandle = ArrayRef;
  bind Arrays = GcArrays;
  bind WasiCharConsts;
  bind WasiByteConsts;
  bind Bool.not = Bool.flip;
  bind Bool.and = Bool.both;
  bind Bool.or = Bool.either;
  bind Bool.xor = Bool.differs;
}
