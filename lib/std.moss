import "./access.moss" use Elem, .get, .length, .push, .read;
import "./bool.moss" use Bool, False, True;
import "./cell.moss" use CellInt, cell_int;
# `.char` is imported by name because it is provided at `Int`, not at
# `Char`: method lookup falls back to the *receiver's* home module, and
# int.moss cannot declare it without importing char.moss back.
import "./char.moss" use Char, Chars, .char;
import "./int.moss" use Int, IntOps, zero, one;
import "./list.moss" use IntList, int_list;
import "./num.moss" use .not;
import "./path.moss" use Path, pwd;
import "./string.moss" use String, first_arg, print, arg_count, arg_at;
import "./strlist.moss" use StrList, str_list;

assume Char {
  fn putchar(c: Char);
}

assume IntList {
  # A whole buffer at once, each element as one byte. `putchar` is a
  # syscall per character in any backend that has syscalls, which is fine
  # for a diagnostic and ruinous for a file: a compiler writing a 1.2MB
  # module through it spends more time in `fd_write` than in codegen.
  fn put_bytes(buf: IntList);
}

# The shared accessors of access.moss carry the element type per receiver
# (D61): `Elem` is one symbol, applied here once per provision, so the
# substitutions never meet.
context Std =
  Bool,
  False,
  True,
  Bool.not,

  Char,
  Chars,
  putchar,

  Int,
  zero,
  one,
  IntOps,

  # Items whose signatures mention `Int` follow it: flattening walks this
  # list in order, so a type must be in scope before anything using it.
  Char.code,
  Int.char,

  String,
  first_arg,
  arg_count,
  arg_at,
  print,
  String.length,
  String.get[Elem=Char],
  String.slice,
  String.concat,

  StrList,
  str_list,
  StrList.push[Elem=String],
  StrList.get[Elem=String],
  StrList.length,

  CellInt,
  cell_int,
  CellInt.read[Elem=Int],
  CellInt.write,

  IntList,
  int_list,
  IntList.push[Elem=Int],
  IntList.get[Elem=Int],
  IntList.set,
  IntList.length,
  put_bytes,

  Path,
  pwd,
  Path.join,
  Path.read[Elem=String],
;
