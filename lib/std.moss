import "./access.moss" use Elem, Index, .get, .set, .length, .push, .read, .begin, .more, .after;
import "./bool.moss" use Bool;
import "./cell.moss" use CellInt, cell_int, .write;
# Detached methods must be imported where their context items are named.
import "./byte.moss" use ByteTypes, Bytes;
import "./char.moss" use Char, Chars, .code, .char;
import "./float.moss" use Floats;
import "./array.moss" use ArrayHandle, Arrays;
import "./int.moss" use Int, IntOps, zero, one;
import "./size.moss" use Size, Sizes;
import "./list.moss" use IntList, int_list;
import "./num.moss" use .not, .and, .or, .xor;
import "./path.moss" use Path, pwd, .join, .readable;
import "./string.moss" use String, StringLiterals, first_arg, print, arg_count, arg_at, .slice, .concat;
import "./strlist.moss" use StrList, str_list;

assume Char {
  fn putchar(c: Char);
}

assume IntList {
  # A whole buffer at once, each element as one byte. `putchar` is a
  # syscall per character in any backend that has syscalls, which is fine
  # for a diagnostic and ruinous for a file: a compiler writing a 1.2MB
  # module through it spends more time in `fd_write` than in codegen.
  fn put_bytes(buf: IntList);
}

# The shared accessors of access.moss carry the element type per receiver
# (D61): `Elem` is one symbol, applied here once per provision, so the
# substitutions never meet.
context Std =
  Bool.not,
  Bool.and,
  Bool.or,
  Bool.xor,

  Char,
  Chars,
  ByteTypes,
  Bytes,
  putchar,

  Int,
  zero,
  one,
  IntOps,

  # Array lengths and indices, and their conversions to and from `Int`
  # (size.moss), after `Int`.
  Sizes,

  # `Float` and its conversions to and from `Int`, after `Int` (D67).
  Floats,

  # Fixed-size arrays (D84): the handle, and the family that makes them
  # for any `Item`, whose members code gets on demand (rule 7).
  ArrayHandle,
  Arrays,

  # Items whose signatures mention `Int` follow it: flattening walks this
  # list in order, so a type must be in scope before anything using it.
  Char.code,
  Int.char,

  String,
  StringLiterals,
  first_arg,
  arg_count,
  arg_at,
  print,
  String.length[Index=Int],
  String.get[Elem=Char, Index=Int],
  String.slice,
  String.concat,

  StrList,
  str_list,
  StrList.push[Elem=String],
  StrList.get[Elem=String, Index=Int],
  StrList.length[Index=Int],

  CellInt,
  cell_int,
  CellInt.read[Elem=Int],
  CellInt.write,

  IntList,
  int_list,
  IntList.push[Elem=Int],
  IntList.get[Elem=Int, Index=Int],
  IntList.set[Elem=Int, Index=Int],
  IntList.length[Index=Int],
  put_bytes,

  Path,
  pwd,
  Path.join,
  Path.readable,
  Path.read[Elem=String],
;
