# https://webassembly.github.io/spec/core/syntax/types.html#number-types
type I32;
type I64;
type F32;
type F64;

# https://webassembly.github.io/spec/core/syntax/instructions.html#parametric-instructions
fn unreachable(): |;

assume I32 {
  # There are no literals (D4), so every I32 is built from these two, the
  # way `Int`'s `zero` and `one` work. They are the only `Wasm` items that
  # are values rather than instructions.
  val i32_zero: I32;
  val i32_one: I32;
}

# https://webassembly.github.io/spec/core/syntax/instructions.html#memory-instructions
assume I32 {
  fn i32_load(address: I32): I32;
  fn i32_load8_s(address: I32): I32;
  fn i32_load8_u(address: I32): I32;
  fn i32_load16_s(address: I32): I32;
  fn i32_load16_u(address: I32): I32;
  fn i32_store(address: I32, value: I32);
  fn i32_store8(address: I32, value: I32);
  fn i32_store16(address: I32, value: I32);
  fn memory_size(): I32;
  fn memory_grow(pages: I32): I32;
  fn memory_copy(dst: I32, src: I32, len: I32);
  fn memory_fill(start: I32, byte: I32, len: I32);

  assume I64 {
    fn i64_load(address: I32): I64;
    fn i64_load8_s(address: I32): I64;
    fn i64_load8_u(address: I32): I64;
    fn i64_load16_s(address: I32): I64;
    fn i64_load16_u(address: I32): I64;
    fn i64_load32_s(address: I32): I64;
    fn i64_load32_u(address: I32): I64;
    fn i64_store(address: I32, value: I64);
    fn i64_store8(address: I32, value: I64);
    fn i64_store16(address: I32, value: I64);
    fn i64_store32(address: I32, value: I64);
  }
}

# https://webassembly.github.io/spec/core/syntax/instructions.html#numeric-instructions
assume I32 {
  fn i32_eqz(n: I32): I32;
  fn i32_eq(a: I32, b: I32): I32;
  fn i32_ne(a: I32, b: I32): I32;
  fn i32_lt_s(a: I32, b: I32): I32;
  fn i32_lt_u(a: I32, b: I32): I32;
  fn i32_gt_s(a: I32, b: I32): I32;
  fn i32_gt_u(a: I32, b: I32): I32;
  fn i32_le_s(a: I32, b: I32): I32;
  fn i32_le_u(a: I32, b: I32): I32;
  fn i32_ge_s(a: I32, b: I32): I32;
  fn i32_ge_u(a: I32, b: I32): I32;
  fn i32_clz(n: I32): I32;
  fn i32_ctz(n: I32): I32;
  fn i32_popcnt(n: I32): I32;
  fn i32_add(a: I32, b: I32): I32;
  fn i32_sub(a: I32, b: I32): I32;
  fn i32_mul(a: I32, b: I32): I32;
  fn i32_div_s(a: I32, b: I32): I32;
  fn i32_div_u(a: I32, b: I32): I32;
  fn i32_rem_s(a: I32, b: I32): I32;
  fn i32_rem_u(a: I32, b: I32): I32;
  fn i32_and(a: I32, b: I32): I32;
  fn i32_or(a: I32, b: I32): I32;
  fn i32_xor(a: I32, b: I32): I32;
  fn i32_shl(a: I32, b: I32): I32;
  fn i32_shr_s(a: I32, b: I32): I32;
  fn i32_shr_u(a: I32, b: I32): I32;
  fn i32_rotl(a: I32, b: I32): I32;
  fn i32_rotr(a: I32, b: I32): I32;
  fn i32_extend8_s(n: I32): I32;
  fn i32_extend16_s(n: I32): I32;

  assume I64 {
    fn i64_eqz(n: I64): I32;
    fn i64_eq(a: I64, b: I64): I32;
    fn i64_ne(a: I64, b: I64): I32;
    fn i64_lt_s(a: I64, b: I64): I32;
    fn i64_lt_u(a: I64, b: I64): I32;
    fn i64_gt_s(a: I64, b: I64): I32;
    fn i64_gt_u(a: I64, b: I64): I32;
    fn i64_le_s(a: I64, b: I64): I32;
    fn i64_le_u(a: I64, b: I64): I32;
    fn i64_ge_s(a: I64, b: I64): I32;
    fn i64_ge_u(a: I64, b: I64): I32;
    fn i64_clz(n: I64): I64;
    fn i64_ctz(n: I64): I64;
    fn i64_popcnt(n: I64): I64;
    fn i64_add(a: I64, b: I64): I64;
    fn i64_sub(a: I64, b: I64): I64;
    fn i64_mul(a: I64, b: I64): I64;
    fn i64_div_s(a: I64, b: I64): I64;
    fn i64_div_u(a: I64, b: I64): I64;
    fn i64_rem_s(a: I64, b: I64): I64;
    fn i64_rem_u(a: I64, b: I64): I64;
    fn i64_and(a: I64, b: I64): I64;
    fn i64_or(a: I64, b: I64): I64;
    fn i64_xor(a: I64, b: I64): I64;
    fn i64_shl(a: I64, b: I64): I64;
    fn i64_shr_s(a: I64, b: I64): I64;
    fn i64_shr_u(a: I64, b: I64): I64;
    fn i64_rotl(a: I64, b: I64): I64;
    fn i64_rotr(a: I64, b: I64): I64;
    fn i32_wrap_i64(n: I64): I32;
    fn i64_extend_i32_s(n: I32): I64;
    fn i64_extend_i32_u(n: I32): I64;
    fn i64_extend8_s(n: I64): I64;
    fn i64_extend16_s(n: I64): I64;
    fn i64_extend32_s(n: I64): I64;
  }
}

# The float half (D67). Comparisons yield an i32, as the integer ones do;
# there are no float constants, so a float starts life as a conversion
# from an integer built out of `i32_zero` and `i32_one`.
assume I32, I64, F32, F64 {
  fn f32_load(address: I32): F32;
  fn f64_load(address: I32): F64;
  fn f32_store(address: I32, value: F32);
  fn f64_store(address: I32, value: F64);

  fn f32_eq(a: F32, b: F32): I32;
  fn f32_ne(a: F32, b: F32): I32;
  fn f32_lt(a: F32, b: F32): I32;
  fn f32_gt(a: F32, b: F32): I32;
  fn f32_le(a: F32, b: F32): I32;
  fn f32_ge(a: F32, b: F32): I32;
  fn f64_eq(a: F64, b: F64): I32;
  fn f64_ne(a: F64, b: F64): I32;
  fn f64_lt(a: F64, b: F64): I32;
  fn f64_gt(a: F64, b: F64): I32;
  fn f64_le(a: F64, b: F64): I32;
  fn f64_ge(a: F64, b: F64): I32;

  fn f32_abs(n: F32): F32;
  fn f32_neg(n: F32): F32;
  fn f32_ceil(n: F32): F32;
  fn f32_floor(n: F32): F32;
  fn f32_trunc(n: F32): F32;
  fn f32_nearest(n: F32): F32;
  fn f32_sqrt(n: F32): F32;
  fn f32_add(a: F32, b: F32): F32;
  fn f32_sub(a: F32, b: F32): F32;
  fn f32_mul(a: F32, b: F32): F32;
  fn f32_div(a: F32, b: F32): F32;
  fn f32_min(a: F32, b: F32): F32;
  fn f32_max(a: F32, b: F32): F32;
  fn f32_copysign(a: F32, b: F32): F32;
  fn f64_abs(n: F64): F64;
  fn f64_neg(n: F64): F64;
  fn f64_ceil(n: F64): F64;
  fn f64_floor(n: F64): F64;
  fn f64_trunc(n: F64): F64;
  fn f64_nearest(n: F64): F64;
  fn f64_sqrt(n: F64): F64;
  fn f64_add(a: F64, b: F64): F64;
  fn f64_sub(a: F64, b: F64): F64;
  fn f64_mul(a: F64, b: F64): F64;
  fn f64_div(a: F64, b: F64): F64;
  fn f64_min(a: F64, b: F64): F64;
  fn f64_max(a: F64, b: F64): F64;
  fn f64_copysign(a: F64, b: F64): F64;

  # Float to integer. The plain `trunc` forms trap on NaN and on a value
  # out of the result's range; the `trunc_sat` forms saturate instead,
  # NaN going to zero.
  fn i32_trunc_f32_s(n: F32): I32;
  fn i32_trunc_f32_u(n: F32): I32;
  fn i32_trunc_f64_s(n: F64): I32;
  fn i32_trunc_f64_u(n: F64): I32;
  fn i64_trunc_f32_s(n: F32): I64;
  fn i64_trunc_f32_u(n: F32): I64;
  fn i64_trunc_f64_s(n: F64): I64;
  fn i64_trunc_f64_u(n: F64): I64;
  fn i32_trunc_sat_f32_s(n: F32): I32;
  fn i32_trunc_sat_f32_u(n: F32): I32;
  fn i32_trunc_sat_f64_s(n: F64): I32;
  fn i32_trunc_sat_f64_u(n: F64): I32;
  fn i64_trunc_sat_f32_s(n: F32): I64;
  fn i64_trunc_sat_f32_u(n: F32): I64;
  fn i64_trunc_sat_f64_s(n: F64): I64;
  fn i64_trunc_sat_f64_u(n: F64): I64;

  # Integer to float, rounding to nearest (ties to even).
  fn f32_convert_i32_s(n: I32): F32;
  fn f32_convert_i32_u(n: I32): F32;
  fn f32_convert_i64_s(n: I64): F32;
  fn f32_convert_i64_u(n: I64): F32;
  fn f64_convert_i32_s(n: I32): F64;
  fn f64_convert_i32_u(n: I32): F64;
  fn f64_convert_i64_s(n: I64): F64;
  fn f64_convert_i64_u(n: I64): F64;

  fn f32_demote_f64(n: F64): F32;
  fn f64_promote_f32(n: F32): F64;

  # The same bits, read as the other type.
  fn i32_reinterpret_f32(n: F32): I32;
  fn i64_reinterpret_f64(n: F64): I64;
  fn f32_reinterpret_i32(n: I32): F32;
  fn f64_reinterpret_i64(n: I64): F64;
}

context Wasm =
  I32,
  I64,
  F32,
  F64,

  i32_zero,
  i32_one,

  unreachable,

  i32_load,
  i64_load,
  i32_load8_s,
  i32_load8_u,
  i32_load16_s,
  i32_load16_u,
  i64_load8_s,
  i64_load8_u,
  i64_load16_s,
  i64_load16_u,
  i64_load32_s,
  i64_load32_u,
  i32_store,
  i64_store,
  i32_store8,
  i32_store16,
  i64_store8,
  i64_store16,
  i64_store32,
  memory_size,
  memory_grow,
  memory_copy,
  memory_fill,

  i32_eqz,
  i32_eq,
  i32_ne,
  i32_lt_s,
  i32_lt_u,
  i32_gt_s,
  i32_gt_u,
  i32_le_s,
  i32_le_u,
  i32_ge_s,
  i32_ge_u,
  i64_eqz,
  i64_eq,
  i64_ne,
  i64_lt_s,
  i64_lt_u,
  i64_gt_s,
  i64_gt_u,
  i64_le_s,
  i64_le_u,
  i64_ge_s,
  i64_ge_u,
  i32_clz,
  i32_ctz,
  i32_popcnt,
  i32_add,
  i32_sub,
  i32_mul,
  i32_div_s,
  i32_div_u,
  i32_rem_s,
  i32_rem_u,
  i32_and,
  i32_or,
  i32_xor,
  i32_shl,
  i32_shr_s,
  i32_shr_u,
  i32_rotl,
  i32_rotr,
  i64_clz,
  i64_ctz,
  i64_popcnt,
  i64_add,
  i64_sub,
  i64_mul,
  i64_div_s,
  i64_div_u,
  i64_rem_s,
  i64_rem_u,
  i64_and,
  i64_or,
  i64_xor,
  i64_shl,
  i64_shr_s,
  i64_shr_u,
  i64_rotl,
  i64_rotr,
  i32_wrap_i64,
  i64_extend_i32_s,
  i64_extend_i32_u,
  i32_extend8_s,
  i32_extend16_s,
  i64_extend8_s,
  i64_extend16_s,
  i64_extend32_s,

  f32_load,
  f64_load,
  f32_store,
  f64_store,
  f32_eq,
  f32_ne,
  f32_lt,
  f32_gt,
  f32_le,
  f32_ge,
  f64_eq,
  f64_ne,
  f64_lt,
  f64_gt,
  f64_le,
  f64_ge,
  f32_abs,
  f32_neg,
  f32_ceil,
  f32_floor,
  f32_trunc,
  f32_nearest,
  f32_sqrt,
  f32_add,
  f32_sub,
  f32_mul,
  f32_div,
  f32_min,
  f32_max,
  f32_copysign,
  f64_abs,
  f64_neg,
  f64_ceil,
  f64_floor,
  f64_trunc,
  f64_nearest,
  f64_sqrt,
  f64_add,
  f64_sub,
  f64_mul,
  f64_div,
  f64_min,
  f64_max,
  f64_copysign,
  i32_trunc_f32_s,
  i32_trunc_f32_u,
  i32_trunc_f64_s,
  i32_trunc_f64_u,
  i64_trunc_f32_s,
  i64_trunc_f32_u,
  i64_trunc_f64_s,
  i64_trunc_f64_u,
  i32_trunc_sat_f32_s,
  i32_trunc_sat_f32_u,
  i32_trunc_sat_f64_s,
  i32_trunc_sat_f64_u,
  i64_trunc_sat_f32_s,
  i64_trunc_sat_f32_u,
  i64_trunc_sat_f64_s,
  i64_trunc_sat_f64_u,
  f32_convert_i32_s,
  f32_convert_i32_u,
  f32_convert_i64_s,
  f32_convert_i64_u,
  f64_convert_i32_s,
  f64_convert_i32_u,
  f64_convert_i64_s,
  f64_convert_i64_u,
  f32_demote_f64,
  f64_promote_f32,
  i32_reinterpret_f32,
  i64_reinterpret_f64,
  f32_reinterpret_i32,
  f64_reinterpret_i64,
;
