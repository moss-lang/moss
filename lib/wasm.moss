# https://webassembly.github.io/spec/core/syntax/types.html#number-types
type I32;
type I64;
type F32;
type F64;

# https://webassembly.github.io/gc/core/syntax/types.html#heap-types
# Any reference to a garbage-collected struct, `(ref null struct)` (D75).
type StructRef;

# Any reference to a garbage-collected array (D81), `(ref null eq)`: an
# `Array` of a one-scalar type is a GC array, and of a wider one a struct
# of arrays, one per scalar ("lane"), and `eq` is what both are.
type ArrayRef;

# https://webassembly.github.io/spec/core/syntax/instructions.html#parametric-instructions
fn unreachable(): |;

assume I32 {
  # There are no literals (D4), so every I32 is built from these two, the
  # way `Int`'s `zero` and `one` work. They are the only `Wasm` items that
  # are values rather than instructions.
  val i32_zero: I32;
  val i32_one: I32;
}

# A linear memory (D79). The platform provides `Memory` at the root as
# the module's first memory, index 0, exported as `memory` (which WASI
# preview 1 requires); a program names more as units (`tag Scratch;`) and
# binds `Memory` to one in a scope. Each distinct memory reached gets its
# own index, which the back end puts on every instruction at it.
type Memory;

# An address, typed by the memory it is into (D73), so that what an
# instruction reads or writes is said by its receiver's type: the memory
# instructions are methods of `Addr`, and `Addr[Memory=M]` selects
# memory `M`. `Addr(a)` is an address in the `Memory` in force.
assume I32, Memory {
  tag Addr[Memory](I32);
}

# https://webassembly.github.io/spec/core/syntax/instructions.html#memory-instructions
# `memory.size` and `memory.grow` are about the receiver's memory, not its
# address; `memory.copy` copies within the receiver's memory, from `src`
# to the receiver.
assume I32, Memory {
  fn Addr.i32_load(): I32;
  fn Addr.i32_load8_s(): I32;
  fn Addr.i32_load8_u(): I32;
  fn Addr.i32_load16_s(): I32;
  fn Addr.i32_load16_u(): I32;
  fn Addr.i32_store(value: I32);
  fn Addr.i32_store8(value: I32);
  fn Addr.i32_store16(value: I32);
  fn Addr.memory_size(): I32;
  fn Addr.memory_grow(pages: I32): I32;
  fn Addr.memory_copy(src: Addr, len: I32);
  fn Addr.memory_fill(byte: I32, len: I32);

  assume I64 {
    fn Addr.i64_load(): I64;
    fn Addr.i64_load8_s(): I64;
    fn Addr.i64_load8_u(): I64;
    fn Addr.i64_load16_s(): I64;
    fn Addr.i64_load16_u(): I64;
    fn Addr.i64_load32_s(): I64;
    fn Addr.i64_load32_u(): I64;
    fn Addr.i64_store(value: I64);
    fn Addr.i64_store8(value: I64);
    fn Addr.i64_store16(value: I64);
    fn Addr.i64_store32(value: I64);
  }

  assume F32, F64 {
    fn Addr.f32_load(): F32;
    fn Addr.f64_load(): F64;
    fn Addr.f32_store(value: F32);
    fn Addr.f64_store(value: F64);
  }
}

# The memory instructions are a family (D84 rule 7), polymorphic in
# `Memory` and fixed in the scalar types: the platform provides it once,
# at the root, and code that requires it gets each instruction at the
# memory its receiver names, on demand. So rebinding `Memory` costs
# nothing — nothing is tied to the memory it was provided at — and no
# rule about memories is needed to say so.
functor Memories[Memory]: I32, I64, F32, F64, Memory ->
  Addr.i32_load, Addr.i32_load8_s, Addr.i32_load8_u, Addr.i32_load16_s, Addr.i32_load16_u,
  Addr.i32_store, Addr.i32_store8, Addr.i32_store16,
  Addr.memory_size, Addr.memory_grow, Addr.memory_copy, Addr.memory_fill,
  Addr.i64_load, Addr.i64_load8_s, Addr.i64_load8_u, Addr.i64_load16_s, Addr.i64_load16_u,
  Addr.i64_load32_s, Addr.i64_load32_u,
  Addr.i64_store, Addr.i64_store8, Addr.i64_store16, Addr.i64_store32,
  Addr.f32_load, Addr.f64_load, Addr.f32_store, Addr.f64_store;

# The instructions at a bare `I32` address in the `Memory` in force:
# ordinary Moss, each making the address (`Addr(address)`, which is
# where a bare address is given a memory) and calling the member. What
# most of the library is written with.
assume I32, I64, F32, F64, Memory, Memories, i32_zero {
  fn i32_load(address: I32): I32 { Addr(address).i32_load() }
  fn i32_load8_s(address: I32): I32 { Addr(address).i32_load8_s() }
  fn i32_load8_u(address: I32): I32 { Addr(address).i32_load8_u() }
  fn i32_load16_s(address: I32): I32 { Addr(address).i32_load16_s() }
  fn i32_load16_u(address: I32): I32 { Addr(address).i32_load16_u() }
  fn i32_store(address: I32, value: I32) { Addr(address).i32_store(value); }
  fn i32_store8(address: I32, value: I32) { Addr(address).i32_store8(value); }
  fn i32_store16(address: I32, value: I32) { Addr(address).i32_store16(value); }
  fn memory_size(): I32 { Addr(i32_zero).memory_size() }
  fn memory_grow(pages: I32): I32 { Addr(i32_zero).memory_grow(pages) }
  fn memory_copy(dst: I32, src: I32, len: I32) { Addr(dst).memory_copy(Addr(src), len); }
  fn memory_fill(start: I32, byte: I32, len: I32) { Addr(start).memory_fill(byte, len); }

  fn i64_load(address: I32): I64 { Addr(address).i64_load() }
  fn i64_load8_s(address: I32): I64 { Addr(address).i64_load8_s() }
  fn i64_load8_u(address: I32): I64 { Addr(address).i64_load8_u() }
  fn i64_load16_s(address: I32): I64 { Addr(address).i64_load16_s() }
  fn i64_load16_u(address: I32): I64 { Addr(address).i64_load16_u() }
  fn i64_load32_s(address: I32): I64 { Addr(address).i64_load32_s() }
  fn i64_load32_u(address: I32): I64 { Addr(address).i64_load32_u() }
  fn i64_store(address: I32, value: I64) { Addr(address).i64_store(value); }
  fn i64_store8(address: I32, value: I64) { Addr(address).i64_store8(value); }
  fn i64_store16(address: I32, value: I64) { Addr(address).i64_store16(value); }
  fn i64_store32(address: I32, value: I64) { Addr(address).i64_store32(value); }

  fn f32_load(address: I32): F32 { Addr(address).f32_load() }
  fn f64_load(address: I32): F64 { Addr(address).f64_load() }
  fn f32_store(address: I32, value: F32) { Addr(address).f32_store(value); }
  fn f64_store(address: I32, value: F64) { Addr(address).f64_store(value); }
}

# https://webassembly.github.io/spec/core/syntax/instructions.html#numeric-instructions
assume I32 {
  fn i32_eqz(n: I32): I32;
  fn i32_eq(a: I32, b: I32): I32;
  fn i32_ne(a: I32, b: I32): I32;
  fn i32_lt_s(a: I32, b: I32): I32;
  fn i32_lt_u(a: I32, b: I32): I32;
  fn i32_gt_s(a: I32, b: I32): I32;
  fn i32_gt_u(a: I32, b: I32): I32;
  fn i32_le_s(a: I32, b: I32): I32;
  fn i32_le_u(a: I32, b: I32): I32;
  fn i32_ge_s(a: I32, b: I32): I32;
  fn i32_ge_u(a: I32, b: I32): I32;
  fn i32_clz(n: I32): I32;
  fn i32_ctz(n: I32): I32;
  fn i32_popcnt(n: I32): I32;
  fn i32_add(a: I32, b: I32): I32;
  fn i32_sub(a: I32, b: I32): I32;
  fn i32_mul(a: I32, b: I32): I32;
  fn i32_div_s(a: I32, b: I32): I32;
  fn i32_div_u(a: I32, b: I32): I32;
  fn i32_rem_s(a: I32, b: I32): I32;
  fn i32_rem_u(a: I32, b: I32): I32;
  fn i32_and(a: I32, b: I32): I32;
  fn i32_or(a: I32, b: I32): I32;
  fn i32_xor(a: I32, b: I32): I32;
  fn i32_shl(a: I32, b: I32): I32;
  fn i32_shr_s(a: I32, b: I32): I32;
  fn i32_shr_u(a: I32, b: I32): I32;
  fn i32_rotl(a: I32, b: I32): I32;
  fn i32_rotr(a: I32, b: I32): I32;
  fn i32_extend8_s(n: I32): I32;
  fn i32_extend16_s(n: I32): I32;

  assume I64 {
    fn i64_eqz(n: I64): I32;
    fn i64_eq(a: I64, b: I64): I32;
    fn i64_ne(a: I64, b: I64): I32;
    fn i64_lt_s(a: I64, b: I64): I32;
    fn i64_lt_u(a: I64, b: I64): I32;
    fn i64_gt_s(a: I64, b: I64): I32;
    fn i64_gt_u(a: I64, b: I64): I32;
    fn i64_le_s(a: I64, b: I64): I32;
    fn i64_le_u(a: I64, b: I64): I32;
    fn i64_ge_s(a: I64, b: I64): I32;
    fn i64_ge_u(a: I64, b: I64): I32;
    fn i64_clz(n: I64): I64;
    fn i64_ctz(n: I64): I64;
    fn i64_popcnt(n: I64): I64;
    fn i64_add(a: I64, b: I64): I64;
    fn i64_sub(a: I64, b: I64): I64;
    fn i64_mul(a: I64, b: I64): I64;
    fn i64_div_s(a: I64, b: I64): I64;
    fn i64_div_u(a: I64, b: I64): I64;
    fn i64_rem_s(a: I64, b: I64): I64;
    fn i64_rem_u(a: I64, b: I64): I64;
    fn i64_and(a: I64, b: I64): I64;
    fn i64_or(a: I64, b: I64): I64;
    fn i64_xor(a: I64, b: I64): I64;
    fn i64_shl(a: I64, b: I64): I64;
    fn i64_shr_s(a: I64, b: I64): I64;
    fn i64_shr_u(a: I64, b: I64): I64;
    fn i64_rotl(a: I64, b: I64): I64;
    fn i64_rotr(a: I64, b: I64): I64;
    fn i32_wrap_i64(n: I64): I32;
    fn i64_extend_i32_s(n: I32): I64;
    fn i64_extend_i32_u(n: I32): I64;
    fn i64_extend8_s(n: I64): I64;
    fn i64_extend16_s(n: I64): I64;
    fn i64_extend32_s(n: I64): I64;
  }
}

# The float half (D67). Comparisons yield an i32, as the integer ones do;
# there are no float constants, so a float starts life as a conversion
# from an integer built out of `i32_zero` and `i32_one`.
assume I32, I64, F32, F64 {
  fn f32_eq(a: F32, b: F32): I32;
  fn f32_ne(a: F32, b: F32): I32;
  fn f32_lt(a: F32, b: F32): I32;
  fn f32_gt(a: F32, b: F32): I32;
  fn f32_le(a: F32, b: F32): I32;
  fn f32_ge(a: F32, b: F32): I32;
  fn f64_eq(a: F64, b: F64): I32;
  fn f64_ne(a: F64, b: F64): I32;
  fn f64_lt(a: F64, b: F64): I32;
  fn f64_gt(a: F64, b: F64): I32;
  fn f64_le(a: F64, b: F64): I32;
  fn f64_ge(a: F64, b: F64): I32;

  fn f32_abs(n: F32): F32;
  fn f32_neg(n: F32): F32;
  fn f32_ceil(n: F32): F32;
  fn f32_floor(n: F32): F32;
  fn f32_trunc(n: F32): F32;
  fn f32_nearest(n: F32): F32;
  fn f32_sqrt(n: F32): F32;
  fn f32_add(a: F32, b: F32): F32;
  fn f32_sub(a: F32, b: F32): F32;
  fn f32_mul(a: F32, b: F32): F32;
  fn f32_div(a: F32, b: F32): F32;
  fn f32_min(a: F32, b: F32): F32;
  fn f32_max(a: F32, b: F32): F32;
  fn f32_copysign(a: F32, b: F32): F32;
  fn f64_abs(n: F64): F64;
  fn f64_neg(n: F64): F64;
  fn f64_ceil(n: F64): F64;
  fn f64_floor(n: F64): F64;
  fn f64_trunc(n: F64): F64;
  fn f64_nearest(n: F64): F64;
  fn f64_sqrt(n: F64): F64;
  fn f64_add(a: F64, b: F64): F64;
  fn f64_sub(a: F64, b: F64): F64;
  fn f64_mul(a: F64, b: F64): F64;
  fn f64_div(a: F64, b: F64): F64;
  fn f64_min(a: F64, b: F64): F64;
  fn f64_max(a: F64, b: F64): F64;
  fn f64_copysign(a: F64, b: F64): F64;

  # Float to integer. The plain `trunc` forms trap on NaN and on a value
  # out of the result's range; the `trunc_sat` forms saturate instead,
  # NaN going to zero.
  fn i32_trunc_f32_s(n: F32): I32;
  fn i32_trunc_f32_u(n: F32): I32;
  fn i32_trunc_f64_s(n: F64): I32;
  fn i32_trunc_f64_u(n: F64): I32;
  fn i64_trunc_f32_s(n: F32): I64;
  fn i64_trunc_f32_u(n: F32): I64;
  fn i64_trunc_f64_s(n: F64): I64;
  fn i64_trunc_f64_u(n: F64): I64;
  fn i32_trunc_sat_f32_s(n: F32): I32;
  fn i32_trunc_sat_f32_u(n: F32): I32;
  fn i32_trunc_sat_f64_s(n: F64): I32;
  fn i32_trunc_sat_f64_u(n: F64): I32;
  fn i64_trunc_sat_f32_s(n: F32): I64;
  fn i64_trunc_sat_f32_u(n: F32): I64;
  fn i64_trunc_sat_f64_s(n: F64): I64;
  fn i64_trunc_sat_f64_u(n: F64): I64;

  # Integer to float, rounding to nearest (ties to even).
  fn f32_convert_i32_s(n: I32): F32;
  fn f32_convert_i32_u(n: I32): F32;
  fn f32_convert_i64_s(n: I64): F32;
  fn f32_convert_i64_u(n: I64): F32;
  fn f64_convert_i32_s(n: I32): F64;
  fn f64_convert_i32_u(n: I32): F64;
  fn f64_convert_i64_s(n: I64): F64;
  fn f64_convert_i64_u(n: I64): F64;

  fn f32_demote_f64(n: F64): F32;
  fn f64_promote_f32(n: F32): F64;

  # The same bits, read as the other type.
  fn i32_reinterpret_f32(n: F32): I32;
  fn i64_reinterpret_f64(n: F64): I64;
  fn f32_reinterpret_i32(n: I32): F32;
  fn f64_reinterpret_i64(n: I64): F64;
}

# Garbage-collected references (D75): a `Ref` is typed by what it holds,
# a listed parameter (D73), and the back end gives each type `Boxed` is
# instantiated at an immutable GC struct of its run of scalars (D59), so
# `Ref[Boxed=X]` is `(ref null $X)`. Taking a `Ref` apart gives a bare
# `StructRef`. `StructCast[Boxed=X](raw).cast()` explicitly recovers
# the typed reference and traps if the struct is of the wrong type.
#
# Boxing and following a reference are ordinary context items, keyed by
# receiver (D47, D62) so that references to several types coexist in one
# scope: `.boxed` is a detached method, provided at receiver `Boxed`, and
# `.deref` is attached to `Ref`, so provided at `Ref[Boxed=X]`. Nothing
# written in Moss can provide them; the platform does, through `Heap`
# below — `struct.new` and a `struct.get` per field.
type Boxed;

assume Boxed {
  tag Ref[Boxed](StructRef);
  fn .boxed(): Ref;
  fn Ref.deref(): Boxed;

  # D81: replacing what a reference holds, a `struct.set` per field. Only
  # `Mutable` below provides it, and a type's struct has mutable fields
  # only where it is applied at that type, so a `Ref` stays a value
  # wherever nothing can write through it.
  fn Ref.set(value: Boxed);
}

assume StructRef, Boxed {
  # An erased handle and the type to recover. Constructing this request
  # is ordinary tag construction. The Base operation performs the check.
  tag StructCast[Boxed](StructRef);
  fn StructCast.cast(): Ref;
}

# Garbage-collected arrays (D81), shaped as `Ref` is: an `Array` is typed
# by what it holds, a listed parameter (D73), and is one GC array per
# scalar of that type's run (D59) — one array where it is one scalar, and
# otherwise an immutable struct of them, each operation done once per
# lane. The constructor is a detached method keyed by its receiver, the
# value every element starts as (`array.new`), so arrays of several types
# coexist in one scope; the rest are attached to `Array`, so provided at
# `Array[Arrayed=X]`. Every operation traps on an index past the length,
# as the instructions do. Nothing written in Moss can provide them; the
# platform does, through `Arrays` below.
type Arrayed;

assume I32, Arrayed {
  tag Array[Arrayed](ArrayRef);
  fn .arrayed(length: I32): Array;
  fn Array.length(): I32;
  fn Array.get(index: I32): Arrayed;
  fn Array.set(index: I32, value: Arrayed);
  fn Array.fill(at: I32, value: Arrayed, count: I32);
  fn Array.copy(at: I32, from: Array, start: I32, count: I32);
}

assume ArrayRef, Arrayed {
  tag ArrayCast[Arrayed](ArrayRef);
  fn ArrayCast.cast(): Array;
}

context Wasm =
  I32,
  I64,
  F32,
  F64,
  StructRef,
  ArrayRef,
  Memory,
  Memories,

  i32_zero,
  i32_one,

  unreachable,

  i32_eqz,
  i32_eq,
  i32_ne,
  i32_lt_s,
  i32_lt_u,
  i32_gt_s,
  i32_gt_u,
  i32_le_s,
  i32_le_u,
  i32_ge_s,
  i32_ge_u,
  i64_eqz,
  i64_eq,
  i64_ne,
  i64_lt_s,
  i64_lt_u,
  i64_gt_s,
  i64_gt_u,
  i64_le_s,
  i64_le_u,
  i64_ge_s,
  i64_ge_u,
  i32_clz,
  i32_ctz,
  i32_popcnt,
  i32_add,
  i32_sub,
  i32_mul,
  i32_div_s,
  i32_div_u,
  i32_rem_s,
  i32_rem_u,
  i32_and,
  i32_or,
  i32_xor,
  i32_shl,
  i32_shr_s,
  i32_shr_u,
  i32_rotl,
  i32_rotr,
  i64_clz,
  i64_ctz,
  i64_popcnt,
  i64_add,
  i64_sub,
  i64_mul,
  i64_div_s,
  i64_div_u,
  i64_rem_s,
  i64_rem_u,
  i64_and,
  i64_or,
  i64_xor,
  i64_shl,
  i64_shr_s,
  i64_shr_u,
  i64_rotl,
  i64_rotr,
  i32_wrap_i64,
  i64_extend_i32_s,
  i64_extend_i32_u,
  i32_extend8_s,
  i32_extend16_s,
  i64_extend8_s,
  i64_extend16_s,
  i64_extend32_s,

  f32_eq,
  f32_ne,
  f32_lt,
  f32_gt,
  f32_le,
  f32_ge,
  f64_eq,
  f64_ne,
  f64_lt,
  f64_gt,
  f64_le,
  f64_ge,
  f32_abs,
  f32_neg,
  f32_ceil,
  f32_floor,
  f32_trunc,
  f32_nearest,
  f32_sqrt,
  f32_add,
  f32_sub,
  f32_mul,
  f32_div,
  f32_min,
  f32_max,
  f32_copysign,
  f64_abs,
  f64_neg,
  f64_ceil,
  f64_floor,
  f64_trunc,
  f64_nearest,
  f64_sqrt,
  f64_add,
  f64_sub,
  f64_mul,
  f64_div,
  f64_min,
  f64_max,
  f64_copysign,
  i32_trunc_f32_s,
  i32_trunc_f32_u,
  i32_trunc_f64_s,
  i32_trunc_f64_u,
  i64_trunc_f32_s,
  i64_trunc_f32_u,
  i64_trunc_f64_s,
  i64_trunc_f64_u,
  i32_trunc_sat_f32_s,
  i32_trunc_sat_f32_u,
  i32_trunc_sat_f64_s,
  i32_trunc_sat_f64_u,
  i64_trunc_sat_f32_s,
  i64_trunc_sat_f32_u,
  i64_trunc_sat_f64_s,
  i64_trunc_sat_f64_u,
  f32_convert_i32_s,
  f32_convert_i32_u,
  f32_convert_i64_s,
  f32_convert_i64_u,
  f64_convert_i32_s,
  f64_convert_i32_u,
  f64_convert_i64_s,
  f64_convert_i64_u,
  f32_demote_f64,
  f64_promote_f32,
  i32_reinterpret_f32,
  i64_reinterpret_f64,
  f32_reinterpret_i32,
  f64_reinterpret_i64,
;

# An abstract functor (D78), which the platform provides, as it provides
# this file's abstract fns. `bind Heap;` needs `Wasm` and a `Boxed` in
# context, and provides `.boxed` at receiver `Boxed` and `.deref` at
# `Ref[Boxed=...]` for whatever `Boxed` is there (D75): to box two types,
# bind `Boxed` to each and apply `Heap` after each. Code that has not
# applied it cannot box anything. Like any abstract functor it may be
# assumed on its own, and bound to another with its signature
# (`bind Alloc = Heap;`).
functor Heap[Boxed]: Wasm, Boxed -> Boxed.boxed, Ref.deref;

# Each is polymorphic in the type it boxes or arrays, and fixed in the
# rest of what its result mentions (D84, draft): `StructRef`, or `I32`
# and `ArrayRef`, which the platform's provision exists only at, so a
# scope that rebinds one cannot apply it until it binds it again.
#
# D81: the platform's other two. `bind Mutable;` provides `Ref.set` at
# `Ref[Boxed=...]` for the `Boxed` in context, and `bind Arrays;` the
# array items at the `Arrayed` in context, as `Heap` does for boxing.
functor Mutable[Boxed]: Wasm, Boxed -> Ref.set;

functor Arrays[Arrayed]: Wasm, Arrayed ->
  Arrayed.arrayed, Array.length, Array.get, Array.set, Array.fill, Array.copy;

# The platform's functors, in a context of their own (D84, O2): not in
# `Wasm`, which each of them takes, so none is among its own inputs — a
# functor bound to `Heap` that applies `Heap` captures the platform's,
# a polyfill — and a function that assumes `Wasm` needs none of them.
# The platform runs `main` in its root context, which has `Gc`, so `main`
# need not assume it (D37); any other function that needs one assumes it.
functor StructCasts[Boxed]: StructRef, Boxed -> StructCast.cast;
functor ArrayCasts[Arrayed]: ArrayRef, Arrayed -> ArrayCast.cast;

context Gc = Heap, Mutable, Arrays, StructCasts, ArrayCasts;
