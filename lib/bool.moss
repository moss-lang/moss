unit False;
unit True;

# Nominal over the sum (not a transparent alias), so that methods can
# attach to Bool — an alias of a union has no nominal head to key on.
type Bool | False | True;

val false: Bool = Bool (False);
val true: Bool = Bool (True);

# The logical operations, defined rather than provided: an attached
# method needs its receiver declared in the same module. `Std` provides
# them at `Bool` as num.moss's `.not`, `.and`, `.or` and `.xor` (D68), so
# `!a`, `a & b`, `a | b` and `a ^ b` work on booleans. They are methods,
# so both operands are always evaluated: short-circuiting is an `if`.
fn Bool.flip(): Bool { if this { false } else { true } }
fn Bool.both(rhs: Bool): Bool { if this { rhs } else { false } }
fn Bool.either(rhs: Bool): Bool { if this { true } else { rhs } }
fn Bool.differs(rhs: Bool): Bool { if this { rhs.flip() } else { rhs } }
