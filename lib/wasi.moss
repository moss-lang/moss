import "./gcstring.moss" use WasiGcStrings;
import "./std.moss" use Std;
import "./wasirawstd.moss" as raw;
import "./wasistd.moss" use Branch;
import "./wasm.moss" use Wasm, Gc;
import "./wasip1.moss" use Wasi;

# Preserve the public raw-memory interface. The compiler imports its
# implementation directly, keeping GC strings outside the bootstrap closure.
functor WasiRawStd: Wasm, Gc, Wasi, Branch -> Std {
  bind raw::WasiRawStd;
}

# User programs get immutable GC strings by default; the raw implementation
# remains an ordinary alternative context with the same public interface.
functor WasiStd: Wasm, Gc, Wasi, Branch -> Std {
  bind WasiRawStd;
  bind WasiGcStrings;
}
