import "./access.moss" use .get, .length, .push, .set;

# A growable list of Int: the native backing store. Generic list
# interfaces (IsList-style) instantiate at a unique receiver type per use
# and delegate to this — see D51 in docs/design/semantics.md. Ids into
# typed arenas are the intended idiom, and those are Ints.
#
# `.get`, `.set`, `.length` and `.push` are the shared accessors of
# access.moss, provided here at `IntList` with `Elem=Int` (D61). Its
# counterpart at `Float` is float.moss's `FloatList` (D69).

type IntList;

assume IntList {
  fn int_list(): IntList;
}
