unit RBracket;
unit Caret;
unit LBrace;
unit Pipe;
unit RBrace;

# Two-character symbols.
unit ExclamEqual;
unit ColonColon;
unit EqualGreater;
unit LessLess;
unit LessEqual;
unit EqualEqual;
unit GreaterEqual;
unit GreaterGreater;

# Keywords.
unit As;
unit Assume;
unit Bind;
unit Break;
unit Context;
unit Else;
unit Fn;
unit For;
unit If;
unit Import;
