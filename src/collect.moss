import "./intern.moss" as intern;
import "./lex.moss" as lexer;
import "./mods.moss" as mods;
import "./parse.moss" as parser;
import "./tree.moss" as tree;

# Collect, self-hosted and multi-file: load the entry file and everything
# it imports, transitively, then check each module's declarations against
# the references in it.
#
# The loader is a worklist rather than a recursion, which is what keeps
# each module's nodes contiguous in the arenas (see mods.moss): a file is
# parsed to completion before the next one starts, even though parsing it
# is what discovers the next one.

assume Std {
  assume lexer::at, lexer::mark, intern::Interner, tree::Tree, mods::Mods {
    # A path's directory, including the trailing slash — empty if there
    # is none.
    fn dir_of(p: String): String {
      var cut = zero;
      var i = zero;
      while i.lt(p.length()) {
        if p.get(i).eq(char::slash) {
          cut = i.add(one);
        }
        i = i.add(one);
      }
      p.slice(zero, cut)
    }

    # An import's path, as written, relative to the importing file's
    # directory. A leading `./` is dropped so that one file always gets
    # one name in the table; `..` is not handled yet.
    fn resolve(dir: String, rel: String): String {
      var start = zero;
      if rel.length().ge(one.add(one)) {
        if rel.get(zero).eq(char::dot) {
          if rel.get(one).eq(char::slash) {
            start = one.add(one);
          }
        }
      }
      dir.concat(rel.slice(start, rel.length().sub(start)))
    }

    # Read and parse one module, then queue the modules it imports.
    fn load_one(m: Int) {
      bind lexer::src=pwd.join(mods::path(m)).read();
      lexer::at.write(zero);
      lexer::mark.write(zero);
      mods::begin(
        tree::kinds.length(),
        tree::ref_ids.length(),
        tree::import_count(),
        tree::kid_mark()
      );
      let roots = int_list();
      parser::file(roots);
      var i = zero;
      while i.lt(roots.length()) {
        tree::kid_push(roots.get(i));
        i = i.add(one);
      }
      mods::set_kid_len(m, roots.length());
      let dir = dir_of(mods::path(m));
      var ix = mods::imp_start(m);
      while ix.lt(tree::import_count()) {
        mods::target_push(mods::add(resolve(dir, tree::import_text(ix))));
        ix = ix.add(one);
      }
    }

    # Does module `m` declare this name? Declarations inside assume blocks
    # are module-level names, so a module's scope is flat.
    fn declared_in(m: Int, id: Int): Bool {
      var i = mods::node_start(m);
      let end = mods::node_end(m, tree::kinds.length());
      while i.lt(end) {
        if tree::name_id_of(i).eq(id) {
          if parser::has_name(i) {
            return true;
          }
        }
        i = i.add(one);
      }
      false
    }

    # A name is in module `m`'s scope if `m` declares it, if one of `m`'s
    # imports names it, or if a `use *` import names a module that
    # declares it.
    fn visible(m: Int, id: Int): Bool {
      if declared_in(m, id) {
        return true;
      }
      var ix = mods::imp_start(m);
      let end = mods::imp_end(m, tree::import_count());
      while ix.lt(end) {
        if tree::import_star(ix) {
          if declared_in(mods::target(ix), id) {
            return true;
          }
        }
        var j = zero;
        while j.lt(tree::import_name_count(ix)) {
          if tree::import_name_at(ix, j).eq(id) {
            return true;
          }
          j = j.add(one);
        }
        ix = ix.add(one);
      }
      false
    }

    # One line per module: its path, then each duplicate declaration as
    # name+`!` and each unresolved reference as name+`?`, once apiece.
    fn report() {
      var m = zero;
      while m.lt(mods::count()) {
        print(mods::path(m));
        putchar(char::colon);
        parser::dups(mods::kid_start(m), mods::kid_len(m));
        let reported = int_list();
        var r = mods::ref_start(m);
        let end = mods::ref_end(m, tree::ref_ids.length());
        while r.lt(end) {
          let id = tree::ref_ids.get(r);
          if visible(m, id).not() {
            if parser::contains(reported, id).not() {
              reported.push(id);
              intern::put(id);
              putchar(char::question);
            }
          }
          r = r.add(one);
        }
        putchar(char::newline);
        m = m.add(one);
      }
    }

    fn run(entry: String) {
      mods::add(entry);
      var m = zero;
      while m.lt(mods::count()) {
        load_one(m);
        m = m.add(one);
      }
      report();
    }
  }
}
