import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./intern.moss" as intern;
import "./prog.moss" as prog;

# Elaborated types, and the layout each one has in Wasm.
#
# Type identity is structural over (declaration, static type bindings)
# [D18], so the arena is hash-consed: elaborating the same type twice
# gives the same id, and two ids are equal exactly when the types are.
# A nominal type's members are its arguments: one type per abstract type
# symbol its payload mentions (`type_reqs`), in that order, so
# `Box[Elem=Char]` and `Box[Elem=Point]` are two types. Written without
# brackets, a nominal is applied to those symbols themselves, and an
# environment that binds them substitutes (`lower::canon`).
#
# Layout is [D59]: every value is a finite run of Wasm scalars and the
# compiler allocates nothing. `()` is no slots; a unit is one, holding
# its code; a nominal tag is exactly its payload ([D58]); a record is its
# fields' runs, one after another, in declaration order; a union of
# units is one scalar, and any wider union is a discriminant followed by
# room for its widest member.

assume Std {
  fn kd_unit(): Int { zero }
  fn kd_never(): Int { one }
  fn kd_nominal(): Int { n2() }
  fn kd_abstract(): Int { n3() }
  fn kd_union(): Int { n4() }
  # A record's members alternate: field name, field type, in declaration
  # order. Field order is part of the type, as it is in the bootstrap.
  fn kd_record(): Int { n5() }

  val ty_kind: IntList;
  val ty_sym: IntList;
  val ty_mstart: IntList;
  val ty_mlen: IntList;
  val ty_mem: IntList;

  # `()` and `|` are asked for constantly — every missing return type is
  # one — and each is a single row, so they are remembered rather than
  # looked up. `ty_by_sym` is the same idea for the nominal and abstract
  # types, indexed by the symbol that names them; and `elab_memo` is
  # indexed by the syntax node, which is sound because a node belongs to
  # exactly one module and so elaborates one way.
  val ty_unit_row: CellInt;
  val ty_never_row: CellInt;
  val ty_by_sym: IntList;
  val elab_memo: IntList;

  # Each `unit` declaration's discriminant. `Bool`'s two are 0 and 1 so
  # that a comparison result can be used directly ([D45]); every other
  # unit takes the next code after those.
  val unit_syms: IntList;
  val unit_codes: IntList;

  # `width` is asked for on every load and store of every local, and a
  # type's layout cannot change once it is elaborated: one slot per type
  # id, holding the width plus one so that zero means "not computed".
  val ty_width: IntList;

  # Each tag's and alias's type requirements, as a run of abstract type
  # symbols in `tr_pool`, indexed by the declaring symbol. `tr_len` is
  # none until computed; while a group is being solved (`solve_reqs`) it
  # holds the current approximation, so a type that mentions itself
  # terminates.
  val tr_start: IntList;
  val tr_len: IntList;
  val tr_pool: IntList;

  context Types = ty_kind, ty_sym, ty_mstart, ty_mlen, ty_mem,
    ty_unit_row, ty_never_row, ty_by_sym, elab_memo,
    unit_syms, unit_codes, ty_width, tr_start, tr_len, tr_pool;

  assume Types, ast::Ast, prog::Prog, intern::Interner {
    fn ty_count(): Int { ty_kind.length() }

    fn kind_of(t: Int): Int { ty_kind.get(t) }
    fn sym_of(t: Int): Int { ty_sym.get(t) }
    fn member_count(t: Int): Int { ty_mlen.get(t) }
    fn member_at(t: Int, i: Int): Int { ty_mem.get(ty_mstart.get(t).add(i)) }

    fn is_kind(t: Int, k: Int): Bool {
      if ast::is_some(t) {
        ty_kind.get(t).eq(k)
      } else {
        false
      }
    }

    # Hash-consed: scan for an identical row before adding one.
    fn intern_ty(kind: Int, sym: Int, members: IntList): Int {
      var t = zero;
      while t.lt(ty_count()) {
        if ty_kind.get(t).eq(kind) {
          if ty_sym.get(t).eq(sym) {
            if ty_mlen.get(t).eq(members.length()) {
              var i = zero;
              var same = true;
              while i.lt(members.length()) {
                if member_at(t, i).ne(members.get(i)) {
                  same = false;
                  i = members.length();
                } else {
                  i = i.add(one);
                }
              }
              if same {
                return t;
              }
            }
          }
        }
        t = t.add(one);
      }
      ty_kind.push(kind);
      ty_sym.push(sym);
      ty_mstart.push(ty_mem.length());
      ty_mlen.push(members.length());
      var i = zero;
      while i.lt(members.length()) {
        ty_mem.push(members.get(i));
        i = i.add(one);
      }
      ty_count().sub(one)
    }

    fn ty_simple(kind: Int): Int {
      intern_ty(kind, ast::none(), int_list())
    }

    fn ty_unit(): Int {
      if ty_unit_row.read().eq(zero) {
        ty_unit_row.write(ty_simple(kd_unit()).add(one));
      }
      ty_unit_row.read().sub(one)
    }

    fn ty_never(): Int {
      if ty_never_row.read().eq(zero) {
        ty_never_row.write(ty_simple(kd_never()).add(one));
      }
      ty_never_row.read().sub(one)
    }

    fn ty_of_symbol(kind: Int, sym: Int): Int {
      while ty_by_sym.length().le(sym) {
        ty_by_sym.push(ast::none());
      }
      if ast::is_some(ty_by_sym.get(sym)) {
        return ty_by_sym.get(sym);
      }
      let t = intern_ty(kind, sym, int_list());
      ty_by_sym.set(sym, t);
      t
    }

    # A unit's discriminant, assigned on first sight and stable after.
    fn unit_code(sym: Int): Int {
      var i = zero;
      while i.lt(unit_syms.length()) {
        if unit_syms.get(i).eq(sym) {
          return unit_codes.get(i);
        }
        i = i.add(one);
      }
      unit_syms.push(sym);
      unit_codes.push(unit_codes.length());
      unit_codes.get(unit_codes.length().sub(one))
    }

    # `False` is 0 and `True` is 1, so that `if` can branch on a
    # comparison result with no conversion. Called once, before anything
    # else asks for a code.
    fn seed_bool(false_sym: Int, true_sym: Int) {
      unit_code(false_sym);
      unit_code(true_sym);
    }

    # Elaboration. `m` is the module the type was written in.

    fn elab(t: Int, m: Int): Int {
      if ast::is_some(t).not() {
        return ty_unit();
      }
      while elab_memo.length().le(t) {
        elab_memo.push(ast::none());
      }
      if ast::is_some(elab_memo.get(t)) {
        return elab_memo.get(t);
      }
      let result = elab_node(t, m);
      elab_memo.set(t, result);
      result
    }

    fn elab_node(t: Int, m: Int): Int {
      let k = ast::kind_of(t);
      if k.eq(ast::k_ty_unit()) {
        return ty_unit();
      }
      if k.eq(ast::k_ty_never()) {
        return ty_never();
      }
      if k.eq(ast::k_ty_union()) {
        let members = int_list();
        var i = zero;
        while i.lt(ast::b_of(t)) {
          add_member(members, elab(ast::kid_at(ast::a_of(t), i), m));
          i = i.add(one);
        }
        if members.length().eq(zero) {
          return ty_never();
        }
        if members.length().eq(one) {
          return members.get(zero);
        }
        return intern_ty(kd_union(), ast::none(), members);
      }
      if k.eq(ast::k_ty_record()) {
        let members = int_list();
        var i = zero;
        while i.lt(ast::b_of(t)) {
          let f = ast::kid_at(ast::a_of(t), i);
          members.push(ast::a_of(f));
          members.push(elab(ast::b_of(f), m));
          i = i.add(one);
        }
        return intern_ty(kd_record(), ast::none(), members);
      }
      if k.ne(ast::k_ty_ref()) {
        # `This` standing alone; see `e_shape`.
        prog::error(prog::e_shape(), m, ast::none());
        return ty_never();
      }
      let sym = prog::resolve_path(m, ast::a_of(t));
      if ast::is_some(sym).not() {
        prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(t)));
        return ty_never();
      }
      if ast::d_of(t).eq(one) {
        return apply(sym, ast::b_of(t), ast::c_of(t), m);
      }
      ty_of_decl(sym)
    }

    # `S[T=U, ...]`, written in module `m`: the nominal or alias `S` with
    # some of its type requirements bound. A requirement left unbound is
    # applied to itself, as `S` alone would be. A binding for a symbol
    # that is not one of `S`'s relevant parameters — one its payload does
    # not mention, any symbol at all for a unit or an abstract type — is
    # `e_irrelevant` (D71), named by that symbol, as in the bootstrap.
    fn apply(sym: Int, run: Int, len: Int, m: Int): Int {
      let kind = prog::sym_kind.get(sym);
      var ok = kind.eq(prog::sk_tag());
      if ok.not() {
        ok = kind.eq(prog::sk_alias());
      }
      var bare = kind.eq(prog::sk_unit());
      if bare.not() {
        bare = kind.eq(prog::sk_type());
      }
      if ok.not() {
        if bare.not() {
          prog::error(prog::e_apply(), m, prog::sym_name.get(sym));
          return ty_of_decl(sym);
        }
      }
      let reqs = int_list();
      if ok {
        reqs_of(sym, reqs);
      }
      let args = int_list();
      var i = zero;
      while i.lt(reqs.length()) {
        args.push(ty_of_symbol(kd_abstract(), reqs.get(i)));
        i = i.add(one);
      }
      i = zero;
      while i.lt(len) {
        let b = ast::kid_at(run, i);
        let lhs = prog::resolve_path(m, ast::a_of(b));
        if ast::is_some(lhs).not() {
          prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(b)));
        } else if prog::sym_kind.get(lhs).ne(prog::sk_type()) {
          prog::error(prog::e_apply(), m, prog::sym_name.get(lhs));
        } else if contains_sym(reqs, lhs).not() {
          prog::error(prog::e_irrelevant(), m, prog::sym_name.get(lhs));
        } else {
          let rhs = elab_spec(ast::b_of(b), m);
          var j = zero;
          while j.lt(reqs.length()) {
            if reqs.get(j).eq(lhs) {
              args.set(j, rhs);
            }
            j = j.add(one);
          }
        }
        i = i.add(one);
      }
      if ok.not() {
        return ty_of_decl(sym);
      }
      if kind.eq(prog::sk_alias()) {
        return subst(ty_of_decl(sym), reqs, args);
      }
      nominal(sym, args)
    }

    # The right-hand side of a type binding: a type by name, maybe applied
    # itself.
    fn elab_spec(spec: Int, m: Int): Int {
      if ast::is_some(ast::b_of(spec)) {
        prog::error(prog::e_apply(), m, ast::b_of(spec));
        return ty_never();
      }
      let sym = prog::resolve_path(m, ast::a_of(spec));
      if ast::is_some(sym).not() {
        prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(spec)));
        return ty_never();
      }
      if ast::d_of(spec).gt(zero) {
        return apply(sym, ast::c_of(spec), ast::d_of(spec), m);
      }
      ty_of_decl(sym)
    }

    # A nominal type at these arguments, one per type requirement.
    fn nominal(sym: Int, args: IntList): Int {
      if args.length().eq(zero) {
        return ty_of_symbol(kd_nominal(), sym);
      }
      intern_ty(kd_nominal(), sym, args)
    }

    # The abstract type symbols a tag or alias is parameterized by — its
    # relevant parameters (D71, narrowing D18/D21): those its payload
    # mentions, directly or through the types it names, minus any those
    # names' own brackets bind. Not everything the enclosing assumes
    # provide, or `unit Stop;` under `assume Std` would be a different
    # type per ambient binding. Over mutually recursive declarations it is
    # the least fixpoint (`solve_reqs`), so the answer does not depend on
    # which declaration was asked about first. The bootstrap's
    # `type_requirements` is the same rule.
    fn reqs_of(sym: Int, out: IntList) {
      while tr_len.length().le(sym) {
        tr_start.push(zero);
        tr_len.push(ast::none());
      }
      if tr_len.get(sym).eq(ast::none()) {
        solve_reqs(sym);
      }
      var i = zero;
      while i.lt(tr_len.get(sym)) {
        out.push(tr_pool.get(tr_start.get(sym).add(i)));
        i = i.add(one);
      }
    }

    fn scans_payload(sym: Int): Bool {
      let kind = prog::sym_kind.get(sym);
      if kind.eq(prog::sk_tag()) {
        true
      } else {
        kind.eq(prog::sk_alias())
      }
    }

    # `root` and every tag or alias it reaches whose requirements are not
    # yet known, solved together: each starts at nothing, and every
    # payload is rescanned against the current answers until none
    # changes. The scan only grows with the answers it reads, so this
    # stops, and at the least fixpoint — where reading an in-progress
    # entry as final, the old shortcut, gave `type A { b: B, t: T }; type
    # B { a: A };` a `B` without `T` whenever `A` was asked first.
    fn solve_reqs(root: Int) {
      let group = int_list();
      group.push(root);
      tr_start.set(root, tr_pool.length());
      tr_len.set(root, zero);
      var g = zero;
      while g.lt(group.length()) {
        let s = group.get(g);
        if scans_payload(s) {
          let found = int_list();
          mentioned(ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s), found);
          var i = zero;
          while i.lt(found.length()) {
            let f = found.get(i);
            while tr_len.length().le(f) {
              tr_start.push(zero);
              tr_len.push(ast::none());
            }
            if tr_len.get(f).eq(ast::none()) {
              tr_start.set(f, tr_pool.length());
              tr_len.set(f, zero);
              group.push(f);
            }
            i = i.add(one);
          }
        }
        g = g.add(one);
      }
      var changed = true;
      while changed {
        changed = false;
        g = zero;
        while g.lt(group.length()) {
          let s = group.get(g);
          if scans_payload(s) {
            let found = int_list();
            free_syms(ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s), found);
            if same_run(found, tr_start.get(s), tr_len.get(s)).not() {
              tr_start.set(s, tr_pool.length());
              var i = zero;
              while i.lt(found.length()) {
                tr_pool.push(found.get(i));
                i = i.add(one);
              }
              tr_len.set(s, found.length());
              changed = true;
            }
          }
          g = g.add(one);
        }
      }
    }

    fn same_run(xs: IntList, start: Int, len: Int): Bool {
      if xs.length().ne(len) {
        return false;
      }
      var i = zero;
      while i.lt(len) {
        if xs.get(i).ne(tr_pool.get(start.add(i))) {
          return false;
        }
        i = i.add(one);
      }
      true
    }

    # The tags and aliases a type expression names, brackets included.
    fn mentioned(t: Int, m: Int, out: IntList) {
      if ast::is_some(t).not() {
        return ();
      }
      let k = ast::kind_of(t);
      if k.eq(ast::k_ty_ref()) {
        mentioned_ref(ast::a_of(t), ast::b_of(t), ast::c_of(t), m, out);
      } else if k.eq(ast::k_ty_union()) {
        var i = zero;
        while i.lt(ast::b_of(t)) {
          mentioned(ast::kid_at(ast::a_of(t), i), m, out);
          i = i.add(one);
        }
      } else if k.eq(ast::k_ty_record()) {
        var i = zero;
        while i.lt(ast::b_of(t)) {
          mentioned(ast::b_of(ast::kid_at(ast::a_of(t), i)), m, out);
          i = i.add(one);
        }
      }
    }

    fn mentioned_ref(path: Int, run: Int, len: Int, m: Int, out: IntList) {
      let sym = prog::resolve_path(m, path);
      if ast::is_some(sym) {
        if scans_payload(sym) {
          out.push(sym);
        }
      }
      var i = zero;
      while i.lt(len) {
        let rhs = ast::b_of(ast::kid_at(run, i));
        mentioned_ref(ast::a_of(rhs), ast::c_of(rhs), ast::d_of(rhs), m, out);
        i = i.add(one);
      }
    }

    fn push_new(out: IntList, v: Int) {
      var i = zero;
      while i.lt(out.length()) {
        if out.get(i).eq(v) {
          return ();
        }
        i = i.add(one);
      }
      out.push(v);
    }

    # The abstract type symbols a type expression mentions.
    fn free_syms(t: Int, m: Int, out: IntList) {
      if ast::is_some(t).not() {
        return ();
      }
      let k = ast::kind_of(t);
      if k.eq(ast::k_ty_ref()) {
        free_syms_ref(ast::a_of(t), ast::b_of(t), ast::c_of(t), m, out);
      } else if k.eq(ast::k_ty_union()) {
        var i = zero;
        while i.lt(ast::b_of(t)) {
          free_syms(ast::kid_at(ast::a_of(t), i), m, out);
          i = i.add(one);
        }
      } else if k.eq(ast::k_ty_record()) {
        var i = zero;
        while i.lt(ast::b_of(t)) {
          free_syms(ast::b_of(ast::kid_at(ast::a_of(t), i)), m, out);
          i = i.add(one);
        }
      }
    }

    # `S[T=U, ...]`: `S`'s own requirements, less the ones the brackets
    # bind, plus whatever the right-hand sides mention.
    fn free_syms_ref(path: Int, run: Int, len: Int, m: Int, out: IntList) {
      let sym = prog::resolve_path(m, path);
      if ast::is_some(sym).not() {
        return ();
      }
      let bound = int_list();
      var i = zero;
      while i.lt(len) {
        let b = ast::kid_at(run, i);
        let lhs = prog::resolve_path(m, ast::a_of(b));
        if ast::is_some(lhs) {
          bound.push(lhs);
        }
        let rhs = ast::b_of(b);
        free_syms_ref(ast::a_of(rhs), ast::c_of(rhs), ast::d_of(rhs), m, out);
        i = i.add(one);
      }
      let kind = prog::sym_kind.get(sym);
      if kind.eq(prog::sk_type()) {
        if contains_sym(bound, sym).not() {
          push_new(out, sym);
        }
        return ();
      }
      let reqs = int_list();
      reqs_of(sym, reqs);
      i = zero;
      while i.lt(reqs.length()) {
        if contains_sym(bound, reqs.get(i)).not() {
          push_new(out, reqs.get(i));
        }
        i = i.add(one);
      }
    }

    fn contains_sym(xs: IntList, v: Int): Bool {
      var i = zero;
      while i.lt(xs.length()) {
        if xs.get(i).eq(v) {
          return true;
        }
        i = i.add(one);
      }
      false
    }

    # `t` with each abstract `from[i]` replaced by `to[i]`.
    fn subst(t: Int, from: IntList, to: IntList): Int {
      let k = kind_of(t);
      if k.eq(kd_abstract()) {
        var i = zero;
        while i.lt(from.length()) {
          if from.get(i).eq(sym_of(t)) {
            return to.get(i);
          }
          i = i.add(one);
        }
        return t;
      }
      if k.eq(kd_nominal()) {
        if member_count(t).eq(zero) {
          return t;
        }
        let args = int_list();
        var i = zero;
        while i.lt(member_count(t)) {
          args.push(subst(member_at(t, i), from, to));
          i = i.add(one);
        }
        return nominal(sym_of(t), args);
      }
      if k.eq(kd_union()) {
        let members = int_list();
        var i = zero;
        while i.lt(member_count(t)) {
          members.push(subst(member_at(t, i), from, to));
          i = i.add(one);
        }
        return union_of(members);
      }
      if k.eq(kd_record()) {
        let members = int_list();
        var i = zero;
        while i.lt(field_count(t)) {
          members.push(field_name_at(t, i));
          members.push(subst(field_type_at(t, i), from, to));
          i = i.add(one);
        }
        return intern_ty(kd_record(), ast::none(), members);
      }
      t
    }

    # A union of these types, flattened and deduplicated as written ones
    # are; a single member is itself, and none is `|`.
    fn union_of(types: IntList): Int {
      let members = int_list();
      var i = zero;
      while i.lt(types.length()) {
        add_member(members, types.get(i));
        i = i.add(one);
      }
      if members.length().eq(zero) {
        return ty_never();
      }
      if members.length().eq(one) {
        return members.get(zero);
      }
      intern_ty(kd_union(), ast::none(), members)
    }

    # The type a type symbol names. An alias is transparent; a `unit` or
    # a tag is nominal; an abstract `type T;` stays abstract until an
    # environment binds it.
    fn ty_of_decl(sym: Int): Int {
      let kind = prog::sym_kind.get(sym);
      if kind.eq(prog::sk_alias()) {
        return elab(ast::b_of(prog::sym_decl.get(sym)), prog::sym_mod.get(sym));
      }
      if kind.eq(prog::sk_unit()) {
        return ty_of_symbol(kd_nominal(), sym);
      }
      if kind.eq(prog::sk_tag()) {
        # Applied to its own requirements; remembered, since this is asked
        # for at every mention of the tag.
        while ty_by_sym.length().le(sym) {
          ty_by_sym.push(ast::none());
        }
        if ast::is_some(ty_by_sym.get(sym)) {
          return ty_by_sym.get(sym);
        }
        let reqs = int_list();
        reqs_of(sym, reqs);
        let args = int_list();
        var i = zero;
        while i.lt(reqs.length()) {
          args.push(ty_of_symbol(kd_abstract(), reqs.get(i)));
          i = i.add(one);
        }
        let t = nominal(sym, args);
        ty_by_sym.set(sym, t);
        return t;
      }
      if kind.eq(prog::sk_type()) {
        return ty_of_symbol(kd_abstract(), sym);
      }
      prog::error(prog::e_type(), prog::sym_mod.get(sym), prog::sym_name.get(sym));
      ty_never()
    }

    # A union's members are deduplicated and flattened, so that
    # `Read | Eof` and an alias naming the same two are one type.
    fn add_member(members: IntList, t: Int) {
      if is_kind(t, kd_never()) {
        return ();
      }
      if is_kind(t, kd_union()) {
        var i = zero;
        while i.lt(member_count(t)) {
          add_member(members, member_at(t, i));
          i = i.add(one);
        }
        return ();
      }
      var i = zero;
      while i.lt(members.length()) {
        if members.get(i).eq(t) {
          return ();
        }
        i = i.add(one);
      }
      members.push(t);
    }

    # A tag's payload at the tag's arguments, or the unit type for a
    # `unit` declaration.
    fn payload_of(t: Int): Int {
      let sym = sym_of(t);
      if prog::sym_kind.get(sym).ne(prog::sk_tag()) {
        return ty_unit();
      }
      let p = elab(ast::b_of(prog::sym_decl.get(sym)), prog::sym_mod.get(sym));
      if member_count(t).eq(zero) {
        return p;
      }
      let reqs = int_list();
      reqs_of(sym, reqs);
      let args = int_list();
      var i = zero;
      while i.lt(member_count(t)) {
        args.push(member_at(t, i));
        i = i.add(one);
      }
      subst(p, reqs, args)
    }

    fn is_unit_decl(t: Int): Bool {
      if is_kind(t, kd_nominal()).not() {
        false
      } else {
        prog::sym_kind.get(sym_of(t)).eq(prog::sk_unit())
      }
    }

    # Layout, D59. How many Wasm scalars a value of this type occupies —
    # memoized, because the back end asks it of a local's type on every
    # load and every store, and a type cannot change shape once it is
    # elaborated.
    #
    # A nominal type asked about while its own width is being computed
    # contains itself, and has no finite layout. Every such cycle passes
    # through a nominal type, because only a nominal type refers to a type
    # by name — so marking those alone is enough to catch it, and the one
    # caught is in the cycle. Reported as `e_shape` and given width zero,
    # so the compiler can carry on to its other diagnostics.
    fn width(t: Int): Int {
      while ty_width.length().le(t) {
        ty_width.push(zero);
      }
      let seen = ty_width.get(t);
      if seen.gt(zero) {
        return seen.sub(one);
      }
      if seen.lt(zero) {
        let sym = sym_of(t);
        prog::error(prog::e_shape(), prog::sym_mod.get(sym), prog::sym_name.get(sym));
        ty_width.set(t, one);
        return zero;
      }
      if is_kind(t, kd_nominal()) {
        ty_width.set(t, ast::none());
      }
      let w = width_of(t);
      if ty_width.get(t).le(zero) {
        ty_width.set(t, w.add(one));
      }
      w
    }

    # A record's fields.
    fn field_count(t: Int): Int { member_count(t).div(n2()) }
    fn field_name_at(t: Int, i: Int): Int { member_at(t, i.add(i)) }
    fn field_type_at(t: Int, i: Int): Int { member_at(t, i.add(i).add(one)) }

    # The field with this interned name, or none.
    fn field_index(t: Int, name: Int): Int {
      var i = zero;
      while i.lt(field_count(t)) {
        if field_name_at(t, i).eq(name) {
          return i;
        }
        i = i.add(one);
      }
      ast::none()
    }

    # Where a field's run starts within the record's.
    fn field_offset(t: Int, i: Int): Int {
      var off = zero;
      var j = zero;
      while j.lt(i) {
        off = off.add(width(field_type_at(t, j)));
        j = j.add(one);
      }
      off
    }

    # The record a value of this type carries: itself, or a tag's
    # payload. None for anything without fields.
    fn record_of(t: Int): Int {
      if is_kind(t, kd_record()) {
        return t;
      }
      if is_kind(t, kd_nominal()) {
        if is_unit_decl(t).not() {
          let p = payload_of(t);
          if is_kind(p, kd_record()) {
            return p;
          }
        }
      }
      ast::none()
    }

    # The layout rule itself. Only `width` calls it, and only once per
    # type.
    fn width_of(t: Int): Int {
      let k = kind_of(t);
      if k.eq(kd_unit()) {
        return zero;
      }
      if k.eq(kd_never()) {
        return zero;
      }
      if k.eq(kd_abstract()) {
        # An unbound abstract type has no layout; the environment must
        # substitute before anyone asks.
        return one;
      }
      if k.eq(kd_nominal()) {
        if is_unit_decl(t) {
          return one;
        }
        return width(payload_of(t));
      }
      if k.eq(kd_record()) {
        return field_offset(t, field_count(t));
      }
      # A union: one scalar if the members discriminate by themselves,
      # otherwise a discriminant beside room for the widest.
      if all_units(t) {
        return one;
      }
      var widest = zero;
      var i = zero;
      while i.lt(member_count(t)) {
        let w = width(member_at(t, i));
        if w.gt(widest) {
          widest = w;
        }
        i = i.add(one);
      }
      widest.add(one)
    }

    fn all_units(t: Int): Bool {
      var i = zero;
      while i.lt(member_count(t)) {
        if is_unit_decl(member_at(t, i)).not() {
          return false;
        }
        i = i.add(one);
      }
      true
    }

    # Whether a value of type `t` is acceptable where `expected` is
    # wanted: equality, divergence, or injection into a union (D17).
    fn fits(t: Int, expected: Int): Bool {
      if t.eq(expected) {
        return true;
      }
      if is_kind(t, kd_never()) {
        return true;
      }
      if is_kind(expected, kd_union()).not() {
        return false;
      }
      if is_kind(t, kd_union()) {
        var i = zero;
        while i.lt(member_count(t)) {
          if is_member(member_at(t, i), expected).not() {
            return false;
          }
          i = i.add(one);
        }
        return true;
      }
      is_member(t, expected)
    }

    fn is_member(t: Int, union: Int): Bool {
      var i = zero;
      while i.lt(member_count(union)) {
        if member_at(union, i).eq(t) {
          return true;
        }
        i = i.add(one);
      }
      false
    }

    # Match compilation asks two things of a scrutinee's type: how many
    # heads it could have, and which member carries a given one.
    fn head_count(t: Int): Int {
      if is_kind(t, kd_union()) {
        member_count(t)
      } else if is_kind(t, kd_never()) {
        zero
      } else {
        one
      }
    }

    fn member_with_head(t: Int, head: Int): Int {
      if is_kind(t, kd_union()).not() {
        if head_of(t).eq(head) {
          return t;
        }
        return ast::none();
      }
      var i = zero;
      while i.lt(member_count(t)) {
        if head_of(member_at(t, i)).eq(head) {
          return member_at(t, i);
        }
        i = i.add(one);
      }
      ast::none()
    }

    # What a member of a union contributes beyond the discriminant: the
    # payload of a tag, and nothing for a unit.
    fn member_payload(t: Int): Int {
      if is_unit_decl(t) {
        ty_unit()
      } else if is_kind(t, kd_nominal()) {
        payload_of(t)
      } else {
        t
      }
    }

    # The head a value discriminates on: a nominal type's own symbol.
    fn head_of(t: Int): Int {
      if is_kind(t, kd_nominal()) {
        sym_of(t)
      } else if is_kind(t, kd_abstract()) {
        sym_of(t)
      } else {
        ast::none()
      }
    }
  }
}
