import "./bytes.moss" use *;
import "./emit.moss" as emit;

# Wasm instruction encoding: opcodes as named functions, and the handful
# of instructions that carry an immediate.
#
# Only the instructions the back end selects by name are here — the
# `Wasm` intrinsics encode through `op_mem` and the wasmops table, so
# their opcodes never need names. The full opcode space is in the
# specification; adding one is a line.

assume Std {
  # Control.
  fn op_unreachable(buf: IntList) { buf.push(0); }
  fn op_end(buf: IntList) { buf.push(11); }
  fn op_else(buf: IntList) { buf.push(5); }
  fn op_return(buf: IntList) { buf.push(15); }
  fn op_drop(buf: IntList) { buf.push(26); }

  # A block type is `0x40` for no result, or a valtype byte.
  fn bt_empty(): Int { 64 }

  fn op_block(buf: IntList, bt: Int) { buf.push(2); buf.push(bt); }
  fn op_loop(buf: IntList, bt: Int) { buf.push(3); buf.push(bt); }

  fn op_br(buf: IntList, depth: Int) {
    buf.push(12);
    uleb(buf, depth);
  }

  fn op_br_if(buf: IntList, depth: Int) {
    buf.push(13);
    uleb(buf, depth);
  }

  fn op_call(buf: IntList, f: Int) {
    buf.push(16);
    uleb(buf, f);
  }

  # Locals.
  fn op_local_get(buf: IntList, i: Int) {
    buf.push(32);
    uleb(buf, i);
  }

  fn op_local_set(buf: IntList, i: Int) {
    buf.push(33);
    uleb(buf, i);
  }

  # Constants.
  fn op_i32_const(buf: IntList, v: Int) {
    buf.push(65);
    sleb(buf, v);
  }

  # Memory. Every access this back end emits is naturally aligned at
  # offset zero, so the memarg is (align, 0).
  fn op_mem(buf: IntList, code: Int, align: Int) {
    buf.push(code);
    uleb(buf, align);
    uleb(buf, 0);
  }

  # The same at memory `mem` (D79): with multiple memories, bit 6 of the
  # alignment flags says a memory index follows. Memory 0 keeps the short
  # form, so a module with one memory is byte for byte as before.
  fn op_mem_at(buf: IntList, code: Int, align: Int, mem: Int) {
    if mem == 0 {
      op_mem(buf, code, align);
    } else {
      buf.push(code);
      uleb(buf, align + 64);
      uleb(buf, mem);
      uleb(buf, 0);
    }
  }

  fn op_i32_store(buf: IntList) { op_mem(buf, 54, 2); }
  # Selected by no code path of the compiler's own; tests/wasi/emit.moss
  # builds a module with it.
  fn op_i32_store8(buf: IntList) { op_mem(buf, 58, 0); }

  fn op_memory_copy(buf: IntList) { op_memory_copy_at(buf, 0); }

  fn op_memory_fill(buf: IntList) { op_memory_fill_at(buf, 0); }

  # Within memory `mem` (D79).
  fn op_memory_copy_at(buf: IntList, mem: Int) {
    buf.push(252);
    uleb(buf, 10);
    uleb(buf, mem);
    uleb(buf, mem);
  }

  fn op_memory_fill_at(buf: IntList, mem: Int) {
    buf.push(252);
    uleb(buf, 11);
    uleb(buf, mem);
  }

  # D75's garbage-collected structs, 0xFB-prefixed: a struct type is its
  # index `j`, and a reference type an `emit::vt_ref` or
  # `emit::vt_structref`, whose heap type an instruction names.
  fn op_struct_new(buf: IntList, j: Int) {
    buf.push(251);
    uleb(buf, 0);
    uleb(buf, j);
  }

  fn op_struct_get(buf: IntList, j: Int, field: Int) {
    buf.push(251);
    uleb(buf, 2);
    uleb(buf, j);
    uleb(buf, field);
  }

  fn op_struct_set(buf: IntList, j: Int, field: Int) {
    buf.push(251);
    uleb(buf, 5);
    uleb(buf, j);
    uleb(buf, field);
  }

  # D81's arrays: an array type is its index `j`, as a struct's is.
  fn op_array(buf: IntList, op: Int, j: Int) {
    buf.push(251);
    uleb(buf, op);
    uleb(buf, j);
  }

  fn op_array_new(buf: IntList, j: Int) { op_array(buf, 6, j); }
  fn op_array_get(buf: IntList, j: Int) { op_array(buf, 11, j); }
  fn op_array_set(buf: IntList, j: Int) { op_array(buf, 14, j); }
  fn op_array_fill(buf: IntList, j: Int) { op_array(buf, 16, j); }

  fn op_array_len(buf: IntList) {
    buf.push(251);
    uleb(buf, 15);
  }

  fn op_array_copy(buf: IntList, j: Int) {
    op_array(buf, 17, j);
    uleb(buf, j);
  }

  fn op_ref_cast_null(buf: IntList, vt: Int) {
    buf.push(251);
    uleb(buf, 23);
    emit::push_heaptype(buf, vt);
  }

  fn op_ref_null(buf: IntList, vt: Int) {
    buf.push(208);
    emit::push_heaptype(buf, vt);
  }
}
