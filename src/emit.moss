import "./bytes.moss" use *;
import "./spell.moss" use *;

# The Wasm module emitter, self-hosted.
#
# A module under construction is a set of parallel arenas, one run per
# kind of index space, exactly as `ast.moss` holds the AST: function
# types, imported functions, defined functions with their bodies in one
# flat instruction arena, and exports. `module` walks them once and lays
# out the binary.
#
# Nothing here knows anything about Moss. Instruction selection is the
# back end's job (codegen.moss); this is the encoder underneath it.

assume Std {
  fn vt_i32(): Int { 127 }
  fn vt_i64(): Int { 126 }
  fn vt_f32(): Int { 125 }
  fn vt_f64(): Int { 124 }

  # The four scalar valtypes, numbered: they are consecutive bytes, i32
  # down to f64, so the `k`th is a subtraction.
  fn vt_count(): Int { 4 }
  fn vt_at(k: Int): Int { vt_i32() - k }

  # D75's references, which are not one byte: `(ref null ht)` is 0x63 and
  # then the heap type. A valtype here is an Int, so they are numbered
  # past every byte: `vt_structref` is `(ref null struct)`, numbered by
  # the abstract heap type's own byte (0x6B), and `vt_ref(j)` is a
  # reference to the `j`th struct type.
  fn vt_structref(): Int { 107 }
  # D81: a bare `ArrayRef`, `(ref null eq)`, by the byte of `eq` (0x6D).
  fn vt_eqref(): Int { 109 }
  fn vt_ref(j: Int): Int { 256 + j }
  fn is_ref(vt: Int): Bool {
    if vt == vt_structref() {
      true
    } else if vt == vt_eqref() {
      true
    } else {
      vt >= 256
    }
  }

  fn push_heaptype(out: IntList, vt: Int) {
    if vt < 256 {
      out.push(vt);
    } else {
      sleb(out, vt - 256);
    }
  }

  fn push_valtype(out: IntList, vt: Int) {
    if is_ref(vt) {
      out.push(99);
      push_heaptype(out, vt);
    } else {
      out.push(vt);
    }
  }

  # Section ids, from the binary format.
  fn sec_type(): Int { 1 }
  fn sec_import(): Int { 2 }
  fn sec_func(): Int { 3 }
  fn sec_mem(): Int { 5 }
  fn sec_export(): Int { 7 }
  fn sec_code(): Int { 10 }

  fn kind_func(): Int { 0 }
  fn kind_mem(): Int { 2 }

  # Function types: `ft_params` and `ft_res` are flat runs of valtype
  # bytes, with a start and a length each. A result list of more than one
  # is the multi-value proposal, which every engine that runs WASI has —
  # and a value of D59 is a run of scalars, so a function returning one
  # returns several results.
  val ft_params: IntList;
  val ft_pstart: IntList;
  val ft_plen: IntList;
  val ft_res: IntList;
  val ft_rstart: IntList;
  val ft_rlen: IntList;

  # Import and export names, one flat byte arena.
  val nchars: IntList;

  # Imported functions, in index order; they occupy the low function
  # indices, so a defined function's index counts from `import_count`.
  val im_mstart: IntList;
  val im_mlen: IntList;
  val im_fstart: IntList;
  val im_flen: IntList;
  val im_type: IntList;

  # Defined functions, and their bodies in one instruction arena. A
  # function's locals are declared as one run per valtype: `fn_locals` is
  # a pool of (count, valtype) pairs, a run of them per function from
  # `fn_lstart`, `fn_llen` pairs long.
  val fn_type: IntList;
  val fn_locals: IntList;
  val fn_lstart: IntList;
  val fn_llen: IntList;
  val fn_bstart: IntList;
  val fn_blen: IntList;
  val insns: IntList;

  val ex_start: IntList;
  val ex_len: IntList;
  val ex_kind: IntList;
  val ex_index: IntList;

  val mem_pages: CellInt;

  # D79: the memories past the main one, each by an opaque key its user
  # looks it up by; the `i`th is memory `i + 1`, and every memory has
  # `mem_pages` pages to start.
  val mem_key: IntList;

  # D75's struct types: each with an opaque key its user looks it up by,
  # and a run of field valtypes in `st_fields`. They take the low type
  # indices, as one `rec` group, since they may refer to each other; so
  # a function type's index is its position past them (`ft_ref`).
  val st_key: IntList;
  val st_fstart: IntList;
  val st_flen: IntList;
  val st_fields: IntList;
  # D81: which are arrays (1; their one field is the element) rather than
  # structs (0), and which have mutable fields (1).
  val st_kind: IntList;
  val st_mut: IntList;

  context Emit =
    ft_params, ft_pstart, ft_plen, ft_res, ft_rstart, ft_rlen,
    nchars,
    im_mstart, im_mlen, im_fstart, im_flen, im_type,
    fn_type, fn_locals, fn_lstart, fn_llen, fn_bstart, fn_blen, insns,
    ex_start, ex_len, ex_kind, ex_index,
    mem_pages, mem_key,
    st_key, st_fstart, st_flen, st_fields, st_kind, st_mut;

  assume Emit {
    # A function type, deduplicated: both sides are buffers of valtype
    # bytes.
    fn type_index(params: IntList, results: IntList): Int {
      var i = 0;
      while i < ft_plen.length() {
        if ft_plen.get(i) == params.length() {
          if ft_rlen.get(i) == results.length() {
            if run_eq(ft_params, ft_pstart.get(i), params) {
              if run_eq(ft_res, ft_rstart.get(i), results) {
                return i;
              }
            }
          }
        }
        i = i + 1;
      }
      ft_pstart.push(ft_params.length());
      ft_plen.push(params.length());
      ft_rstart.push(ft_res.length());
      ft_rlen.push(results.length());
      push_bytes(ft_params, params);
      push_bytes(ft_res, results);
      ft_plen.length() - 1
    }

    # The index a function type has in the module: past the structs.
    fn ft_ref(i: Int): Int { st_key.length() + i }

    # The struct type with this key, or -1.
    fn find_struct(key: Int): Int {
      var j = 0;
      while j < st_key.length() {
        if st_key.get(j) == key {
          return j;
        }
        j = j + 1;
      }
      -1
    }

    # A new struct type, whose fields arrive later (`set_struct_fields`):
    # they may be references to it.
    fn add_struct(key: Int): Int {
      st_key.push(key);
      st_fstart.push(0);
      st_flen.push(0);
      st_kind.push(0);
      st_mut.push(0);
      st_key.length() - 1
    }

    # D81: a type made an array (its one field the element, mutable), or
    # a struct's fields made mutable.
    fn make_array(j: Int) {
      st_kind.set(j, 1);
      st_mut.set(j, 1);
    }

    fn make_mutable(j: Int) { st_mut.set(j, 1); }

    fn set_struct_fields(j: Int, fields: IntList) {
      st_fstart.set(j, st_fields.length());
      st_flen.set(j, fields.length());
      push_bytes(st_fields, fields);
    }

    fn struct_field(j: Int, i: Int): Int { st_fields.get(st_fstart.get(j) + i) }

    fn run_eq(arena: IntList, start: Int, want: IntList): Bool {
      var j = 0;
      while j < want.length() {
        if arena.get(start + j) != want.get(j) {
          return false;
        }
        j = j + 1;
      }
      true
    }

    # The type of a block that leaves these results and takes nothing,
    # which is what a multi-result `if` names.
    fn results_type(results: IntList): Int {
      type_index(int_list(), results)
    }

    # A type of `n` i32 parameters and no result.
    fn type_i32(n: Int): Int {
      let ps = int_list();
      var i = 0;
      while i < n {
        ps.push(vt_i32());
        i = i + 1;
      }
      type_index(ps, int_list())
    }

    fn type_i32_to_i32(n: Int): Int {
      let ps = int_list();
      var i = 0;
      while i < n {
        ps.push(vt_i32());
        i = i + 1;
      }
      let rs = int_list();
      rs.push(vt_i32());
      type_index(ps, rs)
    }

    fn intern_name(src: IntList): Int {
      let s = nchars.length();
      push_bytes(nchars, src);
      s
    }

    fn import_count(): Int {
      im_type.length()
    }

    fn func_count(): Int {
      fn_type.length()
    }

    # An imported function; the result is its index in the function index
    # space, which is also its position among the imports.
    fn add_import(mname: IntList, fname: IntList, ty: Int): Int {
      im_mstart.push(intern_name(mname));
      im_mlen.push(mname.length());
      im_fstart.push(intern_name(fname));
      im_flen.push(fname.length());
      im_type.push(ty);
      im_type.length() - 1
    }

    # Reserve a defined function. Its body arrives later, so that a
    # function may call one declared after it.
    fn add_func(ty: Int): Int {
      fn_type.push(ty);
      fn_lstart.push(0);
      fn_llen.push(0);
      fn_bstart.push(0);
      fn_blen.push(0);
      import_count() + fn_type.length() - 1
    }

    fn no_locals(): IntList { int_list() }

    # `body` must already end with the `end` opcode, and `locals` holds
    # (count, valtype) pairs, one per run of locals it declares.
    fn set_body(f: Int, locals: IntList, body: IntList) {
      let d = f - import_count();
      fn_lstart.set(d, fn_locals.length());
      fn_llen.set(d, locals.length() / 2);
      push_bytes(fn_locals, locals);
      fn_bstart.set(d, insns.length());
      fn_blen.set(d, body.length());
      push_bytes(insns, body);
    }

    fn add_export(name: IntList, kind: Int, index: Int) {
      ex_start.push(intern_name(name));
      ex_len.push(name.length());
      ex_kind.push(kind);
      ex_index.push(index);
    }

    fn push_name(out: IntList, start: Int, len: Int) {
      uleb(out, len);
      var i = 0;
      while i < len {
        out.push(nchars.get(start + i));
        i = i + 1;
      }
    }

    fn section(out: IntList, id: Int, body: IntList) {
      out.push(id);
      uleb(out, body.length());
      push_bytes(out, body);
    }

    fn type_section(out: IntList) {
      if ft_plen.length() + st_key.length() == 0 {
        return ();
      }
      let b = int_list();
      if st_key.length() > 0 {
        # One `rec` group of every struct and array (D81), each final,
        # its fields mutable or not.
        uleb(b, ft_plen.length() + 1);
        b.push(78);
        uleb(b, st_key.length());
        var s = 0;
        while s < st_key.length() {
          if st_kind.get(s) == 1 {
            b.push(94);
            push_valtype(b, struct_field(s, 0));
            b.push(st_mut.get(s));
          } else {
            b.push(95);
            uleb(b, st_flen.get(s));
            var f = 0;
            while f < st_flen.get(s) {
              push_valtype(b, struct_field(s, f));
              b.push(st_mut.get(s));
              f = f + 1;
            }
          }
          s = s + 1;
        }
      } else {
        uleb(b, ft_plen.length());
      }
      var i = 0;
      while i < ft_plen.length() {
        b.push(96);
        uleb(b, ft_plen.get(i));
        var j = 0;
        while j < ft_plen.get(i) {
          push_valtype(b, ft_params.get(ft_pstart.get(i) + j));
          j = j + 1;
        }
        uleb(b, ft_rlen.get(i));
        j = 0;
        while j < ft_rlen.get(i) {
          push_valtype(b, ft_res.get(ft_rstart.get(i) + j));
          j = j + 1;
        }
        i = i + 1;
      }
      section(out, sec_type(), b);
    }

    fn import_section(out: IntList) {
      if import_count() == 0 {
        return ();
      }
      let b = int_list();
      uleb(b, import_count());
      var i = 0;
      while i < import_count() {
        push_name(b, im_mstart.get(i), im_mlen.get(i));
        push_name(b, im_fstart.get(i), im_flen.get(i));
        b.push(kind_func());
        uleb(b, ft_ref(im_type.get(i)));
        i = i + 1;
      }
      section(out, sec_import(), b);
    }

    fn func_section(out: IntList) {
      if func_count() == 0 {
        return ();
      }
      let b = int_list();
      uleb(b, func_count());
      var i = 0;
      while i < func_count() {
        uleb(b, ft_ref(fn_type.get(i)));
        i = i + 1;
      }
      section(out, sec_func(), b);
    }

    fn memory_section(out: IntList) {
      if mem_pages.read() == 0 {
        return ();
      }
      let b = int_list();
      uleb(b, memory_count());
      var i = 0;
      while i < memory_count() {
        b.push(0);
        uleb(b, mem_pages.read());
        i = i + 1;
      }
      section(out, sec_mem(), b);
    }

    # D79: how many memories the module has, and the index of the one a
    # key names, registered the first time it is asked for. The main
    # memory is 0 and has no key.
    fn memory_count(): Int { mem_key.length() + 1 }

    fn memory_index(key: Int): Int {
      var i = 0;
      while i < mem_key.length() {
        if mem_key.get(i) == key {
          return i + 1;
        }
        i = i + 1;
      }
      mem_key.push(key);
      mem_key.length()
    }

    fn export_section(out: IntList) {
      if ex_kind.length() == 0 {
        return ();
      }
      let b = int_list();
      uleb(b, ex_kind.length());
      var i = 0;
      while i < ex_kind.length() {
        push_name(b, ex_start.get(i), ex_len.get(i));
        b.push(ex_kind.get(i));
        uleb(b, ex_index.get(i));
        i = i + 1;
      }
      section(out, sec_export(), b);
    }

    fn code_section(out: IntList) {
      if func_count() == 0 {
        return ();
      }
      let b = int_list();
      uleb(b, func_count());
      var i = 0;
      while i < func_count() {
        let entry = int_list();
        let at = fn_lstart.get(i);
        var groups = 0;
        var k = 0;
        while k < fn_llen.get(i) {
          if fn_locals.get(at + k * 2) > 0 {
            groups = groups + 1;
          }
          k = k + 1;
        }
        uleb(entry, groups);
        k = 0;
        while k < fn_llen.get(i) {
          let n = fn_locals.get(at + k * 2);
          if n > 0 {
            uleb(entry, n);
            push_valtype(entry, fn_locals.get(at + k * 2 + 1));
          }
          k = k + 1;
        }
        var j = 0;
        while j < fn_blen.get(i) {
          entry.push(insns.get(fn_bstart.get(i) + j));
          j = j + 1;
        }
        uleb(b, entry.length());
        push_bytes(b, entry);
        i = i + 1;
      }
      section(out, sec_code(), b);
    }

    # The whole module, in section order.
    fn module(out: IntList) {
      out.push(0);
      push_char(out, char::a);
      push_char(out, char::s);
      push_char(out, char::m);
      out.push(1);
      out.push(0);
      out.push(0);
      out.push(0);
      type_section(out);
      import_section(out);
      func_section(out);
      memory_section(out);
      export_section(out);
      code_section(out);
    }

    # Convenience for the two exports every WASI command module has.
    fn export_start(f: Int) {
      let n = int_list();
      sp_start(n);
      add_export(n, kind_func(), f);
    }

    fn export_memory() {
      let n = int_list();
      sp_memory(n);
      add_export(n, kind_mem(), 0);
    }

    # `wasi_snapshot_preview1.fd_write`, and the others the back end needs.
    fn wasi_import(field: IntList, params: Int): Int {
      let m = int_list();
      sp_wasi_snapshot_preview1(m);
      add_import(m, field, type_i32_to_i32(params))
    }
  }
}
