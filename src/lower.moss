import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./intern.moss" as intern;
import "./prog.moss" as prog;
import "./types.moss" as types;

# Requirement environments: what a region *has*.
#
# A declaration nested in `assume` blocks is implicitly parameterized by
# everything they name ([D26]), so a function's requirements are
# derivable from its nesting alone — which is what lets a recursive call
# terminate, since the needs are known before any body is looked at.
#
# An environment is a persistent chain: one row per provision, each
# pointing at the rest. Extending is a push, so an inner `bind` shadows
# an outer one for the rest of its block and nothing has to be copied.
# The chain is also the key a specialization is cached under, which is
# how [D2]'s "a fn binding is statically a direct call" becomes true.
#
# A key is a symbol, or a (receiver type, method) pair — the same two
# shapes the bootstrap's IR uses. The receiver is the type the provision
# is made at, declaration *and* static bindings ([D18], [D62]), so a
# provision at `Box[Elem=Char]` serves no `Box[Elem=Point]`. Types are
# static and are not needs; vals, fns and methods are.
#
# A type bind maps an abstract symbol to a type, and `canon` substitutes
# those through a type, into a nominal's arguments as well as at its top.
# That is the whole of monomorphization for this program. A context
# *item*'s application is read too — `app_view` — because a provision
# keyed on an abstract receiver an application fixes has to land at the
# concrete one or no call finds it ([D51]).

assume Std {
  fn ek_type(): Int { zero }
  fn ek_val(): Int { one }
  fn ek_fn(): Int { n2() }

  val en_kind: IntList;
  val en_recv: IntList;
  val en_sym: IntList;
  val en_a: IntList;
  val en_b: IntList;
  val en_next: IntList;

  # Each defined function's needs, as a run of (receiver, symbol) pairs.
  # Indexed by symbol, so `nd_start` has one row per symbol.
  val nd_recv: IntList;
  val nd_sym: IntList;
  val nd_start: IntList;
  val nd_len: IntList;
  # The environment each defined function's own declaration sits in.
  val nd_env: IntList;

  # `base_env` is memoized on the run of assume items it walks, because
  # every declaration inside one `assume` block is handed the same run
  # (see `declare_decl`) and identical items give an identical answer.
  # For the compiler's own sources that is thirty-one environments
  # rather than seven hundred and ten.
  val asm_run: IntList;
  val asm_len: IntList;
  val asm_env: IntList;
  val asm_nstart: IntList;
  val asm_nlen: IntList;

  # The index over the environment table: `en_head` is indexed by the key
  # symbol plus one (so that `none` has a bucket too) and holds the newest
  # row plus one; `en_link` chains the rest.
  val en_head: IntList;
  val en_link: IntList;

  context Lower =
    en_kind, en_recv, en_sym, en_a, en_b, en_next,
    nd_recv, nd_sym, nd_start, nd_len, nd_env,
    asm_run, asm_len, asm_env, asm_nstart, asm_nlen,
    en_head, en_link;

  assume Lower, ast::Ast, prog::Prog, types::Types, intern::Interner {
    # Environments.

    fn env_empty(): Int { ast::none() }

    # Hash-consed, so that two chains built from the same bindings in the
    # same order are the same id. The back end caches a specialization on
    # its environment, and that only works if identical environments
    # compare equal — this is what makes them do so.
    #
    # Consing is a lookup like any other, so it goes through an index
    # rather than over the rows: `en_head` buckets on the key symbol, and
    # a row in a bucket needs no `sym` comparison at all. Scanning the
    # whole table here cost a flat half-second on this compiler's own
    # sources, which is the shape D51-era arenas invite and the reason
    # selfhosting.md's "The idiom" now names indexing outright.
    fn env_push(env: Int, kind: Int, recv: Int, sym: Int, a: Int, b: Int): Int {
      let key = sym.add(one);
      while en_head.length().le(key) {
        en_head.push(zero);
      }
      var r = en_head.get(key);
      while r.gt(zero) {
        let e = r.sub(one);
        if en_next.get(e).eq(env) {
          if en_kind.get(e).eq(kind) {
            if en_recv.get(e).eq(recv) {
              if en_a.get(e).eq(a) {
                if en_b.get(e).eq(b) {
                  return e;
                }
              }
            }
          }
        }
        r = en_link.get(e);
      }
      en_kind.push(kind);
      en_recv.push(recv);
      en_sym.push(sym);
      en_a.push(a);
      en_b.push(b);
      en_next.push(env);
      en_link.push(en_head.get(key));
      en_head.set(key, en_kind.length());
      en_kind.length().sub(one)
    }

    # The entry providing this key, or none. The chain is walked from the
    # head, so the innermost binding wins.
    fn env_find(env: Int, kind: Int, recv: Int, sym: Int): Int {
      var e = env;
      while ast::is_some(e) {
        if en_kind.get(e).eq(kind) {
          if en_sym.get(e).eq(sym) {
            if en_recv.get(e).eq(recv) {
              return e;
            }
          }
        }
        e = en_next.get(e);
      }
      ast::none()
    }

    fn env_has(env: Int, kind: Int, recv: Int, sym: Int): Bool {
      ast::is_some(env_find(env, kind, recv, sym))
    }

    # The type an abstract symbol stands for here, chasing substitution
    # edges (D43's union-find, minus the union: with no applications
    # nothing ever merges two keys).
    fn canon(env: Int, t: Int): Int {
      canon_at(env, t, zero)
    }

    # `depth` is a backstop against a binding whose type mentions the
    # symbol it binds.
    fn canon_at(env: Int, t: Int, depth: Int): Int {
      if ast::is_some(t).not() {
        return t;
      }
      if depth.gt(hex(n2(), zero)) {
        return t;
      }
      let cur = canon_top(env, t);
      let k = types::kind_of(cur);
      if k.eq(types::kd_nominal()) {
        if types::member_count(cur).eq(zero) {
          return cur;
        }
        let args = int_list();
        var same = true;
        var i = zero;
        while i.lt(types::member_count(cur)) {
          let a = canon_at(env, types::member_at(cur, i), depth.add(one));
          if a.ne(types::member_at(cur, i)) {
            same = false;
          }
          args.push(a);
          i = i.add(one);
        }
        if same {
          return cur;
        }
        return types::nominal(types::sym_of(cur), args);
      }
      if k.eq(types::kd_union()) {
        let members = int_list();
        var same = true;
        var i = zero;
        while i.lt(types::member_count(cur)) {
          let a = canon_at(env, types::member_at(cur, i), depth.add(one));
          if a.ne(types::member_at(cur, i)) {
            same = false;
          }
          members.push(a);
          i = i.add(one);
        }
        if same {
          return cur;
        }
        return types::union_of(members);
      }
      if k.eq(types::kd_record()) {
        let members = int_list();
        var same = true;
        var i = zero;
        while i.lt(types::field_count(cur)) {
          let a = canon_at(env, types::field_type_at(cur, i), depth.add(one));
          if a.ne(types::field_type_at(cur, i)) {
            same = false;
          }
          members.push(types::field_name_at(cur, i));
          members.push(a);
          i = i.add(one);
        }
        if same {
          return cur;
        }
        return types::intern_ty(types::kd_record(), ast::none(), members);
      }
      cur
    }

    # An abstract type resolved through the bindings in force, until it
    # is not abstract or nothing binds it.
    fn canon_top(env: Int, t: Int): Int {
      var cur = t;
      var fuel = hex(n2(), zero);
      while fuel.gt(zero) {
        if types::is_kind(cur, types::kd_abstract()).not() {
          return cur;
        }
        let e = env_find(env, ek_type(), ast::none(), types::sym_of(cur));
        if ast::is_some(e).not() {
          return cur;
        }
        if en_a.get(e).eq(cur) {
          return cur;
        }
        cur = en_a.get(e);
        fuel = fuel.sub(one);
      }
      cur
    }

    fn env_kind_of(e: Int): Int { en_kind.get(e) }
    fn env_recv_of(e: Int): Int { en_recv.get(e) }
    fn env_sym_of(e: Int): Int { en_sym.get(e) }
    fn env_a_of(e: Int): Int { en_a.get(e) }
    fn env_b_of(e: Int): Int { en_b.get(e) }
    fn env_next_of(e: Int): Int { en_next.get(e) }

    # A type elaborated in module `m` and then resolved through `env`.
    fn elab(env: Int, t: Int, m: Int): Int {
      canon(env, types::elab(t, m))
    }

    # The head a method call keys on: the nominal symbol of the
    # receiver's type, after substitution.
    fn head_of(env: Int, t: Int): Int {
      types::head_of(canon(env, t))
    }

    # Needs.

    fn needs_init() {
      var i = nd_start.length();
      while i.lt(prog::sym_count()) {
        nd_start.push(ast::none());
        nd_len.push(zero);
        nd_env.push(ast::none());
        i = i.add(one);
      }
    }

    fn need_add(recv: IntList, sym: IntList, r: Int, s: Int) {
      var i = zero;
      while i.lt(sym.length()) {
        if sym.get(i).eq(s) {
          if recv.get(i).eq(r) {
            return ();
          }
        }
        i = i.add(one);
      }
      recv.push(r);
      sym.push(s);
    }

    fn needs_count(f: Int): Int { nd_len.get(f) }
    fn need_recv_at(f: Int, i: Int): Int { nd_recv.get(nd_start.get(f).add(i)) }
    fn need_sym_at(f: Int, i: Int): Int { nd_sym.get(nd_start.get(f).add(i)) }
    fn env_of(f: Int): Int { nd_env.get(f) }
    fn is_lowered(f: Int): Bool { ast::is_some(nd_start.get(f)) }

    # A declaration's ambient environment: everything its enclosing
    # assume blocks provide, outermost first.
    fn base_env(f: Int, recv: IntList, sym: IntList): Int {
      let m = prog::sym_mod.get(f);
      var env = env_empty();
      var i = zero;
      while i.lt(prog::sym_nasm.get(f)) {
        env = add_assume_item(
          env, m, ast::kid_at(prog::sym_asm.get(f), i), recv, sym
        );
        i = i.add(one);
      }
      env
    }

    # The memo entry for this run of assume items, or none. A run of
    # length zero is the top level: no items, so the answer is the empty
    # environment whatever module it was reached from, and every such
    # declaration shares one entry.
    fn asm_find(run: Int, len: Int): Int {
      var i = zero;
      while i.lt(asm_run.length()) {
        if asm_len.get(i).eq(len) {
          if len.eq(zero) {
            return i;
          }
          if asm_run.get(i).eq(run) {
            return i;
          }
        }
        i = i.add(one);
      }
      ast::none()
    }

    # Compute and record one function's requirement list. Registered
    # before any body is looked at, so recursion terminates.
    fn lower_needs(f: Int) {
      if is_lowered(f) {
        return ();
      }
      let run = prog::sym_asm.get(f);
      let len = prog::sym_nasm.get(f);
      var memo = asm_find(run, len);
      if ast::is_some(memo).not() {
        let recv = int_list();
        let sym = int_list();
        let env = base_env(f, recv, sym);
        let start = nd_sym.length();
        var i = zero;
        while i.lt(sym.length()) {
          nd_recv.push(recv.get(i));
          nd_sym.push(sym.get(i));
          i = i.add(one);
        }
        memo = asm_run.length();
        asm_run.push(run);
        asm_len.push(len);
        asm_env.push(env);
        asm_nstart.push(start);
        asm_nlen.push(sym.length());
      }
      nd_start.set(f, asm_nstart.get(memo));
      nd_len.set(f, asm_nlen.get(memo));
      nd_env.set(f, asm_env.get(memo));
    }

    # `assume` takes bare paths, optionally with a receiver dot (D24).
    fn add_assume_item(env: Int, m: Int, spec: Int, recv: IntList, sym: IntList): Int {
      add_spec(env, m, spec, recv, sym, zero, env)
    }

    # One type binding of a context item's application. The left-hand side
    # names an abstract type of the item; the right-hand side is a type by
    # name, resolved and canonicalized where the item is *written*.
    fn app_bind(view: Int, m: Int, b: Int): Int {
      let lhs = prog::resolve_path(m, ast::a_of(b));
      if ast::is_some(lhs).not() {
        prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(b)));
        return view;
      }
      if prog::sym_kind.get(lhs).ne(prog::sk_type()) {
        prog::error(prog::e_apply(), m, prog::sym_name.get(lhs));
        return view;
      }
      # The right-hand side is a type by name, maybe applied itself.
      let rhs = ast::b_of(b);
      env_push(
        view, ek_type(), ast::none(), lhs,
        canon(view, types::elab_spec(rhs, m)), ast::none()
      )
    }

    # The environment a context item's own types are read through: the one
    # in force, plus whatever its brackets bind (D22). `IsList[L=IntArr]`
    # means the item's abstract `L` is `IntArr` for the length of that item
    # and no further — which is what lets one scope hold the same
    # interface at two element types, since each item gets its own view.
    #
    # A *snapshot* of the environment rather than the environment as it
    # grows is enough: the only rows `canon` reads are `ek_type()` ones,
    # and a type item in an assume list binds its symbol to itself, so no
    # later item can change an earlier answer.
    fn app_view(view: Int, m: Int, spec: Int): Int {
      var out = view;
      var i = zero;
      while i.lt(ast::d_of(spec)) {
        out = app_bind(out, m, ast::kid_at(ast::c_of(spec), i));
        i = i.add(one);
      }
      out
    }

    fn add_spec(
      env: Int, m: Int, spec: Int, recv: IntList, sym: IntList, depth: Int,
      view: Int
    ): Int {
      if depth.gt(n16()) {
        prog::error(prog::e_deep(), m, ast::none());
        return env;
      }
      let inner = app_view(view, m, spec);
      let dot = ast::b_of(spec);
      let path = ast::a_of(spec);
      if ast::is_some(dot) {
        if ast::is_some(path).not() {
          prog::error(prog::e_recv(), m, dot);
          return env;
        }
        let receiver = prog::resolve_path(m, path);
        if ast::is_some(receiver).not() {
          prog::error(prog::e_scope(), m, ast::path_last(path));
          return env;
        }
        return add_method_item(env, m, receiver, dot, recv, sym, inner);
      }
      let target = prog::resolve_path(m, path);
      if ast::is_some(target).not() {
        prog::error(prog::e_scope(), m, ast::path_last(path));
        return env;
      }
      add_symbol_item(env, m, target, recv, sym, depth, inner)
    }

    fn add_symbol_item(
      env: Int, m: Int, s: Int, recv: IntList, sym: IntList, depth: Int,
      view: Int
    ): Int {
      let kind = prog::sym_kind.get(s);
      if kind.eq(prog::sk_type()) {
        if env_has(env, ek_type(), ast::none(), s) {
          return env;
        }
        return env_push(
          env, ek_type(), ast::none(), s, types::ty_of_symbol(types::kd_abstract(), s), ast::none()
        );
      }
      if kind.eq(prog::sk_val()) {
        # A defined val is concrete: nothing to provide (D50).
        if ast::is_some(ast::c_of(prog::sym_decl.get(s))) {
          return env;
        }
        check_mentions(env, view, m, ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s));
        need_add(recv, sym, ast::none(), s);
        if env_has(env, ek_val(), ast::none(), s) {
          return env;
        }
        let ty = elab(view, ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s));
        return env_push(env, ek_val(), ast::none(), s, ty, ast::none());
      }
      if kind.eq(prog::sk_fn()) {
        # A defined fn carries its own body; assuming it is a no-op.
        if ast::is_some(ast::fn_body(prog::sym_decl.get(s))) {
          return env;
        }
        check_signature(env, view, m, s);
        need_add(recv, sym, ast::none(), s);
        if env_has(env, ek_fn(), ast::none(), s) {
          return env;
        }
        return env_push(env, ek_fn(), ast::none(), s, ast::none(), ast::none());
      }
      if kind.eq(prog::sk_context()) {
        var e = env;
        let d = prog::sym_decl.get(s);
        var i = zero;
        while i.lt(ast::c_of(d)) {
          e = add_spec(
            e, prog::sym_mod.get(s), ast::kid_at(ast::b_of(d), i),
            recv, sym, depth.add(one), view
          );
          i = i.add(one);
        }
        return e;
      }
      # A unit, tag or alias is concrete and always available; a functor
      # is a declaration, not a provision.
      env
    }

    # A method item: `Int.add` in a context, or `.m` at a receiver. The
    # key is the receiver *type* after substitution (D36), so a provision
    # lands where calls will look it up — the whole type, bindings and all
    # (D62), not just its head.
    fn add_method_item(
      env: Int, m: Int, receiver: Int, name: Int, recv: IntList, sym: IntList,
      view: Int
    ): Int {
      let method = find_method_decl(m, receiver, name);
      if ast::is_some(method).not() {
        prog::error(prog::e_method(), m, name);
        return env;
      }
      # The *declaration* is found by the receiver as written; the
      # provision is keyed by what the receiver has been substituted to,
      # which is why an abstract receiver an application fixes lands the
      # provision where calls on the concrete type will look for it.
      let this_ty = canon(view, types::ty_of_decl(receiver));
      if ast::is_some(types::head_of(this_ty)).not() {
        prog::error(prog::e_method(), m, name);
        return env;
      }
      check_signature(env, view, m, method);
      need_add(recv, sym, this_ty, method);
      if env_has(env, ek_fn(), this_ty, method) {
        return env;
      }
      env_push(env, ek_fn(), this_ty, method, ast::none(), ast::none())
    }

    # D20: an item may be assumed only where every abstract type its
    # declared signature mentions is already assumed or bound — in force in
    # the environment being built, or fixed by the item's own brackets
    # (`view`). Otherwise a provision of it could be read at a `T` it was
    # never made at. `m` is the module the assume is written in, for the
    # report; the types are read where the item is declared.
    fn check_mentions(env: Int, view: Int, m: Int, t: Int, home: Int) {
      let found = int_list();
      types::free_syms(t, home, found);
      var i = zero;
      while i.lt(found.length()) {
        let s = found.get(i);
        if env_has(env, ek_type(), ast::none(), s).not() {
          if env_has(view, ek_type(), ast::none(), s).not() {
            prog::error(prog::e_absent(), m, prog::sym_name.get(s));
          }
        }
        i = i.add(one);
      }
    }

    fn check_signature(env: Int, view: Int, m: Int, f: Int) {
      let d = prog::sym_decl.get(f);
      let home = prog::sym_mod.get(f);
      var i = zero;
      while i.lt(ast::fn_nparams(d)) {
        check_mentions(env, view, m, ast::b_of(ast::kid_at(ast::fn_params(d), i)), home);
        i = i.add(one);
      }
      check_mentions(env, view, m, ast::fn_ret(d), home);
    }

    # An attached method on the receiver, or a detached one in scope —
    # falling back to the receiver's home module, so that `CellInt.read`
    # in a context finds the `.read` declared beside `CellInt` without
    # the context's module importing it (D54).
    fn find_method_decl(m: Int, receiver: Int, name: Int): Int {
      let home = prog::sym_mod.get(receiver);
      var found = prog::find_attached(home, receiver, name);
      if ast::is_some(found) {
        return found;
      }
      found = prog::find_attached(m, receiver, name);
      if ast::is_some(found) {
        return found;
      }
      found = prog::lookup(m, prog::ns_detached(), name);
      if ast::is_some(found) {
        return found;
      }
      prog::lookup(home, prog::ns_detached(), name)
    }

    # Every defined function of the program, in module order.
    fn lower_all() {
      needs_init();
      var f = zero;
      while f.lt(prog::sym_count()) {
        let kind = prog::sym_kind.get(f);
        var is_fn = kind.eq(prog::sk_fn());
        if is_fn.not() {
          is_fn = kind.eq(prog::sk_method());
        }
        if is_fn {
          if ast::is_some(ast::fn_body(prog::sym_decl.get(f))) {
            lower_needs(f);
          }
        }
        f = f.add(one);
      }
    }
  }
}
