import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./intern.moss" as intern;
import "./prog.moss" as prog;
import "./spell.moss" use sp_main, sp_Gc;
import "./types.moss" as types;

# Requirement environments: what a region *has*.
#
# A declaration nested in `assume` blocks is implicitly parameterized by
# everything they name ([D26]), so a function's requirements are
# derivable from its nesting alone — which is what lets a recursive call
# terminate, since the needs are known before any body is looked at.
#
# An environment is a persistent chain: one row per provision, each
# pointing at the rest. Extending is a push, so an inner `bind` shadows
# an outer one for the rest of its block and nothing has to be copied.
# The chain is also the key a specialization is cached under, which is
# how [D2]'s "a fn binding is statically a direct call" becomes true.
#
# A key is a symbol, or a (receiver type, method) pair — the same two
# shapes the bootstrap's IR uses. The receiver is the type the provision
# is made at, declaration *and* static bindings ([D18], [D62]), so a
# provision at `Box[Elem=Char]` serves no `Box[Elem=Point]`. Types are
# static and are not needs; vals, fns and methods are.
#
# A type bind maps an abstract symbol to a type, and `canon` substitutes
# those through a type, into a nominal's arguments as well as at its top.
# That is the whole of monomorphization for this program. A context
# *item*'s application is read too — `app_view` — because a provision
# keyed on an abstract receiver an application fixes has to land at the
# concrete one or no call finds it ([D51]).
#
# Coherence ([D62], [D71]): a val, fn or method provision serves only the
# instantiation it was made at. Each provision row carries, in its `b`,
# that instantiation as a chain of type rows — an *app* — over the item's
# `item_deps`: for a val or fn its whole assume nesting (the calculus's
# `dep_tys`), for a method the symbols of those its signature mentions
# (the application θ of `IMth τ m θ`). An assumed item's app records only
# what its brackets bind (`IntList.get[Elem=Int]`); any other symbol means
# what the function's environment means by it, or is not in force if that
# environment does not have it (`app_get`). A bound provision's app is
# written out in full where it is bound (`full_app`, used by the back
# end). The back end compares a callee's app for each need against the
# provision the caller has (`codegen::check_callee`).
#
# A row of a *generic* environment — a declaration's own, or a frame's as
# written (codegen's `cg_genv`) — also says how its item is typed where it
# is used, as the bootstrap's `env.vals`, `env.fns` and `env.methods` do:
# a val's row holds, in its `a`, the type it was provided at; a fn's or a
# method's, the environment its declared signature is read through — the
# one in force where it was assumed or bound, with the item's own
# brackets. So a call of a provision is typed by the provision, whatever
# has been bound since (D72).

assume Std {
  fn ek_type(): Int { 0 }
  fn ek_val(): Int { 1 }
  fn ek_fn(): Int { 2 }
  # Codegen-only lexical functor-link metadata; never a source binding.
  fn ek_capture(): Int { 3 }

  val en_kind: IntList;
  val en_recv: IntList;
  val en_sym: IntList;
  val en_a: IntList;
  val en_b: IntList;
  val en_next: IntList;

  # Each defined function's needs, as a run of (receiver, symbol) pairs.
  # Indexed by symbol, so `nd_start` has one row per symbol.
  val nd_recv: IntList;
  val nd_sym: IntList;
  val nd_start: IntList;
  val nd_len: IntList;
  # The environment each defined function's own declaration sits in.
  val nd_env: IntList;
  # Beside each need, the app its provision row carries in that
  # environment: the instantiation the function requires it at.
  val nd_app: IntList;

  # Each val's, fn's and method's coherence symbols (`item_deps`), as a
  # run in `dp_pool` indexed by symbol; `dp_len` is none until computed.
  val dp_start: IntList;
  val dp_len: IntList;
  val dp_pool: IntList;

  # `base_env` is memoized on the run of assume items it walks, because
  # every declaration inside one `assume` block is handed the same run
  # (see `declare_decl`) and identical items give an identical answer.
  # For the compiler's own sources that is thirty-one environments
  # rather than seven hundred and ten.
  val asm_run: IntList;
  val asm_len: IntList;
  val asm_env: IntList;
  val asm_nstart: IntList;
  val asm_nlen: IntList;

  # The index over the environment table: `en_head` is indexed by the key
  # symbol plus one (so that `none` has a bucket too) and holds the newest
  # row plus one; `en_link` chains the rest.
  val en_head: IntList;
  val en_link: IntList;

  # A bounded memo table for env_find. Its six-cell rows hold a valid flag,
  # the four lookup arguments, and the answer. It belongs to these immutable
  # environment rows and is initialized empty alongside them in boot.moss.
  val en_find_cache: IntList;

  context Lower =
    en_kind, en_recv, en_sym, en_a, en_b, en_next,
    nd_recv, nd_sym, nd_start, nd_len, nd_env, nd_app,
    dp_start, dp_len, dp_pool,
    asm_run, asm_len, asm_env, asm_nstart, asm_nlen,
    en_head, en_link, en_find_cache;

  assume Lower, ast::Ast, prog::Prog, types::Types, intern::Interner {
    # Environments.

    fn env_empty(): Int { ast::none() }

    # Hash-consed, so that two chains built from the same bindings in the
    # same order are the same id. The back end caches a specialization on
    # its environment, and that only works if identical environments
    # compare equal — this is what makes them do so.
    #
    # Consing is a lookup like any other, so it goes through an index
    # rather than over the rows: `en_head` buckets on the key symbol, and
    # a row in a bucket needs no `sym` comparison at all. Scanning the
    # whole table here cost a flat half-second on this compiler's own
    # sources, which is the shape D51-era arenas invite.
    fn env_push(env: Int, kind: Int, recv: Int, sym: Int, a: Int, b: Int): Int {
      let key = sym + 1;
      while en_head.length() <= key {
        en_head.push(0);
      }
      var r = en_head.get(key);
      while r > 0 {
        let e = r - 1;
        if en_next.get(e) == env {
          if en_kind.get(e) == kind {
            if en_recv.get(e) == recv {
              if en_a.get(e) == a {
                if en_b.get(e) == b {
                  return e;
                }
              }
            }
          }
        }
        r = en_link.get(e);
      }
      en_kind.push(kind);
      en_recv.push(recv);
      en_sym.push(sym);
      en_a.push(a);
      en_b.push(b);
      en_next.push(env);
      en_link.push(en_head.get(key));
      en_head.set(key, en_kind.length());
      en_kind.length() - 1
    }

    # The entry providing this key, or none. The chain is walked from the
    # head, so the innermost binding wins.
    fn env_find_uncached(env: Int, kind: Int, recv: Int, sym: Int): Int {
      var e = env;
      while ast::is_some(e) {
        if en_kind.get(e) == kind {
          if en_sym.get(e) == sym {
            if en_recv.get(e) == recv {
              return e;
            }
          }
        }
        e = en_next.get(e);
      }
      ast::none()
    }

    fn env_find(env: Int, kind: Int, recv: Int, sym: Int): Int {
      # Masking keeps the index in range even when Int arithmetic wraps.
      # A collision only replaces a memo row: a hit compares all arguments.
      let at = ((env * 31 + recv * 7 + sym * 127 + kind) & 4095) * 6;
      if en_find_cache.length() == 0 {
        var i = 0;
        while i < 24576 {
          en_find_cache.push(0);
          i = i + 1;
        }
      }
      if en_find_cache.get(at) == 1 {
        if en_find_cache.get(at + 1) == env {
          if en_find_cache.get(at + 2) == kind {
            if en_find_cache.get(at + 3) == recv {
              if en_find_cache.get(at + 4) == sym {
                return en_find_cache.get(at + 5);
              }
            }
          }
        }
      }
      let found = env_find_uncached(env, kind, recv, sym);
      # en_kind/en_sym/en_recv/en_next are append-only. An old head's chain
      # never changes when env_push adds a new head, so this answer stays valid.
      en_find_cache.set(at + 1, env);
      en_find_cache.set(at + 2, kind);
      en_find_cache.set(at + 3, recv);
      en_find_cache.set(at + 4, sym);
      en_find_cache.set(at + 5, found);
      en_find_cache.set(at, 1);
      found
    }

    fn env_has(env: Int, kind: Int, recv: Int, sym: Int): Bool {
      ast::is_some(env_find(env, kind, recv, sym))
    }

    # The type an abstract symbol stands for here, chasing substitution
    # edges: a type bind's, and the union-find edges a merge adds (D43,
    # `unify`).
    fn canon(env: Int, t: Int): Int {
      canon_at(env, t, 0)
    }

    # `depth` is a backstop against a binding whose type mentions the
    # symbol it binds.
    fn canon_at(env: Int, t: Int, depth: Int): Int {
      if !ast::is_some(t) {
        return t;
      }
      if depth > 32 {
        return t;
      }
      let cur = canon_top(env, t);
      let k = types::kind_of(cur);
      if k == types::kd_nominal() {
        if types::member_count(cur) == 0 {
          return cur;
        }
        let args = int_list();
        var same = true;
        var i = 0;
        while i < types::member_count(cur) {
          let a = canon_at(env, types::member_at(cur, i), depth + 1);
          if a != types::member_at(cur, i) {
            same = false;
          }
          args.push(a);
          i = i + 1;
        }
        if same {
          return cur;
        }
        return types::nominal(types::sym_of(cur), args);
      }
      if k == types::kd_union() {
        let members = int_list();
        var same = true;
        var i = 0;
        while i < types::member_count(cur) {
          let a = canon_at(env, types::member_at(cur, i), depth + 1);
          if a != types::member_at(cur, i) {
            same = false;
          }
          members.push(a);
          i = i + 1;
        }
        if same {
          return cur;
        }
        return types::union_of(members);
      }
      if k == types::kd_record() {
        let members = int_list();
        var same = true;
        var i = 0;
        while i < types::field_count(cur) {
          let a = canon_at(env, types::field_type_at(cur, i), depth + 1);
          if a != types::field_type_at(cur, i) {
            same = false;
          }
          members.push(types::field_name_at(cur, i));
          members.push(a);
          i = i + 1;
        }
        if same {
          return cur;
        }
        return types::intern_ty(types::kd_record(), ast::none(), members);
      }
      cur
    }

    # An abstract type resolved through the bindings in force, until it
    # is not abstract or nothing binds it.
    fn canon_top(env: Int, t: Int): Int {
      var cur = t;
      var fuel = 32;
      while fuel > 0 {
        if !types::is_kind(cur, types::kd_abstract()) {
          return cur;
        }
        let e = env_find(env, ek_type(), ast::none(), types::sym_of(cur));
        if !ast::is_some(e) {
          return cur;
        }
        if en_a.get(e) == cur {
          return cur;
        }
        cur = en_a.get(e);
        fuel = fuel - 1;
      }
      cur
    }

    fn env_kind_of(e: Int): Int { en_kind.get(e) }
    fn env_recv_of(e: Int): Int { en_recv.get(e) }
    fn env_sym_of(e: Int): Int { en_sym.get(e) }
    fn env_a_of(e: Int): Int { en_a.get(e) }
    fn env_b_of(e: Int): Int { en_b.get(e) }
    fn env_next_of(e: Int): Int { en_next.get(e) }

    # A type elaborated in module `m` and then resolved through `env`.
    fn elab(env: Int, t: Int, m: Int): Int {
      canon(env, types::elab(t, m))
    }

    # The head a method call keys on: the nominal symbol of the
    # receiver's type, after substitution.
    fn head_of(env: Int, t: Int): Int {
      types::head_of(canon(env, t))
    }

    # Needs.

    fn needs_init() {
      var i = nd_start.length();
      while i < prog::sym_count() {
        nd_start.push(ast::none());
        nd_len.push(0);
        nd_env.push(ast::none());
        i = i + 1;
      }
    }

    fn need_add(recv: IntList, sym: IntList, r: Int, s: Int) {
      var i = 0;
      while i < sym.length() {
        if sym.get(i) == s {
          if recv.get(i) == r {
            return ();
          }
        }
        i = i + 1;
      }
      recv.push(r);
      sym.push(s);
    }

    fn needs_count(f: Int): Int { nd_len.get(f) }
    fn need_recv_at(f: Int, i: Int): Int { nd_recv.get(nd_start.get(f) + i) }
    fn need_sym_at(f: Int, i: Int): Int { nd_sym.get(nd_start.get(f) + i) }
    fn need_app_at(f: Int, i: Int): Int { nd_app.get(nd_start.get(f) + i) }
    fn need_start(f: Int): Int { nd_start.get(f) }
    fn env_of(f: Int): Int { nd_env.get(f) }
    # A symbol made after the table was sized (a type's parameter, D72)
    # is not a function, so it was never lowered.
    fn is_lowered(f: Int): Bool {
      if f >= nd_start.length() {
        return false;
      }
      ast::is_some(nd_start.get(f))
    }

    # A declaration's ambient environment: everything its enclosing
    # assume blocks provide, outermost first.
    #
    # Assuming one item twice merges the two (D43, `unify`), which may add
    # union-find edges — and an item read before the edge was added has a
    # view without it, though the edge holds for the whole region. So when
    # a walk adds any, the items are walked again over the edges found
    # (`edges_of`), so that every view has them from the start, until a
    # walk finds no more. Only then is the environment, or anything read
    # through it, handed out — a merge never happens after a read is
    # cached (codegen's memos key on the environment), and a declaration
    # with no duplicate items costs one walk, as before.
    fn base_env(f: Int, recv: IntList, sym: IntList): Int {
      assume_items(prog::sym_mod.get(f), prog::sym_asm.get(f), prog::sym_nasm.get(f), recv, sym)
    }

    # The environment a run of `len` assume items (or a functor's argument
    # signature) written in module `m` provides, merged as `base_env` says.
    fn assume_items(m: Int, run: Int, len: Int, recv: IntList, sym: IntList): Int {
      var floor = env_empty();
      var r = int_list();
      var s = int_list();
      var env = assume_run(floor, m, run, len, r, s);
      var fuel = 8;
      while fuel > 0 {
        let edges = edges_of(env);
        if edges == floor {
          fuel = 0;
        } else {
          floor = edges;
          r = int_list();
          s = int_list();
          env = assume_run(floor, m, run, len, r, s);
          fuel = fuel - 1;
        }
      }
      var i = 0;
      while i < s.length() {
        recv.push(r.get(i));
        sym.push(s.get(i));
        i = i + 1;
      }
      env
    }

    # One walk of the items, on `env`.
    fn assume_run(env: Int, m: Int, run: Int, len: Int, recv: IntList, sym: IntList): Int {
      var out = env;
      var i = 0;
      while i < len {
        out = add_assume_item(out, m, ast::kid_at(run, i), recv, sym);
        i = i + 1;
      }
      out
    }

    # The merge edges of an environment built from assume items, alone,
    # in the order they were added. A type row an assume adds says the
    # symbol is its parameter (`as_assumed`); any other is an edge.
    # Hash-consed like any chain, so the same edges are the same id.
    fn edges_of(env: Int): Int {
      let rows = int_list();
      var e = env;
      while ast::is_some(e) {
        if en_kind.get(e) == ek_type() {
          if en_a.get(e) != as_assumed(en_sym.get(e)) {
            rows.push(e);
          }
        }
        e = en_next.get(e);
      }
      var out = env_empty();
      var i = rows.length();
      while i > 0 {
        i = i - 1;
        let row = rows.get(i);
        out = env_push(out, ek_type(), ast::none(), en_sym.get(row), en_a.get(row), ast::none());
      }
      out
    }

    # The memo entry for this run of assume items, or none. A run of
    # length zero is the top level: no items, so the answer is the empty
    # environment whatever module it was reached from, and every such
    # declaration shares one entry.
    fn asm_find(run: Int, len: Int): Int {
      var i = 0;
      while i < asm_run.length() {
        if asm_len.get(i) == len {
          if len == 0 {
            return i;
          }
          if asm_run.get(i) == run {
            return i;
          }
        }
        i = i + 1;
      }
      ast::none()
    }

    # The platform runs `main` in its root context (D37): beside what
    # `main` assumes, lib/wasm.moss's `Gc` — the platform's functors,
    # which left `Wasm` (D84, O2) — after the types they are fixed in, so
    # a program that binds `WasiStd` need not assume it. The bootstrap's
    # `add_root_context` is the same.
    fn root_context(): IntList {
      let out = int_list();
      let gn = int_list();
      sp_Gc(gn);
      var w = 0;
      while w < prog::module_count() {
        if prog::is_platform(w) {
          let gc = prog::lookup(w, prog::ns_name(), intern::intern_chars(gn));
          if !ast::is_some(gc) {
            return out;
          }
          if prog::sym_kind.get(gc) != prog::sk_context() {
            return out;
          }
          let d = prog::sym_decl.get(gc);
          var i = 0;
          while i < ast::c_of(d) {
            let fu = prog::resolve_path(w, ast::a_of(ast::kid_at(ast::b_of(d), i)));
            if ast::is_some(fu) {
              if prog::sym_kind.get(fu) == prog::sk_functor() {
                functor_fixed(fu, out);
              }
            }
            i = i + 1;
          }
          out.push(gc);
          return out;
        }
        w = w + 1;
      }
      out
    }

    # Compute and record one function's requirement list. Registered
    # before any body is looked at, so recursion terminates.
    fn lower_needs(f: Int) { lower_needs_at(f, int_list()) }

    # The same, with the items of `root` assumed after the declaration's
    # own: the platform's root context, which `main` runs in (D37, D84
    # O2). Not memoized, since `main` shares its run of assume items
    # with whatever else its `assume` block declares.
    fn lower_needs_at(f: Int, root: IntList) {
      if is_lowered(f) {
        return ();
      }
      let run = prog::sym_asm.get(f);
      let len = prog::sym_nasm.get(f);
      var memo = ast::none();
      if root.length() == 0 {
        memo = asm_find(run, len);
      }
      if !ast::is_some(memo) {
        let recv = int_list();
        let sym = int_list();
        var env = base_env(f, recv, sym);
        var k = 0;
        while k < root.length() {
          env = add_symbol_item(
            env, prog::sym_mod.get(f), root.get(k), recv, sym, int_list(), env, int_list()
          );
          k = k + 1;
        }
        let start = nd_sym.length();
        var i = 0;
        while i < sym.length() {
          nd_recv.push(recv.get(i));
          nd_sym.push(sym.get(i));
          let row = env_find(env, need_kind(sym.get(i)), recv.get(i), sym.get(i));
          if ast::is_some(row) {
            nd_app.push(en_b.get(row));
          } else {
            nd_app.push(env_empty());
          }
          i = i + 1;
        }
        if root.length() > 0 {
          nd_start.set(f, start);
          nd_len.set(f, sym.length());
          nd_env.set(f, env);
          return ();
        }
        memo = asm_run.length();
        asm_run.push(run);
        asm_len.push(len);
        asm_env.push(env);
        asm_nstart.push(start);
        asm_nlen.push(sym.length());
      }
      nd_start.set(f, asm_nstart.get(memo));
      nd_len.set(f, asm_nlen.get(memo));
      nd_env.set(f, asm_env.get(memo));
    }

    # A function the back end synthesizes rather than one declared — an
    # anonymous function at a bind (D70): its environment and its needs,
    # each with the app its provision carries there, are given.
    fn set_needs(f: Int, env: Int, recv: IntList, sym: IntList, app: IntList) {
      needs_init();
      nd_start.set(f, nd_sym.length());
      var i = 0;
      while i < sym.length() {
        nd_recv.push(recv.get(i));
        nd_sym.push(sym.get(i));
        nd_app.push(app.get(i));
        i = i + 1;
      }
      nd_len.set(f, sym.length());
      nd_env.set(f, env);
    }

    # `assume` takes bare paths, optionally with a receiver dot (D24).
    fn add_assume_item(env: Int, m: Int, spec: Int, recv: IntList, sym: IntList): Int {
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(spec)) { prog::location.write(spec + 1); }
      let result = add_assume_item_inner(env, m, spec, recv, sym);
      prog::location.write(saved);
      result
    }

    fn add_assume_item_inner(env: Int, m: Int, spec: Int, recv: IntList, sym: IntList): Int {
      add_spec(env, m, spec, recv, sym, int_list(), int_list())
    }

    # One type binding of a context item's application. The left-hand side
    # names an abstract type of the item; the right-hand side is a type by
    # name, resolved and canonicalized where the item is *written*.
    fn app_bind(view: Int, m: Int, b: Int): Int {
      let lhs = prog::resolve_path(m, ast::a_of(b));
      if !ast::is_some(lhs) {
        prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(b)));
        return view;
      }
      if prog::sym_kind.get(lhs) != prog::sk_type() {
        prog::error(prog::e_apply(), m, prog::sym_name.get(lhs));
        return view;
      }
      # The right-hand side is a type by name, maybe applied itself.
      let rhs = ast::b_of(b);
      env_push(
        view, ek_type(), ast::none(), lhs,
        canon(view, types::elab_spec(rhs, m)), ast::none()
      )
    }

    # The environment a context item's own types are read through: the one
    # in force, plus whatever its brackets bind (D22). `IsList[L=IntArr]`
    # means the item's abstract `L` is `IntArr` for the length of that item
    # and no further — which is what lets one scope hold the same
    # interface at two element types, since each item gets its own view.
    fn app_view(view: Int, m: Int, spec: Int): Int {
      var out = view;
      var i = 0;
      while i < ast::d_of(spec) {
        out = app_bind(out, m, ast::kid_at(ast::c_of(spec), i));
        i = i + 1;
      }
      out
    }

    # Each item is read in the environment as it has grown so far — so an
    # item of a context sees the types assumed before it in that context,
    # as their parameters (D72) — under the substitution the enclosing
    # contexts' brackets make (`over`, a run of (symbol, type) pairs, each
    # context's resolved once, where it is written), and then its own
    # brackets. The bootstrap's `add_spec` reads items the same way
    # (`env.tymap | subst`). `walking` is the contexts being walked,
    # outermost first: contexts nest to any depth, but one met again inside itself
    # would be walked forever (`add_symbol_item`).
    fn add_spec(
      env: Int, m: Int, spec: Int, recv: IntList, sym: IntList, walking: IntList,
      over: IntList
    ): Int {
      let outer = overlay(env, over);
      let inner = app_view(outer, m, spec);
      let dot = ast::b_of(spec);
      let path = ast::a_of(spec);
      if ast::is_some(dot) {
        if !ast::is_some(path) {
          prog::error(prog::e_recv(), m, dot);
          return env;
        }
        let receiver = prog::resolve_path(m, path);
        if !ast::is_some(receiver) {
          prog::error(prog::e_scope(), m, ast::path_last(path));
          return env;
        }
        return add_method_item(env, m, receiver, dot, recv, sym, inner);
      }
      let target = prog::resolve_path(m, path);
      if !ast::is_some(target) {
        prog::error(prog::e_scope(), m, ast::path_last(path));
        return env;
      }
      # A context's items are under its brackets too.
      let inside = int_list();
      var i = 0;
      while i < over.length() {
        inside.push(over.get(i));
        i = i + 1;
      }
      bracket_pairs(inner, outer, inside);
      add_symbol_item(env, m, target, recv, sym, walking, inner, inside)
    }

    # `env` with the pairs of `over` pushed on it, in order.
    fn overlay(env: Int, over: IntList): Int {
      var out = env;
      var i = 0;
      while i < over.length() {
        out = env_push(out, ek_type(), ast::none(), over.get(i), over.get(i + 1), ast::none());
        i = i + 2;
      }
      out
    }

    # The (symbol, type) pairs `app_view` pushed to make `inner` from
    # `outer`, appended to `out` in the order they were pushed.
    fn bracket_pairs(inner: Int, outer: Int, out: IntList) {
      let rows = int_list();
      var e = inner;
      while e != outer {
        rows.push(e);
        e = en_next.get(e);
      }
      var i = rows.length();
      while i > 0 {
        i = i - 1;
        out.push(en_sym.get(rows.get(i)));
        out.push(en_a.get(rows.get(i)));
      }
    }

    fn add_symbol_item(
      env: Int, m: Int, s: Int, recv: IntList, sym: IntList, walking: IntList,
      view: Int, over: IntList
    ): Int {
      let kind = prog::sym_kind.get(s);
      if kind == prog::sk_type() {
        if env_has(env, ek_type(), ast::none(), s) {
          return env;
        }
        return env_push(env, ek_type(), ast::none(), s, as_assumed(s), ast::none());
      }
      if kind == prog::sk_val() {
        # A defined val is concrete: nothing to provide (D50).
        if ast::is_some(ast::c_of(prog::sym_decl.get(s))) {
          return env;
        }
        check_mentions(env, view, m, ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s));
        need_add(recv, sym, ast::none(), s);
        let ty = elab(view, ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s));
        let had = env_find(env, ek_val(), ast::none(), s);
        if ast::is_some(had) {
          let merged = unify(env, en_a.get(had), ty, m, s);
          return merge_app(merged, en_b.get(had), env, view, m, s);
        }
        return env_push(env, ek_val(), ast::none(), s, ty, assumed_app(s, view));
      }
      if kind == prog::sk_fn() {
        # A defined fn carries its own body; assuming it is a no-op.
        if ast::is_some(ast::fn_body(prog::sym_decl.get(s))) {
          return env;
        }
        check_signature(env, view, m, s);
        need_add(recv, sym, ast::none(), s);
        let had = env_find(env, ek_fn(), ast::none(), s);
        if ast::is_some(had) {
          let merged = merge_sig(env, en_a.get(had), view, m, s);
          return merge_app(merged, en_b.get(had), env, view, m, s);
        }
        return env_push(env, ek_fn(), ast::none(), s, view, assumed_app(s, view));
      }
      if kind == prog::sk_context() {
        # A context inside itself has no reading (the bootstrap's "contexts
        # nest in a cycle"), named by the context.
        if types::contains_sym(walking, s) {
          prog::error(prog::e_deep(), m, prog::sym_name.get(s));
          return env;
        }
        let within = int_list();
        var k = 0;
        while k < walking.length() {
          within.push(walking.get(k));
          k = k + 1;
        }
        within.push(s);
        var e = env;
        let d = prog::sym_decl.get(s);
        var i = 0;
        while i < ast::c_of(d) {
          e = add_spec(
            e, prog::sym_mod.get(s), ast::kid_at(ast::b_of(d), i),
            recv, sym, within, over
          );
          i = i + 1;
        }
        return e;
      }
      # D78: an abstract functor is a requirement like any other. Its
      # signature is read where it is applied, so assuming it needs
      # nothing else in force (D20); its provision is at no
      # instantiation (`item_deps`), since a binding serves every one of
      # its inputs. It is a row of the fn table, whose provider is the
      # functor it is bound to.
      if kind == prog::sk_functor() {
        if !ast::is_some(ast::fu_binds(prog::sym_decl.get(s))) {
          let fixed = int_list();
          functor_fixed(s, fixed);
          var x = 0;
          while x < fixed.length() {
            if !env_has(env, ek_type(), ast::none(), fixed.get(x)) {
              prog::error(prog::e_absent(), m, prog::sym_name.get(fixed.get(x)));
            }
            x = x + 1;
          }
          need_add(recv, sym, ast::none(), s);
          if env_has(env, ek_fn(), ast::none(), s) {
            return env;
          }
          # D84 (draft): a bracketed one is at the identity of its fixed
          # inputs, as an assumed val is.
          return env_push(env, ek_fn(), ast::none(), s, ast::none(), assumed_app(s, view));
        }
      }
      # A unit, tag or alias is concrete and always available; a functor
      # with a body is a declaration, not a provision.
      env
    }

    # A method item: `Int.add` in a context, or `.m` at a receiver. The
    # key is the receiver *type* after substitution (D36), so a provision
    # lands where calls will look it up — the whole type, bindings and all
    # (D62), not just its head.
    fn add_method_item(
      env: Int, m: Int, receiver: Int, name: Int, recv: IntList, sym: IntList,
      view: Int
    ): Int {
      let method = find_method_decl(m, receiver, name);
      if !ast::is_some(method) {
        prog::error(prog::e_method(), m, name);
        return env;
      }
      # The *declaration* is found by the receiver as written; the
      # provision is keyed by what the receiver has been substituted to,
      # which is why an abstract receiver an application fixes lands the
      # provision where calls on the concrete type will look for it.
      # E41 (D20): a type symbol is a receiver only through its meaning in
      # force, so `assume T.m, T` needs `T` before `T.m`, as an item whose
      # signature mentions `T` does.
      if prog::sym_kind.get(receiver) == prog::sk_type() {
        if !env_has(view, ek_type(), ast::none(), receiver) {
          prog::error(prog::e_absent(), m, prog::sym_name.get(receiver));
          return env;
        }
      }
      let this_ty = canon(view, types::ty_of_decl(receiver));
      # A union or a record has no declaration for a method to attach
      # to, but a detached method is keyed by the type itself, so it may
      # be provided at one (D75's `.boxed` at a union `Boxed`).
      if !ast::is_some(types::head_of(this_ty)) {
        if ast::is_some(prog::sym_recv.get(method)) {
          prog::error(prog::e_method(), m, name);
          return env;
        }
      }
      check_signature(env, view, m, method);
      need_add(recv, sym, this_ty, method);
      let had = env_find(env, ek_fn(), this_ty, method);
      if ast::is_some(had) {
        let merged = merge_sig(env, en_a.get(had), view, m, method);
        return merge_app(merged, en_b.get(had), env, view, m, method);
      }
      env_push(env, ek_fn(), this_ty, method, view, assumed_app(method, view))
    }

    # Consistent merging (D43). A region carries one binding per key, so
    # an item assumed twice — two contexts that each mention it, perhaps
    # under different brackets — is merged rather than kept twice: the
    # two readings of its type are unified, which identifies their
    # abstract types. Unifying adds a union-find edge, a type row from an
    # abstract symbol to the type it is now the same as, which `canon`
    # chases like a bind's; it fails, `e_merge`, only where two distinct
    # concrete types would have to be one. As the bootstrap's `unify`.
    #
    # A fn's or a method's two readings are its declared signature read
    # through each assumption's view; `This` is the receiver, the same in
    # both, since it is the key.
    fn merge_sig(env: Int, old: Int, view: Int, m: Int, s: Int): Int {
      let d = prog::sym_decl.get(s);
      let home = prog::sym_mod.get(s);
      var out = env;
      var i = 0;
      while i < ast::fn_nparams(d) {
        out = merge_decl_ty(out, old, view, ast::b_of(ast::kid_at(ast::fn_params(d), i)), home, m, s);
        i = i + 1;
      }
      merge_decl_ty(out, old, view, ast::fn_ret(d), home, m, s)
    }

    # D43, Δ4: merging two entries of one item also unifies their
    # instantiations, so the merged key's app does not depend on which
    # entry came first. `old` is the first entry's app, read against
    # `base`, the environment it was assumed in; the second's is what
    # `view` makes of each symbol. A symbol not in force where an entry
    # was read is read as itself.
    fn merge_app(env: Int, old: Int, base: Int, view: Int, m: Int, s: Int): Int {
      let deps = int_list();
      item_deps(s, deps);
      var out = env;
      var i = 0;
      while i < deps.length() {
        let t = deps.get(i);
        let at = types::ty_of_symbol(types::kd_abstract(), t);
        var a = app_get(old, t, base);
        if !ast::is_some(a) {
          a = as_assumed(t);
        }
        var b = as_assumed(t);
        if env_has(view, ek_type(), ast::none(), t) {
          b = canon(view, at);
        }
        out = unify(out, a, b, m, s);
        i = i + 1;
      }
      out
    }

    fn merge_decl_ty(env: Int, old: Int, view: Int, t: Int, home: Int, m: Int, s: Int): Int {
      if ast::is_some(t) {
        if ast::is_kind(t, ast::k_ty_this()) {
          return env;
        }
      }
      unify(env, elab(old, t, home), elab(view, t, home), m, s)
    }

    # `env` with whatever edges make `a` and `b` one type, both read
    # through it first. The edge goes from whichever side is a bare
    # abstract symbol, the first if both; anything else unifies member
    # by member where the two have one shape, and is an error otherwise.
    fn unify(env: Int, a0: Int, b0: Int, m: Int, s: Int): Int {
      let a = canon(env, a0);
      let b = canon(env, b0);
      if a == b {
        return env;
      }
      if is_variable(a) {
        return env_push(env, ek_type(), ast::none(), types::sym_of(a), b, ast::none());
      }
      if is_variable(b) {
        return env_push(env, ek_type(), ast::none(), types::sym_of(b), a, ast::none());
      }
      let k = types::kind_of(a);
      var same = k == types::kind_of(b);
      if same {
        same = types::member_count(a) == types::member_count(b);
      }
      if same {
        if k == types::kd_nominal() {
          same = types::sym_of(a) == types::sym_of(b);
        } else if k == types::kd_abstract() {
          same = types::sym_of(a) == types::sym_of(b);
        } else if k == types::kd_record() {
          var i = 0;
          while i < types::field_count(a) {
            if types::field_name_at(a, i) != types::field_name_at(b, i) {
              same = false;
            }
            i = i + 1;
          }
        } else if k != types::kd_union() {
          same = false;
        }
      }
      if !same {
        prog::error(prog::e_merge(), m, prog::sym_name.get(s));
        return env;
      }
      var out = env;
      if k == types::kd_record() {
        var i = 0;
        while i < types::field_count(a) {
          out = unify(out, types::field_type_at(a, i), types::field_type_at(b, i), m, s);
          i = i + 1;
        }
        return out;
      }
      var i = 0;
      while i < types::member_count(a) {
        out = unify(out, types::member_at(a, i), types::member_at(b, i), m, s);
        i = i + 1;
      }
      out
    }

    # D43: a context that merged two types requires them to be one, so a
    # function whose assumes merged `B` with `C` may be called only where
    # `B` and `C` mean the same — read through the caller's *generic*
    # environment `genv`, so that it comes out the same in every
    # specialization (D80), as the bootstrap's `require_merges`. Returns
    # the symbol of the first merge edge of `f`'s whose two sides differ
    # there, or none. Resolve the complete merge first: an intermediate
    # symbol absent from `genv` cannot hide a constraint on a symbol that
    # is in force there. A symbol absent from the solved equation constrains nothing.
    fn merge_conflict(genv: Int, f: Int): Int {
      merge_conflict_env(genv, env_of(f))
    }

    fn merge_conflict_env(genv: Int, own: Int): Int {
      var e = own;
      while ast::is_some(e) {
        if en_kind.get(e) == ek_type() {
          let k = en_sym.get(e);
          let v = canon(own, as_assumed(k));
          if v != as_assumed(k) {
            let mentioned = int_list();
            mentioned.push(k);
            abstracts_in(v, mentioned);
            var here = true;
            var i = 0;
            while i < mentioned.length() {
              var t = mentioned.get(i);
              if ast::is_some(prog::origin_of(t)) {
                t = prog::origin_of(t);
              }
              if !env_has(genv, ek_type(), ast::none(), t) {
                here = false;
              }
              i = i + 1;
            }
            if here {
              let lhs = instantiate(genv, types::ty_of_symbol(types::kd_abstract(), k));
              if lhs != instantiate(genv, v) {
                return k;
              }
            }
          }
        }
        e = en_next.get(e);
      }
      ast::none()
    }

    # The abstract symbols a type mentions, appended to `out`.
    fn abstracts_in(t: Int, out: IntList) {
      if !ast::is_some(t) {
        return ();
      }
      let k = types::kind_of(t);
      if k == types::kd_abstract() {
        types::push_new(out, types::sym_of(t));
      }
      if k == types::kd_record() {
        var i = 0;
        while i < types::field_count(t) {
          abstracts_in(types::field_type_at(t, i), out);
          i = i + 1;
        }
      } else {
        var i = 0;
        while i < types::member_count(t) {
          abstracts_in(types::member_at(t, i), out);
          i = i + 1;
        }
      }
    }

    # An abstract type with no arguments: a symbol a merge may bind.
    fn is_variable(t: Int): Bool {
      if !ast::is_some(t) {
        return false;
      }
      if !types::is_kind(t, types::kd_abstract()) {
        return false;
      }
      types::member_count(t) == 0
    }

    # D20: an item may be assumed only where every abstract type its
    # declared signature mentions is already assumed or bound — in force in
    # the environment being built, or fixed by the item's own brackets
    # (`view`). Otherwise a provision of it could be read at a `T` it was
    # never made at. `m` is the module the assume is written in, for the
    # report; the types are read where the item is declared.
    fn check_mentions(env: Int, view: Int, m: Int, t: Int, home: Int) {
      let found = int_list();
      types::free_syms(t, home, found);
      var i = 0;
      while i < found.length() {
        let s = found.get(i);
        if !env_has(env, ek_type(), ast::none(), s) {
          if !env_has(view, ek_type(), ast::none(), s) {
            prog::error(prog::e_absent(), m, prog::sym_name.get(s));
          }
        }
        i = i + 1;
      }
    }

    fn check_signature(env: Int, view: Int, m: Int, f: Int) {
      let d = prog::sym_decl.get(f);
      let home = prog::sym_mod.get(f);
      var i = 0;
      while i < ast::fn_nparams(d) {
        check_mentions(env, view, m, ast::b_of(ast::kid_at(ast::fn_params(d), i)), home);
        i = i + 1;
      }
      check_mentions(env, view, m, ast::fn_ret(d), home);
    }

    # Coherence.

    # The table a need's provision lives in: a val's, or a fn's (which a
    # method's is too).
    fn need_kind(s: Int): Int {
      if prog::sym_kind.get(s) == prog::sk_val() {
        ek_val()
      } else {
        ek_fn()
      }
    }

    # The type symbols a val, fn or method item depends on: for a val or
    # a fn its whole assume nesting ([D21] unchanged for them; `dep_tys`),
    # for a method those of them its signature mentions — its application
    # θ, beside the receiver that is the other half of its key. The
    # bootstrap's `provision_app` reads the same symbols.
    fn item_deps(s: Int, out: IntList) {
      while dp_len.length() <= s {
        dp_start.push(0);
        dp_len.push(ast::none());
      }
      if dp_len.get(s) == ast::none() {
        let all = int_list();
        # D78: an abstract functor's binding serves every instantiation
        # of its inputs, so it depends on no type symbol — unless it lists
        # its polymorphic inputs (D84, draft): then it is at an
        # instantiation of the rest of what its result mentions.
        if prog::sym_kind.get(s) != prog::sk_functor() {
          nest_types(prog::sym_mod.get(s), prog::sym_asm.get(s), prog::sym_nasm.get(s), all, int_list());
        } else {
          functor_fixed(s, all);
        }
        let found = int_list();
        if prog::sym_kind.get(s) == prog::sk_method() {
          let said = int_list();
          signature_syms(s, said);
          var i = 0;
          while i < all.length() {
            if types::contains_sym(said, all.get(i)) {
              found.push(all.get(i));
            }
            i = i + 1;
          }
        } else {
          var i = 0;
          while i < all.length() {
            found.push(all.get(i));
            i = i + 1;
          }
        }
        dp_start.set(s, dp_pool.length());
        var i = 0;
        while i < found.length() {
          dp_pool.push(found.get(i));
          i = i + 1;
        }
        dp_len.set(s, found.length());
      }
      var i = 0;
      while i < dp_len.get(s) {
        out.push(dp_pool.get(dp_start.get(s) + i));
        i = i + 1;
      }
    }

    # D84 (draft): `P(F)`, the polymorphic inputs a bracketed abstract
    # functor lists, resolved in its module.
    fn functor_params(s: Int, out: IntList) {
      let d = prog::sym_decl.get(s);
      var i = 0;
      while i < ast::fu_nparams(d) {
        let t = prog::lookup(prog::sym_mod.get(s), prog::ns_name(), ast::kid_at(ast::fu_params(d), i));
        if ast::is_some(t) {
          types::push_new(out, t);
        }
        i = i + 1;
      }
    }

    # `M(F)`: the type symbols the items of `F`'s result mention, through
    # relevant parameters, less the types the result holds itself.
    fn functor_mentions(s: Int, out: IntList) {
      let d = prog::sym_decl.get(s);
      let outputs = int_list();
      result_type_syms(prog::sym_mod.get(s), ast::fu_res(d), ast::fu_nres(d), outputs);
      let found = int_list();
      mention_walk(prog::sym_mod.get(s), ast::fu_res(d), ast::fu_nres(d), found, 0);
      var i = 0;
      while i < found.length() {
        if !types::contains_sym(outputs, found.get(i)) {
          types::push_new(out, found.get(i));
        }
        i = i + 1;
      }
    }

    # The types a functor's result holds, through contexts: the same walk
    # as an assume nesting's (`nest_types`).
    fn result_type_syms(m: Int, run: Int, n: Int, out: IntList) {
      nest_types(m, run, n, out, int_list());
    }

    fn mention_walk(m: Int, run: Int, n: Int, out: IntList, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        let t = prog::resolve_path(m, ast::a_of(spec));
        if ast::is_some(t) {
          let syms = int_list();
          var item = true;
          if ast::is_some(ast::b_of(spec)) {
            types::free_syms_ref(ast::a_of(spec), ast::none(), 0, m, syms);
            let method = find_method_decl(m, t, ast::b_of(spec));
            if ast::is_some(method) {
              signature_syms(method, syms);
            }
          } else {
            let kind = prog::sym_kind.get(t);
            let d = prog::sym_decl.get(t);
            if kind == prog::sk_context() {
              mention_walk(prog::sym_mod.get(t), ast::b_of(d), ast::c_of(d), out, depth + 1);
              item = false;
            } else if kind == prog::sk_val() {
              # D84 rule 1 (strengthened): a val's or fn's dependencies,
              # its whole telescope (D71, D79), not only its signature.
              item_deps(t, syms);
              types::free_syms(ast::b_of(d), prog::sym_mod.get(t), syms);
            } else if kind == prog::sk_fn() {
              item_deps(t, syms);
              signature_syms(t, syms);
            } else if kind == prog::sk_functor() {
              # D84 rule 1: an abstract functor item `G` mentions `X(G)`.
              if ast::is_some(ast::fu_binds(d)) {
                item = false;
              } else {
                functor_fixed(t, syms);
              }
            } else {
              item = false;
            }
          }
          if item {
            # The item's own brackets: what they bind is not mentioned,
            # what their right-hand sides mention is.
            let bound = int_list();
            var b = 0;
            while b < ast::d_of(spec) {
              let binding = ast::kid_at(ast::c_of(spec), b);
              let lhs = prog::resolve_path(m, ast::a_of(binding));
              if ast::is_some(lhs) {
                bound.push(lhs);
              }
              b = b + 1;
            }
            var j = 0;
            while j < syms.length() {
              if !types::contains_sym(bound, syms.get(j)) {
                types::push_new(out, syms.get(j));
              }
              j = j + 1;
            }
            b = 0;
            while b < ast::d_of(spec) {
              let rhs = ast::b_of(ast::kid_at(ast::c_of(spec), b));
              types::free_syms_ref(ast::a_of(rhs), ast::c_of(rhs), ast::d_of(rhs), m, out);
              b = b + 1;
            }
          }
        }
        i = i + 1;
      }
    }

    # The types each application of a bracketed `F` supplies: `P(F)`, and
    # `F`'s input types outside `X(F)`.
    fn functor_poly(s: Int, out: IntList) {
      # An unbracketed `F` is polymorphic in all of `M(F)` (D84 rule 1).
      if ast::fu_bracketed(prog::sym_decl.get(s)) {
        functor_params(s, out);
      } else {
        functor_mentions(s, out);
      }
      let xs = int_list();
      functor_fixed(s, xs);
      let d = prog::sym_decl.get(s);
      let ins = int_list();
      nest_types(prog::sym_mod.get(s), ast::fu_args(d), ast::fu_nargs(d), ins, int_list());
      var i = 0;
      while i < ins.length() {
        if !types::contains_sym(xs, ins.get(i)) {
          types::push_new(out, ins.get(i));
        }
        i = i + 1;
      }
    }

    # `X(F)` = `M(F)` less `P(F)`, for a bracketed `F`; nothing for an
    # unbracketed one, whose binding serves every instantiation (D78).
    fn functor_fixed(s: Int, out: IntList) {
      let d = prog::sym_decl.get(s);
      if !ast::fu_bracketed(d) {
        return ();
      }
      let ps = int_list();
      functor_params(s, ps);
      let ms = int_list();
      functor_mentions(s, ms);
      var i = 0;
      while i < ms.length() {
        if !types::contains_sym(ps, ms.get(i)) {
          types::push_new(out, ms.get(i));
        }
        i = i + 1;
      }
    }

    # The abstract types a run of assume items names, through the contexts
    # it names.
    # D73: every parameter a tag lists must be a type its assume nesting
    # requires, as a bracket application's left side must be.
    fn check_listed() {
      var s = 0;
      while s < prog::sym_count() {
        let d = prog::sym_decl.get(s);
        if prog::sym_kind.get(s) == prog::sk_tag() {
          if ast::d_of(d) > 0 {
            let nesting = int_list();
            nest_types(prog::sym_mod.get(s), prog::sym_asm.get(s), prog::sym_nasm.get(s), nesting, int_list());
            var i = 0;
            while i < ast::d_of(d) {
              let name = ast::kid_at(ast::c_of(d), i);
              let t = prog::lookup(prog::sym_mod.get(s), prog::ns_name(), name);
              var ok = ast::is_some(t);
              if ok {
                ok = types::contains_sym(nesting, t);
              }
              if !ok {
                prog::error(prog::e_listed(), prog::sym_mod.get(s), name);
              }
              i = i + 1;
            }
          }
        }
        s = s + 1;
      }
    }

    # D58 on definitions: every tag has a finite layout (types.check_layout).
    fn check_layouts() {
      var s = 0;
      while s < prog::sym_count() {
        types::check_layout(s);
        s = s + 1;
      }
    }

    # D15, where a union is written: each member is nominal there, and no
    # two share a head. A type symbol member passes only if `env`, the
    # context the union is written in, binds it to a nominal type (or to
    # a union of them); as written, before anything binds it, it stands
    # for itself and does not. Each declaration's types are checked so
    # (`check_unions`), and a body's annotations in the body's generic
    # environment (codegen's `elab_ty`).
    fn check_written(env: Int, t: Int, m: Int) {
      if !ast::is_some(t) {
        return ();
      }
      let k = ast::kind_of(t);
      if k == ast::k_ty_record() {
        var i = 0;
        while i < ast::b_of(t) {
          check_written(env, ast::b_of(ast::kid_at(ast::a_of(t), i)), m);
          i = i + 1;
        }
        return ();
      }
      if k != ast::k_ty_union() {
        return ();
      }
      let members = int_list();
      var i = 0;
      while i < ast::b_of(t) {
        let kid = ast::kid_at(ast::a_of(t), i);
        check_written(env, kid, m);
        # `This` in a union is an error of its own (`e_shape`), and a
        # record member is reported by `types::check_members`.
        let kk = ast::kind_of(kid);
        if kk != ast::k_ty_this() {
          if kk != ast::k_ty_record() {
            types::add_member(members, canon(env, types::elab(kid, m)));
          }
        }
        i = i + 1;
      }
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(t)) { prog::location.write(t + 1); }
      i = 0;
      while i < members.length() {
        let x = members.get(i);
        if types::is_kind(x, types::kd_nominal()) {
          var j = 0;
          while j < i {
            let y = members.get(j);
            if types::is_kind(y, types::kd_nominal()) {
              if types::sym_of(y) == types::sym_of(x) {
                prog::error(prog::e_union(), m, prog::sym_name.get(types::sym_of(x)));
              }
            }
            j = j + 1;
          }
        } else if types::is_kind(x, types::kd_abstract()) {
          prog::error(prog::e_union(), m, prog::sym_name.get(types::sym_of(x)));
        } else {
          prog::error(prog::e_union(), m, ast::none());
        }
        i = i + 1;
      }
      prog::location.write(saved);
    }

    # Criteria section 7: every declaration is checked as written, used or
    # not, each type symbol standing for itself. A use reads it again at
    # its own meanings, as before.
    # - A tag's payload, an alias's body, a val's type and a fn's or
    #   method's signature elaborate (names resolve, no alias cycle), and
    #   their unions are D15's (`check_written`).
    # - A context's items form, as an assume nesting of their own would,
    #   with every type symbol in force as itself.
    # - A functor's arguments form, and each item of its result resolves.
    # (Every symbol's own nesting is formed by `check_assumes`, and a
    # functor's totality by codegen's `check_functor_total`.)
    fn check_declarations() {
      let saved = prog::location.read();
      let cyclic = check_alias_cycles();
      # Every type symbol standing for itself: a context's items are read
      # at each use with the user's types, so its own nesting is not
      # where they are read (`context Branch = i32_bool;` mentions `I32`).
      # (`as_assumed` may make a parameter symbol, so the count is read
      # first.)
      var as_written = env_empty();
      let declared = prog::sym_count();
      var t = 0;
      while t < declared {
        if prog::sym_kind.get(t) == prog::sk_type() {
          as_written = env_push(as_written, ek_type(), ast::none(), t, as_assumed(t), ast::none());
        }
        t = t + 1;
      }
      var s = 0;
      while s < prog::sym_count() {
        let d = prog::sym_decl.get(s);
        let m = prog::sym_mod.get(s);
        let kind = prog::sym_kind.get(s);
        if ast::is_some(d) {
          prog::location.write(d + 1);
          if kind == prog::sk_fn() {
            if !cyclic { decl_signature(d, m); }
          } else if kind == prog::sk_method() {
            if !cyclic { decl_signature(d, m); }
          } else if kind == prog::sk_context() {
            if ast::is_kind(d, ast::k_d_context()) {
              assume_run(as_written, m, ast::b_of(d), ast::c_of(d), int_list(), int_list());
            }
          } else if kind == prog::sk_functor() {
            decl_functor(d, m);
          } else if !cyclic {
            decl_type(d, m);
          }
        }
        s = s + 1;
      }
      prog::location.write(saved);
    }

    # A type a declaration writes, as written.
    fn decl_written(t: Int, m: Int) {
      if !ast::is_some(t) {
        return ();
      }
      # A bare `This` is the receiver's type, which only a use supplies.
      if !ast::is_kind(t, ast::k_ty_this()) {
        types::elab(t, m);
      }
      check_written(env_empty(), t, m);
    }

    fn decl_type(d: Int, m: Int) {
      let k = ast::kind_of(d);
      if k == ast::k_d_tag() {
        decl_written(ast::b_of(d), m);
      } else if k == ast::k_d_alias() {
        decl_written(ast::b_of(d), m);
      } else if k == ast::k_d_val() {
        decl_written(ast::b_of(d), m);
      }
    }

    fn decl_signature(d: Int, m: Int) {
      if !ast::is_kind(d, ast::k_d_fn()) {
        return ();
      }
      var i = 0;
      while i < ast::fn_nparams(d) {
        decl_written(ast::b_of(ast::kid_at(ast::fn_params(d), i)), m);
        i = i + 1;
      }
      decl_written(ast::fn_ret(d), m);
    }

    fn decl_functor(d: Int, m: Int) {
      if !ast::is_kind(d, ast::k_d_functor()) {
        return ();
      }
      assume_items(m, ast::fu_args(d), ast::fu_nargs(d), int_list(), int_list());
      var i = 0;
      while i < ast::fu_nres(d) {
        let spec = ast::kid_at(ast::fu_res(d), i);
        let path = ast::a_of(spec);
        if ast::is_some(path) {
          if !ast::is_some(prog::resolve_path(m, path)) {
            let saved = prog::location.read();
            if ast::is_some(ast::source_start(spec)) { prog::location.write(spec + 1); }
            prog::error(prog::e_scope(), m, ast::path_last(path));
            prog::location.write(saved);
          }
        }
        i = i + 1;
      }
    }

    # An alias whose body reaches itself through aliases has no reading
    # (Audit: no finite `TyAlias` derivation); elaborating one would not
    # end, so this is found first, and then no declaration's types are
    # elaborated here. Whether any was found.
    fn check_alias_cycles(): Bool {
      let errors = prog::error_count();
      let done = int_list();
      var s = 0;
      while s < prog::sym_count() {
        if prog::sym_kind.get(s) == prog::sk_alias() {
          alias_cycle_from(s, int_list(), done);
        }
        s = s + 1;
      }
      prog::error_count() > errors
    }

    fn alias_cycle_from(s: Int, walking: IntList, done: IntList) {
      if types::contains_sym(walking, s) {
        prog::error(prog::e_alias_cycle(), prog::sym_mod.get(s), prog::sym_name.get(s));
        return ();
      }
      if types::contains_sym(done, s) {
        return ();
      }
      let d = prog::sym_decl.get(s);
      if !ast::is_kind(d, ast::k_d_alias()) {
        return ();
      }
      let within = int_list();
      var i = 0;
      while i < walking.length() {
        within.push(walking.get(i));
        i = i + 1;
      }
      within.push(s);
      let named = int_list();
      types::mentioned(ast::b_of(d), prog::sym_mod.get(s), named);
      i = 0;
      while i < named.length() {
        if prog::sym_kind.get(named.get(i)) == prog::sk_alias() {
          alias_cycle_from(named.get(i), within, done);
        }
        i = i + 1;
      }
      done.push(s);
    }

    # Depth first, entering each context once (`seen`), so contexts nest
    # to any depth and a cycle of them is the union of their items; the
    # types come out in order of first reaching, as the bootstrap's
    # `walk_specs` gives them.
    fn nest_types(m: Int, run: Int, len: Int, out: IntList, seen: IntList) {
      var i = 0;
      while i < len {
        let spec = ast::kid_at(run, i);
        if !ast::is_some(ast::b_of(spec)) {
          if ast::is_some(ast::a_of(spec)) {
            let target = prog::resolve_path(m, ast::a_of(spec));
            if ast::is_some(target) {
              let kind = prog::sym_kind.get(target);
              if kind == prog::sk_type() {
                types::push_new(out, target);
              } else if kind == prog::sk_context() {
                if !types::contains_sym(seen, target) {
                  seen.push(target);
                  let d = prog::sym_decl.get(target);
                  nest_types(prog::sym_mod.get(target), ast::b_of(d), ast::c_of(d), out, seen);
                }
              }
            }
          }
        }
        i = i + 1;
      }
    }

    fn signature_syms(f: Int, out: IntList) {
      let d = prog::sym_decl.get(f);
      let home = prog::sym_mod.get(f);
      var i = 0;
      while i < ast::fn_nparams(d) {
        types::free_syms(ast::b_of(ast::kid_at(ast::fn_params(d), i)), home, out);
        i = i + 1;
      }
      types::free_syms(ast::fn_ret(d), home, out);
    }

    # An assumed item's app: only what the item's own brackets (`view`)
    # make of its symbols. The rest is read against the environment the
    # function ends up with (`app_get`), so the order of an assume list
    # does not matter.
    fn assumed_app(s: Int, view: Int): Int {
      let deps = int_list();
      item_deps(s, deps);
      var app = env_empty();
      var i = 0;
      while i < deps.length() {
        let t = deps.get(i);
        let at = types::ty_of_symbol(types::kd_abstract(), t);
        let v = canon(view, at);
        var differs = v != at;
        if differs {
          differs = v != as_assumed(t);
        }
        if differs {
          app = env_push(app, ek_type(), ast::none(), t, v, ast::none());
        }
        i = i + 1;
      }
      app
    }

    # A bound provision's app, in full: for each symbol, what it denotes
    # in `view` where the bind is made, or none where it is not in force.
    fn full_app(s: Int, view: Int): Int {
      let deps = int_list();
      item_deps(s, deps);
      var app = env_empty();
      var i = 0;
      while i < deps.length() {
        let t = deps.get(i);
        var v = ast::none();
        if env_has(view, ek_type(), ast::none(), t) {
          v = canon(view, types::ty_of_symbol(types::kd_abstract(), t));
        }
        app = env_push(app, ek_type(), ast::none(), t, v, ast::none());
        i = i + 1;
      }
      app
    }

    # What `app` says symbol `t` denotes: its own row, or else — for an
    # assumed item's sparse app — `t` itself if the environment `base` it
    # was assumed in has `t`, and none (not in force) if it does not.
    fn app_get(app: Int, t: Int, base: Int): Int {
      var e = app;
      while ast::is_some(e) {
        if en_sym.get(e) == t {
          return en_a.get(e);
        }
        e = en_next.get(e);
      }
      if env_has(base, ek_type(), ast::none(), t) {
        return as_assumed(t);
      }
      ast::none()
    }

    # What an assumed type symbol is: its parameter (D72).
    fn as_assumed(t: Int): Int {
      types::ty_of_symbol(types::kd_abstract(), prog::param_of(t))
    }

    # A type as a declaration states it — its parameters standing for
    # whatever is supplied for their symbols — read at a use in `env`:
    # each parameter becomes the generation of its symbol in force there.
    # A declared symbol that is not a parameter is read as `canon` reads
    # it. Only for a type that comes from a declaration; one this scope
    # already gave to something keeps its own parameters.
    fn instantiate(env: Int, t: Int): Int {
      let from = int_list();
      let to = int_list();
      params_in(t, from);
      var i = 0;
      while i < from.length() {
        to.push(canon(
          env, types::ty_of_symbol(types::kd_abstract(), prog::origin_of(from.get(i)))
        ));
        i = i + 1;
      }
      canon(env, types::subst(t, from, to))
    }

    fn params_in(t: Int, out: IntList) {
      if !ast::is_some(t) {
        return ();
      }
      let k = types::kind_of(t);
      if k == types::kd_abstract() {
        if ast::is_some(prog::origin_of(types::sym_of(t))) {
          types::push_new(out, types::sym_of(t));
        }
      } else if k == types::kd_record() {
        var i = 0;
        while i < types::field_count(t) {
          params_in(types::field_type_at(t, i), out);
          i = i + 1;
        }
      } else {
        var i = 0;
        while i < types::member_count(t) {
          params_in(types::member_at(t, i), out);
          i = i + 1;
        }
      }
    }

    # An attached method on the receiver, or a detached one in scope.
    # Detached methods must be imported even in context items.
    fn find_method_decl(m: Int, receiver: Int, name: Int): Int {
      let home = prog::sym_mod.get(receiver);
      var found = prog::find_attached(home, receiver, name);
      if ast::is_some(found) {
        return found;
      }
      prog::lookup(m, prog::ns_detached(), name)
    }

    # Validate every context declaration, including unused ones. A
    # recursion stack distinguishes cycles from shared subcontexts.
    fn check_context_cycle(s: Int, walking: IntList, done: IntList) {
      if types::contains_sym(walking, s) {
        prog::error(prog::e_deep(), prog::sym_mod.get(s), prog::sym_name.get(s));
        return ();
      }
      if types::contains_sym(done, s) {
        return ();
      }
      let within = int_list();
      var i = 0;
      while i < walking.length() {
        within.push(walking.get(i));
        i = i + 1;
      }
      within.push(s);
      let d = prog::sym_decl.get(s);
      i = 0;
      while i < ast::c_of(d) {
        let spec = ast::kid_at(ast::b_of(d), i);
        if !ast::is_some(ast::b_of(spec)) {
          let t = prog::resolve_path(prog::sym_mod.get(s), ast::a_of(spec));
          if ast::is_some(t) {
            if prog::sym_kind.get(t) == prog::sk_context() {
              check_context_cycle(t, within, done);
            }
          }
        }
        i = i + 1;
      }
      done.push(s);
    }

    # A function gets the root context when exposed as main, regardless
    # of which name its declaration used.
    fn is_root_fn(s: Int): Bool {
      if prog::sym_kind.get(s) != prog::sk_fn() {
        return false;
      }
      let mn = int_list();
      sp_main(mn);
      let name = intern::intern_chars(mn);
      var m = 0;
      while m < prog::module_count() {
        if prog::lookup(m, prog::ns_name(), name) == s {
          return true;
        }
        m = m + 1;
      }
      false
    }

    # D20: validate the callee's complete context, including the platform
    # root when it is main. Reconstructing just its written assumes would
    # omit those implicit type and functor requirements.
    fn check_assumed_requirements(env: Int, m: Int, receiver: Int, s: Int) {
      if prog::sym_kind.get(s) == prog::sk_functor() {
        return ();
      }
      if is_root_fn(s) {
        lower_needs_at(s, root_context());
      } else {
        lower_needs(s);
      }
      let row = env_find(env, need_kind(s), receiver, s);
      var app = env_empty();
      if ast::is_some(row) {
        app = en_b.get(row);
      }
      let all = int_list();
      var at = env_of(s);
      while ast::is_some(at) {
        if en_kind.get(at) == ek_type() {
          types::push_new(all, en_sym.get(at));
        }
        at = en_next.get(at);
      }
      let mentioned = int_list();
      if prog::sym_kind.get(s) == prog::sk_method() {
        signature_syms(s, mentioned);
      }
      var view = env;
      var i = 0;
      while i < all.length() {
        let t = all.get(i);
        var relevant = true;
        if prog::sym_kind.get(s) == prog::sk_method() {
          relevant = types::contains_sym(mentioned, t);
        }
        if relevant {
          let ty = app_get(app, t, env);
          if !ast::is_some(ty) {
            prog::error(prog::e_absent(), m, prog::sym_name.get(t));
          } else {
            view = env_push(view, ek_type(), ast::none(), t, canon(env, ty), ast::none());
          }
        }
        i = i + 1;
      }
      i = 0;
      while i < needs_count(s) {
        let ds = need_sym_at(s, i);
        let dr = need_recv_at(s, i);
        var here = dr;
        if ast::is_some(dr) {
          here = instantiate(view, dr);
        }
        let have = env_find(view, need_kind(ds), here, ds);
        if !ast::is_some(have) {
          prog::error(prog::e_absent(), m, prog::sym_name.get(ds));
        } else if !assumed_coherent(ds, need_app_at(s, i), env_of(s), en_b.get(have), env, view) {
          # AUDIT-CHANGES #57 (D62): and at the instantiation `s` needs
          # it, as a call of `s` here would ask (the oracle's
          # `require_needs`).
          prog::error(prog::e_incoherent(), m, prog::sym_name.get(ds));
        }
        i = i + 1;
      }
    }

    # One need of an assumed item, as codegen's `coherent` compares a
    # call's: `want`, the item's app for `ds` against its declaration's
    # environment `wbase`, read in `view` (where the item's own
    # instantiation is in force), against `have`, the app the assumed
    # provision of `ds` is at, against `hbase`.
    fn assumed_coherent(ds: Int, want: Int, wbase: Int, have: Int, hbase: Int, view: Int): Bool {
      let deps = int_list();
      item_deps(ds, deps);
      var i = 0;
      while i < deps.length() {
        let t = deps.get(i);
        let wv = app_get(want, t, wbase);
        var need = ast::none();
        if ast::is_some(wv) {
          need = instantiate(view, wv);
        } else if env_has(view, ek_type(), ast::none(), t) {
          need = canon(view, types::ty_of_symbol(types::kd_abstract(), t));
        }
        var got = app_get(have, t, hbase);
        if ast::is_some(got) {
          got = canon(view, got);
        }
        if need != got {
          return false;
        }
        i = i + 1;
      }
      true
    }

    # Defined functions do not become run-time provisions in the native
    # compiler, but listing one still checks its ambient requirements.
    # Traverse those items separately from the run-time need list.
    fn check_defined_items(env: Int, m: Int, run: Int, n: Int, walking: IntList) {
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        if !ast::is_some(ast::b_of(spec)) {
          let s = prog::resolve_path(m, ast::a_of(spec));
          if ast::is_some(s) {
            let view = app_view(env, m, spec);
            let kind = prog::sym_kind.get(s);
            let d = prog::sym_decl.get(s);
            if kind == prog::sk_fn() {
              if ast::is_some(ast::fn_body(d)) {
                check_assumed_requirements(view, m, ast::none(), s);
              }
            } else if kind == prog::sk_context() {
              if !types::contains_sym(walking, s) {
                let next = int_list();
                var j = 0;
                while j < walking.length() {
                  next.push(walking.get(j));
                  j = j + 1;
                }
                next.push(s);
                check_defined_items(view, prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), next);
              }
            }
          }
        }
        i = i + 1;
      }
    }

    fn check_assumes() {
      let seen_run = int_list();
      let seen_len = int_list();
      let seen_root = int_list();
      var f = 0;
      while f < prog::sym_count() {
        # Every symbol's nesting, whatever its kind (criteria section 7):
        # a nesting that holds only types or tags forms too.
        if ast::is_some(prog::sym_decl.get(f)) {
          let run = prog::sym_asm.get(f);
          let len = prog::sym_nasm.get(f);
          var rooted = 0;
          if is_root_fn(f) { rooted = 1; }
          var seen = false;
          var at = 0;
          while at < seen_run.length() {
            if seen_run.get(at) == run {
              if seen_len.get(at) == len {
                if seen_root.get(at) == rooted {
                  seen = true;
                }
              }
            }
            at = at + 1;
          }
          if !seen {
            seen_run.push(run);
            seen_len.push(len);
            seen_root.push(rooted);
            let recv = int_list();
            let syms = int_list();
            var env = base_env(f, recv, syms);
            if rooted == 1 {
              lower_needs_at(f, root_context());
              env = env_of(f);
            }
            var i = 0;
            while i < syms.length() {
              check_assumed_requirements(env, prog::sym_mod.get(f), recv.get(i), syms.get(i));
              i = i + 1;
            }
            check_defined_items(env, prog::sym_mod.get(f), run, len, int_list());
          }
        }
        f = f + 1;
      }
    }

    # D89: a bracket application on a function call, `f[A = T](e1, ...)`,
    # is `{ let a1 = e1; ...; bind A = T; f(a1, ...) }`, with names `ai`
    # no program can write (`%arg0`, ...): the arguments are evaluated,
    # in the caller's terms, before the binds. Each binding names a type
    # `f`'s assume nesting requires (`nest_types`, the bootstrap's
    # `reqs`) and binds it to a type by name, as a bracket on any
    # reference does (D22). Every such call is rewritten in place, before
    # anything reads a body, so that each pass of the back end sees only
    # the block; a tag's application (`Box[Elem=I32](x)`) stays as it is.
    fn desugar_call_brackets() {
      let n = ast::nkind.length();
      var id = 0;
      while id < n {
        if ast::kind_of(id) == ast::k_ex_call() {
          let callee = ast::a_of(id);
          if ast::is_kind(callee, ast::k_ex_path()) {
            if ast::d_of(callee) == 1 {
              let m = ast::source_module(id);
              if ast::is_some(m) {
                let f = prog::resolve_path(m, ast::a_of(callee));
                if ast::is_some(f) {
                  if prog::sym_kind.get(f) == prog::sk_fn() {
                    call_block(id, f, m);
                  }
                }
              }
            }
          }
        }
        id = id + 1;
      }
    }

    # A node synthesized for `call`, with its source range.
    fn at_call(node: Int, call: Int): Int {
      ast::nfile.set(node, ast::nfile.get(call));
      ast::nstart.set(node, ast::nstart.get(call));
      ast::nend.set(node, ast::nend.get(call));
      node
    }

    fn call_arg_name(i: Int): Int {
      let cs = int_list();
      push_string(cs, "%arg");
      if i == 0 {
        cs.push(48);
      }
      let digits = int_list();
      var k = i;
      while k > 0 {
        digits.push(48 + k % 10);
        k = k / 10;
      }
      var j = digits.length();
      while j > 0 {
        j = j - 1;
        cs.push(digits.get(j));
      }
      intern::intern_chars(cs)
    }

    fn call_block(call: Int, f: Int, m: Int) {
      let saved = prog::location.read();
      prog::location.write(call + 1);
      let callee = ast::a_of(call);
      let reqs = int_list();
      nest_types(prog::sym_mod.get(f), prog::sym_asm.get(f), prog::sym_nasm.get(f), reqs, int_list());
      let stmts = int_list();
      let args = int_list();
      var i = 0;
      while i < ast::c_of(call) {
        let name = call_arg_name(i);
        stmts.push(at_call(ast::node3(ast::k_st_let(), name, ast::none(), ast::kid_at(ast::b_of(call), i)), call));
        let ps = int_list();
        ps.push(name);
        args.push(at_call(ast::node4(ast::k_ex_path(), ast::path_of(ps), ast::none(), 0, 0), call));
        i = i + 1;
      }
      let items = int_list();
      i = 0;
      while i < ast::c_of(callee) {
        let b = ast::kid_at(ast::b_of(callee), i);
        let rhs = ast::b_of(b);
        let lhs = prog::resolve_path(m, ast::a_of(b));
        if !ast::is_some(lhs) {
          prog::error(prog::e_scope(), m, ast::path_last(ast::a_of(b)));
        } else if prog::sym_kind.get(lhs) != prog::sk_type() {
          # Only a type is bound so far (D89).
          prog::error(prog::e_apply(), m, prog::sym_name.get(lhs));
        } else if !types::contains_sym(reqs, lhs) {
          prog::error(prog::e_irrelevant(), m, prog::sym_name.get(lhs));
        } else if ast::is_some(ast::b_of(rhs)) {
          # `f[T = R.m]`, `f[T = .m]`: a method is no type.
          prog::error(prog::e_apply(), m, prog::sym_name.get(lhs));
        } else {
          let spec = at_call(ast::node4(ast::k_spec(), ast::a_of(b), ast::none(), ast::none(), 0), call);
          var applied = 0;
          if ast::d_of(rhs) > 0 {
            applied = 1;
          }
          let value = at_call(ast::node4(ast::k_ex_path(), ast::a_of(rhs), ast::c_of(rhs), ast::d_of(rhs), applied), call);
          items.push(at_call(ast::node2(ast::k_st_item(), spec, value), call));
        }
        i = i + 1;
      }
      stmts.push(at_call(ast::node2(ast::k_st_bind(), ast::commit(items), items.length()), call));
      let plain = at_call(ast::node4(ast::k_ex_path(), ast::a_of(callee), ast::none(), 0, 0), call);
      let inner = at_call(ast::node3(ast::k_ex_call(), plain, ast::commit(args), args.length()), call);
      let run = ast::commit(stmts);
      ast::nkind.set(call, ast::k_ex_block());
      ast::na.set(call, run);
      ast::nb.set(call, stmts.length());
      ast::nc.set(call, inner);
      ast::nd.set(call, ast::none());
      prog::location.write(saved);
    }

    # Every defined function of the program, in module order.
    # Every defined function's needs; a module's `main`'s with the root
    # context beside its own (`lower_needs_at`).
    fn lower_all() {
      let done = int_list();
      var ctx = 0;
      while ctx < prog::sym_count() {
        if prog::sym_kind.get(ctx) == prog::sk_context() {
          check_context_cycle(ctx, int_list(), done);
        }
        ctx = ctx + 1;
      }
      needs_init();
      # Each module's `main`, including an import, wherever execution starts: a
      # function is checked the same wherever the program starts (D16).
      let mn = int_list();
      sp_main(mn);
      let name = intern::intern_chars(mn);
      let root = root_context();
      var m = 0;
      while m < prog::module_count() {
        let main = prog::lookup(m, prog::ns_name(), name);
        if ast::is_some(main) {
          if prog::sym_kind.get(main) == prog::sk_fn() {
            if ast::is_some(ast::fn_body(prog::sym_decl.get(main))) {
              lower_needs_at(main, root);
            }
          }
        }
        m = m + 1;
      }
      var f = 0;
      while f < prog::sym_count() {
        let kind = prog::sym_kind.get(f);
        var is_fn = kind == prog::sk_fn();
        if !is_fn {
          is_fn = kind == prog::sk_method();
        }
        if is_fn {
          if ast::is_some(ast::fn_body(prog::sym_decl.get(f))) {
            lower_needs(f);
          }
        }
        f = f + 1;
      }
      check_assumes();
    }
  }
}
