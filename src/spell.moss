import "./bytes.moss" use push_char;

# The strings the compiler must hold itself.
#
# A Wasm module names its imports and exports in its own bytes, so an
# emitter cannot avoid knowing how `wasi_snapshot_preview1` is spelled.
# There are no string literals (D48), so each one is written character by
# character against the `char` constants — the same technique the lexer's
# keyword trie uses to recognise keywords without literals. This is the
# whole of what [D48] costs the back end: one function per name, and no
# name the compiler does not already need appears here.
#
# Generated by scratch/gen_spell.py; regenerate rather than edit.

assume Std {
