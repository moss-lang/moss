import "./lex.moss" as lexer use Token;
import "./token.moss" use *;
import "./intern.moss" as intern;
import "./tree.moss" as tree;

# Parser v3: recursive descent over the declaration grammar, building the
# arena tree of tree.moss with each declaration's *name* captured as a span
# into the source (payloads are still skipped). Lookahead is threaded
# functionally: each function takes the current token and returns the
# lookahead after what it consumed.

assume Std {
  assume lexer::src, lexer::at, lexer::mark, intern::Interner, tree::Tree {
    # Skip a balanced { ... }; `t` is the lookahead after the opening brace.
    fn skip_braces(t: Token): Token {
      var depth = one;
      var cur = t;
      loop {
        match cur {
          Eof => break,
          LBrace => { depth = depth.add(one); }
          RBrace => { depth = depth.sub(one); }
          _ => (),
        }
        cur = lexer::lex();
        if depth.eq(zero) {
          break;
        }
      }
      cur
    }

    # Skip to just past the next semicolon. Declaration payloads contain no
    # semicolons (record types have commas), so this ends the declaration.
    fn skip_to_semi(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        _ => cur,
      }
    }

    # A fn declaration ends at a semicolon (abstract) or a balanced body.
    fn skip_fn(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          LBrace => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        LBrace => skip_braces(lexer::lex()),
        _ => cur,
      }
    }

    # A declaration introduced by a keyword whose next token is its name:
    # record the leaf with the name's span and skip the rest.
    fn named(k: Int, out: IntList): Token {
      let h = lexer::lex();
      match h {
        Name => {
          let ns = lexer::mark.read();
          let nl = lexer::at.read().sub(ns);
          out.push(tree::leaf(k, ns, nl, intern::intern(ns, nl)));
          skip_to_semi(lexer::lex())
        }
        _ => {
          out.push(tree::leaf(k, zero, zero, intern::intern(zero, zero)));
          skip_to_semi(h)
        }
      }
    }

    # Parse declarations until end of file or an unmatched closing brace,
    # pushing each declaration's node id into `out`.
    fn decls(t: Token, out: IntList): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          RBrace => break,
          Import => {
            out.push(tree::leaf(tree::k_import(), zero, zero, intern::intern(zero, zero)));
            cur = skip_to_semi(lexer::lex());
          }
          Assume => {
            var h = lexer::lex();
            loop {
              match h {
                Eof => break,
                LBrace => break,
                _ => { h = lexer::lex(); }
              }
            }
            match h {
              LBrace => {
                let mine = int_list();
                let inner = decls(lexer::lex(), mine);
                let start = tree::kid_mark();
                var i = zero;
                while i.lt(mine.length()) {
                  tree::kid_push(mine.get(i));
                  i = i.add(one);
                }
                out.push(tree::node(
                  tree::k_assume(), start, mine.length(), zero, zero,
                  intern::intern(zero, zero)
                ));
                match inner {
                  RBrace => { cur = lexer::lex(); }
                  _ => { cur = inner; }
                }
              }
              _ => { cur = h; }
            }
          }
          Type => { cur = named(tree::k_type(), out); }
          Unit => { cur = named(tree::k_unit(), out); }
          Val => { cur = named(tree::k_val(), out); }
          Context => { cur = named(tree::k_context(), out); }
          Fn => {
            # Plain `f`, attached `T.m`, or detached `.m`: the name is the
            # last name before the parameter list.
            var h = lexer::lex();
            match h {
              Dot => { h = lexer::lex(); }
              _ => (),
            }
            var ns = zero;
            var nl = zero;
            match h {
              Name => {
                ns = lexer::mark.read();
                nl = lexer::at.read().sub(ns);
                h = lexer::lex();
                match h {
                  Dot => {
                    h = lexer::lex();
                    match h {
                      Name => {
                        ns = lexer::mark.read();
                        nl = lexer::at.read().sub(ns);
                        h = lexer::lex();
                      }
                      _ => (),
                    }
                  }
                  _ => (),
                }
              }
              _ => (),
            }
            out.push(tree::leaf(tree::k_fn(), ns, nl, intern::intern(ns, nl)));
            cur = skip_fn(h);
          }
          _ => {
            out.push(tree::leaf(tree::k_bad(), zero, zero, intern::intern(zero, zero)));
            cur = lexer::lex();
          }
        }
      }
      cur
    }

    fn put_name(id: Int) {
      let ns = tree::name_start_of(id);
      let nl = tree::name_len_of(id);
      var j = zero;
      while j.lt(nl) {
        putchar(lexer::src.get(ns.add(j)));
        j = j.add(one);
      }
    }

    # Walk the finished arena: one letter per node, then the node's name
    # sliced out of the source, then `;` — assume children in parentheses.
    fn dump(id: Int) {
      let k = tree::kind_of(id);
      if k.eq(tree::k_import()) {
        putchar(char::i)
      } else if k.eq(tree::k_assume()) {
        putchar(char::a)
      } else if k.eq(tree::k_type()) {
        putchar(char::t)
      } else if k.eq(tree::k_unit()) {
        putchar(char::u)
      } else if k.eq(tree::k_val()) {
        putchar(char::v)
      } else if k.eq(tree::k_context()) {
        putchar(char::c)
      } else if k.eq(tree::k_fn()) {
        putchar(char::f)
      } else {
        putchar(char::question)
      }
      if k.eq(tree::k_assume()) {
        putchar(char::lparen);
        let s = tree::start_of(id);
        let n = tree::len_of(id);
        var i = zero;
        while i.lt(n) {
          dump(tree::kid_at(s.add(i)));
          i = i.add(one);
        }
        putchar(char::rparen);
      } else {
        put_name(id);
        putchar(char::semi);
      }
    }

    # Collect, first step: within one scope, two declarations may not share
    # a name (the bootstrap's "duplicate definition" error). Reports each
    # duplicate as name+`!`, recursing into assume blocks.
    fn dups(s: Int, n: Int) {
      var i = zero;
      while i.lt(n) {
        let a = tree::kid_at(s.add(i));
        if tree::name_len_of(a).gt(zero) {
          var j = i.add(one);
          while j.lt(n) {
            let b = tree::kid_at(s.add(j));
            if tree::name_id_of(a).eq(tree::name_id_of(b)) {
              put_name(b);
              putchar(char::exclam);
              j = n;
            } else {
              j = j.add(one);
            }
          }
        }
        if tree::kind_of(a).eq(tree::k_assume()) {
          dups(tree::start_of(a), tree::len_of(a));
        }
        i = i.add(one);
      }
    }

    fn run() {
      let roots = int_list();
      decls(lexer::lex(), roots);
      let rs = tree::kid_mark();
      var i = zero;
      while i.lt(roots.length()) {
        tree::kid_push(roots.get(i));
        i = i.add(one);
      }
      i = zero;
      while i.lt(roots.length()) {
        dump(roots.get(i));
        i = i.add(one);
      }
      putchar(char::newline);
      dups(rs, roots.length());
      putchar(char::newline);
    }
  }
}
