import "./lex.moss" as lexer use Token;
import "./token.moss" use *;
import "./tree.moss" as tree;

# Parser v2: recursive descent over the declaration grammar, building the
# arena tree of tree.moss (assume blocks own their children; other
# declarations are leaves; payloads are skipped for now). Lookahead is
# threaded functionally: each function takes the current token and returns
# the lookahead after what it consumed.

assume Std {
  assume lexer::src, lexer::at, tree::Tree {
    # Skip a balanced { ... }; `t` is the lookahead after the opening brace.
    fn skip_braces(t: Token): Token {
      var depth = one;
      var cur = t;
      loop {
        match cur {
          Eof => break,
          LBrace => { depth = depth.add(one); }
          RBrace => { depth = depth.sub(one); }
          _ => (),
        }
        cur = lexer::lex();
        if depth.eq(zero) {
          break;
        }
      }
      cur
    }

    # Skip to just past the next semicolon. Declaration payloads contain no
    # semicolons (record types have commas), so this ends the declaration.
    fn skip_to_semi(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        _ => cur,
      }
    }

    # A fn declaration ends at a semicolon (abstract) or a balanced body.
    fn skip_fn(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          LBrace => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        LBrace => skip_braces(lexer::lex()),
        _ => cur,
      }
    }

    # Parse declarations until end of file or an unmatched closing brace,
    # pushing each declaration's node id into `out`.
    fn decls(t: Token, out: IntList): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          RBrace => break,
          Import => {
            out.push(tree::leaf(tree::k_import()));
            cur = skip_to_semi(lexer::lex());
          }
          Assume => {
            var h = lexer::lex();
            loop {
              match h {
                Eof => break,
                LBrace => break,
                _ => { h = lexer::lex(); }
              }
            }
            match h {
              LBrace => {
                let mine = int_list();
                let inner = decls(lexer::lex(), mine);
                let start = tree::kid_mark();
                var i = zero;
                while i.lt(mine.length()) {
                  tree::kid_push(mine.get(i));
                  i = i.add(one);
                }
                out.push(tree::node(tree::k_assume(), start, mine.length()));
                match inner {
                  RBrace => { cur = lexer::lex(); }
                  _ => { cur = inner; }
                }
              }
              _ => { cur = h; }
            }
          }
          Type => {
            out.push(tree::leaf(tree::k_type()));
            cur = skip_to_semi(lexer::lex());
          }
          Unit => {
            out.push(tree::leaf(tree::k_unit()));
            cur = skip_to_semi(lexer::lex());
          }
          Val => {
            out.push(tree::leaf(tree::k_val()));
            cur = skip_to_semi(lexer::lex());
          }
          Context => {
            out.push(tree::leaf(tree::k_context()));
            cur = skip_to_semi(lexer::lex());
          }
          Fn => {
            out.push(tree::leaf(tree::k_fn()));
            cur = skip_fn(lexer::lex());
          }
          _ => {
            out.push(tree::leaf(tree::k_bad()));
            cur = lexer::lex();
          }
        }
      }
      cur
    }

    # Walk the finished arena: one letter per node, assume children in
    # parentheses. This reads the tree back out of the data, which is the
    # point — the arena is the parser's real output.
    fn dump(id: Int) {
      let k = tree::kind_of(id);
      if k.eq(tree::k_import()) {
        putchar(char::i)
      } else if k.eq(tree::k_assume()) {
        putchar(char::a)
      } else if k.eq(tree::k_type()) {
        putchar(char::t)
      } else if k.eq(tree::k_unit()) {
        putchar(char::u)
      } else if k.eq(tree::k_val()) {
        putchar(char::v)
      } else if k.eq(tree::k_context()) {
        putchar(char::c)
      } else if k.eq(tree::k_fn()) {
        putchar(char::f)
      } else {
        putchar(char::x)
      }
      if k.eq(tree::k_assume()) {
        putchar(char::lparen);
        let s = tree::start_of(id);
        let n = tree::len_of(id);
        var i = zero;
        while i.lt(n) {
          dump(tree::kid_at(s.add(i)));
          i = i.add(one);
        }
        putchar(char::rparen);
      }
    }

    fn run() {
      let roots = int_list();
      decls(lexer::lex(), roots);
      var i = zero;
      while i.lt(roots.length()) {
        dump(roots.get(i));
        i = i.add(one);
      }
      putchar(char::newline);
    }
  }
}
