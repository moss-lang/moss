import "./lex.moss" as lexer use Token;
import "./token.moss" use *;

# Structural parser, v1: recursive descent over the declaration grammar,
# printing one letter per declaration (i/a/t/u/v/c/f, x for junk) and
# skipping declaration payloads. Lookahead is threaded functionally: each
# function takes the current token and returns the lookahead that follows
# what it consumed. The full AST needs arenas (typed wrappers over
# IntList) and lands next.

assume Std {
  assume lexer::src, lexer::at {
    # Skip a balanced { ... }; `t` is the lookahead after the opening brace.
    # Returns the lookahead after the matching closing brace.
    fn skip_braces(t: Token): Token {
      var depth = one;
      var cur = t;
      loop {
        match cur {
          Eof => break,
          LBrace => { depth = depth.add(one); }
          RBrace => { depth = depth.sub(one); }
          _ => (),
        }
        cur = lexer::lex();
        if depth.eq(zero) {
          break;
        }
      }
      cur
    }

    # Skip to just past the next semicolon. Declaration payloads contain no
    # semicolons (record types have commas), so this ends the declaration.
    fn skip_to_semi(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        _ => cur,
      }
    }

    # A fn declaration ends at a semicolon (abstract) or a balanced body.
    fn skip_fn(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          Semi => break,
          LBrace => break,
          _ => { cur = lexer::lex(); }
        }
      }
      match cur {
        Semi => lexer::lex(),
        LBrace => skip_braces(lexer::lex()),
        _ => cur,
      }
    }

    # Parse declarations until end of file or an unmatched closing brace
    # (the end of the enclosing assume block). Returns that lookahead.
    fn decls(t: Token): Token {
      var cur = t;
      loop {
        match cur {
          Eof => break,
          RBrace => break,
          Import => {
            putchar(char::i);
            cur = skip_to_semi(lexer::lex());
          }
          Assume => {
            putchar(char::a);
            var h = lexer::lex();
            loop {
              match h {
                Eof => break,
                LBrace => break,
                _ => { h = lexer::lex(); }
              }
            }
            match h {
              LBrace => {
                let inner = decls(lexer::lex());
                match inner {
                  RBrace => { cur = lexer::lex(); }
                  _ => { cur = inner; }
                }
              }
              _ => { cur = h; }
            }
          }
          Type => {
            putchar(char::t);
            cur = skip_to_semi(lexer::lex());
          }
          Unit => {
            putchar(char::u);
            cur = skip_to_semi(lexer::lex());
          }
          Val => {
            putchar(char::v);
            cur = skip_to_semi(lexer::lex());
          }
          Context => {
            putchar(char::c);
            cur = skip_to_semi(lexer::lex());
          }
          Fn => {
            putchar(char::f);
            cur = skip_fn(lexer::lex());
          }
          _ => {
            putchar(char::x);
            cur = lexer::lex();
          }
        }
      }
      cur
    }

    fn tree() {
      decls(lexer::lex());
      putchar(char::newline);
    }
  }
}
