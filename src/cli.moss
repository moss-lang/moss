import "./lex.moss" as lexer;
import "./token.moss" use Eof;

assume Std {
  # Lex the file named by the first argument and print one dot per token.
  fn cli() {
    bind lexer::src=pwd.join(first_arg()).read();
    bind lexer::at=cell_int();
    loop {
      match lexer::lex() {
        Eof => break,
        _ => putchar(char::dot),
      }
    }
    putchar(char::newline);
  }
}
