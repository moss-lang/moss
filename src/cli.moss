import "./lex.moss" as lexer;
import "./parse.moss" as parser;

assume Std {
  # Parse the file named by the first argument, printing one letter per
  # declaration (see parse.moss).
  fn cli() {
    bind lexer::src=pwd.join(first_arg()).read();
    bind lexer::at=cell_int();
    parser::tree();
  }
}
