# Byte buffers for the self-hosted back end.
#
# A buffer is an `IntList` whose elements are byte values; a section, a
# function body and the module itself are all one of these, and building
# a length-prefixed thing means filling a fresh buffer and appending it
# under its own length.

assume Std {
  fn push_char(buf: IntList, c: Char) {
    buf.push(c.code());
  }

  fn push_bytes(dst: IntList, src: IntList) {
    var i = 0;
    while i < src.length() {
      dst.push(src.get(i));
      i = i + 1;
    }
  }

  # LEB128, unsigned. `Int.shr` is arithmetic (there is no logical shift
  # on `Int`), so the shifted-in sign bits are masked off — which is what
  # lets a value with its top bit set, such as a large address, terminate.
  fn uleb(buf: IntList, value: Int) {
    let low25 = (1 << 25) - 1;
    var n = value;
    var going = true;
    while going {
      let low = n & 127;
      n = (n >> 7) & low25;
      if n == 0 {
        buf.push(low);
        going = false;
      } else {
        buf.push(low + 128);
      }
    }
  }

  # LEB128, signed: stop once the remaining bits are all copies of the
  # sign bit already emitted.
  fn sleb(buf: IntList, value: Int) {
    var n = value;
    var going = true;
    while going {
      let low = n & 127;
      n = n >> 7;
      let negative = (low & 64) != 0;
      if n == 0 {
        if negative {
          buf.push(low + 128);
        } else {
          buf.push(low);
          going = false;
        }
      } else if n == -1 {
        if negative {
          buf.push(low);
          going = false;
        } else {
          buf.push(low + 128);
        }
      } else {
        buf.push(low + 128);
      }
    }
  }

  # Decimal, for the dumps the stages are checked against.
  fn put_int(n: Int) {
    if n < 0 {
      putchar(char::hyphen);
      put_int(0 - n);
    } else if n < 10 {
      putchar((char::digit0.code() + n).char());
    } else {
      put_int(n / 10);
      putchar((char::digit0.code() + n % 10).char());
    }
  }

}
