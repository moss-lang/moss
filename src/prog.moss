import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./intern.moss" as intern;
import "./lex.moss" as lexer;
import "./syntax.moss" as syntax;

# Collect, over the real tree: load the module graph, give every
# declaration a symbol, and wire imports into module scopes.
#
# This is stage 3 of the pipeline, minus what needs types: a method call
# resolves through its receiver's type (D36), so expression-level
# resolution belongs to lowering.
#
# Everything is arenas again (D51): a symbol is an index, and a scope is
# a run of entries with a by-name index over it. The index matters —
# resolving one name per context item, against every entry in the
# program, was most of what the compiler spent its time on.

assume Std {
  # Symbol kinds.
  fn sk_type(): Int { 0 }
  fn sk_unit(): Int { 1 }
  fn sk_alias(): Int { 2 }
  fn sk_tag(): Int { 3 }
  fn sk_val(): Int { 4 }
  fn sk_fn(): Int { 5 }
  fn sk_context(): Int { 6 }
  fn sk_method(): Int { 7 }
  fn sk_functor(): Int { 8 }

  # Namespaces. A plain name, a detached method name (the `.m` namespace,
  # keyed without the dot), and a module alias.
  fn ns_name(): Int { 0 }
  fn ns_detached(): Int { 1 }
  fn ns_alias(): Int { 2 }

  # Error codes, one character each: there are no string literals (D48),
  # and a diagnostic that names the symbol and says which rule it broke
  # is most of the value of one.
  fn e_dup(): Int { 0 }        # duplicate definition
  fn e_scope(): Int { 1 }       # not in scope
  fn e_export(): Int { 2 }     # the module does not export it
  fn e_module(): Int { 3 }     # qualified through a non-module
  fn e_collide(): Int { 4 }    # D44: one name, two symbols
  fn e_recv(): Int { 5 }       # attached receiver not in scope
  fn e_syntax(): Int { 6 }
  fn e_body(): Int { 7 }       # a detached method with a body

  # Modules, in load order.
  val mpaths: StrList;
  val mroots: IntList;
  val mnroots: IntList;
  # 0 not started, 1 being loaded (so a second visit is a cycle), 2 done.
  val mstate: IntList;
  # Empty, or holding the prelude's path. Every module outside the
  # prelude's own directory glob-imports it without saying so.
  val pinfo: StrList;

  # Symbols.
  val sym_mod: IntList;
  val sym_name: IntList;
  val sym_kind: IntList;
  val sym_decl: IntList;
  val sym_recv: IntList;
  # The assume items lexically enclosing the declaration, outermost
  # first: a run of spec nodes, which is the whole of D26's implicit
  # parameterization.
  val sym_asm: IntList;
  val sym_nasm: IntList;
  # A type symbol's parameter, made on first use (`param_of`), and back:
  # what an assumed type stands for, apart from what its name means after
  # a later bind of it (D72). Sparse, so shorter than the symbol table.
  val sym_param: IntList;
  val sym_origin: IntList;

  # Scope entries: (module, namespace, name, target, exported).
  val ent_mod: IntList;
  val ent_ns: IntList;
  val ent_name: IntList;
  val ent_to: IntList;
  val ent_pub: IntList;

  # An index over those entries, keyed by name. Every lookup is by name,
  # and a name is already a dense small integer by the time it gets here
  # — the interner hands out 0, 1, 2, ... in first-seen order — so the
  # index needs no hash: `ent_head` is indexed by the name id directly
  # and holds the newest entry for it, and `ent_link` runs parallel to
  # the entries, chaining the rest. A bucket holds one entry per module
  # and namespace that binds that name, which measures at a mean of two
  # against the two thousand entries a scan used to read.
  val ent_head: IntList;
  val ent_link: IntList;

  # Attached methods, keyed by (module, receiver symbol, name).
  val att_mod: IntList;
  val att_recv: IntList;
  val att_name: IntList;
  val att_sym: IntList;

  # Diagnostics: a code, the module it was found in, and a name.
  val err_code: IntList;
  val err_mod: IntList;
  val err_name: IntList;

  # An import cycle (D10).
  fn e_cycle(): Int { 8 }

  # A path where a type belongs, or a symbol that is not a type.
  fn e_type(): Int { 9 }

  # No such method for that receiver.
  fn e_method(): Int { 10 }

  # A context that nests too deeply to be real.
  fn e_deep(): Int { 11 }

  # A bracket application on something that takes none — a val, a fn, a
  # module — or a binding whose left-hand side is not an abstract type.
  fn e_apply(): Int { 12 }

  # A type with no layout: one that contains itself, so that its run of
  # scalars would never end (there is no heap to break the cycle, D58), or
  # a bare `This`. `This` never reaches here in practice, because a
  # signature always comes from the concrete provider rather than from the
  # abstract declaration that writes it.
  fn e_shape(): Int { 13 }

  # A module the host will not open: no such file, or one outside the
  # directory it opened for this program. Without this the read traps,
  # and a mistyped import comes out as a Wasm backtrace.
  fn e_read(): Int { 14 }

  # D20: an assume item whose declared signature mentions an abstract type
  # that is neither assumed nor bound where it is assumed (`assume W.m`
  # with `.m(): T` and no `T`). Named by the type, as the bootstrap's
  # "type `T` is not available in the context here" is.
  fn e_absent(): Int { 15 }

  # D71: a bracket binding for a symbol that is not one of the applied
  # type's relevant parameters (`Stop[Int=Num]` for a unit, `W[T=Char]`
  # for a tag whose payload does not mention `T`). Named by the symbol, as
  # the bootstrap's "binds `T`, which is not one of its parameters" is.
  fn e_irrelevant(): Int { 16 }

  # D62, D71: a call (or a provider's bind) whose callee needs a val, fn or
  # method at an instantiation other than the one the provision in force
  # was made at — after a `bind T = ...`, or through a method bind's own
  # brackets. Named by the item, as the bootstrap's "calling `f` needs
  # `seed` at [T=Int], but the one in the context here was provided at
  # [T=Char]" is.
  fn e_incoherent(): Int { 16 + 1 }

  # D27, D54, D70: a method bind's provider, or an anonymous function at
  # any bind, whose signature is not the bound declaration's read where
  # the bind is made — a different parameter count, or a parameter or
  # result of another type. A plain function providing a method takes
  # the method's declared parameters, which exclude the receiver (D54).
  # Named by the bound symbol, as the bootstrap's "method bind signature
  # mismatch: provider `p` has ..." is.
  fn e_signature(): Int { 16 + 2 }

  # D73: a tag lists a parameter that is not a type its assume nesting
  # requires (named by the parameter).
  fn e_listed(): Int { 16 + 5 }

  # `this` where there is no receiver: in a plain function — a plain
  # function providing a method included, since it cannot see what the
  # method was called on (D54) — or an anonymous function bound to a fn
  # (D70). The bootstrap's "`this` is only legal inside method bodies".
  fn e_this(): Int { 16 + 3 }

  # D70: an anonymous function anywhere but the right side of a fn or
  # method bind (named by nothing), or an assignment in one to a local it
  # captured, which it holds by value (named by the local).
  fn e_lambda(): Int { 16 + 4 }

  context Prog =
    mpaths, mroots, mnroots, mstate, pinfo,
    ent_head, ent_link,
    sym_mod, sym_name, sym_kind, sym_decl, sym_recv, sym_asm, sym_nasm,
    sym_param, sym_origin,
    ent_mod, ent_ns, ent_name, ent_to, ent_pub,
    att_mod, att_recv, att_name, att_sym,
    err_code, err_mod, err_name;

  assume Prog, ast::Ast, intern::Interner {
    # A report says a code, a module and a name and nothing else (D48),
    # so the same three twice say nothing more. They do come twice: the
    # back end emits each body in two passes, and a type it elaborates
    # there — a tag's brackets at a construction — is elaborated in both.
    fn error(code: Int, m: Int, name: Int) {
      var i = 0;
      while i < err_code.length() {
        if err_code.get(i) == code {
          if err_mod.get(i) == m {
            if err_name.get(i) == name {
              return ();
            }
          }
        }
        i = i + 1;
      }
      err_code.push(code);
      err_mod.push(m);
      err_name.push(name);
    }

    fn error_count(): Int { err_code.length() }

    fn module_count(): Int { mpaths.length() }

    fn module_path(m: Int): String { mpaths.get(m) }

    fn sym_count(): Int { sym_kind.length() }

    # The abstract type an assumed type symbol `s` stands for (D72): a
    # symbol of its own, which no bind ever rebinds. A bind of `s` starts a
    # new generation of the *name*, and a type already given to something
    # must keep reading the old one, so an assumed `s` is this parameter
    # rather than `s` itself. Same name, module and declaration as `s`.
    fn param_of(s: Int): Int {
      while sym_param.length() <= s {
        sym_param.push(ast::none());
      }
      if ast::is_some(sym_param.get(s)) {
        return sym_param.get(s);
      }
      let p = add_symbol(
        sym_mod.get(s), sym_name.get(s), sym_kind.get(s), sym_decl.get(s),
        ast::none(), sym_asm.get(s), sym_nasm.get(s)
      );
      sym_param.set(s, p);
      while sym_origin.length() <= p {
        sym_origin.push(ast::none());
      }
      sym_origin.set(p, s);
      p
    }

    # The type symbol a parameter stands for, or none if `s` is not one.
    fn origin_of(s: Int): Int {
      if s >= sym_origin.length() {
        return ast::none();
      }
      sym_origin.get(s)
    }

    # Paths.

    fn str_eq(a: String, b: String): Bool {
      if a.length() != b.length() {
        return false;
      }
      var i = 0;
      while i < a.length() {
        if a.get(i) != b.get(i) {
          return false;
        }
        i = i + 1;
      }
      true
    }

    # Where the last '/' ends: `dir_of` keeps everything before it and
    # `basename` everything after.
    fn path_cut(p: String): Int {
      var cut = 0;
      var i = 0;
      while i < p.length() {
        if p.get(i) == char::slash {
          cut = i + 1;
        }
        i = i + 1;
      }
      cut
    }

    fn dir_of(p: String): String { p.slice(0, path_cut(p)) }

    fn basename(p: String): String {
      let cut = path_cut(p);
      p.slice(cut, p.length() - cut)
    }

    fn seg_dots(p: String, start: Int, len: Int, n: Int): Bool {
      if len != n {
        return false;
      }
      var i = 0;
      while i < len {
        if p.get(start + i) != char::dot {
          return false;
        }
        i = i + 1;
      }
      true
    }

    # An import path made canonical: relative to the importing file's
    # directory, with `.` dropped and `..` collapsed, so that one file
    # reached two ways is one module and not two (D56).
    fn canon(base: String, rel: String): String {
      var joined = rel;
      if rel.length() > 0 {
        if !(rel.get(0) == char::slash) {
          joined = dir_of(base).concat(rel);
        }
      }
      let starts = int_list();
      let lens = int_list();
      var top = 0;
      var i = 0;
      var from = 0;
      while i <= joined.length() {
        var cut = i == joined.length();
        if !cut {
          cut = joined.get(i) == char::slash;
        }
        if cut {
          let len = i - from;
          if len == 0 {
            ()
          } else if seg_dots(joined, from, len, 1) {
            ()
          } else if seg_dots(joined, from, len, 2) {
            var pop = top > 0;
            if pop {
              pop = !seg_dots(joined, starts.get(top - 1), lens.get(top - 1), 2);
            }
            if pop {
              top = top - 1;
            } else {
              top = push_at(starts, lens, top, from, len);
            }
          } else {
            top = push_at(starts, lens, top, from, len);
          }
          from = i + 1;
        }
        i = i + 1;
      }
      let sep = slash_of(joined);
      var out = joined.slice(0, 0);
      var j = 0;
      while j < top {
        if j > 0 {
          out = out.concat(sep);
        }
        out = out.concat(joined.slice(starts.get(j), lens.get(j)));
        j = j + 1;
      }
      out
    }

    # A one-character String holding `/`, cut out of a path that has one.
    fn slash_of(p: String): String {
      var i = 0;
      while i < p.length() {
        if p.get(i) == char::slash {
          return p.slice(i, 1);
        }
        i = i + 1;
      }
      p.slice(0, 0)
    }

    # The two lists are a stack: `set` past the end is not allowed, so a
    # push either overwrites a popped slot or extends.
    fn push_at(starts: IntList, lens: IntList, top: Int, s: Int, l: Int): Int {
      if top < starts.length() {
        starts.set(top, s);
        lens.set(top, l);
      } else {
        starts.push(s);
        lens.push(l);
      }
      top + 1
    }

    fn find_module(p: String): Int {
      var m = 0;
      while m < module_count() {
        if str_eq(mpaths.get(m), p) {
          return m;
        }
        m = m + 1;
      }
      module_count()
    }

    fn add_module(p: String): Int {
      let m = find_module(p);
      if m < module_count() {
        return m;
      }
      mpaths.push(p);
      mroots.push(0);
      mnroots.push(0);
      mstate.push(0);
      m
    }

    fn root_at(m: Int, i: Int): Int { ast::kid_at(mroots.get(m), i) }

    fn root_count(m: Int): Int { mnroots.get(m) }

    # Scope entries.

    fn lookup(m: Int, ns: Int, name: Int): Int {
      let e = find_entry(m, ns, name, false);
      if ast::is_some(e) {
        ent_to.get(e)
      } else {
        ast::none()
      }
    }

    fn export_of(m: Int, ns: Int, name: Int): Int {
      let e = find_entry(m, ns, name, true);
      if ast::is_some(e) {
        ent_to.get(e)
      } else {
        ast::none()
      }
    }

    # The entry for this key, walking only the entries that share the
    # name. There is at most one per (module, namespace, name): both
    # `define` and `bind_entry` refuse to add a second.
    fn find_entry(m: Int, ns: Int, name: Int, only_public: Bool): Int {
      if name >= ent_head.length() {
        return ast::none();
      }
      var i = ent_head.get(name);
      while ast::is_some(i) {
        if ent_mod.get(i) == m {
          if ent_ns.get(i) == ns {
            if !only_public {
              return i;
            }
            if ent_pub.get(i) == 1 {
              return i;
            }
          }
        }
        i = ent_link.get(i);
      }
      ast::none()
    }

    # One row, and its place in the by-name chain. Every insert goes
    # through here, so the index cannot drift from the entries.
    fn push_entry(m: Int, ns: Int, name: Int, to: Int, pub: Int) {
      while ent_head.length() <= name {
        ent_head.push(ast::none());
      }
      let row = ent_mod.length();
      ent_mod.push(m);
      ent_ns.push(ns);
      ent_name.push(name);
      ent_to.push(to);
      ent_pub.push(pub);
      ent_link.push(ent_head.get(name));
      ent_head.set(name, row);
    }

    # D44: one local name may not refer to two different symbols.
    fn bind_entry(m: Int, ns: Int, name: Int, to: Int, pub: Int) {
      let existing = lookup(m, ns, name);
      if ast::is_some(existing) {
        if existing != to {
          error(e_collide(), m, name);
        }
        return ();
      }
      push_entry(m, ns, name, to, pub);
    }

    # Symbols.

    fn add_symbol(m: Int, name: Int, kind: Int, decl: Int, recv: Int, asm: Int, nasm: Int): Int {
      sym_mod.push(m);
      sym_name.push(name);
      sym_kind.push(kind);
      sym_decl.push(decl);
      sym_recv.push(recv);
      sym_asm.push(asm);
      sym_nasm.push(nasm);
      sym_kind.length() - 1
    }

    fn find_attached(m: Int, recv: Int, name: Int): Int {
      var i = 0;
      while i < att_mod.length() {
        if att_mod.get(i) == m {
          if att_recv.get(i) == recv {
            if att_name.get(i) == name {
              return att_sym.get(i);
            }
          }
        }
        i = i + 1;
      }
      ast::none()
    }

    # Declaration, pass one: every plain name and detached method. An
    # attached method waits, because its receiver must be declared first.
    fn declare_decl(m: Int, d: Int, asm: Int, nasm: Int, pending: IntList) {
      let k = ast::kind_of(d);
      if k == ast::k_d_assume() {
        # The enclosing items grow by this block's, outermost first.
        let items = int_list();
        var i = 0;
        while i < nasm {
          items.push(ast::kid_at(asm, i));
          i = i + 1;
        }
        i = 0;
        while i < ast::b_of(d) {
          items.push(ast::kid_at(ast::a_of(d), i));
          i = i + 1;
        }
        let inner = ast::commit(items);
        i = 0;
        while i < ast::d_of(d) {
          declare_decl(m, ast::kid_at(ast::c_of(d), i), inner, items.length(), pending);
          i = i + 1;
        }
        return ();
      }
      if k == ast::k_d_import() {
        return ();
      }
      if k == ast::k_d_bad() {
        return ();
      }
      if k == ast::k_d_fn() {
        let recv = ast::fn_recv(d);
        if recv == ast::recv_detached() {
          if ast::is_some(ast::fn_body(d)) {
            error(e_body(), m, ast::fn_name(d));
          }
          define(m, ns_detached(), ast::fn_name(d),
            add_symbol(m, ast::fn_name(d), sk_method(), d, ast::none(), asm, nasm));
        } else if recv == ast::recv_plain() {
          define(m, ns_name(), ast::fn_name(d),
            add_symbol(m, ast::fn_name(d), sk_fn(), d, ast::none(), asm, nasm));
        } else {
          pending.push(d);
          pending.push(asm);
          pending.push(nasm);
        }
        return ();
      }
      define(m, ns_name(), ast::decl_name(d),
        add_symbol(m, ast::decl_name(d), decl_kind(k), d, ast::none(), asm, nasm));
    }

    fn decl_kind(k: Int): Int {
      if k == ast::k_d_type() {
        sk_type()
      } else if k == ast::k_d_unit() {
        sk_unit()
      } else if k == ast::k_d_alias() {
        sk_alias()
      } else if k == ast::k_d_tag() {
        sk_tag()
      } else if k == ast::k_d_val() {
        sk_val()
      } else if k == ast::k_d_context() {
        sk_context()
      } else {
        sk_functor()
      }
    }

    # A module's own declarations are exported; a duplicate is an error
    # where it is written rather than where it is used.
    fn define(m: Int, ns: Int, name: Int, sym: Int) {
      if ast::is_some(lookup(m, ns, name)) {
        error(e_dup(), m, name);
        return ();
      }
      push_entry(m, ns, name, sym, 1);
    }

    fn declare(m: Int) {
      let pending = int_list();
      var i = 0;
      while i < root_count(m) {
        declare_decl(m, root_at(m, i), 0, 0, pending);
        i = i + 1;
      }
      i = 0;
      while i < pending.length() {
        let d = pending.get(i);
        let recv_name = ast::fn_recv(d);
        let recv = lookup(m, ns_name(), recv_name);
        if !ast::is_some(recv) {
          error(e_recv(), m, recv_name);
        } else if ast::is_some(find_attached(m, recv, ast::fn_name(d))) {
          error(e_dup(), m, ast::fn_name(d));
        } else {
          att_mod.push(m);
          att_recv.push(recv);
          att_name.push(ast::fn_name(d));
          att_sym.push(add_symbol(
            m, ast::fn_name(d), sk_method(), d, recv,
            pending.get(i + 1), pending.get(i + 2)
          ));
        }
        i = i + 3;
      }
    }

    # Wire one import into scope. `glob` also covers the implicit prelude
    # import, which has no declaration of its own.
    fn link(m: Int, target: Int, alias: Int, glob: Int, uses: Int, nuses: Int) {
      if ast::is_some(alias) {
        bind_entry(m, ns_alias(), alias, target, 1);
      }
      if glob == 1 {
        var i = 0;
        while i < ent_mod.length() {
          if ent_mod.get(i) == target {
            if ent_pub.get(i) == 1 {
              # A glob does not re-export what it brings in (D9).
              bind_entry(m, ent_ns.get(i), ent_name.get(i), ent_to.get(i), 0);
            }
          }
          i = i + 1;
        }
        return ();
      }
      var i = 0;
      while i < nuses {
        let name = ast::use_name(uses, i);
        let dotted = ast::use_dot(uses, i);
        var local = ast::use_as(uses, i);
        if !ast::is_some(local) {
          local = name;
        }
        if dotted == 1 {
          let sym = export_of(target, ns_detached(), name);
          if ast::is_some(sym) {
            bind_entry(m, ns_detached(), local, sym, 1);
          } else {
            error(e_export(), m, name);
          }
        } else {
          let sym = export_of(target, ns_name(), name);
          if ast::is_some(sym) {
            bind_entry(m, ns_name(), local, sym, 1);
          } else {
            let sub = export_of(target, ns_alias(), name);
            if ast::is_some(sub) {
              bind_entry(m, ns_alias(), local, sub, 1);
            } else {
              error(e_export(), m, name);
            }
          }
        }
        i = i + 1;
      }
    }

    # Resolution. A path is a symbol, or — when every segment but the
    # last names a module — an export of that module.

    fn resolve_path(m: Int, p: Int): Int {
      var cur = lookup(m, ns_name(), ast::path_at(p, 0));
      var is_mod = false;
      if !ast::is_some(cur) {
        cur = lookup(m, ns_alias(), ast::path_at(p, 0));
        is_mod = true;
      }
      if !ast::is_some(cur) {
        return ast::none();
      }
      var i = 1;
      while i < ast::path_len(p) {
        if !is_mod {
          error(e_module(), m, ast::path_at(p, i - 1));
          return ast::none();
        }
        let name = ast::path_at(p, i);
        let next = export_of(cur, ns_name(), name);
        if ast::is_some(next) {
          cur = next;
          is_mod = false;
        } else {
          let sub = export_of(cur, ns_alias(), name);
          if !ast::is_some(sub) {
            error(e_export(), m, name);
            return ast::none();
          }
          cur = sub;
          is_mod = true;
        }
        i = i + 1;
      }
      if is_mod {
        return ast::none();
      }
      cur
    }

    # `m` in scope, or `mod::m` through an alias.
    fn resolve_detached(m: Int, p: Int): Int {
      if ast::path_len(p) == 1 {
        return lookup(m, ns_detached(), ast::path_at(p, 0));
      }
      var here = lookup(m, ns_alias(), ast::path_at(p, 0));
      var i = 1;
      while i < ast::path_len(p) - 1 {
        if !ast::is_some(here) {
          return ast::none();
        }
        here = export_of(here, ns_alias(), ast::path_at(p, i));
        i = i + 1;
      }
      if !ast::is_some(here) {
        return ast::none();
      }
      export_of(here, ns_detached(), ast::path_last(p))
    }

    fn starts_with(p: String, prefix: String): Bool {
      if p.length() < prefix.length() {
        return false;
      }
      str_eq(p.slice(0, prefix.length()), prefix)
    }

    # The standard library does not auto-import itself.
    fn wants_prelude(path: String): Bool {
      if pinfo.length() == 0 {
        false
      } else if str_eq(path, pinfo.get(0)) {
        false
      } else {
        !starts_with(path, dir_of(pinfo.get(0)))
      }
    }

    # Where an import points (D64). A path whose first segment is `.` or
    # `..` is relative to the importing file, as is an absolute one; any
    # other names a file in the standard library, which is the prelude's
    # directory. Without a prelude there is no library to look in.
    fn resolve(base: String, rel: String): String {
      if pinfo.length() == 0 {
        return canon(base, rel);
      }
      if rel.length() > 0 {
        if rel.get(0) == char::slash {
          return canon(base, rel);
        }
      }
      var len = 0;
      while len < rel.length() {
        if rel.get(len) == char::slash {
          if seg_dots(rel, 0, len, 1) {
            return canon(base, rel);
          }
          if seg_dots(rel, 0, len, 2) {
            return canon(base, rel);
          }
          return canon(pinfo.get(0), rel);
        }
        len = len + 1;
      }
      canon(pinfo.get(0), rel)
    }

    # Loading. Depth first, because a module links its imports and an
    # import's exports are only complete once it has linked its own.
    assume lexer::at, lexer::mark, syntax::Cursor {
      fn parse_module(m: Int) {
        let path = pwd.join(module_path(m));
        if !path.readable() {
          error(e_read(), m, ast::none());
          return ();
        }
        bind lexer::src=path.read();
        lexer::at.write(0);
        lexer::mark.write(0);
        let before = syntax::errs.read();
        let roots = int_list();
        syntax::parse_file(roots);
        if syntax::errs.read() > before {
          error(e_syntax(), m, ast::none());
        }
        mroots.set(m, ast::commit(roots));
        mnroots.set(m, roots.length());
      }

      fn load(m: Int) {
        if mstate.get(m) == 2 {
          return ();
        }
        if mstate.get(m) == 1 {
          error(e_cycle(), m, ast::none());
          return ();
        }
        mstate.set(m, 1);
        parse_module(m);
        declare(m);
        var prelude = ast::none();
        if wants_prelude(module_path(m)) {
          prelude = add_module(pinfo.get(0));
          load(prelude);
        }
        var i = 0;
        while i < root_count(m) {
          let d = root_at(m, i);
          if ast::kind_of(d) == ast::k_d_import() {
            load(add_module(resolve(module_path(m), ast::imp_text(d))));
          }
          i = i + 1;
        }
        if ast::is_some(prelude) {
          link(m, prelude, ast::none(), 1, 0, 0);
        }
        i = 0;
        while i < root_count(m) {
          let d = root_at(m, i);
          if ast::kind_of(d) == ast::k_d_import() {
            link(
              m, find_module(resolve(module_path(m), ast::imp_text(d))),
              ast::imp_alias(d), ast::imp_star(d),
              ast::imp_uses(d), ast::imp_nuses(d)
            );
          }
          i = i + 1;
        }
        mstate.set(m, 2);
      }

      # Load `entry` and everything it reaches. `prelude` may be the
      # empty path, in which case there is none.
      fn load_program(prelude: String, entry: String): Int {
        let root = entry.slice(0, 0);
        if prelude.length() > 0 {
          pinfo.push(canon(root, prelude));
        }
        let m = add_module(canon(root, entry));
        load(m);
        m
      }
    }
  }
}
