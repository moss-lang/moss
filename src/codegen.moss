import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./emit.moss" as emit;
import "./insn.moss" use *;
import "./intern.moss" as intern;
import "./lower.moss" as lower;
import "./prog.moss" as prog;
import "./spell.moss" use *;
import "./tcode.moss" use *;
import "./types.moss" as types;
import "./wasmops.moss" as wops;

# The back end: the primitive context, straight to Wasm.
#
# D52 says a program may assume `Wasm` and `Wasi` rather than `Std`, and
# that the compiler itself is written that way. This compiles exactly
# that language: a call to a `Wasm` item becomes the instruction it
# names, a call to a `Wasi` item becomes a call to an import the module
# declares, and everything else is an ordinary function.
#
# Bodies are emitted twice, because a Wasm function index counts the
# imports first and so cannot be handed out until every import is known.
# The first pass throws its output away and exists to find every
# specialization the program reaches; then the index spaces are fixed;
# then the second pass emits against the final numbering. Emitting is
# the only walk of a body there is, which is what stops the two passes
# from disagreeing about what one contains — an earlier design walked
# bodies separately to discover them, and the walks resolved method
# calls differently because one of them had no locals in scope. The
# same goes for a body's locals: the first pass records them as
# emission creates them, and the second lays out exactly those.

assume Std {

  # Back-end diagnostics. These historical numbers overlap prog's codes;
  # cg_err_phase distinguishes the domains when emission reports either.
  # Keep the compact protocol's numbers stable.
  fn c_no_main(): Int { 14 }
  fn c_unsupported(): Int { 15 }   # a construct outside this slice
  fn c_unbound(): Int { 16 }       # abstract, and nothing provides it
  fn c_unknown_op(): Int { 16 + 1 }  # a `Wasm` name with no instruction
  fn c_bad_type(): Int { 16 + 2 }
  # A call whose specialization the first pass never reached, so the two
  # passes disagree. A bug in this back end rather than in the program.
  fn c_missing(): Int { 16 + 3 }
  fn c_break(): Int { 16 + 4 }  # `break` outside any loop

  # Reachable *specializations*: a function under a specific set of
  # bindings, and the Wasm index each gets. A type or fn bind changes the
  # code rather than the data (D2), so two call sites that bind
  # differently get two bodies, each with its calls resolved to direct
  # ones — which is what makes a fn bind compilable without a table.
  val fq_sym: IntList;
  val fq_env: IntList;
  val fq_index: IntList;

  # The environment the frame being compiled is in, extended by every
  # `bind` it executes and restored at the end of each block.
  val cg_env: CellInt;

  # The return type of the function being compiled, so that `return e`
  # knows what to inject into.
  val cg_ret: CellInt;

  # Whether this is the pass whose output is kept. Bodies are emitted
  # twice: once to find every specialization the program reaches, which
  # is what fixes the function indices, and once against the final
  # numbering. Emitting is the only walk of a body there is, so the two
  # passes cannot disagree about what it contains.
  #
  # A third value, 2, is the check pass (D16): every function the
  # program does not reach is walked once more, in its generic
  # environment with nothing specialized, so that it is checked as the
  # bootstrap checks every function. It reports, like the kept pass, and
  # otherwise behaves like the first: its output is thrown away, it
  # creates locals as it goes, and it reaches nothing (`checking`).
  #
  # Code a reached frame contains but never runs — the arms of a `match`
  # its specialization does not get to — is walked the same way, into a
  # buffer that is thrown away (`dead`): as 2 inside the kept pass, and
  # as 3, which reports nothing, inside the first.
  val cg_real: CellInt;

  # WASI functions called anywhere, and the import index each gets.
  val wi_sym: IntList;
  val wi_index: IntList;

  # The locals of the function being compiled: interned name, elaborated
  # type, and the Wasm indices its value occupies. A value is a run of
  # scalars (D59), so a local owns a run of `lc_slots` rather than one
  # index — and which indices those are is only known once every local
  # of the function is, because the locals past the parameters are
  # grouped by valtype. The first pass finds them out; the second lays
  # them out before it emits.
  #
  # A local has two types. `lc_type` is its type as the code is written,
  # in the frame's generic terms (`cg_genv`), which is what it is checked
  # and resolved against; `lc_spec` is what that is in this
  # specialization, which is what it is laid out by. The second is
  # recorded where the first pass makes the local, since a type a `bind
  # F;` made (D78) means something only inside its block.
  val lc_name: IntList;
  val lc_type: IntList;
  val lc_spec: IntList;
  val lc_start: IntList;
  val lc_slots: IntList;
  val lc_base: CellInt;
  val lc_visible: CellInt;

  # Where each need key's value lives in the frame being compiled: the
  # local holding it. A val is the only context that exists at runtime
  # (D2), so this is the whole of the runtime environment — and it is
  # block-scoped exactly like the locals, which is what makes an inner
  # `bind` shadow an outer one to the end of its block and no further.
  val pv_recv: IntList;
  val pv_sym: IntList;
  val pv_local: IntList;
  val pv_top: CellInt;
  # D78: where the provision stack starts for the binds of a functor
  # bound to an abstract one, which see only their own inputs
  # (`restrict_to_args`); zero everywhere else.
  val pv_floor: CellInt;

  # D78: the fresh generation each application (`bind F;`, by its spec
  # node) makes of each type in an abstract functor's result; and, as a
  # stack to `es_top`, the generations live applications made in the
  # frame being compiled, as types, beside the symbols they are
  # generations of, for the escape check (`check_escape`).
  val fr_spec: IntList;
  val fr_type: IntList;
  val fr_sym: IntList;
  val es_made: IntList;
  val es_sym: IntList;
  val es_top: CellInt;

  # Reading a type through an environment, memoized: what a generic type
  # is in a specialized environment (`spec`), and `lower`'s `canon` and
  # `instantiate` through a generic one. Each is a walk of the chain per
  # abstract symbol, and a parameter has no row in the environment that
  # mentions it, so every such walk is the whole chain. A hash table on
  # (what, environment, type): `sp_head` holds the newest row of a bucket
  # plus one, and `sp_link` chains the rest.
  val sp_what: IntList;
  val sp_env: IntList;
  val sp_ty: IntList;
  val sp_res: IntList;
  val sp_link: IntList;
  val sp_head: IntList;

  # D77 rule 5: each method call's resolution, decided against the
  # receiver's generic type in the frame's generic environment and
  # recorded per call site — (node, generic environment, receiver type)
  # — so that every specialization of the frame, and both passes, call
  # what the code as written means. A row is a defined attached method
  # called directly (`rm_meth`), or the method a provision of which, at
  # the receiver, is called (`rm_sym`); neither, where nothing is in
  # scope. Bucketed on the node.
  val rm_node: IntList;
  val rm_genv: IntList;
  val rm_recv: IntList;
  val rm_meth: IntList;
  val rm_sym: IntList;
  val rm_link: IntList;
  val rm_head: IntList;

  # Open label scopes, and the depth at which each enclosing loop's exit
  # block sits, so that `break` knows how far out to branch.
  val cg_depth: CellInt;
  val cg_loops: IntList;
  val cg_ntop: CellInt;

  # The modules whose declarations are primitive rather than ordinary:
  # `Wasm` is instructions, `Wasi` is imports, `Bool` is a lang item
  # (D45) whose two units are 0 and 1, and `i32_bool` is the coercion
  # from a comparison to something `if` can take. The bootstrap back end
  # recognizes exactly the same four by the file that declares them.
  val cg_wasm: CellInt;
  val cg_wasi: CellInt;
  val cg_bool: CellInt;
  val cg_std: CellInt;

  # The elaborated `I32`, `I64`, `F32`, `F64` and `Bool` types, found
  # once: an instruction's result type has to come from somewhere, and
  # the `Wasm` table records only which scalar it is.
  val cg_i32: CellInt;
  val cg_i64: CellInt;
  val cg_f32: CellInt;
  val cg_f64: CellInt;
  val cg_boolty: CellInt;

  # D75: lib/wasm.moss's `Ref`, `Boxed` and `StructRef`, and its methods
  # `.boxed` and `Ref.deref` — a reference's valtype depends on what it
  # holds, so the back end has to know these, as it knows the scalar
  # types, by name; and the two methods are what the platform's `Heap`
  # provides, with instructions rather than a function.
  val cg_ref: CellInt;
  val cg_boxed: CellInt;
  val cg_structref: CellInt;
  val cg_box: CellInt;
  val cg_deref: CellInt;
  # D81: lib/wasm.moss's `Array`, `Arrayed` and `ArrayRef`, then the
  # methods `Mutable` and `Arrays` provide, in `platform_prim`'s order
  # from 3: `Ref.set`, `.arrayed`, and `Array`'s `length`, `get`, `set`,
  # `fill` and `copy`.
  val cg_gc: IntList;
  # Physical widths, after preserving incompatible reference union lanes.
  val cg_width: IntList;

  # D79: lib/wasm.moss's `Memory`. The memory instructions are `Addr`'s
  # methods (`cg_gc`'s last), which the platform's family `Memories`
  # provides: what the receiver's `Memory` is in the specialization says
  # which memory an instruction names.
  val cg_memory: CellInt;

  val cg_errs: IntList;
  val cg_err_name: IntList;
  # The function whose body was being emitted, recorded with each
  # diagnostic. The frame a complaint came from costs one symbol id and
  # identifies which function produced the error code.
  val cg_err_at: IntList;
  val cg_err_start: IntList;
  val cg_err_end: IntList;
  val cg_err_mod: IntList;
  val cg_err_phase: IntList;
  val cg_entry: CellInt;
  val cg_where: CellInt;

  # Memoized `val_slots`: the val keys a (sym, env) specialization takes,
  # as a run in `vs_pool`. `vs_head` is indexed by the symbol id and holds
  # the newest row plus one (zero meaning none), `vs_link` chains the rest
  # — the same index shape prog.moss uses for scopes.
  val vs_env: IntList;
  val vs_start: IntList;
  val vs_len: IntList;
  val vs_link: IntList;
  val vs_head: IntList;
  val vs_pool: IntList;

  # Captured slots (D26): a val a fn bind captured, keyed by the
  # environment entry that bind made and by the slot as its provider
  # names it — itself captured, one level per bind the provider sees. A
  # slot is a symbol id when it is at least zero and one of these rows,
  # encoded below `ast::none()`, when it is not; so a captured value can
  # never be mistaken for the val of the same name in force where it is
  # finally used. Bucketed on the entry, as `vs_head` is on the symbol.
  val ck_entry: IntList;
  val ck_inner: IntList;
  val ck_link: IntList;
  val ck_head: IntList;

  # The locals each specialization's body needs, as the first pass met
  # them: a run of types in `fl_types`, indexed by queue position. The
  # first pass creates a local the moment emission reveals it; the second
  # creates the same ones up front, so it can lay them out by valtype
  # before emitting, and then reveals them in the same order.
  val fl_start: IntList;
  val fl_len: IntList;
  val fl_types: IntList;

  # Which vals each defined function can reach (`need_used`). `un_sym`
  # holds, per function, the vals it names and the defined functions it
  # may call or bind, chained through `un_link` from `un_head` (indexed
  # by symbol, the newest row plus one). `un_mark` stamps symbols during
  # one walk over that graph, and `un_flags` keeps the answer for each
  # function's needs as a run, from `un_fstart` (indexed by symbol, the
  # start plus one). `un_meths` lists every method, defined or abstract,
  # that a method call may reach — a defined one is a body to walk, an
  # abstract one a need that call keeps — chained by name through
  # `un_mlink` from `un_mhead` (indexed by name id, the newest plus one).
  val un_sym: IntList;
  val un_link: IntList;
  val un_head: IntList;
  val un_mark: IntList;
  val un_last: IntList;
  val un_stamp: CellInt;
  val un_meths: IntList;
  val un_mlink: IntList;
  val un_mhead: IntList;
  val un_fstart: IntList;
  val un_flags: IntList;
  # One function's needs at a time, by symbol, for `callee_chain`:
  # stamped `un_ustamp` in `un_listed` where it lists one, and in
  # `un_used` where one it lists is reached; and the `un_mark` stamp of
  # what it reaches at all, for the fns it does not list (0: unknown).
  val un_used: IntList;
  val un_listed: IntList;
  val un_ustamp: CellInt;
  val un_reach: CellInt;
  # `callee_chain`'s runs, indexed by symbol (`ce_start` is the start
  # plus one).
  val ce_start: IntList;
  val ce_len: IntList;
  val ce_pool: IntList;

  # D68: the library symbols operators and literals mean, found once by
  # the module that declares them — `num.moss`'s method for each binary
  # operator at its token code, then the extra slots below `lg_base`.
  # Each is still provided through the context where it is used; this
  # only says *which* symbol, so that it is never a lookup by name.
  val cg_lang: IntList;

  # Coherence (D62, D71), checked on the program as written rather than
  # on a specialization. `cg_genv` is the frame's *generic* environment:
  # its declaration's own (`lower::env_of`), where an assumed type is
  # itself, extended by each `bind` the body makes as it is written — so
  # it says what a call means whatever the frame is specialized to, and
  # each provision row in it carries the app it was made at
  # (lower.moss). `ch_` memoizes `check_callee` on (callee's need run,
  # generic environment), indexed by the environment as `vs_` is by
  # symbol.
  val cg_genv: CellInt;
  # The generic environment at entry to this function or captured functor
  # body, before its local binds. Sparse assumed apps read this baseline.
  val cg_gbase: CellInt;
  # D84 rule 7: while a call of a family member on demand is emitted, the
  # caller's environments (`cg_aenv`, `cg_agenv`; `cg_aon` is 1 while they
  # are set). The application is a scope around the call's *provision*
  # only: its arguments are the caller's expressions, emitted in the
  # caller's terms (`emit_args`), so that a `P(F)` symbol the application
  # binds — `Item`, say — does not capture the caller's own.
  val cg_aenv: CellInt;
  val cg_agenv: CellInt;
  val cg_aon: CellInt;
  # The functor whose binds `run_functor` is running (none outside one):
  # an anonymous function bound there assumes that functor's inputs and
  # what its earlier binds made, not everything its application captured
  # (`make_lambda`).
  val cg_fbody: CellInt;
  val ch_run: IntList;
  val ch_link: IntList;
  val ch_head: IntList;

  # D70: the function synthesized for each anonymous function at a bind,
  # one per (node, generic environment) the bind runs in — its signature
  # and its captured locals' types are the frame's, as written.
  # `lm_recv` says whether it takes a receiver; its captured locals are
  # a run of (name, val symbol) pairs in `lm_cap`. `cg_capt` holds the
  # locals that are captured ones, which a body may read but not assign.
  val lm_node: IntList;
  val lm_genv: IntList;
  val lm_sym: IntList;
  val lm_recv: IntList;
  val lm_cstart: IntList;
  val lm_clen: IntList;
  val lm_cap: IntList;
  val cg_capt: IntList;

  # D78: each functor with binds that some `bind F = G;` bound to an
  # abstract one, in the order met, which the check pass checks against
  # its own argument signature, as the bootstrap's `check_functor_body`.
  val fb_sym: IntList;

  # D84 (draft): each captured environment of a binding of a bracketed
  # abstract functor — the specialized one, which the binding's row holds
  # in its `b` — beside the generic one in force with it at the bind.
  val cl_env: IntList;
  val cl_genv: IntList;
  # Whether `apply_bound` is the check made where a bracketed functor is
  # bound, which compares what the binds made with the promise.
  val cl_check: CellInt;
  # The capture `apply_bound` is to run its binds in, for the call in
  # hand (none: D78's restriction to the functor's own inputs).
  val cl_cur: CellInt;
  # The declaration environment of the frame each capture was made in,
  # beside `cl_env`, and the one in force while captured binds run (none:
  # the frame's own), which an assumed row's app is read against.
  val cl_bases: IntList;
  val cl_base: CellInt;

  # D55: each functor with binds whose totality has been checked, so it
  # is checked once however often it is applied (`check_functor_total`).
  val ft_sym: IntList;

  context Codegen =
    fq_sym, fq_env, fq_index, wi_sym, wi_index, cg_env, cg_real, cg_ret,
    lc_name, lc_type, lc_spec, lc_start, lc_slots, lc_base, lc_visible,
    pv_recv, pv_sym, pv_local, pv_top, pv_floor,
    fr_spec, fr_type, fr_sym, es_made, es_sym, es_top, cl_env, cl_genv, cl_check, cl_cur, cl_bases, cl_base,
    sp_what, sp_env, sp_ty, sp_res, sp_link, sp_head,
    rm_node, rm_genv, rm_recv, rm_meth, rm_sym, rm_link, rm_head,
    cg_depth, cg_loops, cg_ntop, cg_wasm, cg_wasi, cg_bool, cg_std,
    cg_i32, cg_i64, cg_f32, cg_f64, cg_boolty,
    cg_ref, cg_boxed, cg_structref, cg_box, cg_deref, cg_gc, cg_width, cg_memory, cg_errs, cg_err_name, cg_err_at, cg_err_start, cg_err_end, cg_err_mod, cg_err_phase, cg_entry, cg_where,
    vs_env, vs_start, vs_len, vs_link, vs_head, vs_pool,
    ck_entry, ck_inner, ck_link, ck_head,
    fl_start, fl_len, fl_types,
    un_sym, un_link, un_head, un_mark, un_last, un_stamp, un_meths, un_mlink, un_mhead,
    un_fstart, un_flags,
    un_used, un_listed, un_ustamp, un_reach, ce_start, ce_len, ce_pool,
    cg_lang, cg_genv, cg_gbase, cg_aenv, cg_agenv, cg_aon, cg_fbody, ch_run, ch_link, ch_head,
    lm_node, lm_genv, lm_sym, lm_recv, lm_cstart, lm_clen, lm_cap, cg_capt,
    fb_sym, ft_sym;

  assume Codegen, ast::Ast, intern::Interner, prog::Prog, wops::WasmOps,
    emit::Emit, types::Types, lower::Lower {
    # Only the kept pass reports: the first one runs against indices that
    # do not exist yet, so anything it says would be said twice.
    fn cg_error(code: Int, name: Int) { record_error(1, code, name); }

    # Collector codes and back-end codes overlap numerically. Keep their
    # domains explicit even when a semantic error is found during emission.
    fn semantic_error(code: Int, name: Int) { record_error(0, code, name); }

    fn record_error(phase: Int, code: Int, name: Int) {
      if cg_real.read() == 0 {
        return ();
      }
      if cg_real.read() == 3 {
        return ();
      }
      var node = prog::location.read() - 1;
      if !ast::is_some(ast::source_start(node)) {
        if ast::is_some(cg_where.read()) {
          node = prog::sym_decl.get(cg_where.read());
        }
      }
      let start = ast::source_start(node);
      let end = ast::source_end(node);
      var home = ast::source_module(node);
      if !ast::is_some(home) { home = cg_entry.read(); }
      # Checked as written, a function says the same thing in every
      # specialization that reaches it; once is enough.
      var i = 0;
      while i < cg_errs.length() {
        if cg_errs.get(i) == code {
          if cg_err_name.get(i) == name {
            if cg_err_at.get(i) == cg_where.read() {
              if cg_err_start.get(i) == start {
                if cg_err_end.get(i) == end {
                  if cg_err_mod.get(i) == home {
                    if cg_err_phase.get(i) == phase { return (); }
                  }
                }
              }
            }
          }
        }
        i = i + 1;
      }
      cg_errs.push(code);
      cg_err_name.push(name);
      cg_err_at.push(cg_where.read());
      cg_err_start.push(start);
      cg_err_end.push(end);
      cg_err_mod.push(home);
      cg_err_phase.push(phase);
    }

    fn cg_error_count(): Int { cg_errs.length() }

    # Whether this is the check pass, which has no specialization: a
    # generic type is laid out as itself (an abstract type one scalar
    # wide, as the bootstrap's back end has it), and a provision the
    # generic environment has but nothing provides here is called
    # through nothing. Only emission needs what a provision is.
    fn checking(): Bool { cg_real.read() >= 2 }

    # Enter code that nothing runs, to check it (`cg_real`); returns what
    # to restore with `alive`.
    fn dead(): Int {
      let was = cg_real.read();
      if was == 0 {
        cg_real.write(3);
      } else if was == 1 {
        cg_real.write(2);
      }
      was
    }

    fn alive(was: Int) { cg_real.write(was); }

    # Whether a row of the specialized environment names a provider.
    fn provides(row: Int): Bool {
      if !ast::is_some(row) {
        return false;
      }
      ast::is_some(lower::env_a_of(row))
    }

    fn spelled(): IntList { int_list() }

    # Which module is which. `Wasm` and `Wasi` are recognized by the file
    # that declares them, so an ordinary function that happens to be
    # called `i32_add` is still an ordinary function.
    fn name_is(s: String, cs: IntList): Bool {
      if s.length() != cs.length() {
        return false;
      }
      var i = 0;
      while i < s.length() {
        if s.get(i).code() != cs.get(i) {
          return false;
        }
        i = i + 1;
      }
      true
    }

    fn find_primitive_modules() {
      let w = spelled();
      sp_wasm_moss(w);
      let a = spelled();
      sp_wasip1_moss(a);
      let b = spelled();
      sp_bool_moss(b);
      let s = spelled();
      sp_wasistd_moss(s);
      cg_wasm.write(ast::none());
      cg_wasi.write(ast::none());
      cg_bool.write(ast::none());
      cg_std.write(ast::none());
      var m = 0;
      while m < prog::module_count() {
        let base = prog::basename(prog::module_path(m));
        if prog::library_module(m) {
        if name_is(base, w) {
          cg_wasm.write(m);
        }
        if name_is(base, a) {
          cg_wasi.write(m);
        }
        if name_is(base, b) {
          cg_bool.write(m);
        }
        if name_is(base, s) {
          cg_std.write(m);
        }
        }
        m = m + 1;
      }
      find_lang_symbols();
      cg_i32.write(wasm_type(0));
      cg_i64.write(wasm_type(1));
      cg_f32.write(wasm_type(2));
      cg_f64.write(wasm_type(3));
      cg_boolty.write(bool_type());
      find_gc_symbols();
    }

    fn wasm_symbol(cs: IntList): Int {
      if !ast::is_some(cg_wasm.read()) {
        return ast::none();
      }
      prog::lookup(cg_wasm.read(), prog::ns_name(), intern::intern_chars(cs))
    }

    fn find_gc_symbols() {
      let r = spelled();
      sp_Ref(r);
      cg_ref.write(wasm_symbol(r));
      let b = spelled();
      sp_Boxed(b);
      cg_boxed.write(wasm_symbol(b));
      let s = spelled();
      sp_StructRef(s);
      cg_structref.write(wasm_symbol(s));
      cg_box.write(ast::none());
      cg_deref.write(ast::none());
      find_array_symbols();
      let mm = spelled();
      sp_Memory(mm);
      cg_memory.write(wasm_symbol(mm));
      if !ast::is_some(cg_wasm.read()) {
        return ();
      }
      let n = spelled();
      sp_boxed(n);
      cg_box.write(prog::lookup(
        cg_wasm.read(), prog::ns_detached(), intern::intern_chars(n)
      ));
      if ast::is_some(cg_ref.read()) {
        let d = spelled();
        sp_deref(d);
        cg_deref.write(prog::find_attached(
          cg_wasm.read(), cg_ref.read(), intern::intern_chars(d)
        ));
      }
    }

    # D81's: `cg_gc` as its comment lists them, none where lib/wasm.moss
    # is not in the program.
    fn find_array_symbols() {
      let a = spelled();
      sp_Array(a);
      cg_gc.push(wasm_symbol(a));
      let t = spelled();
      sp_Arrayed(t);
      cg_gc.push(wasm_symbol(t));
      let r = spelled();
      sp_ArrayRef(r);
      cg_gc.push(wasm_symbol(r));
      let st = spelled();
      sp_set(st);
      cg_gc.push(attached_in_wasm(cg_ref.read(), st));
      var made = ast::none();
      if ast::is_some(cg_wasm.read()) {
        let n = spelled();
        sp_arrayed(n);
        made = prog::lookup(cg_wasm.read(), prog::ns_detached(), intern::intern_chars(n));
      }
      cg_gc.push(made);
      let arr = cg_gc.get(0);
      let len = spelled();
      sp_length(len);
      cg_gc.push(attached_in_wasm(arr, len));
      let g = spelled();
      sp_get(g);
      cg_gc.push(attached_in_wasm(arr, g));
      let s = spelled();
      sp_set(s);
      cg_gc.push(attached_in_wasm(arr, s));
      let f = spelled();
      sp_fill(f);
      cg_gc.push(attached_in_wasm(arr, f));
      let c = spelled();
      sp_copy(c);
      cg_gc.push(attached_in_wasm(arr, c));
      let ad = spelled();
      sp_Addr(ad);
      cg_gc.push(wasm_symbol(ad));
    }

    fn attached_in_wasm(recv: Int, name: IntList): Int {
      if !ast::is_some(cg_wasm.read()) {
        return ast::none();
      }
      if !ast::is_some(recv) {
        return ast::none();
      }
      prog::find_attached(cg_wasm.read(), recv, intern::intern_chars(name))
    }

    fn array_sym(): Int { cg_gc.get(0) }
    fn addr_sym(): Int { cg_gc.get(10) }

    # `platform_prim`'s answer for `Addr`'s methods, the memory
    # instructions (D79), each the instruction of its own name.
    fn mem_prim(): Int { 100 }
    fn arrayed_sym(): Int { cg_gc.get(1) }
    fn arrayref_sym(): Int { cg_gc.get(2) }

    # Which of the platform's primitives a provision's provider is: 1 for
    # `.boxed`, 2 for `Ref.deref`, 3 for `Ref.set`, 4 for `.arrayed`, 5
    # to 9 for `Array`'s `length`, `get`, `set`, `fill` and `copy` (D81),
    # `mem_prim()` for a method of `Addr` (D79), 0 for anything else. `bind Heap;`
    # makes a provision whose provider is the method itself, which has no
    # body, and a call through it is the instructions (D75).
    fn platform_prim(provider: Int): Int {
      if !ast::is_some(provider) {
        return 0;
      }
      if prog::sym_mod.get(provider) != cg_wasm.read() {
        return 0;
      }
      if provider == cg_box.read() {
        return 1;
      }
      if provider == cg_deref.read() {
        return 2;
      }
      var k = 3;
      while k < 10 {
        if provider == cg_gc.get(k) {
          return k;
        }
        k = k + 1;
      }
      if ast::is_some(addr_sym()) {
        if prog::sym_recv.get(provider) == addr_sym() {
          return mem_prim();
        }
      }
      0
    }

    # D75. Whether a type is a `Ref`, what one holds, and the struct type
    # of what it holds: one per type, registered before its fields are
    # computed, since they may be references to it. The first pass finds
    # every one; the second only looks them up, since a function type's
    # index counts them.
    #
    # A `Ref` is a GC reference only where its payload is the platform's
    # `StructRef` (D78): a scope that binds `StructRef` — to an arena's
    # `I32` address, say — and provides `.boxed` and `.deref` itself makes
    # it a tag over that, like any other. So `ty` is a specialized type.
    fn is_ref_type(ty: Int): Bool {
      if !ast::is_some(cg_ref.read()) {
        return false;
      }
      if !types::is_kind(ty, types::kd_nominal()) {
        return false;
      }
      if types::sym_of(ty) != cg_ref.read() {
        return false;
      }
      wide_scalar(types::payload_of(ty)) == emit::vt_structref()
    }

    fn held_of(ref_ty: Int): Int { held_by(ref_ty, cg_ref.read(), cg_boxed.read()) }

    fn held_by(ref_ty: Int, head: Int, param: Int): Int {
      let reqs = int_list();
      types::reqs_of(head, reqs);
      var i = 0;
      while i < reqs.length() {
        if reqs.get(i) == param {
          return types::member_at(ref_ty, i);
        }
        i = i + 1;
      }
      ty_none()
    }

    # D81: whether a type is an `Array`, and what one holds.
    fn is_array_type(ty: Int): Bool {
      if !ast::is_some(array_sym()) {
        return false;
      }
      if !types::is_kind(ty, types::kd_nominal()) {
        return false;
      }
      if types::sym_of(ty) != array_sym() {
        return false;
      }
      wide_scalar(types::payload_of(ty)) == emit::vt_eqref()
    }

    fn array_held(ty: Int): Int { held_by(ty, array_sym(), arrayed_sym()) }

    # Whether a type a reference would hold is one this specialization
    # does not know: `Boxed` itself, unbound.
    fn unknown_held(held: Int): Bool {
      if !types::is_kind(held, types::kd_abstract()) {
        return false;
      }
      let sym = types::sym_of(held);
      if sym == cg_boxed.read() {
        return true;
      }
      if sym == prog::param_of(cg_boxed.read()) {
        return true;
      }
      if !ast::is_some(arrayed_sym()) {
        return false;
      }
      if sym == arrayed_sym() {
        return true;
      }
      sym == prog::param_of(arrayed_sym())
    }

    fn struct_of(held: Int): Int {
      let found = emit::find_struct(held);
      if found >= 0 {
        return found;
      }
      # The check pass writes no module, so it adds nothing to this one.
      if checking() {
        return 0;
      }
      if cg_real.read() == 1 {
        cg_error(c_missing(), ast::none());
      }
      let j = emit::add_struct(held);
      let fields = int_list();
      var i = 0;
      while i < width(held) {
        fields.push(valtype_at(held, i));
        i = i + 1;
      }
      emit::set_struct_fields(j, fields);
      j
    }

    fn ref_valtype(held: Int): Int { emit::vt_ref(struct_of(held)) }

    # D81: the type of an `Array[Arrayed=held]` — an array of its one
    # scalar, or an immutable struct of one array per scalar, the "lanes",
    # each an array of its valtype shared by every element type with one —
    # reserved before its lanes are computed, as a struct is. Keyed apart
    # from the structs: a handle by -2 - 2·held, a lane by -3 - 2·valtype.
    fn array_of(held: Int): Int {
      let key = -2 - held - held;
      let found = emit::find_struct(key);
      if found >= 0 {
        return found;
      }
      if checking() {
        return 0;
      }
      if cg_real.read() == 1 {
        cg_error(c_missing(), ast::none());
      }
      let j = emit::add_struct(key);
      let fields = int_list();
      let w = width(held);
      if w == 0 {
        # Nothing to store: a value of `()` has no scalar to lay out.
        cg_error(c_unsupported(), ast::none());
        fields.push(emit::vt_i32());
        emit::make_array(j);
      } else if w == 1 {
        fields.push(valtype_at(held, 0));
        emit::make_array(j);
      } else {
        var i = 0;
        while i < w {
          fields.push(emit::vt_ref(lane_of(valtype_at(held, i))));
          i = i + 1;
        }
      }
      emit::set_struct_fields(j, fields);
      j
    }

    fn lane_of(vt: Int): Int {
      let key = -3 - vt - vt;
      let found = emit::find_struct(key);
      if found >= 0 {
        return found;
      }
      if checking() {
        return 0;
      }
      if cg_real.read() == 1 {
        cg_error(c_missing(), ast::none());
      }
      let j = emit::add_struct(key);
      emit::make_array(j);
      let fields = int_list();
      fields.push(vt);
      emit::set_struct_fields(j, fields);
      j
    }

    # A zero of a valtype: what pads a narrower member of a union, which
    # for a reference slot is `ref.null`.
    fn push_zero(body: IntList, vt: Int) {
      if emit::is_ref(vt) {
        op_ref_null(body, vt);
      } else if vt == emit::vt_i64() {
        body.push(66);
        body.push(0);
      } else if vt == emit::vt_f32() {
        body.push(67);
        var i = 0;
        while i < 4 {
          body.push(0);
          i = i + 1;
        }
      } else if vt == emit::vt_f64() {
        body.push(68);
        var i = 0;
        while i < 8 {
          body.push(0);
          i = i + 1;
        }
      } else {
        op_i32_const(body, 0);
      }
    }

    # D68's fixed symbols. Past every token code, the slots that are not
    # a binary operator's: the unary methods, then the literals' `zero`,
    # `one` and `float`.
    fn lg_base(): Int { 64 }
    fn lg_neg(): Int { lg_base() }
    fn lg_not(): Int { lg_base() + 1 }
    fn lg_zero(): Int { lg_base() + 2 }
    fn lg_one(): Int { lg_base() + 3 }
    fn lg_float(): Int { lg_base() + 4 }

    fn lang(slot: Int): Int { cg_lang.get(slot) }

    fn find_module_named(cs: IntList): Int {
      var found = ast::none();
      var m = 0;
      while m < prog::module_count() {
        if prog::library_module(m) {
          if name_is(prog::basename(prog::module_path(m)), cs) {
            found = m;
          }
        }
        m = m + 1;
      }
      found
    }

    fn lang_set(slot: Int, m: Int, ns: Int, cs: IntList) {
      if ast::is_some(m) {
        cg_lang.set(slot, prog::lookup(m, ns, intern::intern_chars(cs)));
      }
    }

    fn find_lang_symbols() {
      while cg_lang.length() < ast::op_get() + 1 {
        cg_lang.push(ast::none());
      }
      let a = spelled();
      sp_num_moss(a);
      let num = find_module_named(a);
      let d = prog::ns_detached();
      let c1 = spelled();
      sp_neg(c1);
      lang_set(lg_neg(), num, d, c1);
      let c2 = spelled();
      sp_not(c2);
      lang_set(lg_not(), num, d, c2);
      let c3 = spelled();
      sp_mul(c3);
      lang_set(tk_star(), num, d, c3);
      let c4 = spelled();
      sp_div(c4);
      lang_set(tk_slash(), num, d, c4);
      let c5 = spelled();
      sp_rem(c5);
      lang_set(tk_percent(), num, d, c5);
      let c6 = spelled();
      sp_add(c6);
      lang_set(tk_plus(), num, d, c6);
      let c7 = spelled();
      sp_sub(c7);
      lang_set(tk_hyphen(), num, d, c7);
      let c8 = spelled();
      sp_shl(c8);
      lang_set(tk_less_less(), num, d, c8);
      let c9 = spelled();
      sp_shr(c9);
      lang_set(tk_greater_greater(), num, d, c9);
      let c10 = spelled();
      sp_eq(c10);
      lang_set(tk_equal_equal(), num, d, c10);
      let c11 = spelled();
      sp_ne(c11);
      lang_set(tk_exclam_equal(), num, d, c11);
      let c12 = spelled();
      sp_lt(c12);
      lang_set(tk_less(), num, d, c12);
      let c13 = spelled();
      sp_gt(c13);
      lang_set(tk_greater(), num, d, c13);
      let c14 = spelled();
      sp_le(c14);
      lang_set(tk_less_equal(), num, d, c14);
      let c15 = spelled();
      sp_ge(c15);
      lang_set(tk_greater_equal(), num, d, c15);
      let c16 = spelled();
      sp_and(c16);
      lang_set(tk_ampersand(), num, d, c16);
      let c17 = spelled();
      sp_xor(c17);
      lang_set(tk_caret(), num, d, c17);
      let c18 = spelled();
      sp_or(c18);
      lang_set(tk_pipe(), num, d, c18);
      let b = spelled();
      sp_int_moss(b);
      let int = find_module_named(b);
      let c19 = spelled();
      sp_zero(c19);
      lang_set(lg_zero(), int, prog::ns_name(), c19);
      let c20 = spelled();
      sp_one(c20);
      lang_set(lg_one(), int, prog::ns_name(), c20);
      let f = spelled();
      sp_float_moss(f);
      let c21 = spelled();
      sp_float(c21);
      lang_set(lg_float(), find_module_named(f), prog::ns_name(), c21);
      # `for` (draft): access.moss's iteration methods, and `.get`.
      let acc = spelled();
      sp_access_moss(acc);
      let access = find_module_named(acc);
      let c22 = spelled();
      sp_begin(c22);
      lang_set(ast::op_begin(), access, d, c22);
      let c23 = spelled();
      sp_more(c23);
      lang_set(ast::op_more(), access, d, c23);
      let c24 = spelled();
      sp_after(c24);
      lang_set(ast::op_after(), access, d, c24);
      let c25 = spelled();
      sp_get(c25);
      lang_set(ast::op_get(), access, d, c25);
    }

    # The method an operator node means.
    fn op_symbol(e: Int): Int {
      let op = ast::a_of(e);
      if ast::kind_of(e) == ast::k_ex_unary() {
        if op == tk_hyphen() {
          return lang(lg_neg());
        }
        if op == ast::op_begin() {
          return lang(op);
        }
        return lang(lg_not());
      }
      lang(op)
    }

    # The scalar types are declarations of lib/wasm.moss like any other,
    # so they are found by name in its scope rather than invented. `k`
    # numbers them as `emit::vt_at` does: I32, I64, F32, F64.
    fn spell_scalar(cs: IntList, k: Int) {
      if k == 0 {
        sp_I32(cs);
      } else if k == 1 {
        sp_I64(cs);
      } else if k == 2 {
        sp_F32(cs);
      } else {
        sp_F64(cs);
      }
    }

    fn wasm_type(which: Int): Int {
      let cs = spelled();
      spell_scalar(cs, which);
      let sym = prog::lookup(
        cg_wasm.read(), prog::ns_name(), intern::intern_chars(cs)
      );
      if !ast::is_some(sym) {
        return types::ty_never();
      }
      types::ty_of_decl(sym)
    }

    # `Bool` likewise, and its two units get discriminants 0 and 1 before
    # anything else asks for a code (D45).
    fn bool_type(): Int {
      let b = spelled();
      sp_Bool(b);
      let f = spelled();
      sp_False(f);
      let t = spelled();
      sp_True(t);
      let fsym = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(f));
      let tsym = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(t));
      if ast::is_some(fsym) {
        if ast::is_some(tsym) {
          types::seed_bool(fsym, tsym);
        }
      }
      let sym = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(b));
      if !ast::is_some(sym) {
        return types::ty_never();
      }
      types::ty_of_decl(sym)
    }

    # Runtime declarations are checked before reachability. A selected custom
    # library must obey the machine representation its primitives implement.
    fn runtime_scalar(t: Int, k: Int, env: Int): Bool {
      if k == 0 { return t == types::ty_unit(); }
      if k == 5 { return t == lower::canon(env, cg_boolty.read()); }
      t == lower::canon(env, wasm_type(k - 1))
    }

    fn runtime_args(sym: Int, args: Int, result: Int, env: Int): Bool {
      let d = prog::sym_decl.get(sym);
      let m = prog::sym_mod.get(sym);
      var i = 0;
      var schema = args;
      while schema > 0 {
        if i >= ast::fn_nparams(d) { return false; }
        let t = sig_ty(env, ast::b_of(ast::kid_at(ast::fn_params(d), i)), m, types::ty_never());
        if !runtime_scalar(t, schema % 8, env) { return false; }
        schema = schema / 8;
        i = i + 1;
      }
      if i != ast::fn_nparams(d) { return false; }
      runtime_scalar(sig_ty(env, ast::fn_ret(d), m, types::ty_never()), result, env)
    }

    # Check the actual entry view against the fixed machine representation.
    fn runtime_entry_scalar(t: Int, k: Int, sym: Int): Bool {
      if k == 0 { return t == types::ty_unit(); }
      if k == 5 { return t == lower::canon(lower::env_of(sym), cg_boolty.read()); }
      t == lower::canon(lower::env_of(sym), wasm_type(k - 1))
    }

    fn runtime_entry_args(sym: Int, args: Int, result: Int, env: Int): Bool {
      let row = lower::env_find(env, lower::ek_fn(), ast::none(), sym);
      if !ast::is_some(row) { return false; }
      let view = lower::env_a_of(row);
      let d = prog::sym_decl.get(sym);
      let m = prog::sym_mod.get(sym);
      var i = 0;
      var schema = args;
      while schema > 0 {
        if i >= ast::fn_nparams(d) { return false; }
        let t = lower::canon(env, sig_ty(view, ast::b_of(ast::kid_at(ast::fn_params(d), i)), m, types::ty_never()));
        if !runtime_entry_scalar(t, schema % 8, sym) { return false; }
        schema = schema / 8;
        i = i + 1;
      }
      if i != ast::fn_nparams(d) { return false; }
      runtime_entry_scalar(lower::canon(env, sig_ty(view, ast::fn_ret(d), m, types::ty_never())), result, sym)
    }

    fn runtime_machine_symbol(sym: Int): Bool {
      if (sym == cg_structref.read()) | (sym == arrayref_sym()) { return true; }
      let declared = types::ty_of_decl(sym);
      var k = 0;
      while k < 4 {
        if declared == wasm_type(k) { return true; }
        k = k + 1;
      }
      false
    }

    fn runtime_entry_view(sym: Int, env: Int) {
      if in_wasi(sym) { runtime_wasi(sym, env, true); }
      if is_i32_bool(sym) {
        if !runtime_entry_args(sym, 1, 5, env) { runtime_shape_error(sym); }
      }
      if !in_wasm(sym) { return (); }
      if prog::sym_kind.get(sym) == prog::sk_functor() {
        let row = lower::env_find(env, lower::ek_fn(), ast::none(), sym);
        if !ast::is_some(row) { runtime_shape_error(sym); return (); }
        let fixed = int_list();
        lower::functor_fixed(sym, fixed);
        var j = 0;
        while j < fixed.length() {
          let t = fixed.get(j);
          if runtime_machine_symbol(t) {
            let have = lower::app_get(lower::env_b_of(row), t, env);
            if !ast::is_some(have) { runtime_shape_error(sym); return (); }
            let actual = lower::canon(env, have);
            if (actual != types::ty_of_decl(t)) & (actual != lower::as_assumed(t)) {
              runtime_shape_error(sym);
            }
          }
          j = j + 1;
        }
        return ();
      }
      let op = wops::find_op(prog::sym_name.get(sym));
      if !ast::is_some(op) { return (); }
      if prog::sym_kind.get(sym) == prog::sk_val() {
        if (wops::op_kinds.get(op) == wops::wk_const0()) | (wops::op_kinds.get(op) == wops::wk_const1()) {
          let row = lower::env_find(env, lower::ek_val(), ast::none(), sym);
          if !ast::is_some(row) { runtime_shape_error(sym); return (); }
          if !runtime_entry_scalar(lower::canon(env, lower::env_a_of(row)), 1, sym) { runtime_shape_error(sym); }
        }
      } else if prog::sym_kind.get(sym) == prog::sk_fn() {
        if (wops::op_codes.get(op) == 0) & (wops::op_kinds.get(op) == wops::wk_simple()) {
          return ();
        }
        if !runtime_entry_args(sym, wops::op_args.get(op), wops::op_res.get(op), env) { runtime_shape_error(sym); }
      }
    }

    fn runtime_shape_error(sym: Int) { cg_error(c_bad_type(), prog::sym_name.get(sym)); }

    fn runtime_abstracts() {
      let seen = int_list();
      {
        let n = spelled(); sp_I32(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_I64(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_F32(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_F64(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_StructRef(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_ArrayRef(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_Memory(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_Boxed(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
      {
        let n = spelled(); sp_Arrayed(n);
        let sym = wasm_symbol(n);
        if ast::is_some(sym) {
          if prog::sym_kind.get(sym) != prog::sk_type() { runtime_shape_error(sym); }
          var i = 0;
          while i < seen.length() {
            if seen.get(i) == sym { runtime_shape_error(sym); }
            i = i + 1;
          }
          seen.push(sym);
        }
      }
    }

    fn runtime_tag(sym: Int, param: Int, handle: Int) {
      if !ast::is_some(sym) { return (); }
      if !ast::is_some(param) { runtime_shape_error(sym); return (); }
      if !ast::is_some(handle) { runtime_shape_error(sym); return (); }
      if prog::sym_kind.get(sym) != prog::sk_tag() { runtime_shape_error(sym); return (); }
      let rs = int_list(); types::reqs_of(sym, rs);
      if rs.length() == 0 { runtime_shape_error(sym); return (); }
      if rs.get(0) != param { runtime_shape_error(sym); return (); }
      if types::payload_of(types::ty_of_decl(sym)) != types::ty_of_decl(handle) {
        runtime_shape_error(sym);
      }
    }

    fn runtime_bool() {
      if !ast::is_some(cg_bool.read()) { return (); }
      let b = spelled(); sp_Bool(b);
      let sym = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(b));
      if !ast::is_some(sym) { return (); }
      let f = spelled(); sp_False(f);
      let t = spelled(); sp_True(t);
      let fs = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(f));
      let ts = prog::lookup(cg_bool.read(), prog::ns_name(), intern::intern_chars(t));
      if !ast::is_some(fs) { runtime_shape_error(sym); return (); }
      if !ast::is_some(ts) { runtime_shape_error(sym); return (); }
      if prog::sym_kind.get(sym) != prog::sk_tag() { runtime_shape_error(sym); return (); }
      if prog::sym_kind.get(fs) != prog::sk_unit() { runtime_shape_error(sym); return (); }
      if prog::sym_kind.get(ts) != prog::sk_unit() { runtime_shape_error(sym); return (); }
      if fs == ts { runtime_shape_error(sym); return (); }
      let rs = int_list(); types::reqs_of(sym, rs);
      if rs.length() != 0 { runtime_shape_error(sym); return (); }
      let pay = types::payload_of(types::ty_of_decl(sym));
      if !types::is_kind(pay, types::kd_union()) { runtime_shape_error(sym); return (); }
      if types::member_count(pay) != 2 { runtime_shape_error(sym); return (); }
      let a = types::member_at(pay, 0); let z = types::member_at(pay, 1);
      let ft = types::ty_of_decl(fs); let tt = types::ty_of_decl(ts);
      if a == ft { if z == tt { return (); } }
      if a == tt { if z == ft { return (); } }
      runtime_shape_error(sym);
    }

    fn check_runtime_library() {
      runtime_abstracts(); runtime_bool();
      runtime_tag(cg_ref.read(), cg_boxed.read(), cg_structref.read());
      runtime_tag(array_sym(), arrayed_sym(), arrayref_sym());
      let i = spelled(); sp_I32(i);
      runtime_tag(addr_sym(), cg_memory.read(), wasm_symbol(i));
      # Every abstract selected-platform functor is lowered to primitive
      # bindings by the oracle, even when no application is reached.
      var fu = 0;
      while fu < prog::sym_count() {
        if in_wasm(fu) {
          if prog::sym_kind.get(fu) == prog::sk_functor() { runtime_functor(fu); }
        }
        fu = fu + 1;
      }
    }

    fn runtime_fn_type(sym: Int, i: Int, this_ty: Int): Int {
      let d = prog::sym_decl.get(sym);
      var t = ast::fn_ret(d);
      if ast::is_some(i) { t = ast::b_of(ast::kid_at(ast::fn_params(d), i)); }
      sig_ty(lower::env_of(sym), t, prog::sym_mod.get(sym), this_ty)
    }

    fn runtime_ref(t: Int, arr: Bool, content: Int): Bool {
      var head = cg_ref.read(); var param = cg_boxed.read();
      if arr { head = array_sym(); param = arrayed_sym(); }
      if !types::is_kind(t, types::kd_nominal()) { return false; }
      if types::sym_of(t) != head { return false; }
      held_by(t, head, param) == content
    }

    fn runtime_gc_method(sym: Int): Bool {
      let prim = platform_prim(sym);
      if prim == 0 { return true; }
      let env = lower::env_of(sym);
      var head = prog::sym_recv.get(sym);
      if prim == 1 { head = cg_boxed.read(); }
      if prim == 4 { head = arrayed_sym(); }
      if !ast::is_some(head) { return false; }
      let recv = lower::canon(env, types::ty_of_decl(head));
      let rt = runtime_fn_type(sym, ast::none(), recv);
      let n = ast::fn_nparams(prog::sym_decl.get(sym));
      if prim == 1 { return (n == 0) & runtime_ref(rt, false, recv); }
      if prim == 2 { return (n == 0) & runtime_ref(recv, false, rt); }
      if prim == 3 {
        if n != 1 { return false; }
        return runtime_ref(recv, false, runtime_fn_type(sym, 0, recv)) & (rt == types::ty_unit());
      }
      if prim == 4 {
        if n != 1 { return false; }
        return runtime_scalar(runtime_fn_type(sym, 0, recv), 1, env) & runtime_ref(rt, true, recv);
      }
      if prim == 5 { return (n == 0) & runtime_scalar(rt, 1, env); }
      if prim == 6 {
        if n != 1 { return false; }
        return runtime_scalar(runtime_fn_type(sym, 0, recv), 1, env) & runtime_ref(recv, true, rt);
      }
      if prim == 7 {
        if n != 2 { return false; }
        return runtime_scalar(runtime_fn_type(sym, 0, recv), 1, env) & runtime_ref(recv, true, runtime_fn_type(sym, 1, recv)) & (rt == types::ty_unit());
      }
      if prim == 8 {
        if n != 3 { return false; }
        return runtime_scalar(runtime_fn_type(sym, 0, recv), 1, env) & runtime_ref(recv, true, runtime_fn_type(sym, 1, recv)) & runtime_scalar(runtime_fn_type(sym, 2, recv), 1, env) & (rt == types::ty_unit());
      }
      if prim == 9 {
        if n != 4 { return false; }
        return runtime_scalar(runtime_fn_type(sym, 0, recv), 1, env) & runtime_ref(runtime_fn_type(sym, 1, recv), true, array_held(recv)) & runtime_scalar(runtime_fn_type(sym, 2, recv), 1, env) & runtime_scalar(runtime_fn_type(sym, 3, recv), 1, env) & (rt == types::ty_unit());
      }
      # Memory methods have a nominal Addr receiver, whose payload is I32.
      let op = wops::find_op(prog::sym_name.get(sym));
      if !ast::is_some(op) { return true; }
      var args = wops::op_args.get(op);
      if wops::op_kinds.get(op) != wops::wk_memzero() { args = args / 8; }
      var i = 0;
      while args > 0 {
        if i >= n { return false; }
        let t = runtime_fn_type(sym, i, recv);
        var ok = runtime_scalar(t, args % 8, env);
        if wops::op_kinds.get(op) == wops::wk_memcopy() {
          if i == 0 { ok = t == recv; }
        }
        if !ok { return false; }
        args = args / 8; i = i + 1;
      }
      (i == n) & runtime_scalar(rt, wops::op_res.get(op), env)
    }

    fn runtime_functor(sym: Int) {
      let d = prog::sym_decl.get(sym);
      if ast::is_some(ast::fu_binds(d)) { return (); }
      let home = prog::sym_mod.get(sym);
      var i = 0;
      while i < ast::fu_nres(d) {
        let spec = ast::kid_at(ast::fu_res(d), i);
        let recv = prog::resolve_path(home, ast::a_of(spec));
        if ast::is_some(recv) {
          if ast::is_some(ast::b_of(spec)) {
            let method = lower::find_method_decl(home, recv, ast::b_of(spec));
            if ast::is_some(method) { runtime_primitive(method); }
          }
        }
        i = i + 1;
      }
    }

    fn runtime_named(sym: Int, name: IntList, args: Int, result: Int, env: Int, entry: Bool) {
      if sym_named(sym, name) {
        if entry {
          if !runtime_entry_args(sym, args, result, env) { runtime_shape_error(sym); }
        } else {
          if !runtime_args(sym, args, result, env) { runtime_shape_error(sym); }
        }
      }
    }

    fn runtime_wasi(sym: Int, env: Int, entry: Bool) {
      { let n = spelled();
        push_char(n, char::f);
        push_char(n, char::d);
        push_char(n, char::underscore);
        push_char(n, char::w);
        push_char(n, char::r);
        push_char(n, char::i);
        push_char(n, char::t);
        push_char(n, char::e);
        runtime_named(sym, n, 585, 1, env, entry);
      }
      { let n = spelled();
        push_char(n, char::f);
        push_char(n, char::d);
        push_char(n, char::underscore);
        push_char(n, char::r);
        push_char(n, char::e);
        push_char(n, char::a);
        push_char(n, char::d);
        runtime_named(sym, n, 585, 1, env, entry);
      }
      { let n = spelled();
        push_char(n, char::p);
        push_char(n, char::r);
        push_char(n, char::o);
        push_char(n, char::c);
        push_char(n, char::underscore);
        push_char(n, char::e);
        push_char(n, char::x);
        push_char(n, char::i);
        push_char(n, char::t);
        runtime_named(sym, n, 1, 0, env, entry);
      }
      { let n = spelled();
        push_char(n, char::a);
        push_char(n, char::r);
        push_char(n, char::g);
        push_char(n, char::s);
        push_char(n, char::underscore);
        push_char(n, char::s);
        push_char(n, char::i);
        push_char(n, char::z);
        push_char(n, char::e);
        push_char(n, char::s);
        push_char(n, char::underscore);
        push_char(n, char::g);
        push_char(n, char::e);
        push_char(n, char::t);
        runtime_named(sym, n, 9, 1, env, entry);
      }
      { let n = spelled();
        push_char(n, char::a);
        push_char(n, char::r);
        push_char(n, char::g);
        push_char(n, char::s);
        push_char(n, char::underscore);
        push_char(n, char::g);
        push_char(n, char::e);
        push_char(n, char::t);
        runtime_named(sym, n, 9, 1, env, entry);
      }
      { let n = spelled();
        push_char(n, char::f);
        push_char(n, char::d);
        push_char(n, char::underscore);
        push_char(n, char::c);
        push_char(n, char::l);
        push_char(n, char::o);
        push_char(n, char::s);
        push_char(n, char::e);
        runtime_named(sym, n, 1, 1, env, entry);
      }
      { let n = spelled();
        push_char(n, char::p);
        push_char(n, char::a);
        push_char(n, char::t);
        push_char(n, char::h);
        push_char(n, char::underscore);
        push_char(n, char::o);
        push_char(n, char::p);
        push_char(n, char::e);
        push_char(n, char::n);
        runtime_named(sym, n, 19468873, 1, env, entry);
      }
    }

    fn runtime_primitive(sym: Int) {
        let kind = prog::sym_kind.get(sym);
        if !runtime_gc_method(sym) { runtime_shape_error(sym); }
        if in_wasi(sym) { runtime_wasi(sym, lower::env_of(sym), false); }
        if is_i32_bool(sym) {
          if !runtime_args(sym, 1, 5, lower::env_of(sym)) { runtime_shape_error(sym); }
        }
        if in_wasm(sym) {
          let op = wops::find_op(prog::sym_name.get(sym));
          if ast::is_some(op) {
            let d = prog::sym_decl.get(sym);
            if kind == prog::sk_val() {
              if (wops::op_kinds.get(op) == wops::wk_const0()) | (wops::op_kinds.get(op) == wops::wk_const1()) {
                let ty = lower::canon(lower::env_of(sym), types::elab(ast::b_of(d), prog::sym_mod.get(sym)));
                if ast::is_some(ast::c_of(d)) | !runtime_scalar(ty, 1, lower::env_of(sym)) { runtime_shape_error(sym); }
              }
            } else if kind == prog::sk_fn() {
              if (wops::op_codes.get(op) == 0) & (wops::op_kinds.get(op) == wops::wk_simple()) {
                if ast::fn_nparams(d) != 0 { runtime_shape_error(sym); }
              } else if !runtime_args(sym, wops::op_args.get(op), wops::op_res.get(op), lower::env_of(sym)) {
                runtime_shape_error(sym);
              }
            }
          }
        }
    }

    fn in_bool(sym: Int): Bool {
      prog::sym_mod.get(sym) == cg_bool.read()
    }

    # `i32_bool`, the one item of lib/wasistd.moss the back end provides
    # itself: `Bool` is 0 or 1 with its tag erased, so it is `n != 0`.
    fn is_i32_bool(sym: Int): Bool {
      if prog::sym_mod.get(sym) != cg_std.read() {
        return false;
      }
      let cs = spelled();
      sp_i32_bool(cs);
      intern::chars_eq(prog::sym_name.get(sym), cs)
    }

    fn sym_named(sym: Int, cs: IntList): Bool {
      intern::chars_eq(prog::sym_name.get(sym), cs)
    }

    fn in_wasm(sym: Int): Bool {
      prog::sym_mod.get(sym) == cg_wasm.read()
    }

    fn in_wasi(sym: Int): Bool {
      prog::sym_mod.get(sym) == cg_wasi.read()
    }

    fn is_defined_fn(sym: Int): Bool {
      if prog::sym_kind.get(sym) != prog::sk_fn() {
        false
      } else {
        ast::is_some(ast::fn_body(prog::sym_decl.get(sym)))
      }
    }

    # An attached method with a body. Its receiver is nominal (Q5), and
    # it is the only kind of provider that can see what it was called on
    # (D54) — which is why `this` is a parameter like any other.
    fn is_defined_method(sym: Int): Bool {
      if prog::sym_kind.get(sym) != prog::sk_method() {
        return false;
      }
      if !ast::is_some(prog::sym_recv.get(sym)) {
        return false;
      }
      ast::is_some(ast::fn_body(prog::sym_decl.get(sym)))
    }

    fn is_compilable(sym: Int): Bool {
      if is_defined_fn(sym) {
        true
      } else {
        is_defined_method(sym)
      }
    }

    # `this`'s type, for a method: its receiver declaration, read in `env`.
    fn this_type_in(env: Int, sym: Int): Int {
      lower::canon(env, types::ty_of_decl(prog::sym_recv.get(sym)))
    }

    # `this` is the first local of a method's frame, so it needs no name.
    fn this_local(): Int { lc_base.read() }

    # Whether a provider takes the receiver of the method it provides:
    # an attached method does, as `this`. A plain function does not — it
    # takes the method's declared parameters, which exclude the receiver,
    # and cannot see what the method was called on (D54).
    fn takes_receiver(provider: Int): Bool {
      if is_defined_method(provider) {
        return true;
      }
      let i = lambda_row(provider);
      if ast::is_some(i) {
        return lm_recv.get(i) == 1;
      }
      false
    }

    # The row of the anonymous function `sym` is, or none.
    fn is_lambda(sym: Int): Bool { ast::is_some(lambda_row(sym)) }

    fn lambda_row(sym: Int): Int {
      var i = 0;
      while i < lm_sym.length() {
        if lm_sym.get(i) == sym {
          return i;
        }
        i = i + 1;
      }
      ast::none()
    }

    # Whether the frame being compiled has a receiver for `this` to name,
    # reporting `e_this` where it does not.
    fn has_this(m: Int): Bool {
      if takes_receiver(cg_where.read()) {
        return true;
      }
      prog::error(prog::e_this(), m, ast::none());
      false
    }

    # Provisions.

    fn provide(recv: Int, sym: Int, l: Int) {
      if pv_top.read() < pv_recv.length() {
        pv_recv.set(pv_top.read(), recv);
        pv_sym.set(pv_top.read(), sym);
        pv_local.set(pv_top.read(), l);
      } else {
        pv_recv.push(recv);
        pv_sym.push(sym);
        pv_local.push(l);
      }
      pv_top.write(pv_top.read() + 1);
    }

    # The innermost provision for this key, so a rebind wins.
    fn provision_of(recv: Int, sym: Int): Int {
      var i = pv_top.read();
      while i > pv_floor.read() {
        i = i - 1;
        if pv_sym.get(i) == sym {
          if pv_recv.get(i) == recv {
            return pv_local.get(i);
          }
        }
      }
      ast::none()
    }

    # Which of a function's needs travel as parameters. A val does,
    # because it is a runtime value; a fn or a method compiles at its use
    # site, and `Wasm`'s two vals — `i32_zero` and `i32_one` — are
    # instructions rather than data.
    fn passed_need(recv: Int, sym: Int): Bool {
      if ast::is_some(recv) {
        return false;
      }
      if prog::sym_kind.get(sym) != prog::sk_val() {
        return false;
      }
      !in_wasm(sym)
    }

    # A val need's type: its declared type, read in `env`. A captured slot
    # has the type of the val it finally names, read where that val was
    # needed — in the environment of the provider whose bind captured it,
    # one capture at a time — and not in `env`: a frame that only passes a
    # capture on may know nothing of the types its declaration mentions
    # (`Holder[Item]`, with `Item` bound beside the bind), and would lay
    # it out as a scalar per abstract type.
    fn need_type_in(env: Int, slot: Int): Int {
      var e = env;
      var s = slot;
      while is_captured(s) {
        let row = ck_row(s);
        e = lower::env_b_of(ck_entry.get(row));
        s = ck_inner.get(row);
      }
      lower::elab(e, ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s))
    }

    # A val a frame takes as a parameter, as the frame's code sees it: the
    # type its provision in the generic environment was made at. A slot
    # the frame only passes on is never read here, and keeps `sty`.
    fn need_gtype(slot: Int, sty: Int): Int {
      if is_captured(slot) {
        return sty;
      }
      let row = lower::env_find(cg_genv.read(), lower::ek_val(), ast::none(), slot);
      if !ast::is_some(row) {
        return sty;
      }
      if !ast::is_some(lower::env_a_of(row)) {
        return sty;
      }
      lower::env_a_of(row)
    }

    fn contains(xs: IntList, v: Int): Bool {
      var i = 0;
      while i < xs.length() {
        if xs.get(i) == v {
          return true;
        }
        i = i + 1;
      }
      false
    }

    # The memo row for this key, or none. Bucketed on the symbol, which
    # is a dense id, so a hit is a chain of the environments that one
    # symbol has been asked about — two of them, on this compiler.
    fn vs_lookup(sym: Int, env: Int): Int {
      if sym >= vs_head.length() {
        return ast::none();
      }
      var r = vs_head.get(sym);
      while r > 0 {
        let row = r - 1;
        if vs_env.get(row) == env {
          return row;
        }
        r = vs_link.get(row);
      }
      ast::none()
    }

    # One row, and its place in the by-symbol chain. Every insert goes
    # through here, so the index cannot drift from the rows.
    fn vs_store(sym: Int, env: Int, start: Int, len: Int): Int {
      while vs_head.length() <= sym {
        vs_head.push(0);
      }
      vs_env.push(env);
      vs_start.push(start);
      vs_len.push(len);
      vs_link.push(vs_head.get(sym));
      vs_head.set(sym, vs_env.length());
      vs_env.length() - 1
    }

    # Append unless it is already there. What the walk produces is a list
    # of first occurrences, and appending a child's whole run this way
    # gives the same list the one shared `out` used to: both are
    # first-occurrence order over the same depth-first sequence, which is
    # what makes memoizing every frame — not just the outermost — sound.
    fn vs_append(out: IntList, v: Int) {
      if !contains(out, v) {
        out.push(v);
      }
    }

    # The slot for a value captured by the bind that made `entry`.
    fn ck_slot(entry: Int, inner: Int): Int {
      if entry < ck_head.length() {
        var r = ck_head.get(entry);
        while r > 0 {
          let row = r - 1;
          if ck_inner.get(row) == inner {
            return -(row + 2);
          }
          r = ck_link.get(row);
        }
      }
      while ck_head.length() <= entry {
        ck_head.push(0);
      }
      ck_entry.push(entry);
      ck_inner.push(inner);
      ck_link.push(ck_head.get(entry));
      ck_head.set(entry, ck_entry.length());
      -(ck_entry.length() + 1)
    }

    fn is_captured(slot: Int): Bool { slot < ast::none() }

    fn ck_row(slot: Int): Int { -slot - 2 }

    # The val a slot finally names, under however many captures.
    fn slot_sym(slot: Int): Int {
      var s = slot;
      while is_captured(s) {
        s = ck_inner.get(ck_row(s));
      }
      s
    }

    # The memo row for this key, computing it if it is not there yet. The
    # answer is a pure function of (sym, env): a requirement list is fixed
    # before the back end runs and an environment is hash-consed to an id,
    # so two calls with one key cannot disagree. Recomputing it per call
    # site was this compiler's running time — 21,684 walks over 68 million
    # requirements for 755 distinct keys.
    fn vs_row(sym: Int, env: Int, depth: Int): Int {
      let hit = vs_lookup(sym, env);
      if ast::is_some(hit) {
        return hit;
      }
      let tmp = int_list();
      val_slots_walk(tmp, sym, env, depth);
      let start = vs_pool.length();
      var i = 0;
      while i < tmp.length() {
        vs_pool.push(tmp.get(i));
        i = i + 1;
      }
      vs_store(sym, env, start, tmp.length())
    }

    # The walk itself: what one (sym, env) contributes. Its own passed
    # needs, plus — for every fn need bound to a provider — whatever that
    # provider needs in turn. A bound provider runs in a frame that never
    # mentions its values, which may be several below the bind, so they
    # are threaded down; as captured slots, because they are the values
    # in force at the bind (D26), whatever has been rebound since.
    fn val_slots_walk(out: IntList, sym: Int, env: Int, depth: Int) {
      if depth > 32 {
        semantic_error(prog::e_deep(), prog::sym_name.get(sym));
        return ();
      }
      var i = 0;
      while i < lower::needs_count(sym) {
        let r = lower::need_recv_at(sym, i);
        let ns = lower::need_sym_at(sym, i);
        if passed_need(r, ns) {
          if need_used(sym, i) {
            vs_append(out, ns);
          }
        } else {
          let e = lower::env_find(env, lower::ek_fn(), r, ns);
          var walk = ast::is_some(e);
          if walk {
            if prog::sym_kind.get(ns) == prog::sk_functor() {
              # D84 6: a functor binding's entry carries the vals it
              # captured, as a fn provider's does.
              walk = false;
              let slots = int_list();
              functor_slots(e, slots, depth + 1);
              var j = 0;
              while j < slots.length() {
                vs_append(out, ck_slot(e, slots.get(j)));
                j = j + 1;
              }
            }
          }
          if walk {
            if ast::is_some(lower::env_a_of(e)) {
              let row = vs_row(
                lower::env_a_of(e), lower::env_b_of(e), depth + 1
              );
              var j = 0;
              while j < vs_len.get(row) {
                vs_append(out, ck_slot(e, vs_pool.get(vs_start.get(row) + j)));
                j = j + 1;
              }
            }
          }
        }
        i = i + 1;
      }
    }

    # Which needs a function reaches. A requirement list comes from the
    # assume nesting alone, so everything inside `assume Std` needs every
    # `Std` val — a hundred-odd character constants among them — and a
    # function also takes, for each fn need bound to a provider, whatever
    # that provider takes. Passing all of that ran functions past Wasm's
    # thousand parameters. So a val need travels only if the function can
    # reach it: name it, or call or bind a defined function that does.
    # This over-approximates (a method call may reach every defined
    # method of its name; a name that a local shadows still counts),
    # which is safe, since both ends of a call ask `val_slots`.

    fn uses_init() {
      while un_head.length() < prog::sym_count() {
        un_head.push(0);
        un_mark.push(0);
        un_last.push(0);
        un_fstart.push(0);
      }
      var f = 0;
      while f < prog::sym_count() {
        if prog::sym_kind.get(f) == prog::sk_method() {
          let name = prog::sym_name.get(f);
          while un_mhead.length() <= name {
            un_mhead.push(0);
          }
          un_meths.push(f);
          un_mlink.push(un_mhead.get(name));
          un_mhead.set(name, un_meths.length());
        }
        f = f + 1;
      }
      # D84 rule 7: a call by a family member's name may apply the family
      # on demand, so it reaches the family as `bind F;` would.
      f = 0;
      while f < prog::sym_count() {
        if is_family(f) {
          let d = prog::sym_decl.get(f);
          let mods = int_list();
          let specs = int_list();
          family_leaves(prog::sym_mod.get(f), ast::fu_res(d), ast::fu_nres(d), mods, specs, 0);
          var i = 0;
          while i < specs.length() {
            let name = ast::b_of(specs.get(i));
            while un_mhead.length() <= name {
              un_mhead.push(0);
            }
            un_meths.push(f);
            un_mlink.push(un_mhead.get(name));
            un_mhead.set(name, un_meths.length());
            i = i + 1;
          }
        }
        f = f + 1;
      }
      f = 0;
      while f < prog::sym_count() {
        if is_compilable(f) {
          uw_node(f, ast::fn_body(prog::sym_decl.get(f)), prog::sym_mod.get(f));
        }
        f = f + 1;
      }
      # D84 rule 7: a function's method need may be met by applying a
      # family on demand where it is called (`demand_needs`), so needing
      # a member reaches the families that produce one of its name.
      f = 0;
      while f < prog::sym_count() {
        if is_compilable(f) {
          if lower::is_lowered(f) {
            var i = 0;
            while i < lower::needs_count(f) {
              if ast::is_some(lower::need_recv_at(f, i)) {
                uw_families(f, prog::sym_name.get(lower::need_sym_at(f, i)));
              }
              i = i + 1;
            }
          }
        }
        f = f + 1;
      }
    }

    # The families among what a call by `name` may reach (`uw_meths`).
    fn uw_families(f: Int, name: Int) {
      if name >= un_mhead.length() {
        return ();
      }
      var r = un_mhead.get(name);
      while r > 0 {
        if is_family(un_meths.get(r - 1)) {
          uw_row(f, un_meths.get(r - 1));
        }
        r = un_mlink.get(r - 1);
      }
    }

    fn uw_row(f: Int, s: Int) {
      if un_last.get(s) == f + 1 {
        return ();
      }
      un_last.set(s, f + 1);
      un_sym.push(s);
      un_link.push(un_head.get(f));
      un_head.set(f, un_sym.length());
    }

    # A symbol a body names: a val it reads, or a function it may run —
    # an abstract one included, so that whether a fn need is reached is
    # known too (`fn_need_used`).
    fn uw_sym(f: Int, s: Int) {
      if !ast::is_some(s) {
        return ();
      }
      if prog::sym_kind.get(s) == prog::sk_val() {
        uw_row(f, s);
      } else if prog::sym_kind.get(s) == prog::sk_fn() {
        uw_row(f, s);
      } else if is_compilable(s) {
        uw_row(f, s);
      }
    }

    fn uw_run(f: Int, run: Int, n: Int, m: Int) {
      var i = 0;
      while i < n {
        uw_node(f, ast::kid_at(run, i), m);
        i = i + 1;
      }
    }

    fn uw_node(f: Int, e: Int, m: Int) {
      if !ast::is_some(e) {
        return ();
      }
      let k = ast::kind_of(e);
      if k == ast::k_ex_path() {
        uw_sym(f, prog::resolve_path(m, ast::a_of(e)));
      } else if k == ast::k_ex_call() {
        uw_sym(f, prog::resolve_path(m, ast::a_of(ast::a_of(e))));
        uw_run(f, ast::b_of(e), ast::c_of(e), m);
      } else if k == ast::k_ex_field() {
        uw_node(f, ast::a_of(e), m);
      } else if k == ast::k_ex_method() {
        uw_node(f, ast::a_of(e), m);
        uw_run(f, ast::c_of(e), ast::d_of(e), m);
        uw_meths(f, ast::path_last(ast::b_of(e)));
      } else if k == ast::k_ex_unary() {
        uw_node(f, ast::b_of(e), m);
        uw_lang_meths(f, op_symbol(e));
      } else if k == ast::k_ex_binary() {
        uw_node(f, ast::b_of(e), m);
        uw_run(f, ast::c_of(e), 1, m);
        uw_lang_meths(f, op_symbol(e));
      } else if k == ast::k_ex_lit() {
        # D68: a literal reads `zero` and `one` and calls `.add`, `.mul`
        # and, for a decimal one (an exponent makes one), `float` and
        # `.div`.
        uw_sym(f, lang(lg_zero()));
        uw_sym(f, lang(lg_one()));
        uw_lang_meths(f, lang(tk_plus()));
        uw_lang_meths(f, lang(tk_star()));
        if ast::is_some(ast::c_of(e)) {
          uw_sym(f, lang(lg_float()));
          uw_lang_meths(f, lang(tk_slash()));
        }
      } else if k == ast::k_ex_record() {
        var i = 0;
        while i < ast::c_of(e) {
          let field = ast::kid_at(ast::b_of(e), i);
          if ast::is_some(ast::b_of(field)) {
            uw_node(f, ast::b_of(field), m);
          } else {
            # `{ x }` reads `x`.
            uw_sym(f, prog::lookup(m, prog::ns_name(), ast::a_of(field)));
          }
          i = i + 1;
        }
      } else if k == ast::k_ex_if() {
        uw_node(f, ast::a_of(e), m);
        uw_node(f, ast::b_of(e), m);
        uw_node(f, ast::c_of(e), m);
      } else if k == ast::k_ex_match() {
        uw_node(f, ast::a_of(e), m);
        var i = 0;
        while i < ast::c_of(e) {
          uw_node(f, ast::b_of(ast::kid_at(ast::b_of(e), i)), m);
          i = i + 1;
        }
      } else if k == ast::k_ex_return() {
        uw_node(f, ast::a_of(e), m);
      } else if k == ast::k_ex_block() {
        uw_run(f, ast::a_of(e), ast::b_of(e), m);
        uw_node(f, ast::c_of(e), m);
      } else if k == ast::k_st_let() {
        uw_node(f, ast::c_of(e), m);
      } else if k == ast::k_st_var() {
        uw_node(f, ast::c_of(e), m);
      } else if k == ast::k_st_assign() {
        uw_node(f, ast::b_of(e), m);
      } else if k == ast::k_st_expr() {
        uw_node(f, ast::a_of(e), m);
      } else if k == ast::k_st_while() {
        uw_node(f, ast::a_of(e), m);
        uw_node(f, ast::b_of(e), m);
      } else if k == ast::k_st_loop() {
        uw_node(f, ast::a_of(e), m);
      } else if k == ast::k_st_bind() {
        uw_binds(f, ast::a_of(e), ast::b_of(e), m, 0);
      } else if k == ast::k_ex_lambda() {
        # D70: what it reaches, it reaches from the bind's frame, which
        # captures it there.
        uw_node(f, ast::d_of(e), m);
      }
    }

    # Every method a call of this name may reach: a defined one, whose
    # body it may run, and an abstract one, a need it may call (which is
    # how `fn_need_used` knows a method need is reached).
    fn uw_meths(f: Int, name: Int) {
      if name >= un_mhead.length() {
        return ();
      }
      var r = un_mhead.get(name);
      while r > 0 {
        uw_row(f, un_meths.get(r - 1));
        r = un_mlink.get(r - 1);
      }
    }

    fn uw_lang_meths(f: Int, sym: Int) {
      if ast::is_some(sym) {
        uw_meths(f, prog::sym_name.get(sym));
      }
    }

    # A bind evaluates a val's value here, and captures a provider's
    # needs here (D26); applying a functor does both for its binds,
    # written in its own module.
    fn uw_binds(f: Int, run: Int, n: Int, m: Int, depth: Int) {
      if depth > 8 {
        return ();
      }
      var i = 0;
      while i < n {
        let item = ast::kid_at(run, i);
        let value = ast::b_of(item);
        if ast::is_some(value) {
          uw_node(f, value, m);
          uw_provider(f, value, m);
          uw_functor_bind(ast::a_of(item), value, m, depth);
        } else {
          let spec = ast::a_of(item);
          if ast::is_some(ast::a_of(spec)) {
            let fu = prog::resolve_path(m, ast::a_of(spec));
            if ast::is_some(fu) {
              if prog::sym_kind.get(fu) == prog::sk_functor() {
                let d = prog::sym_decl.get(fu);
                if !ast::is_some(ast::fu_binds(d)) {
                  # D78: applying an abstract functor reaches whatever
                  # it can be bound to (`uw_functor_bind`).
                  uw_row(f, fu);
                }
                var j = 0;
                while j < ast::fu_nbinds(d) {
                  let stmt = ast::kid_at(ast::fu_binds(d), j);
                  uw_binds(
                    f, ast::a_of(stmt), ast::b_of(stmt), prog::sym_mod.get(fu),
                    depth + 1
                  );
                  j = j + 1;
                }
              }
            }
          }
        }
        i = i + 1;
      }
    }

    # D78: `bind F = G;` — an application of `F` reaches what `G`'s binds
    # reach, whichever frame applies it, so the rows hang off the two
    # functors rather than off the frame: `F` reaches `G`, and `G` (walked
    # once) reaches what its binds name.
    fn uw_functor_bind(spec: Int, value: Int, m: Int, depth: Int) {
      if ast::is_some(ast::b_of(spec)) {
        return ();
      }
      if !ast::is_some(ast::a_of(spec)) {
        return ();
      }
      if ast::kind_of(value) != ast::k_ex_path() {
        return ();
      }
      let fu = prog::resolve_path(m, ast::a_of(spec));
      let g = prog::resolve_path(m, ast::a_of(value));
      if !ast::is_some(fu) {
        return ();
      }
      if !ast::is_some(g) {
        return ();
      }
      if prog::sym_kind.get(fu) != prog::sk_functor() {
        return ();
      }
      if prog::sym_kind.get(g) != prog::sk_functor() {
        return ();
      }
      uw_row(fu, g);
      let d = prog::sym_decl.get(g);
      if ast::is_some(ast::fu_binds(d)) {
        if un_head.get(g) == 0 {
          # Marked first, so a functor whose binds bind it again stops.
          uw_row(g, g);
          var j = 0;
          while j < ast::fu_nbinds(d) {
            let stmt = ast::kid_at(ast::fu_binds(d), j);
            uw_binds(g, ast::a_of(stmt), ast::b_of(stmt), prog::sym_mod.get(g), depth + 1);
            j = j + 1;
          }
        }
      }
    }

    # `bind Int.add = Num.add;`: an attached provider, written as a field.
    fn uw_provider(f: Int, value: Int, m: Int) {
      if ast::kind_of(value) != ast::k_ex_field() {
        return ();
      }
      let obj = ast::a_of(value);
      if ast::kind_of(obj) != ast::k_ex_path() {
        return ();
      }
      let recv = prog::resolve_path(m, ast::a_of(obj));
      if ast::is_some(recv) {
        uw_sym(f, prog::find_attached(prog::sym_mod.get(recv), recv, ast::b_of(value)));
      }
    }

    # Stamps, in `un_mark`, every symbol `f` can reach — itself, what its
    # body names, and what those reach in turn — and returns the stamp.
    fn uw_reach(f: Int): Int {
      let stamp = un_stamp.read() + 1;
      un_stamp.write(stamp);
      let todo = int_list();
      todo.push(f);
      un_mark.set(f, stamp);
      var t = 0;
      while t < todo.length() {
        var r = un_head.get(todo.get(t));
        while r > 0 {
          let s = un_sym.get(r - 1);
          if un_mark.get(s) != stamp {
            un_mark.set(s, stamp);
            if prog::sym_kind.get(s) != prog::sk_val() {
              todo.push(s);
            }
          }
          r = un_link.get(r - 1);
        }
        t = t + 1;
      }
      stamp
    }

    # Whether `f`'s `i`th need is a val it can reach. Answered for all of
    # `f`'s needs at once, by one walk from `f`, and kept.
    fn need_used(f: Int, i: Int): Bool {
      # A symbol made after the walk, if any: assume it reaches all.
      if f >= un_fstart.length() {
        return true;
      }
      if un_fstart.get(f) == 0 {
        let stamp = uw_reach(f);
        un_fstart.set(f, un_flags.length() + 1);
        var j = 0;
        while j < lower::needs_count(f) {
          if un_mark.get(lower::need_sym_at(f, j)) == stamp {
            un_flags.push(1);
          } else {
            un_flags.push(0);
          }
          j = j + 1;
        }
      }
      un_flags.get(un_fstart.get(f) - 1 + i) == 1
    }

    # The val keys a specialization takes as parameters, in the order the
    # signature declares them — which is the calling convention, so the
    # order is not free to change.
    fn val_slots(out: IntList, sym: Int, env: Int, depth: Int) {
      let row = vs_row(sym, env, depth);
      var i = 0;
      while i < vs_len.get(row) {
        out.push(vs_pool.get(vs_start.get(row) + i));
        i = i + 1;
      }
    }

    # D74: an attached method is at its receiver's instantiation. Whatever
    # the receiver's type binds — its arguments, one per requirement of
    # its declaration — the callee reads as bound so, whatever this frame
    # has bound since; everything else it needs comes from this frame. So
    # both environments gain those bindings, for as long as the caller
    # reads the callee through them (it restores both): the generic one
    # at the receiver's generic arguments, the specialized one at what
    # they are here.
    fn receiver_view(grecv: Int) {
      if types::kind_of(grecv) != types::kd_nominal() {
        return ();
      }
      if types::member_count(grecv) == 0 {
        return ();
      }
      let reqs = int_list();
      types::reqs_of(types::sym_of(grecv), reqs);
      var view = cg_env.read();
      var gview = cg_genv.read();
      var i = 0;
      while i < reqs.length() {
        let a = types::member_at(grecv, i);
        view = lower::env_push(view, lower::ek_type(), ast::none(), reqs.get(i), spec(a), ast::none());
        gview = lower::env_push(gview, lower::ek_type(), ast::none(), reqs.get(i), a, ast::none());
        i = i + 1;
      }
      cg_env.write(view);
      cg_genv.write(gview);
    }

    # Which of its fn needs `f` can reach: call it, bind it onward, or
    # call something that does — a method by name, whatever its receiver.
    # Stamps `f`'s needs by symbol, in `un_listed` and, where reached, in
    # `un_used`, and returns the stamp `fn_need_used` reads them by.
    fn fn_needs_used(f: Int): Int {
      let stamp = un_ustamp.read() + 1;
      un_ustamp.write(stamp);
      while un_used.length() < prog::sym_count() {
        un_used.push(0);
        un_listed.push(0);
      }
      var j = 0;
      while j < lower::needs_count(f) {
        let sym = lower::need_sym_at(f, j);
        un_listed.set(sym, stamp);
        if need_used(f, j) {
          un_used.set(sym, stamp);
        }
        j = j + 1;
      }
      # Its environment may hold a fn it does not list — an anonymous
      # function in a functor's binds lists only that functor's items
      # (`make_lambda`), though made where everything is in force. Such
      # an entry is kept only if `f` can reach the symbol at all: one kept
      # though unreachable would carry its provider's captures into the
      # specialization's key, and a provision that shadows it on a
      # recursive path would make a new key at every depth
      # (`rebind_recursive`). The walk comes last, as `need_used`'s
      # overwrite `un_mark`.
      if f < un_fstart.length() {
        un_reach.write(uw_reach(f));
      } else {
        un_reach.write(0);
      }
      stamp
    }

    # Whether the function `fn_needs_used` last stamped can reach its fn
    # need `sym`. A symbol it does not list among its needs is kept if it
    # can reach the symbol at all, and if that is not known — a function
    # made after the walk — kept, to be safe.
    fn fn_need_used(stamp: Int, sym: Int): Bool {
      if un_used.get(sym) == stamp {
        true
      } else if un_listed.get(sym) == stamp {
        false
      } else if un_reach.read() == 0 {
        true
      } else if sym >= un_mark.length() {
        true
      } else {
        un_mark.get(sym) == un_reach.read()
      }
    }

    # The entries of a callee's base environment that `callee_env` takes
    # from the caller, outermost first: its type entries, unless it is an
    # anonymous function, and the fn needs it can reach. That depends on
    # the callee alone, and every call site asks, so it is worked out
    # once; returns the run's start in `ce_pool`, its length in `ce_len`.
    fn callee_chain(callee: Int): Int {
      while ce_start.length() < prog::sym_count() {
        ce_start.push(0);
        ce_len.push(0);
      }
      if ce_start.get(callee) > 0 {
        return ce_start.get(callee) - 1;
      }
      let lambda = is_lambda(callee);
      let used = fn_needs_used(callee);
      let chain = int_list();
      var e = lower::env_of(callee);
      while ast::is_some(e) {
        chain.push(e);
        e = lower::env_next_of(e);
      }
      let start = ce_pool.length();
      var i = chain.length();
      while i > 0 {
        i = i - 1;
        let entry = chain.get(i);
        let kind = lower::env_kind_of(entry);
        if kind == lower::ek_type() {
          if !lambda {
            ce_pool.push(entry);
          }
        } else if kind == lower::ek_fn() {
          if fn_need_used(used, lower::env_sym_of(entry)) {
            ce_pool.push(entry);
          }
        }
      }
      ce_start.set(callee, start + 1);
      ce_len.set(callee, ce_pool.length() - start);
      start
    }

    # The environment a callee is compiled in: its own bindings, taken
    # from this frame. Built by walking the callee's base environment
    # outermost first, so that the same bindings always give the same
    # chain — which is what lets it key the specialization cache. A fn or
    # method the callee never reaches is left out (`callee_chain`), so
    # that bindings it cannot observe do not make a specialization of
    # their own, nor pass it what their providers capture — every
    # provider bound above it, each capturing what the ones before it
    # did, which grows with the number of them. And a function that
    # rebinds such a fn on its own recursive path would otherwise demand
    # one per depth. Each fn entry made for the callee goes into `map`
    # beside the entry of this frame it came from, which is how its
    # captured slots are found here.
    #
    # A provision is found here under the key this frame's code means by
    # the callee's need — its receiver read through the generic
    # environment (`need_key_recv`) — and stored under the callee's own,
    # which is the key the callee's code will look it up by. So two needs
    # the callee tells apart stay apart, though this specialization may
    # make them one type. A declared callee's types are given one by one;
    # an anonymous function, made in this frame, is in this frame's terms,
    # and takes every type this specialization has.
    fn callee_env(callee: Int, map: IntList): Int {
      let senv = cg_env.read();
      let genv = cg_genv.read();
      let lambda = is_lambda(callee);
      let start = callee_chain(callee);
      var out = lower::env_empty();
      if lambda {
        out = types_of(senv);
      }
      var i = 0;
      while i < ce_len.get(callee) {
        let entry = ce_pool.get(start + i);
        i = i + 1;
        let kind = lower::env_kind_of(entry);
        let recv = lower::env_recv_of(entry);
        let sym = lower::env_sym_of(entry);
        if kind == lower::ek_type() {
          if !lambda {
            let here = lower::env_find(senv, lower::ek_type(), recv, sym);
            if ast::is_some(here) {
              out = lower::env_push(
                out, lower::ek_type(), recv, sym, lower::env_a_of(here), ast::none()
              );
              # An assumed type's parameter is what the callee was given
              # for it, which a bind inside the callee leaves alone (D72).
              if lower::env_a_of(entry) == lower::as_assumed(sym) {
                out = lower::env_push(
                  out, lower::ek_type(), recv, prog::param_of(sym),
                  lower::env_a_of(here), ast::none()
                );
              }
            }
          }
        } else if kind == lower::ek_fn() {
          let here = lower::env_find(
            senv, lower::ek_fn(), need_key_recv(callee, genv, recv), sym
          );
          var keep = ast::is_some(here);
          if keep {
            keep = ast::is_some(lower::env_a_of(here));
          }
          if keep {
            out = lower::env_push(
              out, lower::ek_fn(), recv, sym,
              lower::env_a_of(here), lower::env_b_of(here)
            );
            map.push(out);
            map.push(here);
          }
        }
      }
      out
    }

    # Types.

    fn ty_none(): Int { types::ty_unit() }

    # Two environments describe a frame. The *generic* one (`cg_genv`) is
    # the code as written: its declaration's own, where an assumed type is
    # its parameter (D72), extended by each bind the body makes. Every type
    # the frame gives a value — a local's, an expression's — is in its
    # terms, and every type check and every method resolution is made
    # against it, so that each comes out the same in every specialization,
    # as the bootstrap's do, made while it lowers a function once. The
    # *specialized* one (`cg_env`) is what this specialization supplies: a
    # type row for each symbol the generic types mention, saying what it
    # is here, and a provider for each provision, under the provision's
    # generic key. So specializing a generic type is substituting through
    # it (`spec`), and is needed only for layout; and two generations, or
    # two provisions, that this specialization makes one type are still
    # two.

    # A type elaborated in module `m` and read in the generic environment:
    # a type bind is what makes a declared symbol mean something here.
    fn elab_ty(t: Int, m: Int): Int {
      canon_in(cg_genv.read(), types::elab(t, m))
    }

    # What a generic type is in this specialization.
    fn spec(t: Int): Int {
      if !ast::is_some(t) {
        return t;
      }
      let env = cg_env.read();
      let hit = memo_find(0, env, t);
      if ast::is_some(hit) {
        return sp_res.get(hit);
      }
      memo_keep(0, env, t, unparam(lower::canon(env, t)))
    }

    # `lower::canon` and `lower::instantiate`, memoized.
    fn canon_in(env: Int, t: Int): Int {
      if !ast::is_some(t) {
        return t;
      }
      let hit = memo_find(1, env, t);
      if ast::is_some(hit) {
        return sp_res.get(hit);
      }
      memo_keep(1, env, t, lower::canon(env, t))
    }

    fn instantiate_in(env: Int, t: Int): Int {
      let hit = memo_find(2, env, t);
      if ast::is_some(hit) {
        return sp_res.get(hit);
      }
      memo_keep(2, env, t, lower::instantiate(env, t))
    }

    fn memo_buckets(): Int { 1 << 16 }

    fn memo_bucket(what: Int, env: Int, t: Int): Int {
      let h = (t * 31 + env * 7 + what) % memo_buckets();
      if h < 0 {
        h + memo_buckets()
      } else {
        h
      }
    }

    fn memo_find(what: Int, env: Int, t: Int): Int {
      if sp_head.length() == 0 {
        return ast::none();
      }
      var r = sp_head.get(memo_bucket(what, env, t));
      while r > 0 {
        let row = r - 1;
        if sp_ty.get(row) == t {
          if sp_env.get(row) == env {
            if sp_what.get(row) == what {
              return row;
            }
          }
        }
        r = sp_link.get(row);
      }
      ast::none()
    }

    fn memo_keep(what: Int, env: Int, t: Int, out: Int): Int {
      while sp_head.length() < memo_buckets() {
        sp_head.push(0);
      }
      let b = memo_bucket(what, env, t);
      sp_what.push(what);
      sp_env.push(env);
      sp_ty.push(t);
      sp_res.push(out);
      sp_link.push(sp_head.get(b));
      sp_head.set(b, sp_what.length());
      out
    }

    # A parameter this specialization was given nothing for — a platform
    # type nothing binds, as `StructRef` is in `main` — is its symbol
    # unbound, which is what the specialized environment, reading a
    # declaration's types through their symbols, calls it too.
    fn unparam(t: Int): Int {
      let ps = int_list();
      lower::params_in(t, ps);
      if ps.length() == 0 {
        return t;
      }
      let from = int_list();
      let to = int_list();
      var i = 0;
      while i < ps.length() {
        let o = prog::origin_of(ps.get(i));
        if !ast::is_some(prog::origin_of(o)) {
          from.push(ps.get(i));
          to.push(types::ty_of_symbol(types::kd_abstract(), o));
        }
        i = i + 1;
      }
      if from.length() == 0 {
        return t;
      }
      types::subst(t, from, to)
    }

    # How many scalars a value of a generic type is here.
    fn width(ty: Int): Int {
      let t = spec(ty);
      let base = types::width(t);
      if checking() { return base; }
      while cg_width.length() <= t { cg_width.push(0); }
      if cg_width.get(t) > 0 { return cg_width.get(t) - 1; }
      if cg_width.get(t) < 0 { return base; }
      cg_width.set(t, -1);
      let w = physical_width(t, base);
      cg_width.set(t, w + 1);
      w
    }

    fn physical_width(ty: Int, base: Int): Int {
      if is_ref_type(ty) { return 1; }
      if is_array_type(ty) { return 1; }
      if types::is_kind(ty, types::kd_nominal()) {
        if types::is_unit_decl(ty) { return 1; }
        return width(types::payload_of(ty));
      }
      if types::is_kind(ty, types::kd_record()) {
        return field_off(ty, types::field_count(ty));
      }
      if types::is_kind(ty, types::kd_union()) {
        var total = 1;
        var widest = 0;
        var i = 0;
        while i < types::member_count(ty) {
          let w = width(types::member_payload(types::member_at(ty, i)));
          total = total + w;
          if w > widest { widest = w; }
          i = i + 1;
        }
        if disjoint_union(ty) { return total; }
        return widest + 1;
      }
      base
    }

    # Keep precise reference types in separate lanes when payloads cannot
    # share a Wasm slot. Ordinary compatible unions keep the compact layout.
    fn disjoint_union(ty: Int): Bool {
      if checking() { return false; }
      if !types::is_kind(ty, types::kd_union()) { return false; }
      var a = 0;
      while a < types::member_count(ty) {
        let pa = types::member_payload(types::member_at(ty, a));
        var b = 0;
        while b < a {
          let pb = types::member_payload(types::member_at(ty, b));
          var i = 0;
          while i < width(pa) {
            if i < width(pb) {
              let va = layout_lane_key(pa, i);
              let vb = layout_lane_key(pb, i);
              if va != vb {
                if va < 0 { return true; }
                if emit::is_ref(va) { return true; }
                if vb < 0 { return true; }
                if emit::is_ref(vb) { return true; }
              }
            }
            i = i + 1;
          }
          b = b + 1;
        }
        a = a + 1;
      }
      false
    }

    # Compare lane identities without constructing GC types. In particular,
    # recursive boxed unions must finish physical layout before struct_of
    # starts filling their fields. Precise refs use their canonical held type.
    fn layout_lane_key(ty: Int, i: Int): Int {
      let scalar = wide_scalar(ty);
      if ast::is_some(scalar) { return scalar; }
      if is_ref_type(ty) {
        let held = held_of(ty);
        return -2 - held - held;
      }
      if is_array_type(ty) {
        let held = array_held(ty);
        return -3 - held - held;
      }
      if types::is_kind(ty, types::kd_nominal()) {
        if types::is_unit_decl(ty) { return emit::vt_i32(); }
        return layout_lane_key(types::payload_of(ty), i);
      }
      if types::is_kind(ty, types::kd_record()) {
        var j = 0;
        while j < types::field_count(ty) {
          let off = field_off(ty, j);
          let field = types::field_type_at(ty, j);
          if i < off + width(field) { return layout_lane_key(field, i - off); }
          j = j + 1;
        }
      }
      if types::is_kind(ty, types::kd_union()) {
        if i == 0 { return emit::vt_i32(); }
        var offset = 1;
        var j = 0;
        let separate = disjoint_union(ty);
        while j < types::member_count(ty) {
          let payload = types::member_payload(types::member_at(ty, j));
          if i >= offset {
            if i < offset + width(payload) { return layout_lane_key(payload, i - offset); }
          }
          if separate { offset = offset + width(payload); }
          j = j + 1;
        }
      }
      emit::vt_i32()
    }

    fn union_offset(ty: Int, head: Int): Int {
      let t = spec(ty);
      if !disjoint_union(t) { return 1; }
      var offset = 1;
      var i = 0;
      while i < types::member_count(t) {
        let member = types::member_at(t, i);
        if types::head_of(member) == head { return offset; }
        offset = offset + width(types::member_payload(member));
        i = i + 1;
      }
      offset
    }

    # A need's key as `env`, a generic environment of the caller, knows it
    # (D62): a declaration states its receiver in terms of its own
    # parameters, read as the generations in force there (D72); an
    # anonymous function was made in a frame, and its keys are already in
    # that frame's terms.
    fn need_key_recv(f: Int, env: Int, r: Int): Int {
      if !ast::is_some(r) {
        r
      } else if is_lambda(f) {
        r
      } else {
        instantiate_in(env, r)
      }
    }

    # Which of `Wasm`'s `I64`, `F32` and `F64` an abstract type is, as a
    # valtype, or none — the one place the back end has to know a type by
    # name, because a valtype is not something the type system models.
    # (`I32` needs no test: it is what everything else is.)
    fn wide_scalar(ty: Int): Int {
      if !types::is_kind(ty, types::kd_abstract()) {
        return ast::none();
      }
      let sym = types::sym_of(ty);
      if !in_wasm(sym) {
        return ast::none();
      }
      if sym == cg_structref.read() {
        return emit::vt_structref();
      }
      if sym == arrayref_sym() {
        return emit::vt_eqref();
      }
      var k = 1;
      while k < emit::vt_count() {
        let cs = spelled();
        spell_scalar(cs, k);
        if sym_named(sym, cs) {
          return emit::vt_at(k);
        }
        k = k + 1;
      }
      ast::none()
    }

    # The Wasm valtype of one slot of a value of this type, generic. A tag
    # is its payload (D58); a union's slot zero is its discriminant and the
    # rest come from its members.
    fn valtype_at(ty: Int, i: Int): Int { slot_valtype(spec(ty), i) }

    fn slot_valtype(ty: Int, i: Int): Int {
      let scalar = wide_scalar(ty);
      if ast::is_some(scalar) {
        return scalar;
      }
      if is_ref_type(ty) {
        return ref_valtype(held_of(ty));
      }
      if is_array_type(ty) {
        return emit::vt_ref(array_of(array_held(ty)));
      }
      if types::is_kind(ty, types::kd_nominal()) {
        if types::is_unit_decl(ty) {
          return emit::vt_i32();
        }
        return slot_valtype(types::payload_of(ty), i);
      }
      if types::is_kind(ty, types::kd_union()) {
        if i == 0 {
          return emit::vt_i32();
        }
        var j = 0;
        var offset = 1;
        let separate = disjoint_union(ty);
        while j < types::member_count(ty) {
          let p = types::member_payload(types::member_at(ty, j));
          if i >= offset {
            if width(p) > i - offset { return slot_valtype(p, i - offset); }
          }
          if separate { offset = offset + width(p); }
          j = j + 1;
        }
      }
      if types::is_kind(ty, types::kd_record()) {
        var j = 0;
        while j < types::field_count(ty) {
          let off = field_off(ty, j);
          let f = types::field_type_at(ty, j);
          if i < off + width(f) {
            return slot_valtype(f, i - off);
          }
          j = j + 1;
        }
      }
      emit::vt_i32()
    }

    # Records.

    # A field's type, generic, of a generic record.
    fn field_ty(rec: Int, i: Int): Int { types::field_type_at(rec, i) }

    # Where a field's run starts, which only the record's specialization
    # can say: a field of an abstract type is as wide as what it is here.
    fn field_off(rec: Int, i: Int): Int {
      let r = spec(rec);
      var offset = 0;
      var j = 0;
      while j < i {
        offset = offset + width(types::field_type_at(r, j));
        j = j + 1;
      }
      offset
    }

    # The type a tag construction builds: the tag at whatever its brackets
    # bind (`Box[Elem=Point](...)`), or applied to its own requirements,
    # and either way read through the bindings in force.
    fn tag_type(callee: Int, sym: Int, m: Int): Int {
      let g = cg_genv.read();
      if ast::d_of(callee) == 1 {
        return canon_in(g, types::apply(sym, ast::b_of(callee), ast::c_of(callee), m));
      }
      canon_in(g, types::ty_of_decl(sym))
    }

    # The record an expression's value carries, or none.
    fn record_type_of(e: Int, m: Int): Int {
      types::record_of(type_of(e, m))
    }

    # `x.f` where the value is already in a local: which local, and where
    # in it the field starts. Locals, `this`, contextual vals and fields
    # of those are places; anything else has to be evaluated first.
    fn place_local(e: Int, m: Int): Int {
      let k = ast::kind_of(e);
      if k == ast::k_ex_this() {
        if !has_this(m) {
          return ast::none();
        }
        return this_local();
      }
      if k == ast::k_ex_path() {
        let p = ast::a_of(e);
        if ast::path_len(p) == 1 {
          let local = find_local(ast::path_at(p, 0));
          if ast::is_some(local) {
            return local;
          }
        }
        let sym = prog::resolve_path(m, p);
        if !ast::is_some(sym) {
          return ast::none();
        }
        if prog::sym_kind.get(sym) != prog::sk_val() {
          return ast::none();
        }
        return provision_of(ast::none(), sym);
      }
      if k == ast::k_ex_field() {
        if ast::is_some(field_at(e, m)) {
          return place_local(ast::a_of(e), m);
        }
      }
      ast::none()
    }

    fn place_offset(e: Int, m: Int): Int {
      if ast::kind_of(e) == ast::k_ex_field() {
        let rec = record_type_of(ast::a_of(e), m);
        return place_offset(ast::a_of(e), m) + field_off(rec, field_at(e, m));
      }
      0
    }

    # Which field `x.f` names, or none.
    fn field_at(e: Int, m: Int): Int {
      let rec = record_type_of(ast::a_of(e), m);
      if !ast::is_some(rec) {
        return ast::none();
      }
      types::field_index(rec, ast::b_of(e))
    }

    fn emit_field(body: IntList, e: Int, m: Int): Int {
      let l = place_local(e, m);
      if ast::is_some(l) {
        let rec = record_type_of(ast::a_of(e), m);
        let ty = field_ty(rec, field_at(e, m));
        let off = place_offset(e, m);
        var j = 0;
        while j < width(ty) {
          op_local_get(body, local_slot(l, off + j));
          j = j + 1;
        }
        return ty;
      }
      # Not in a local: evaluate it into a temporary, and take the
      # field's run of slots from that. The record is whatever emitting
      # it produced, which `type_of` cannot always say beforehand.
      let got = emit_expr(body, ast::a_of(e), m);
      let rec = types::record_of(got);
      var i = ast::none();
      if ast::is_some(rec) {
        i = types::field_index(rec, ast::b_of(e));
      }
      if !ast::is_some(i) {
        drop_value(body, got);
        cg_error(c_bad_type(), ast::b_of(e));
        return ty_none();
      }
      let ty = field_ty(rec, i);
      let tmp = reveal(ast::none(), got);
      store_local(body, tmp);
      let off = field_off(rec, i);
      var j = 0;
      while j < width(ty) {
        op_local_get(body, local_slot(tmp, off + j));
        j = j + 1;
      }
      ty
    }

    # `Tag { f = e, ... }`: the payload's fields, in the record's own
    # order whatever order they are written in. Every field once, and
    # only fields the record has.
    fn emit_record(body: IntList, e: Int, m: Int): Int {
      let path = ast::a_of(ast::a_of(e));
      let sym = prog::resolve_path(m, path);
      if !ast::is_some(sym) {
        semantic_error(prog::e_scope(), ast::path_last(path));
        return ty_none();
      }
      let nominal = tag_type(ast::a_of(e), sym, m);
      let rec = types::record_of(nominal);
      if !ast::is_some(rec) {
        cg_error(c_bad_type(), prog::sym_name.get(sym));
        return ty_none();
      }
      var i = 0;
      while i < ast::c_of(e) {
        let rf = ast::kid_at(ast::b_of(e), i);
        if !ast::is_some(types::field_index(rec, ast::a_of(rf))) {
          cg_error(c_bad_type(), ast::a_of(rf));
        }
        var j = i + 1;
        while j < ast::c_of(e) {
          if ast::a_of(ast::kid_at(ast::b_of(e), j)) == ast::a_of(rf) {
            cg_error(c_bad_type(), ast::a_of(rf));
          }
          j = j + 1;
        }
        i = i + 1;
      }
      var f = 0;
      while f < types::field_count(rec) {
        let name = types::field_name_at(rec, f);
        let ty = field_ty(rec, f);
        var given = ast::none();
        var k = 0;
        while k < ast::c_of(e) {
          let rf = ast::kid_at(ast::b_of(e), k);
          if ast::a_of(rf) == name {
            given = rf;
          }
          k = k + 1;
        }
        if !ast::is_some(given) {
          cg_error(c_bad_type(), name);
        } else if ast::is_some(ast::b_of(given)) {
          emit_as(body, ast::b_of(given), m, ty);
        } else {
          # `{ f }` is `{ f = f }`.
          let local = find_local(name);
          if ast::is_some(local) {
            load_local(body, local);
          } else {
            semantic_error(prog::e_scope(), name);
          }
        }
        f = f + 1;
      }
      nominal
    }

    # What `Tag { ... }` destructures: the nominal's payload, when that is a
    # record itself (D34). A payload that is another nominal type has to
    # be matched through that type's own head.
    fn pattern_record(payload: Int): Int {
      if types::is_kind(payload, types::kd_record()) {
        payload
      } else {
        ast::none()
      }
    }

    # The name a record pattern's field binds, or none: `{ f }` binds
    # `f`, `{ f = x }` binds `x`, `{ f = _ }` binds nothing. Anything
    # deeper is not a binder; `record_pattern_ok` reports it.
    fn rfield_binder(pf: Int, m: Int): Int {
      let sub = ast::b_of(pf);
      if !ast::is_some(sub) {
        return ast::a_of(pf);
      }
      if ast::kind_of(sub) == ast::k_pt_path() {
        if !ast::is_some(ast::b_of(sub)) {
          if !ast::is_some(arm_head_any(sub, m)) {
            return ast::path_last(ast::a_of(sub));
          }
        }
      }
      ast::none()
    }

    # Whether this back end can destructure the pattern: a record
    # payload, fields it has, and only binders or wildcards inside.
    fn record_pattern_ok(pat: Int, rec: Int, m: Int): Bool {
      if !ast::is_some(rec) {
        return false;
      }
      var i = 0;
      while i < ast::c_of(pat) {
        let pf = ast::kid_at(ast::b_of(pat), i);
        if !ast::is_some(types::field_index(rec, ast::a_of(pf))) {
          return false;
        }
        if !ast::is_some(rfield_binder(pf, m)) {
          let sub = ast::b_of(pf);
          if ast::kind_of(sub) != ast::k_pt_wild() {
            return false;
          }
        }
        i = i + 1;
      }
      true
    }

    # Binding a record pattern's fields, from a local holding the record
    # at slot `base`.
    fn bind_record_fields(body: IntList, pat: Int, rec: Int, m: Int, l: Int, base: Int) {
      var i = 0;
      while i < ast::c_of(pat) {
        let pf = ast::kid_at(ast::b_of(pat), i);
        let name = rfield_binder(pf, m);
        if ast::is_some(name) {
          let f = types::field_index(rec, ast::a_of(pf));
          let off = base + field_off(rec, f);
          var j = 0;
          while j < width(field_ty(rec, f)) {
            op_local_get(body, local_slot(l, off + j));
            j = j + 1;
          }
          bind_here(body, name, field_ty(rec, f));
        }
        i = i + 1;
      }
    }

    # Locals.

    # A local of generic type `ty`, laid out as `sty`, its specialization.
    fn add_local(name: Int, ty: Int, sty: Int): Int {
      lc_name.push(name);
      lc_type.push(ty);
      lc_spec.push(sty);
      lc_start.push(lc_slots.length());
      var i = 0;
      while i < width(sty) {
        lc_slots.push(ast::none());
        i = i + 1;
      }
      lc_name.length() - 1
    }

    fn local_slot(l: Int, i: Int): Int { lc_slots.get(lc_start.get(l) + i) }

    fn set_local_slot(l: Int, i: Int, slot: Int) {
      lc_slots.set(lc_start.get(l) + i, slot);
    }

    fn local_width(l: Int): Int { width(lc_spec.get(l)) }

    # Emission takes every local by revealing the next one, in order, and
    # uses the one it just revealed. Going through here rather than
    # looking a name up is what keeps the two passes from drifting apart —
    # a `match` temporary has no name to look up.
    #
    # The cursor only ever goes forward, in both passes, because that is
    # what makes "the nth local created is the nth revealed" true: a block
    # that declares locals and is followed by another declaration in the
    # scope around it would otherwise hand out the same index twice. Leaving
    # a scope therefore *retires* its names rather than rewinding the
    # cursor, and revealing a local gives it its name back.
    #
    # In the first pass nothing is there yet, so revealing creates the
    # local, with slots numbered just for that pass (its output is thrown
    # away). In the second pass the cursor walks the locals the first one
    # recorded, laid out as the first pass specialized them; running off
    # their end means the passes disagree. Either way the local takes the
    # generic type it is revealed at.
    fn reveal(name: Int, ty: Int): Int {
      let l = lc_visible.read();
      if l == lc_name.length() {
        if cg_real.read() == 1 {
          cg_error(c_missing(), name);
        }
        add_local(name, ty, spec(ty));
        var i = 0;
        while i < local_width(l) {
          set_local_slot(l, i, lc_start.get(l) + i);
          i = i + 1;
        }
      }
      lc_visible.write(l + 1);
      lc_name.set(l, name);
      lc_type.set(l, ty);
      l
    }

    # Leaving a scope: everything it introduced stops answering to its
    # name, so an inner `let x` cannot be found from outside.
    fn close_scope(mark: Int) {
      var l = mark;
      while l < lc_visible.read() {
        lc_name.set(l, ast::none());
        l = l + 1;
      }
    }

    # A value on the stack, into a local: the top of the stack is the
    # last slot, so they are written back to front.
    fn store_local(body: IntList, l: Int) {
      var i = local_width(l);
      while i > 0 {
        i = i - 1;
        op_local_set(body, local_slot(l, i));
      }
    }

    fn load_local(body: IntList, l: Int) {
      var i = 0;
      while i < local_width(l) {
        op_local_get(body, local_slot(l, i));
        i = i + 1;
      }
    }

    # The innermost local of this name that is still in scope.
    fn find_local(name: Int): Int {
      var i = lc_visible.read();
      while i > lc_base.read() {
        i = i - 1;
        if lc_name.get(i) == name {
          return i;
        }
      }
      ast::none()
    }

    # Expression types.

    # An expression's generic type, before it is emitted — what emitting
    # it would return, as far as can be said without the locals a
    # `match` arm or a block binds.
    fn type_of(e: Int, m: Int): Int {
      let k = ast::kind_of(e);
      if k == ast::k_ex_block() {
        if ast::is_some(ast::c_of(e)) {
          return type_of(ast::c_of(e), m);
        }
        return ty_none();
      }
      if k == ast::k_ex_if() {
        return type_of(ast::b_of(e), m);
      }
      if k == ast::k_ex_this() {
        return lc_type.get(this_local());
      }
      if k == ast::k_ex_method() {
        let recv_ty = type_of(ast::a_of(e), m);
        let r = resolve_method(e, m, recv_ty);
        let meth = rm_meth.get(r);
        if ast::is_some(meth) {
          let emark = cg_env.read();
          let gmark = cg_genv.read();
          receiver_view(recv_ty);
          let ret = sig_ret(cg_genv.read(), meth, recv_ty);
          cg_env.write(emark);
          cg_genv.write(gmark);
          return ret;
        }
        if !ast::is_some(rm_sym.get(r)) {
          return ty_none();
        }
        return provision_ret(recv_ty, rm_sym.get(r));
      }
      if k == ast::k_ex_unary() {
        return operator_type(e, m);
      }
      if k == ast::k_ex_lit() {
        return literal_type(e);
      }
      if k == ast::k_ex_binary() {
        return operator_type(e, m);
      }
      if k == ast::k_ex_path() {
        if ast::path_len(ast::a_of(e)) == 1 {
          let local = find_local(ast::path_at(ast::a_of(e), 0));
          if ast::is_some(local) {
            return lc_type.get(local);
          }
        }
        let sym = prog::resolve_path(m, ast::a_of(e));
        if !ast::is_some(sym) {
          return ty_none();
        }
        return symbol_type(sym);
      }
      if k == ast::k_ex_call() {
        let sym = prog::resolve_path(m, ast::a_of(ast::a_of(e)));
        if !ast::is_some(sym) {
          return ty_none();
        }
        # A tag construction is a value of the tag's own type (D58).
        if prog::sym_kind.get(sym) == prog::sk_tag() {
          return tag_type(ast::a_of(e), sym, m);
        }
        if in_wasm(sym) {
          return op_result(wops::find_op(prog::sym_name.get(sym)));
        }
        if in_wasi(sym) { runtime_wasi(sym, lower::env_of(sym), false); }
        if is_i32_bool(sym) {
          return cg_boolty.read();
        }
        if is_defined_fn(sym) {
          return sig_ret(cg_genv.read(), sym, ast::none());
        }
        # Provided: typed by its provision (D72).
        let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), ast::none(), sym);
        if ast::is_some(grow) {
          return sig_ret(row_view(grow), sym, ast::none());
        }
        return elab_ty(
          ast::fn_ret(prog::sym_decl.get(sym)), prog::sym_mod.get(sym)
        );
      }
      if k == ast::k_ex_record() {
        let sym = prog::resolve_path(m, ast::a_of(ast::a_of(e)));
        if !ast::is_some(sym) {
          return ty_none();
        }
        return tag_type(ast::a_of(e), sym, m);
      }
      if k == ast::k_ex_field() {
        let i = field_at(e, m);
        if !ast::is_some(i) {
          return ty_none();
        }
        return field_ty(record_type_of(ast::a_of(e), m), i);
      }
      # `()`, `break`, `return` and everything this slice does not cover
      # leave nothing behind.
      ty_none()
    }

    fn operator_type(e: Int, m: Int): Int {
      provision_ret(type_of(ast::b_of(e), m), op_symbol(e))
    }

    # An integer literal is what `one` is here, a decimal one what
    # `float` returns.
    fn literal_type(e: Int): Int {
      if !ast::is_some(ast::c_of(e)) {
        if !ast::is_some(lang(lg_one())) {
          return ty_none();
        }
        let l = provision_of(ast::none(), lang(lg_one()));
        if !ast::is_some(l) {
          return ty_none();
        }
        return lc_type.get(l);
      }
      let sym = lang(lg_float());
      if !ast::is_some(sym) {
        return ty_none();
      }
      let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), ast::none(), sym);
      if !ast::is_some(grow) {
        return ty_none();
      }
      sig_ret(row_view(grow), sym, ast::none())
    }

    # What a path standing alone denotes: a unit value, a `Bool`
    # constant, a `Wasm` value like `i32_zero`, a contextual val, or
    # nothing this back end can produce.
    fn symbol_type(sym: Int): Int {
      if prog::sym_kind.get(sym) == prog::sk_unit() {
        return types::ty_of_decl(sym);
      }
      if in_wasm(sym) {
        return op_result(wops::find_op(prog::sym_name.get(sym)));
      }
      if in_bool(sym) {
        return cg_boolty.read();
      }
      if prog::sym_kind.get(sym) == prog::sk_val() {
        let l = provision_of(ast::none(), sym);
        if ast::is_some(l) {
          return lc_type.get(l);
        }
        return elab_ty(ast::b_of(prog::sym_decl.get(sym)), prog::sym_mod.get(sym));
      }
      ty_none()
    }

    # An instruction's result, as this frame's code sees the scalar type:
    # lib/wasm.moss's own, through the `Wasm` the frame assumed.
    fn op_result(op: Int): Int {
      if !ast::is_some(op) {
        return ty_none();
      }
      let r = wops::op_res.get(op);
      var t = ty_none();
      if wops::op_codes.get(op) == 0 {
        # `unreachable` is declared `: |`, so it is any type (D15), as in
        # the bootstrap: a match arm that traps can stand for any other.
        if wops::op_kinds.get(op) == wops::wk_simple() {
          return types::ty_never();
        }
      }
      if r == wops::wr_i64() {
        t = cg_i64.read();
      } else if r == wops::wr_i32() {
        t = cg_i32.read();
      } else if r == wops::wr_f32() {
        t = cg_f32.read();
      } else if r == wops::wr_f64() {
        t = cg_f64.read();
      } else {
        return ty_none();
      }
      lower::canon(cg_genv.read(), t)
    }

    # Typing a call (D72, D74). A callee's declared signature, read
    # through a generic environment `g`: for a direct call, the frame's
    # own — with the receiver's view, for an attached method — whose
    # bindings give each of the callee's type symbols the generation in
    # force; for a provision, the one it was provided in (`row_view`), so
    # that it is typed as provided, whatever has been bound since. `This`
    # is the receiver `this_ty`.
    fn sig_params(g: Int, sym: Int, this_ty: Int): IntList {
      let out = int_list();
      let d = prog::sym_decl.get(sym);
      let home = prog::sym_mod.get(sym);
      var i = 0;
      while i < ast::fn_nparams(d) {
        out.push(sig_ty(g, ast::b_of(ast::kid_at(ast::fn_params(d), i)), home, this_ty));
        i = i + 1;
      }
      out
    }

    fn sig_ret(g: Int, sym: Int, this_ty: Int): Int {
      sig_ty(g, ast::fn_ret(prog::sym_decl.get(sym)), prog::sym_mod.get(sym), this_ty)
    }

    # The environment a provision's signature is read through: what its
    # row in the generic environment records (lower.moss), or, failing
    # that, the frame's.
    fn row_view(row: Int): Int {
      if ast::is_some(lower::env_a_of(row)) {
        return lower::env_a_of(row);
      }
      cg_genv.read()
    }

    # What calling the method `sym` the context provides at `recv_ty`
    # yields, or nothing where it provides none. A platform provision
    # (D75) is typed by its declaration like any other: `.boxed` makes a
    # `Ref` at the `Boxed` it was provided at, which is its key, and
    # `Ref.deref` yields that `Boxed`.
    fn provision_ret(recv_ty: Int, sym: Int): Int {
      if !ast::is_some(sym) {
        return ty_none();
      }
      let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), recv_ty, sym);
      if !ast::is_some(grow) {
        return on_demand_ret(recv_ty, sym);
      }
      sig_ret(row_view(grow), sym, recv_ty)
    }

    # Reachability.

    fn queued(sym: Int, env: Int): Int {
      var i = 0;
      while i < fq_sym.length() {
        if fq_sym.get(i) == sym {
          if fq_env.get(i) == env {
            return i;
          }
        }
        i = i + 1;
      }
      ast::none()
    }

    fn imported(sym: Int): Int {
      var i = 0;
      while i < wi_sym.length() {
        if wi_sym.get(i) == sym {
          return i;
        }
        i = i + 1;
      }
      ast::none()
    }

    # The first pass is supposed to have reached everything. If this one
    # finds something new, the two passes disagree, which is a bug here
    # rather than in the program.
    fn late(sym: Int): Bool {
      if cg_real.read() == 1 {
        cg_error(c_missing(), prog::sym_name.get(sym));
        return true;
      }
      false
    }

    # Note that this specialization is reached. The queue is drained by a
    # loop rather than by recursion, so it grows while it is walked.
    fn reach(sym: Int, env: Int) {
      if checking() {
        return ();
      }
      if ast::is_some(queued(sym, env)) {
        return ();
      }
      if late(sym) {
        return ();
      }
      fq_sym.push(sym);
      fq_env.push(env);
      fq_index.push(ast::none());
    }

    # A WASI function is exactly an import of this module (D52).
    fn reach_import(sym: Int) {
      if checking() {
        return ();
      }
      if ast::is_some(imported(sym)) {
        return ();
      }
      if late(sym) {
        return ();
      }
      wi_sym.push(sym);
      wi_index.push(ast::none());
    }

    # A defined function's signature: its declared parameters, then one
    # per need it takes as data, in the order `lower.moss` fixed. Both
    # sides read that order from the same place, which is what makes it
    # a calling convention rather than a coincidence.
    fn signature_of_fn(sym: Int, env: Int): Int {
      let d = prog::sym_decl.get(sym);
      let m = prog::sym_mod.get(sym);
      let ps = int_list();
      if is_defined_method(sym) {
        push_valtypes(ps, this_type_in(env, sym));
      }
      var i = 0;
      while i < ast::fn_nparams(d) {
        let p = ast::kid_at(ast::fn_params(d), i);
        push_valtypes(ps, lower::elab(env, ast::b_of(p), m));
        i = i + 1;
      }
      let vals = int_list();
      val_slots(vals, sym, env, 0);
      i = 0;
      while i < vals.length() {
        push_valtypes(ps, need_type_in(env, vals.get(i)));
        i = i + 1;
      }
      finish_signature(ps, lower::elab(env, ast::fn_ret(d), m))
    }

    fn push_valtypes(ps: IntList, ty: Int) {
      var j = 0;
      while j < width(ty) {
        ps.push(valtype_at(ty, j));
        j = j + 1;
      }
    }

    fn finish_signature(ps: IntList, ret: Int): Int {
      let rs = int_list();
      push_valtypes(rs, ret);
      emit::type_index(ps, rs)
    }

    # A WASI import: everything it takes and returns is a scalar the
    # declaration names.
    fn signature_of(d: Int, m: Int): Int {
      let ps = int_list();
      var i = 0;
      while i < ast::fn_nparams(d) {
        let p = ast::kid_at(ast::fn_params(d), i);
        let ty = types::elab(ast::b_of(p), m);
        var j = 0;
        while j < width(ty) {
          ps.push(valtype_at(ty, j));
          j = j + 1;
        }
        i = i + 1;
      }
      finish_signature(ps, types::elab(ast::fn_ret(d), m))
    }

    fn declare_all() {
      var i = 0;
      while i < wi_sym.length() {
        let sym = wi_sym.get(i);
        let field = int_list();
        intern::put_chars(field, prog::sym_name.get(sym));
        let m0 = int_list();
        sp_wasi_snapshot_preview1(m0);
        wi_index.set(
          i,
          emit::add_import(
            m0, field,
            signature_of(prog::sym_decl.get(sym), prog::sym_mod.get(sym))
          )
        );
        i = i + 1;
      }
      i = 0;
      while i < fq_sym.length() {
        let sym = fq_sym.get(i);
        cg_env.write(fq_env.get(i));
        fq_index.set(i, emit::add_func(signature_of_fn(sym, fq_env.get(i))));
        i = i + 1;
      }
      cg_env.write(lower::env_empty());
    }

    fn index_of_fn(sym: Int, env: Int): Int {
      let i = queued(sym, env);
      if ast::is_some(i) {
        fq_index.get(i)
      } else {
        ast::none()
      }
    }

    fn index_of_import(sym: Int): Int {
      let i = imported(sym);
      if ast::is_some(i) {
        wi_index.get(i)
      } else {
        ast::none()
      }
    }

    # Pass three: bodies.

    # What a pattern's payload binder holds: of the member the pattern
    # selects, which for a union is not the union itself.
    fn pattern_payload(pat: Int, sty: Int, m: Int): Int {
      if types::is_kind(sty, types::kd_union()) {
        return arm_payload(pat, m, sty);
      }
      types::member_payload(sty)
    }

    # Parameters take the low indices, in order and slot by slot; the
    # locals past them are grouped by valtype, which is the shape of the
    # code section's locals vector. The result is how many locals of each
    # valtype were needed, in the order of `emit::vt_at`.
    fn assign_slots(nparams: Int): IntList {
      var next = 0;
      var l = lc_base.read();
      while l < lc_base.read() + nparams {
        var i = 0;
        while i < local_width(l) {
          set_local_slot(l, i, next);
          next = next + 1;
          i = i + 1;
        }
        l = l + 1;
      }
      # The scalars in `emit::vt_at`'s order, then D75's references: the
      # bare ones (D81's `ArrayRef` the second), then one per GC type.
      let counts = int_list();
      var k = 0;
      while k < emit::vt_count() + 2 + emit::st_key.length() {
        var vt = emit::vt_structref();
        if k < emit::vt_count() {
          vt = emit::vt_at(k);
        } else if k == emit::vt_count() + 1 {
          vt = emit::vt_eqref();
        } else if k > emit::vt_count() + 1 {
          vt = emit::vt_ref(k - emit::vt_count() - 2);
        }
        let first = next;
        l = lc_base.read() + nparams;
        while l < lc_name.length() {
          var i = 0;
          while i < local_width(l) {
            if slot_valtype(lc_spec.get(l), i) == vt {
              set_local_slot(l, i, next);
              next = next + 1;
            }
            i = i + 1;
          }
          l = l + 1;
        }
        if next > first {
          counts.push(next - first);
          counts.push(vt);
        }
        k = k + 1;
      }
      counts
    }

    # Emitting returns the *type* the expression left on the stack, which
    # is the only reliable way to know it: a `let`'s local is not visible
    # until the statement that introduces it has been emitted, so asking
    # for a block's tail type before emitting the block gives the wrong
    # answer.
    fn emit_expr(body: IntList, e: Int, m: Int): Int {
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(e)) { prog::location.write(e + 1); }
      let result = emit_expr_inner(body, e, m);
      prog::location.write(saved);
      result
    }

    fn emit_expr_inner(body: IntList, e: Int, m: Int): Int {
      let k = ast::kind_of(e);
      if k == ast::k_ex_unit() {
        return ty_none();
      }
      if k == ast::k_ex_block() {
        return emit_block(body, e, m);
      }
      if k == ast::k_ex_if() {
        return emit_if(body, e, m);
      }
      if k == ast::k_ex_match() {
        return emit_match(body, e, m);
      }
      if k == ast::k_ex_break() {
        if cg_ntop.read() == 0 {
          cg_error(c_break(), ast::none());
          return ty_none();
        }
        let top = 2 * (cg_ntop.read() - 1);
        cg_loops.set(top + 1, 1);
        op_br(body, cg_depth.read() - cg_loops.get(top));
        return types::ty_never();
      }
      if k == ast::k_ex_return() {
        if !ast::is_some(cg_ret.read()) {
          cg_error(c_bad_type(), ast::none());
          return ty_none();
        }
        if ast::is_some(ast::a_of(e)) {
          emit_as(body, ast::a_of(e), m, cg_ret.read());
        } else if canon_in(cg_env.read(), cg_ret.read()) != types::ty_unit() {
          cg_error(c_bad_type(), ast::none());
          return ty_none();
        }
        op_return(body);
        return types::ty_never();
      }
      if k == ast::k_ex_this() {
        if !has_this(m) {
          return ty_none();
        }
        load_local(body, this_local());
        return lc_type.get(this_local());
      }
      if k == ast::k_ex_path() {
        return emit_path(body, e, m);
      }
      if k == ast::k_ex_call() {
        return emit_call(body, e, m);
      }
      if k == ast::k_ex_method() {
        return emit_method(body, e, m);
      }
      if k == ast::k_ex_record() {
        return emit_record(body, e, m);
      }
      if k == ast::k_ex_field() {
        return emit_field(body, e, m);
      }
      if k == ast::k_ex_unary() {
        return emit_operator(body, e, m);
      }
      if k == ast::k_ex_binary() {
        return emit_operator(body, e, m);
      }
      if k == ast::k_ex_lit() {
        return emit_literal(body, e);
      }
      if k == ast::k_ex_lambda() {
        # D70: only a bind's right side, which never comes here.
        prog::error(prog::e_lambda(), m, ast::none());
        return ty_none();
      }
      cg_error(c_unsupported(), ast::none());
      ty_none()
    }

    # Literals (D68). A literal is not a constant but a use of fixed
    # library symbols, provided here like any others, so its meaning
    # follows what `Int` and `Float` are bound to — the same expansion
    # bootstrap/mossc/lower.py builds:
    #
    #   integer: int.moss's `zero` and `one`, num.moss's `.add` and `.mul`
    #            at `Int`, Horner over the digits with each digit and ten
    #            a sum of `one`s;
    #   decimal: float(m).div(float(10^k)), `m` and `10^k` built in
    #            `Float` from `float(digit)`s and `float(ten)`s;
    #   exponent `eN`: the same `m`, and for `n = N - k`, `.div` by
    #            `10^-n` if `n < 0` (so with no exponent, N = 0, this is
    #            the decimal case), `.mul` by `10^n` if `n > 0`, and `m`
    #            alone if `n = 0`.
    #
    # Nothing is checked: a literal means what that arithmetic computes,
    # wrapping, trapping or rounding as the bound `Int` and `Float` do.
    #
    # Each is emitted straight onto the stack: a receiver, its argument,
    # then the call, which `emit_provided` finishes.

    fn emit_literal(body: IntList, e: Int): Int {
      let run = ast::a_of(e);
      let n = ast::b_of(e);
      if !ast::is_some(ast::c_of(e)) {
        return emit_digits(body, run, n);
      }
      var shift = 0 - ast::c_of(e);
      if ast::is_some(ast::d_of(e)) {
        shift = ast::kid_at(ast::d_of(e), 0) - ast::c_of(e);
      }
      var i = 0;
      while i < n {
        if ast::kid_at(run, i) != 0 {
          break;
        }
        i = i + 1;
      }
      var t = ty_none();
      if i == n {
        t = emit_float_digit(body, 0);
      } else {
        t = emit_float_digit(body, ast::kid_at(run, i));
        i = i + 1;
        while i < n {
          emit_float_digit(body, 10);
          t = emit_lang_method(body, t, tk_star());
          let d = ast::kid_at(run, i);
          if d > 0 {
            emit_float_digit(body, d);
            t = emit_lang_method(body, t, tk_plus());
          }
          i = i + 1;
        }
      }
      if shift == 0 {
        return t;
      }
      var count = shift;
      if count < 0 {
        count = 0 - count;
      }
      var scale = emit_float_digit(body, 10);
      var j = 1;
      while j < count {
        emit_float_digit(body, 10);
        scale = emit_lang_method(body, scale, tk_star());
        j = j + 1;
      }
      if shift > 0 {
        emit_lang_method(body, t, tk_star())
      } else {
        emit_lang_method(body, t, tk_slash())
      }
    }

    fn emit_lang_val(body: IntList, slot: Int): Int {
      let sym = lang(slot);
      if !ast::is_some(sym) {
        cg_error(c_unsupported(), ast::none());
        return ty_none();
      }
      let l = provision_of(ast::none(), sym);
      if !ast::is_some(l) {
        cg_error(c_unbound(), prog::sym_name.get(sym));
        return ty_none();
      }
      load_local(body, l);
      lc_type.get(l)
    }

    # num.moss's method in `slot`, called on the receiver and argument
    # already on the stack.
    fn literal_method_signature(recv_ty: Int, sym: Int, row: Int): Bool {
      let ps = sig_params(row_view(row), sym, recv_ty);
      if ps.length() != 1 { return false; }
      let t = lower::canon(cg_genv.read(), recv_ty);
      if lower::canon(cg_genv.read(), ps.get(0)) != t { return false; }
      lower::canon(cg_genv.read(), sig_ret(row_view(row), sym, recv_ty)) == t
    }

    fn emit_lang_method(body: IntList, recv_ty: Int, slot: Int): Int {
      let sym = lang(slot);
      if !ast::is_some(sym) {
        cg_error(c_unsupported(), ast::none());
        return ty_none();
      }
      let row = generic_row(recv_ty, sym);
      if !ast::is_some(row) {
        # D84 rule 7 applies to literal arithmetic too. Its operands are
        # already on the stack; the family's binds leave them in place.
        let ts = int_list();
        let tt = int_list();
        let fu = family_member(recv_ty, sym, ts, tt);
        if ast::is_some(fu) {
          matching_in_force(tt);
          return emit_literal_on_demand(body, recv_ty, slot, sym, fu, ts, tt);
        }
        semantic_error(prog::e_method(), prog::sym_name.get(sym));
        return ty_none();
      }
      if !literal_method_signature(recv_ty, sym, row) {
        cg_error(c_bad_type(), prog::sym_name.get(sym));
        return ty_none();
      }
      let bound = provision_at(recv_ty, sym);
      if !provides(bound) {
        if checking() {
          return provision_ret(recv_ty, sym);
        }
        cg_error(c_unbound(), prog::sym_name.get(sym));
        return ty_none();
      }
      emit_provided(body, bound, provision_ret(recv_ty, sym))
    }

    fn emit_literal_on_demand(
      body: IntList, recv_ty: Int, slot: Int, sym: Int, fu: Int, ts: IntList, tt: IntList
    ): Int {
      let emark = cg_env.read();
      let gmark = cg_genv.read();
      let pmark = pv_top.read();
      let floor = pv_floor.read();
      let smark = es_top.read();
      let concrete = int_list();
      var i = 0;
      while i < ts.length() {
        concrete.push(spec(tt.get(i)));
        i = i + 1;
      }
      i = 0;
      while i < ts.length() {
        cg_env.write(lower::env_push(cg_env.read(), lower::ek_type(), ast::none(), ts.get(i), concrete.get(i), ast::none()));
        cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), ts.get(i), tt.get(i), ast::none()));
        i = i + 1;
      }
      # A family makes methods only, so this application has no fresh
      # type-generation site to record in an AST expression.
      apply_abstract(body, ast::none(), fu, 0, bw_emit());
      var ret = ty_none();
      if ast::is_some(generic_row(recv_ty, sym)) {
        ret = emit_lang_method(body, recv_ty, slot);
      } else {
        semantic_error(prog::e_method(), prog::sym_name.get(sym));
      }
      cg_env.write(emark);
      cg_genv.write(gmark);
      pv_top.write(pmark);
      pv_floor.write(floor);
      es_top.write(smark);
      ret
    }

    # `one + one + ...`, `n` of them.
    fn emit_small(body: IntList, n: Int): Int {
      var t = emit_lang_val(body, lg_one());
      var i = 1;
      while i < n {
        emit_lang_val(body, lg_one());
        t = emit_lang_method(body, t, tk_plus());
        i = i + 1;
      }
      t
    }

    fn emit_digit(body: IntList, d: Int): Int {
      if d == 0 {
        return emit_lang_val(body, lg_zero());
      }
      emit_small(body, d)
    }

    fn emit_digits(body: IntList, run: Int, n: Int): Int {
      var i = 0;
      while i < n {
        if ast::kid_at(run, i) != 0 {
          break;
        }
        i = i + 1;
      }
      if i == n {
        return emit_digit(body, 0);
      }
      var t = emit_digit(body, ast::kid_at(run, i));
      i = i + 1;
      while i < n {
        emit_small(body, 10);
        t = emit_lang_method(body, t, tk_star());
        let d = ast::kid_at(run, i);
        if d > 0 {
          emit_small(body, d);
          t = emit_lang_method(body, t, tk_plus());
        }
        i = i + 1;
      }
      t
    }

    # float.moss's `float` as this frame has it bound, if to a function.
    fn float_provision(): Int {
      let sym = lang(lg_float());
      if !ast::is_some(sym) {
        return ast::none();
      }
      let bound = lower::env_find(cg_env.read(), lower::ek_fn(), ast::none(), sym);
      if !ast::is_some(bound) {
        return ast::none();
      }
      if !ast::is_some(lower::env_a_of(bound)) {
        return ast::none();
      }
      if !is_compilable(lower::env_a_of(bound)) {
        return ast::none();
      }
      bound
    }

    # `float(d)`, for a digit or ten.
    fn emit_float_digit(body: IntList, d: Int): Int {
      emit_digit(body, d);
      let bound = float_provision();
      if !ast::is_some(bound) {
        if checking() {
          if ast::is_some(lang(lg_float())) {
            let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), ast::none(), lang(lg_float()));
            if ast::is_some(grow) {
              return sig_ret(row_view(grow), lang(lg_float()), ast::none());
            }
          }
        }
        if ast::is_some(lang(lg_float())) {
          cg_error(c_unbound(), prog::sym_name.get(lang(lg_float())));
        } else {
          cg_error(c_unsupported(), ast::none());
        }
        return ty_none();
      }
      let sym = lang(lg_float());
      let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), ast::none(), sym);
      if !ast::is_some(grow) {
        cg_error(c_unbound(), prog::sym_name.get(sym));
        return ty_none();
      }
      emit_provided(body, bound, sig_ret(row_view(grow), sym, ast::none()))
    }

    # D68: an operator is a call of one fixed method of lib/num.moss,
    # provided at its operand's type exactly as a method call's provision
    # is — so an operator the context does not provide there is the error
    # calling the method would be.
    fn emit_operator(body: IntList, e: Int, m: Int): Int {
      let sym = op_symbol(e);
      if !ast::is_some(sym) {
        cg_error(c_unsupported(), ast::none());
        return ty_none();
      }
      let recv = int_list();
      let recv_ty = emit_expr(recv, ast::b_of(e), m);
      var nargs = 0;
      if ast::kind_of(e) == ast::k_ex_binary() {
        nargs = 1;
      }
      emit_provided_method(body, recv, recv_ty, sym, ast::c_of(e), nargs, m, e)
    }

    # A call of the method `sym` the context provides at `recv_ty`, the
    # receiver already emitted into `recv` and the arguments a run: typed
    # by the provision as the generic environment has it, and called
    # through whatever provides it in this specialization, which keys it
    # the same way.
    fn emit_provided_method(
      body: IntList, recv: IntList, recv_ty: Int, sym: Int, run: Int, n: Int, m: Int,
      e: Int
    ): Int {
      let grow = generic_row(recv_ty, sym);
      if !ast::is_some(grow) {
        # D84 rule 7: a member of a family in force, on demand.
        let ts = int_list();
        let tt = int_list();
        let fu = family_member(recv_ty, sym, ts, tt);
        if ast::is_some(fu) {
          matching_in_force(tt);
          return emit_on_demand(body, recv, recv_ty, sym, run, n, m, e, fu, ts, tt);
        }
        semantic_error(prog::e_method(), prog::sym_name.get(sym));
        return ty_none();
      }
      let bound = provision_at(recv_ty, sym);
      var provider = ast::none();
      if ast::is_some(bound) {
        provider = lower::env_a_of(bound);
      }
      if !ast::is_some(provider) {
        if checking() {
          emit_args(body, run, n, m, sig_params(row_view(grow), sym, recv_ty));
          return sig_ret(row_view(grow), sym, recv_ty);
        }
        cg_error(c_unbound(), prog::sym_name.get(sym));
        return ty_none();
      }
      let penv = lower::env_b_of(bound);
      let prim = platform_prim(provider);
      if prim == mem_prim() {
        return emit_mem_op(
          body, recv, recv_ty, run, n, m,
          sig_params(row_view(grow), sym, recv_ty), prog::sym_name.get(sym),
          sig_ret(row_view(grow), sym, recv_ty)
        );
      }
      if prim > 2 {
        return emit_gc_op(
          body, recv, recv_ty, prim, run, n, m,
          sig_params(row_view(grow), sym, recv_ty), prog::sym_name.get(sym),
          sig_ret(row_view(grow), sym, recv_ty)
        );
      }
      if prim > 0 {
        return emit_platform(
          body, recv, recv_ty, prim, n, prog::sym_name.get(sym),
          sig_ret(row_view(grow), sym, recv_ty)
        );
      }
      push_receiver(body, recv, recv_ty, provider);
      emit_args(body, run, n, m, sig_params(row_view(grow), sym, recv_ty));
      reach(provider, penv);
      push_needs(body, provider, penv, bound, int_list());
      op_call(body, index_of_fn(provider, penv));
      sig_ret(row_view(grow), sym, recv_ty)
    }

    # A method call's receiver, already emitted into `recv`: an argument
    # if the provider takes it, and otherwise evaluated and dropped (D54).
    fn push_receiver(body: IntList, recv: IntList, recv_ty: Int, provider: Int) {
      push_bytes(body, recv);
      if !takes_receiver(provider) {
        drop_value(body, recv_ty);
      }
    }

    # The provision of method `sym` at this receiver, keyed by its whole
    # generic type (D62): its row in the generic environment, which types
    # a call, and in the specialized one, which says what provides it.
    fn generic_row(recv_ty: Int, sym: Int): Int {
      if !ast::is_some(sym) {
        return ast::none();
      }
      lower::env_find(cg_genv.read(), lower::ek_fn(), recv_ty, sym)
    }

    fn provision_at(recv_ty: Int, sym: Int): Int {
      if !ast::is_some(sym) {
        return ast::none();
      }
      lower::env_find(cg_env.read(), lower::ek_fn(), recv_ty, sym)
    }

    # `x.m(a)`. The receiver is emitted first, aside, because its type is
    # what selects the method, and emitting is the one reliable way to
    # know it: `type_of` cannot see into a `match`, whose arms' binders
    # are not in scope until they are emitted. What the call means is
    # resolved against that type as the code is written (`resolve_method`);
    # a defined attached method is called directly, at its receiver's
    # instantiation (D74), and anything else is a provision.
    fn emit_method(body: IntList, e: Int, m: Int): Int {
      let recv = int_list();
      let recv_ty = emit_expr(recv, ast::a_of(e), m);
      let name = ast::path_last(ast::b_of(e));
      let r = resolve_method(e, m, recv_ty);
      let meth = rm_meth.get(r);
      if ast::is_some(meth) {
        let demark = cg_env.read();
        let dgmark = cg_genv.read();
        let dpmark = pv_top.read();
        let dfloor = pv_floor.read();
        let dsmark = es_top.read();
        demand_needs(body, meth, e);
        check_callee_at(meth, recv_ty);
        let map = int_list();
        let emark = cg_env.read();
        let gmark = cg_genv.read();
        receiver_view(recv_ty);
        let penv = callee_env(meth, map);
        let ps = sig_params(cg_genv.read(), meth, recv_ty);
        let ret = sig_ret(cg_genv.read(), meth, recv_ty);
        cg_env.write(emark);
        cg_genv.write(gmark);
        push_bytes(body, recv);
        emit_args_in(body, ast::c_of(e), ast::d_of(e), m, ps, demark, dgmark);
        reach(meth, penv);
        push_needs(body, meth, penv, ast::none(), map);
        op_call(body, index_of_fn(meth, penv));
        cg_env.write(demark);
        cg_genv.write(dgmark);
        pv_top.write(dpmark);
        pv_floor.write(dfloor);
        es_top.write(dsmark);
        return ret;
      }
      if !ast::is_some(rm_sym.get(r)) {
        semantic_error(prog::e_method(), name);
        return ty_none();
      }
      emit_provided_method(
        body, recv, recv_ty, rm_sym.get(r), ast::c_of(e), ast::d_of(e), m, e
      )
    }

    # D77: what `e.m(...)` calls, given its receiver's generic type —
    # decided against the code as written and kept per call site (rule
    # 5), so that every specialization, and both passes, call the same
    # thing, as they do in the bootstrap, which resolves while lowering a
    # function once (`synth_method`). The rules are D77's: where the
    # receiver's head has an attached method of the name and the context
    # provides, at this receiver, the detached method the name means here
    # (imported, D61), the provision wins (rule 4); otherwise an attached
    # method declared beside the head or in this module — a defined one is
    # called directly, an abstract one is a key the context provides
    # (D36); otherwise the detached method in scope, or `mod::m`, is the
    # key. A receiver with no nominal head — a union, a record, or an
    # abstract type, whose parameter has no methods of its own — has only
    # detached ones (D75). Returns the row (`rm_`), which names nothing
    # where nothing is in scope.
    fn resolve_method(e: Int, m: Int, grecv: Int): Int {
      let genv = cg_genv.read();
      while rm_head.length() <= e {
        rm_head.push(0);
      }
      var r = rm_head.get(e);
      while r > 0 {
        let row = r - 1;
        if rm_genv.get(row) == genv {
          if rm_recv.get(row) == grecv {
            return row;
          }
        }
        r = rm_link.get(row);
      }
      let path = ast::b_of(e);
      let name = ast::path_last(path);
      var meth = ast::none();
      var sym = ast::none();
      let detached = prog::resolve_detached(m, path);
      let head = types::head_of(grecv);
      if ast::path_len(path) > 1 {
        sym = detached;
      } else if ast::is_some(head) {
        var attached = prog::find_attached(prog::sym_mod.get(head), head, name);
        if !ast::is_some(attached) {
          attached = prog::find_attached(m, head, name);
        }
        var provided = false;
        if ast::is_some(attached) {
          if ast::is_some(detached) {
            provided = lower::env_has(genv, lower::ek_fn(), grecv, detached);
          }
        }
        if !ast::is_some(attached) {
          sym = detached;
        } else if provided {
          sym = detached;
        } else if is_defined_method(attached) {
          meth = attached;
        } else {
          sym = attached;
        }
      } else {
        sym = detached;
      }
      rm_node.push(e);
      rm_genv.push(genv);
      rm_recv.push(grecv);
      rm_meth.push(meth);
      rm_sym.push(sym);
      rm_link.push(rm_head.get(e));
      rm_head.set(e, rm_node.length());
      rm_node.length() - 1
    }

    # A value entering a union (D17, D58): the one place a tag is
    # attached. The union is a discriminant beside room for its widest
    # member, so the value is emitted into a buffer first and the
    # discriminant goes in ahead of it. A unit member needs none of that
    # — the code *is* the value — so it only wants padding.
    fn union_remap_needed(got: Int, want: Int): Bool {
      let g = spec(got);
      let w = spec(want);
      if g == w { return false; }
      if !types::is_kind(g, types::kd_union()) { return false; }
      if !types::is_kind(w, types::kd_union()) { return false; }
      if disjoint_union(g) { return true; }
      disjoint_union(w)
    }

    fn remap_union(body: IntList, valbuf: IntList, got: Int, want: Int) {
      let tmp = reveal(ast::none(), got);
      push_bytes(body, valbuf);
      store_local(body, tmp);
      var member = 0;
      let n = types::member_count(got);
      while member < n {
        let variant = types::member_at(got, member);
        let head = types::head_of(variant);
        if member + 1 < n {
          op_local_get(body, local_slot(tmp, 0));
          op_i32_const(body, types::unit_code(head));
          body.push(70);
          op_if_ty(body, want);
        }
        op_local_get(body, local_slot(tmp, 0));
        let from = union_offset(got, head);
        let to = union_offset(want, head);
        var i = 1;
        while i < to {
          push_zero(body, valtype_at(want, i));
          i = i + 1;
        }
        i = 0;
        while i < width(types::member_payload(variant)) {
          op_local_get(body, local_slot(tmp, from + i));
          i = i + 1;
        }
        pad(body, want, to + i);
        if member + 1 < n { op_else(body); }
        member = member + 1;
      }
      member = 1;
      while member < n { op_end(body); member = member + 1; }
    }

    fn inject(body: IntList, valbuf: IntList, got: Int, want: Int) {
      if is_never(got) {
        # It never arrives, so it is any type at all (D15).
        push_bytes(body, valbuf);
        settle(body, got, want);
        return ();
      }
      if union_remap_needed(got, want) {
        remap_union(body, valbuf, spec(got), spec(want));
        return ();
      }
      if width(want) <= width(got) {
        push_bytes(body, valbuf);
        return ();
      }
      if types::is_unit_decl(got) {
        push_bytes(body, valbuf);
        pad(body, want, 1);
        return ();
      }
      let head = types::head_of(got);
      if !ast::is_some(head) {
        cg_error(c_unsupported(), ast::none());
        push_bytes(body, valbuf);
        return ();
      }
      # A limit of this layout, not a type error: the check pass, laying
      # out nothing real, has nothing to say about it.
      if !checking() {
        if !disjoint_union(spec(want)) { check_slots(got, want, head); }
      }
      let offset = union_offset(want, head);
      op_i32_const(body, types::unit_code(head));
      var i = 1;
      while i < offset {
        push_zero(body, valtype_at(want, i));
        i = i + 1;
      }
      push_bytes(body, valbuf);
      pad(body, want, offset + width(got));
    }

    # A union's slot has one valtype, its first member's that reaches it
    # (D59); a member that puts a reference where another puts a scalar,
    # or the other way round, would need a slot of each, which this
    # layout does not have. Reported (`c_unsupported`, by the member)
    # rather than compiled to a module that fails to validate.
    fn check_slots(got: Int, want: Int, head: Int) {
      var i = 0;
      while i < width(got) {
        let mine = valtype_at(got, i);
        let slot = valtype_at(want, i + 1);
        if mine != slot {
          if emit::is_ref(mine) {
            cg_error(c_unsupported(), prog::sym_name.get(head));
            return ();
          }
          if emit::is_ref(slot) {
            cg_error(c_unsupported(), prog::sym_name.get(head));
            return ();
          }
        }
        i = i + 1;
      }
    }

    # The union's slots from `from` on, as zeros of their own valtypes.
    fn pad(body: IntList, want: Int, from: Int) {
      var i = from;
      while i < width(want) {
        push_zero(body, valtype_at(want, i));
        i = i + 1;
      }
    }

    # Emit `e` where a value of type `want` is expected. An `if`, a
    # `match` or a block passes the expectation on to whatever produces
    # its value, so that each branch injects rather than the whole
    # expression having to be widened after the fact.
    fn emit_as(body: IntList, e: Int, m: Int, want: Int): Int {
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(e)) { prog::location.write(e + 1); }
      let result = emit_as_inner(body, e, m, want);
      prog::location.write(saved);
      result
    }

    fn emit_as_inner(body: IntList, e: Int, m: Int, want: Int): Int {
      if !ast::is_some(want) {
        return emit_expr(body, e, m);
      }
      let k = ast::kind_of(e);
      if k == ast::k_ex_if() {
        return emit_if_as(body, e, m, want);
      }
      if k == ast::k_ex_block() {
        return emit_block_as(body, e, m, want);
      }
      if k == ast::k_ex_match() {
        return emit_match_as(body, e, m, want);
      }
      let tmp = int_list();
      let got = emit_expr(tmp, e, m);
      # D17, as the bootstrap checks it: what a position yields must fit
      # what it declared. Both are generic — the code as written, where
      # two generations of a type are two types (D72) however this
      # specialization makes them — so the answer is the same in every
      # specialization. A got with no width is either real unit or a body
      # that jumped out — this back end types both as unit — so only a
      # valued got is held to it.
      if width(got) > 0 {
        if !types::fits(got, want) {
          cg_error(c_bad_type(), ast::none());
        }
      }
      if width(got) == width(want) {
        if !union_remap_needed(got, want) {
          push_bytes(body, tmp);
          return got;
        }
      }
      inject(body, tmp, spec(got), spec(want));
      want
    }

    fn emit_path(body: IntList, e: Int, m: Int): Int {
      let p = ast::a_of(e);
      if ast::path_len(p) == 1 {
        let local = find_local(ast::path_at(p, 0));
        if ast::is_some(local) {
          load_local(body, local);
          return lc_type.get(local);
        }
      }
      let sym = prog::resolve_path(m, p);
      if !ast::is_some(sym) {
        semantic_error(prog::e_scope(), ast::path_last(p));
        return ty_none();
      }
      # A `unit` value is its discriminant and nothing else (D59).
      if prog::sym_kind.get(sym) == prog::sk_unit() {
        op_i32_const(body, types::unit_code(sym));
        return types::ty_of_decl(sym);
      }
      if in_wasm(sym) {
        runtime_primitive(sym);
        let op = wops::find_op(prog::sym_name.get(sym));
        if ast::is_some(op) {
          emit_op(body, op);
          return op_result(op);
        }
        cg_error(c_unknown_op(), prog::sym_name.get(sym));
        return ty_none();
      }
      # A val nobody defined is context: its value arrived as a
      # parameter, or a `bind` in an enclosing block put it in a local.
      if prog::sym_kind.get(sym) == prog::sk_val() {
        if !ast::is_some(ast::c_of(prog::sym_decl.get(sym))) {
          let l = provision_of(ast::none(), sym);
          if ast::is_some(l) {
            load_local(body, l);
            return lc_type.get(l);
          }
          cg_error(c_unbound(), prog::sym_name.get(sym));
          return ty_none();
        }
      }
      if in_bool(sym) {
        let t = spelled();
        sp_true(t);
        if sym_named(sym, t) {
          op_i32_const(body, 1);
          return cg_boolty.read();
        }
        let f = spelled();
        sp_false(f);
        if sym_named(sym, f) {
          op_i32_const(body, 0);
          return cg_boolty.read();
        }
      }
      cg_error(c_unbound(), prog::sym_name.get(sym));
      ty_none()
    }

    fn emit_call(body: IntList, e: Int, m: Int): Int {
      let callee = ast::a_of(e);
      let sym = prog::resolve_path(m, ast::a_of(callee));
      if !ast::is_some(sym) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(callee)));
        return ty_none();
      }
      # A nominal value *is* its payload (D58), so constructing one emits
      # the payload and nothing more — the payload at the nominal's arguments.
      if prog::sym_kind.get(sym) == prog::sk_tag() {
        let nominal = tag_type(callee, sym, m);
        let want = int_list();
        want.push(types::member_payload(nominal));
        emit_args(body, ast::b_of(e), ast::c_of(e), m, want);
        if is_ref_type(spec(nominal)) {
          # D75: a `Ref` built from a bare `StructRef` is forged, and the
          # one place a reference is cast — to the struct of what it
          # claims to hold, trapping if it does not.
          let held = held_of(spec(nominal));
          if unknown_held(held) {
            if checking() {
              return nominal;
            }
            cg_error(c_unbound(), prog::sym_name.get(sym));
            return nominal;
          }
          op_ref_cast_null(body, ref_valtype(held));
        }
        if is_array_type(spec(nominal)) {
          # D81: and so is an `Array` built from a bare `ArrayRef`.
          let held = array_held(spec(nominal));
          if unknown_held(held) {
            if checking() {
              return nominal;
            }
            cg_error(c_unbound(), prog::sym_name.get(sym));
            return nominal;
          }
          op_ref_cast_null(body, emit::vt_ref(array_of(held)));
        }
        return nominal;
      }
      if is_defined_fn(sym) {
        let demark = cg_env.read();
        let dgmark = cg_genv.read();
        let dpmark = pv_top.read();
        let dfloor = pv_floor.read();
        let dsmark = es_top.read();
        demand_needs(body, sym, e);
        check_callee(sym);
        let map = int_list();
        let env = callee_env(sym, map);
        emit_args_in(body, ast::b_of(e), ast::c_of(e), m, sig_params(cg_genv.read(), sym, ast::none()), demark, dgmark);
        reach(sym, env);
        push_needs(body, sym, env, ast::none(), map);
        op_call(body, index_of_fn(sym, env));
        let ret = sig_ret(cg_genv.read(), sym, ast::none());
        cg_env.write(demark);
        cg_genv.write(dgmark);
        pv_top.write(dpmark);
        pv_floor.write(dfloor);
        es_top.write(dsmark);
        return ret;
      }
      # An abstract fn the context provides. D2: statically a direct
      # call, with the captured context passed as data; typed by its
      # provision in the generic environment (D72).
      if !in_wasm(sym) {
        let bound = lower::env_find(
          cg_env.read(), lower::ek_fn(), ast::none(), sym
        );
        let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), ast::none(), sym);
        if ast::is_some(bound) {
          if ast::is_some(lower::env_a_of(bound)) {
            # Provided by a primitive (D66): a call to that.
            if !is_compilable(lower::env_a_of(bound)) {
              return emit_primitive_call(body, e, m, lower::env_a_of(bound));
            }
            if ast::is_some(grow) {
              let view = row_view(grow);
              emit_args(body, ast::b_of(e), ast::c_of(e), m, sig_params(view, sym, ast::none()));
              return emit_provided(body, bound, sig_ret(view, sym, ast::none()));
            }
          }
        }
        # The check pass: provided generically, by nothing here.
        if checking() {
          if ast::is_some(grow) {
            if !provides(bound) {
              if !in_wasi(sym) {
                if !is_i32_bool(sym) {
                  let view = row_view(grow);
                  emit_args(body, ast::b_of(e), ast::c_of(e), m, sig_params(view, sym, ast::none()));
                  return sig_ret(view, sym, ast::none());
                }
              }
            }
          }
        }
      }
      emit_primitive_call(body, e, m, sym)
    }

    # A call to an instruction, a WASI import, or `i32_bool` — the
    # primitive context, which nothing provides because it is the bottom.
    fn emit_primitive_call(body: IntList, e: Int, m: Int, sym: Int): Int {
      runtime_primitive(sym);
      emit_args(body, ast::b_of(e), ast::c_of(e), m, param_types(sym));
      if in_wasm(sym) {
        runtime_primitive(sym);
        let op = wops::find_op(prog::sym_name.get(sym));
        if ast::is_some(op) {
          emit_op(body, op);
          return op_result(op);
        }
        cg_error(c_unknown_op(), prog::sym_name.get(sym));
        return ty_none();
      }
      if is_i32_bool(sym) {
        op_i32_const(body, 0);
        body.push(71);
        return cg_boolty.read();
      }
      if in_wasi(sym) {
        reach_import(sym);
        op_call(body, index_of_import(sym));
        return elab_ty(
          ast::fn_ret(prog::sym_decl.get(sym)), prog::sym_mod.get(sym)
        );
      }
      cg_error(c_unbound(), prog::sym_name.get(sym));
      ty_none()
    }

    # D75: a call through what `bind Heap;` provided. `.boxed()` is
    # `struct.new` of the struct for the receiver's type, and `.deref()`
    # one `struct.get` per field of the struct for what the receiver
    # holds — its own `Boxed` (D74), whatever this frame has bound since.
    # The receiver is already emitted into `recv`.
    fn emit_platform(
      body: IntList, recv: IntList, recv_ty: Int, prim: Int, nargs: Int, name: Int,
      gret: Int
    ): Int {
      let ty = spec(recv_ty);
      var held = ty;
      if prim == 2 {
        held = held_of(ty);
      }
      if nargs != 0 {
        cg_error(c_bad_type(), name);
      }
      if unknown_held(held) {
        if checking() {
          return gret;
        }
        cg_error(c_unbound(), name);
        return ty_none();
      }
      let j = struct_of(held);
      push_bytes(body, recv);
      if prim == 1 {
        op_struct_new(body, j);
        return gret;
      }
      if width(held) == 0 {
        op_drop(body);
        return gret;
      }
      let tmp = reveal(ast::none(), recv_ty);
      store_local(body, tmp);
      var i = 0;
      while i < width(held) {
        op_local_get(body, local_slot(tmp, 0));
        op_struct_get(body, j, i);
        i = i + 1;
      }
      gret
    }

    # D81: a call through what `bind Mutable;` or `bind Arrays;` provided.
    # The receiver (already emitted into `recv`) and each argument go to
    # locals, and the operation is done once per lane — on the array
    # itself where what it holds is one scalar, otherwise on each lane
    # array the struct holds. `Ref.set` is a `struct.set` per field, and
    # makes the struct's fields mutable.
    fn emit_gc_op(
      body: IntList, recv: IntList, recv_ty: Int, prim: Int, run: Int, n: Int, m: Int,
      params: IntList, name: Int, gret: Int
    ): Int {
      let ty = spec(recv_ty);
      var held = ty;
      if prim == 3 {
        held = held_of(ty);
      } else if prim > 4 {
        held = array_held(ty);
      }
      if n != params.length() {
        cg_error(c_bad_type(), name);
      }
      if unknown_held(held) {
        if checking() {
          return gret;
        }
        cg_error(c_unbound(), name);
        return ty_none();
      }
      push_bytes(body, recv);
      let r = reveal(ast::none(), recv_ty);
      store_local(body, r);
      emit_args(body, run, n, m, params);
      let args = int_list();
      var i = 0;
      while i < n {
        args.push(reveal(ast::none(), params.get(i)));
        i = i + 1;
      }
      i = n;
      while i > 0 {
        i = i - 1;
        store_local(body, args.get(i));
      }
      if prim == 3 {
        let j = struct_of(held);
        if !checking() {
          emit::make_mutable(j);
        }
        i = 0;
        while i < width(held) {
          op_local_get(body, local_slot(r, 0));
          op_local_get(body, local_slot(args.get(0), i));
          op_struct_set(body, j, i);
          i = i + 1;
        }
        return gret;
      }
      let j = array_of(held);
      let w = width(held);
      if prim == 4 {
        i = 0;
        while i < w {
          op_local_get(body, local_slot(r, i));
          op_local_get(body, local_slot(args.get(0), 0));
          op_array_new(body, lane_at(j, held, i));
          i = i + 1;
        }
        if w > 1 {
          op_struct_new(body, j);
        }
        return gret;
      }
      if prim == 5 {
        lane(body, r, j, w, 0);
        op_array_len(body);
        return gret;
      }
      i = 0;
      while i < w {
        let lj = lane_at(j, held, i);
        lane(body, r, j, w, i);
        op_local_get(body, local_slot(args.get(0), 0));
        if prim == 6 {
          op_array_get(body, lj);
        } else if prim == 7 {
          op_local_get(body, local_slot(args.get(1), i));
          op_array_set(body, lj);
        } else if prim == 8 {
          op_local_get(body, local_slot(args.get(1), i));
          op_local_get(body, local_slot(args.get(2), 0));
          op_array_fill(body, lj);
        } else {
          lane(body, args.get(1), j, w, i);
          op_local_get(body, local_slot(args.get(2), 0));
          op_local_get(body, local_slot(args.get(3), 0));
          op_array_copy(body, lj);
        }
        i = i + 1;
      }
      gret
    }

    # Lane `i` of the array in local `l`: the array itself if it has one.
    fn lane(body: IntList, l: Int, j: Int, w: Int, i: Int) {
      op_local_get(body, local_slot(l, 0));
      if w > 1 {
        op_struct_get(body, j, i);
      }
    }

    fn lane_at(j: Int, held: Int, i: Int): Int {
      if width(held) > 1 {
        return lane_of(valtype_at(held, i));
      }
      j
    }

    # A call to whatever a bind put here: the arguments are already on
    # the stack, so this is the provider's needs and the call. It yields
    # `ret`, what the provision is typed to return.
    fn emit_provided(body: IntList, bound: Int, ret: Int): Int {
      let provider = lower::env_a_of(bound);
      let penv = lower::env_b_of(bound);
      reach(provider, penv);
      push_needs(body, provider, penv, bound, int_list());
      op_call(body, index_of_fn(provider, penv));
      ret
    }

    # The callee's needs, in its order, taken from this frame. A need the
    # frame cannot supply is the context error of D20 rather than a
    # scope error: the name is fine, nobody provided it here.
    fn push_needs(body: IntList, callee: Int, env: Int, via: Int, map: IntList) {
      let vals = int_list();
      val_slots(vals, callee, env, 0);
      var i = 0;
      while i < vals.length() {
        let l = provision_of(ast::none(), caller_slot(vals.get(i), via, map));
        if ast::is_some(l) {
          load_local(body, l);
        } else {
          cg_error(c_unbound(), prog::sym_name.get(slot_sym(vals.get(i))));
        }
        i = i + 1;
      }
    }

    # A callee's slot as this frame knows it. Everything a bound provider
    # takes was captured by the bind that made `via`; a direct callee
    # takes its own vals by symbol, and a captured one under whichever
    # entry of this frame its binding came from (`map`, from
    # `callee_env`).
    fn caller_slot(slot: Int, via: Int, map: IntList): Int {
      if ast::is_some(via) {
        return ck_slot(via, slot);
      }
      if is_captured(slot) {
        let row = ck_row(slot);
        var i = 0;
        while i < map.length() {
          if map.get(i) == ck_entry.get(row) {
            return ck_slot(map.get(i + 1), ck_inner.get(row));
          }
          i = i + 2;
        }
      }
      slot
    }

    # D26: a provider's context is captured at the bind site. Each slot
    # it takes is provided again under the entry the bind just made, from
    # the local that holds it here — a bound val's local is written once,
    # by its own bind, so sharing it is the capture. The provider's
    # environment is the one a direct call would compile it in
    # (`callee_env`), and `map` says which entry of this frame each of
    # its captured slots comes from.
    fn capture(entry: Int, map: IntList, mode: Int) {
      if mode != bw_emit() {
        return ();
      }
      let vals = int_list();
      val_slots(vals, lower::env_a_of(entry), lower::env_b_of(entry), 0);
      var i = 0;
      while i < vals.length() {
        let l = provision_of(ast::none(), caller_slot(vals.get(i), ast::none(), map));
        if ast::is_some(l) {
          provide(ast::none(), ck_slot(entry, vals.get(i)), l);
        }
        i = i + 1;
      }
    }

    # What `capture` does for a provision copied from `bound` (D66): the
    # values travel with that provision, so each is the one `bound`
    # carries here, not whatever its val is bound to by now.
    fn recapture(entry: Int, bound: Int, mode: Int) {
      if mode != bw_emit() {
        return ();
      }
      let vals = int_list();
      val_slots(vals, lower::env_a_of(entry), lower::env_b_of(entry), 0);
      var i = 0;
      while i < vals.length() {
        let l = provision_of(ast::none(), ck_slot(bound, vals.get(i)));
        if ast::is_some(l) {
          provide(ast::none(), ck_slot(entry, vals.get(i)), l);
        }
        i = i + 1;
      }
    }

    # The declared parameter types of a primitive callee, as this frame's
    # code sees them, or an empty list when it has none the back end can
    # see (a tag construction, an instruction).
    fn param_types(sym: Int): IntList {
      let out = int_list();
      let kind = prog::sym_kind.get(sym);
      # Constructing a nominal takes its payload (D58).
      if kind == prog::sk_tag() {
        out.push(types::member_payload(types::ty_of_decl(sym)));
        return out;
      }
      var ok = kind == prog::sk_fn();
      if !ok {
        ok = kind == prog::sk_method();
      }
      if !ok {
        return out;
      }
      let d = prog::sym_decl.get(sym);
      let home = prog::sym_mod.get(sym);
      var i = 0;
      while i < ast::fn_nparams(d) {
        out.push(elab_ty(ast::b_of(ast::kid_at(ast::fn_params(d), i)), home));
        i = i + 1;
      }
      out
    }

    # Q4: a call's arguments are checked and emitted in the caller's
    # context Γ (`env`, `genv`, as they were before the call's family
    # demands), never with the demanded families in force: an argument
    # means what it means in `let a = e; f(a)`. The demands' binds bind
    # no vals (D84 rule 7), so emitting their code first is not observed.
    fn emit_args_in(body: IntList, run: Int, n: Int, m: Int, want: IntList, env: Int, genv: Int) {
      let hon = cg_aon.read();
      let haenv = cg_aenv.read();
      let hagenv = cg_agenv.read();
      cg_aenv.write(env);
      cg_agenv.write(genv);
      cg_aon.write(1);
      emit_args(body, run, n, m, want);
      cg_aon.write(hon);
      cg_aenv.write(haenv);
      cg_agenv.write(hagenv);
    }

    fn emit_args(body: IntList, run: Int, n: Int, m: Int, want: IntList) {
      # D84 rule 7: the arguments of a call on demand are the caller's.
      let on = cg_aon.read();
      let env = cg_env.read();
      let genv = cg_genv.read();
      if on == 1 {
        cg_env.write(cg_aenv.read());
        cg_genv.write(cg_agenv.read());
        cg_aon.write(0);
      }
      var i = 0;
      while i < n {
        var expect = ast::none();
        if i < want.length() {
          expect = want.get(i);
        }
        emit_as(body, ast::kid_at(run, i), m, expect);
        i = i + 1;
      }
      if on == 1 {
        cg_env.write(env);
        cg_genv.write(genv);
        cg_aon.write(1);
      }
    }

    # D79: a memory instruction, `Addr`'s method `name`, which the
    # platform's `Memories` provides: the receiver is the address (for
    # `memory.size` and `memory.grow`, only which memory: evaluated and
    # dropped), at the memory its `Memory` is in this specialization.
    fn emit_mem_op(
      body: IntList, recv: IntList, recv_ty: Int, run: Int, n: Int, m: Int,
      params: IntList, name: Int, gret: Int
    ): Int {
      let op = wops::find_op(name);
      if !ast::is_some(op) {
        cg_error(c_unknown_op(), name);
        return ty_none();
      }
      let mem = memory_at(held_by(spec(recv_ty), addr_sym(), cg_memory.read()));
      push_bytes(body, recv);
      if wops::op_kinds.get(op) == wops::wk_memzero() {
        drop_value(body, recv_ty);
      }
      emit_args(body, run, n, m, params);
      emit_op_at(body, op, mem);
      gret
    }

    fn emit_op(body: IntList, op: Int) { emit_op_at(body, op, 0); }

    fn emit_op_at(body: IntList, op: Int, mem: Int) {
      let kind = wops::op_kinds.get(op);
      let code = wops::op_codes.get(op);
      if kind == wops::wk_simple() {
        body.push(code);
      } else if kind == wops::wk_memarg() {
        op_mem_at(body, code, wops::op_aligns.get(op), mem);
      } else if kind == wops::wk_const0() {
        op_i32_const(body, 0);
      } else if kind == wops::wk_const1() {
        op_i32_const(body, 1);
      } else if kind == wops::wk_memzero() {
        body.push(code);
        uleb(body, mem);
      } else if kind == wops::wk_memcopy() {
        op_memory_copy_at(body, mem);
      } else if kind == wops::wk_prefixed() {
        # 0xFC, then the sub-opcode the table keeps as an alignment.
        body.push(code);
        uleb(body, wops::op_aligns.get(op));
      } else {
        op_memory_fill_at(body, mem);
      }
    }

    # D79: the memory a memory instruction names, from `t`, what its
    # receiver's `Memory` is in this specialization. The platform's, the
    # main memory, is 0; any other type, a memory of its own, numbered the
    # first time it is met (`Memories` is polymorphic in `Memory`, D84).
    fn memory_at(t: Int): Int {
      let mem = cg_memory.read();
      if !ast::is_some(mem) {
        return 0;
      }
      if types::is_kind(t, types::kd_abstract()) {
        if types::sym_of(t) == mem {
          return 0;
        }
        if types::sym_of(t) == prog::param_of(mem) {
          return 0;
        }
        if t == main_memory() {
          return 0;
        }
        # D84 3c: a `Memory` each application supplies, fresh where a
        # binding is checked: code nothing runs.
        if checking() {
          return 0;
        }
      }
      if types::is_kind(t, types::kd_abstract()) {
        cg_error(c_unsupported(), prog::sym_name.get(mem));
        return 0;
      }
      if checking() {
        return 0;
      }
      emit::memory_index(t)
    }

    fn emit_block(body: IntList, e: Int, m: Int): Int {
      emit_block_as(body, e, m, ast::none())
    }

    fn emit_block_as(body: IntList, e: Int, m: Int, want: Int): Int {
      let mark = lc_visible.read();
      let smark = es_top.read();
      let pmark = pv_top.read();
      let emark = cg_env.read();
      let gmark = cg_genv.read();
      var diverged = false;
      var i = 0;
      while i < ast::b_of(e) {
        diverged = emit_stmt(body, ast::kid_at(ast::a_of(e), i), m);
        i = i + 1;
      }
      var ty = ty_none();
      if ast::is_some(ast::c_of(e)) {
        ty = emit_as(body, ast::c_of(e), m, want);
      } else {
        # Without a tail a block yields `()`, or `|` if its last statement
        # cannot fall through; held to what is expected, as the
        # bootstrap's `synth_block` holds it.
        if diverged {
          ty = types::ty_never();
        }
        if ast::is_some(want) {
          if !types::fits(ty, want) {
            cg_error(c_bad_type(), ast::none());
          } else if diverged {
            settle(body, ty, want);
            ty = want;
          }
        }
      }
      check_escape(ty, smark);
      es_top.write(smark);
      close_scope(mark);
      pv_top.write(pmark);
      cg_env.write(emark);
      cg_genv.write(gmark);
      ty
    }

    # A block's type. One result is its valtype; several is a function
    # type index, which a block type may name — the same multi-value the
    # result list of a function needs, so it costs no more of the engine.
    # The index is written as a signed LEB, which is what distinguishes
    # it from a valtype byte.
    fn open_block(body: IntList, opcode: Int, ty: Int) {
      body.push(opcode);
      if width(ty) == 0 {
        body.push(bt_empty());
      } else if width(ty) == 1 {
        emit::push_valtype(body, valtype_at(ty, 0));
      } else {
        if checking() {
          sleb(body, 0);
          return ();
        }
        let rs = int_list();
        push_valtypes(rs, ty);
        sleb(body, emit::ft_ref(emit::results_type(rs)));
      }
    }

    fn op_if_ty(body: IntList, ty: Int) { open_block(body, 4, ty); }

    # The block type is an immediate of the `if` opcode, so it has to be
    # written before the branch it describes — and it is only known once
    # that branch has been emitted. So the branch goes into a buffer of
    # its own first. The depth is raised around that, since a `break`
    # inside it counts this `if` as one level.
    fn emit_if(body: IntList, e: Int, m: Int): Int {
      emit_if_as(body, e, m, ast::none())
    }

    fn emit_if_as(body: IntList, e: Int, m: Int, want: Int): Int {
      emit_expr(body, ast::a_of(e), m);
      cg_depth.write(cg_depth.read() + 1);
      let then = int_list();
      let ty = emit_as(then, ast::b_of(e), m, want);
      if !ast::is_some(ast::c_of(e)) {
        op_if_ty(body, ty);
        push_bytes(body, then);
        if width(ty) > 0 {
          # An `if` that yields a value has to have an `else` to yield it.
          cg_error(c_bad_type(), ast::none());
        } else if ast::is_some(want) {
          if !types::fits(ty_none(), want) {
            cg_error(c_bad_type(), ast::none());
          }
        }
        op_end(body);
        cg_depth.write(cg_depth.read() - 1);
        return ty_none();
      }
      # The block type is written as soon as it is known, before the
      # `else` is emitted, as it always was: emitting can add a function
      # type, and the order they are added in is their numbering.
      let head = int_list();
      let tj = branch_ty(ast::b_of(e), ty, want);
      if !is_never(tj) {
        op_if_ty(head, tj);
      }
      let els = int_list();
      let ety = emit_as(els, ast::c_of(e), m, want);
      let out = result_ty(tj, branch_ty(ast::c_of(e), ety, want), want);
      if is_never(tj) {
        op_if_ty(head, out);
      }
      push_bytes(body, head);
      push_bytes(body, then);
      settle(body, ty, out);
      op_else(body);
      push_bytes(body, els);
      settle(body, ety, out);
      op_end(body);
      cg_depth.write(cg_depth.read() - 1);
      finish_ty(out, want)
    }

    fn is_never(t: Int): Bool { types::is_kind(lower::canon(cg_genv.read(), t), types::kd_never()) }

    # The type a branch of an `if` or an arm of a `match` yields, for
    # comparing with the others, as the bootstrap's `block_type` has it:
    # a block's tail's, and `()` for a block without one, even when its
    # last statement cannot fall through. With a type expected, each was
    # checked against it instead.
    fn branch_ty(node: Int, got: Int, want: Int): Int {
      if ast::is_some(want) {
        return got;
      }
      if ast::kind_of(node) == ast::k_ex_block() {
        if !ast::is_some(ast::c_of(node)) {
          return ty_none();
        }
      }
      got
    }

    # The type of an `if` or a `match` so far, `acc`, with one more
    # branch's, `t`. With nothing expected the branches agree, or one
    # diverges, as the bootstrap's `join` has it, after applying the merges
    # of the generic context (D43), before specialization. With a type expected,
    # the first branch that does not diverge gives the layout.
    fn result_ty(acc: Int, t: Int, want: Int): Int {
      if is_never(acc) {
        return t;
      }
      if is_never(t) {
        return acc;
      }
      if !ast::is_some(want) {
        if lower::canon(cg_genv.read(), acc) != lower::canon(cg_genv.read(), t) {
          cg_error(c_bad_type(), ast::none());
        }
      }
      acc
    }

    # With a type expected, an `if` or a `match` whose every branch
    # diverges still has that type, as in the bootstrap.
    fn finish_ty(out: Int, want: Int): Int {
      if ast::is_some(want) {
        if is_never(out) {
          return want;
        }
      }
      out
    }

    # A branch that diverges, where the whole yields a value: a call of a
    # function that returns `|` falls through as far as the validator can
    # see, so it is told.
    fn settle(body: IntList, got: Int, out: Int) {
      if is_never(got) {
        if width(out) > 0 {
          op_unreachable(body);
        }
      }
    }

    fn push_slice(out: IntList, from: IntList, start: Int, end: Int) {
      var i = start;
      while i < end {
        out.push(from.get(i));
        i = i + 1;
      }
    }

    # `match`, for the two shapes this back end covers. When the
    # scrutinee's type has one possible head nothing needs
    # discriminating: the first arm always matches, and a tag pattern
    # just names the payload that is already on the stack. When every
    # member is a unit the value *is* the discriminant, so the arms
    # become a chain of comparisons against unit codes.
    fn emit_match(body: IntList, e: Int, m: Int): Int {
      emit_match_as(body, e, m, ast::none())
    }

    fn emit_match_as(body: IntList, e: Int, m: Int, want: Int): Int {
      let sty = lower::canon(cg_genv.read(), type_of(ast::a_of(e), m));
      let ty = emit_match_shaped(body, e, m, sty, want);
      check_exhaustive(e, m, sty);
      ty
    }

    fn emit_match_shaped(body: IntList, e: Int, m: Int, sty: Int, want: Int): Int {
      if ast::c_of(e) == 0 {
        # `match e {}` requires `e : |` (D34): evaluate and diverge.
        emit_expr(body, ast::a_of(e), m);
        op_unreachable(body);
        return finish_ty(types::ty_never(), want);
      }
      # The shape is the specialization's; the arms are typed generically.
      if types::head_count(spec(sty)) == 1 {
        return emit_single_arm(body, e, m, sty, want);
      }
      emit_union_match(body, e, m, sty, want)
    }

    # One possible head: bind and run the first arm. The rest are
    # checked, and run nowhere.
    fn emit_single_arm(body: IntList, e: Int, m: Int, sty: Int, want: Int): Int {
      let mark = lc_visible.read();
      emit_expr(body, ast::a_of(e), m);
      let arm = ast::kid_at(ast::b_of(e), 0);
      let ty = emit_single_arm_body(body, arm, m, sty, want);
      close_scope(mark);
      let out = check_arms(e, m, sty, ast::none(), 1, want, branch_ty(ast::b_of(arm), ty, want));
      settle(body, ty, out);
      finish_ty(out, want)
    }

    fn emit_single_arm_body(body: IntList, arm: Int, m: Int, sty: Int, want: Int): Int {
      let mark = lc_visible.read();
      bind_pattern(body, ast::a_of(arm), sty, m);
      let ty = emit_as(body, ast::b_of(arm), m, want);
      close_scope(mark);
      ty
    }

    # D16 and D34: every arm is checked against the scrutinee's type as
    # written, including those that this specialization's shape never
    # runs — after the first where it has one head, after a binder or `_`
    # in a union (`tmp` holds the scrutinee there; none for one head).
    # On a scrutinee of abstract type both happen, whatever it is
    # specialized to. They are walked as dead code, into nothing, and
    # what they yield joins `acc`, the type of the arms before them.
    fn check_arms(
      e: Int, m: Int, sty: Int, tmp: Int, from: Int, want: Int, acc: Int
    ): Int {
      var out = acc;
      var i = from;
      while i < ast::c_of(e) {
        let was = dead();
        let junk = int_list();
        let arm = ast::kid_at(ast::b_of(e), i);
        var ty = ty_none();
        if ast::is_some(tmp) {
          ty = emit_match_arm_body(junk, arm, m, sty, tmp, want);
        } else {
          ty = emit_single_arm_body(junk, arm, m, sty, want);
        }
        alive(was);
        out = result_ty(out, branch_ty(ast::b_of(arm), ty, want), want);
        i = i + 1;
      }
      out
    }

    # D34: a unit or tag pattern — bare, binding a payload, or
    # destructuring a record — names a member of the scrutinee's type as
    # written. An abstract type's one head is itself, so no unit or tag is
    # a member of it, whatever it specializes to: what a match means
    # cannot depend on the specialization (D16).
    # And it is one: a single name is a binder only when it names
    # nothing, and a unit or tag otherwise; a payload or a record of
    # fields opens a tag. Reported by the name it was written with, as
    # the bootstrap's `compile_pattern` reports it.
    fn check_member(pat: Int, m: Int, sty: Int) {
      if pattern_bad(pat, m, sty) {
        var name = ast::none();
        if ast::kind_of(pat) == ast::k_pt_path() {
          name = ast::path_last(ast::a_of(pat));
        } else if ast::is_some(ast::a_of(pat)) {
          name = ast::path_last(ast::a_of(pat));
        }
        cg_error(c_bad_type(), name);
      }
    }

    fn pattern_bad(pat: Int, m: Int, sty: Int): Bool {
      let k = ast::kind_of(pat);
      if k == ast::k_pt_path() {
        let sym = prog::resolve_path(m, ast::a_of(pat));
        if !ast::is_some(sym) {
          return ast::is_some(ast::b_of(pat));
        }
        let kind = prog::sym_kind.get(sym);
        if kind != prog::sk_tag() {
          if kind != prog::sk_unit() {
            return true;
          }
          if ast::is_some(ast::b_of(pat)) {
            return true;
          }
        }
      } else if k == ast::k_pt_record() {
        if !ast::is_some(ast::a_of(pat)) {
          return true;
        }
        let sym = prog::resolve_path(m, ast::a_of(pat));
        if !ast::is_some(sym) {
          return true;
        }
        if prog::sym_kind.get(sym) != prog::sk_tag() {
          return true;
        }
      } else {
        return false;
      }
      !ast::is_some(types::member_with_head(sty, arm_head_any(pat, m)))
    }

    # D34: without a binder or `_`, the arms cover every head of the
    # scrutinee's type as written — whichever a specialization has, as
    # the bootstrap's `synth_match` checks it — and `match e {}` is for
    # an `e : |` alone, which takes no arms. Checked after the arms, as
    # the bootstrap does, and not at all once a pattern is ill-formed or
    # names no member (`check_member` said so). Reports the first head
    # missing, or none for a scrutinee with no head to cover.
    fn check_exhaustive(e: Int, m: Int, sty: Int) {
      let n = ast::c_of(e);
      var a = 0;
      while a < n {
        if pattern_bad(ast::a_of(ast::kid_at(ast::b_of(e), a)), m, sty) {
          return ();
        }
        a = a + 1;
      }
      if types::is_kind(sty, types::kd_never()) {
        if n > 0 {
          cg_error(c_bad_type(), ast::none());
        }
        return ();
      }
      var i = 0;
      while i < n {
        let pat = ast::a_of(ast::kid_at(ast::b_of(e), i));
        if ast::kind_of(pat) == ast::k_pt_wild() {
          return ();
        }
        if ast::kind_of(pat) == ast::k_pt_path() {
          if !ast::is_some(ast::b_of(pat)) {
            if !ast::is_some(prog::resolve_path(m, ast::a_of(pat))) {
              return ();
            }
          }
        }
        i = i + 1;
      }
      var count = 1;
      if types::is_kind(sty, types::kd_union()) {
        count = types::member_count(sty);
      }
      var heads = 0;
      var j = 0;
      while j < count {
        var member = sty;
        if types::is_kind(sty, types::kd_union()) {
          member = types::member_at(sty, j);
        }
        let head = types::head_of(member);
        if ast::is_some(head) {
          heads = heads + 1;
          if !covers(e, m, head) {
            cg_error(c_bad_type(), prog::sym_name.get(head));
            return ();
          }
        }
        j = j + 1;
      }
      if heads == 0 {
        cg_error(c_bad_type(), ast::none());
      }
    }

    fn covers(e: Int, m: Int, head: Int): Bool {
      var i = 0;
      while i < ast::c_of(e) {
        if arm_head_any(ast::a_of(ast::kid_at(ast::b_of(e), i)), m) == head {
          return true;
        }
        i = i + 1;
      }
      false
    }

    # A pattern against a value already on the stack. A binder takes the
    # whole value; a tag pattern takes its payload, which is the same
    # scalars (D58); a wildcard drops it.
    fn bind_pattern(body: IntList, pat: Int, sty: Int, m: Int) {
      check_member(pat, m, sty);
      let k = ast::kind_of(pat);
      if k == ast::k_pt_wild() {
        drop_value(body, sty);
        return ();
      }
      if k == ast::k_pt_record() {
        let rec = pattern_record(pattern_payload(pat, sty, m));
        if !record_pattern_ok(pat, rec, m) {
          drop_value(body, sty);
          cg_error(c_unsupported(), ast::none());
          return ();
        }
        let tmp = reveal(ast::none(), pattern_payload(pat, sty, m));
        store_local(body, tmp);
        bind_record_fields(body, pat, rec, m, tmp, 0);
        return ();
      }
      if k != ast::k_pt_path() {
        cg_error(c_unsupported(), ast::none());
        return ();
      }
      let sub = ast::b_of(pat);
      if !ast::is_some(sub) {
        # A single name is a binder unless it resolves to a unit or tag,
        # and a resolved one carries no payload to name.
        if ast::is_some(arm_head_any(pat, m)) {
          drop_value(body, sty);
          return ();
        }
        bind_here(body, ast::path_last(ast::a_of(pat)), sty);
        return ();
      }
      let payload = types::member_payload(sty);
      if ast::kind_of(sub) == ast::k_pt_path() {
        if !ast::is_some(ast::b_of(sub)) {
          bind_here(body, ast::path_last(ast::a_of(sub)), payload);
          return ();
        }
        # A nested tag pattern; at least name the tag it opens.
        cg_error(c_unsupported(), ast::path_last(ast::a_of(sub)));
        return ();
      }
      if ast::kind_of(sub) == ast::k_pt_wild() {
        drop_value(body, payload);
        return ();
      }
      cg_error(c_unsupported(), ast::none());
    }

    fn bind_here(body: IntList, name: Int, ty: Int) {
      store_local(body, reveal(name, ty));
    }

    fn drop_value(body: IntList, ty: Int) {
      var i = 0;
      while i < width(ty) {
        op_drop(body);
        i = i + 1;
      }
    }

    # A discriminated union: slot zero is the discriminant — for a union
    # of units it is also the whole value — and any further slots are
    # room for the widest member's payload (D59). Testing an arm reads
    # slot zero; taking a payload reads the ones beyond it. One emitter
    # for both shapes.
    fn emit_union_match(body: IntList, e: Int, m: Int, sty: Int, want: Int): Int {
      let scrutinee = int_list();
      emit_expr(scrutinee, ast::a_of(e), m);
      let tmp = reveal(ast::none(), sty);
      push_bytes(body, scrutinee);
      store_local(body, tmp);
      emit_match_arms(body, e, m, sty, tmp, want)
    }

    # The arms this shape runs, up to the first that matches anything,
    # as a chain of `if`s: arm `i` is the `then` of the `i`th, and the
    # last the `else` of the one before. Each is emitted, in order and at
    # its own depth, before the chain is put together, since with nothing
    # expected its block type is what all the arms agree on. What is
    # known early is still written early — a test's unit code, a block
    # type — since both number things in the order they are first met.
    # Into `code`, per arm: its test, its body, its block type, at the
    # offsets in `at`.
    fn emit_match_arms(
      body: IntList, e: Int, m: Int, sty: Int, tmp: Int, want: Int
    ): Int {
      var last = ast::c_of(e) - 1;
      var i = 0;
      while i < last {
        if ast::is_some(arm_head_any(ast::a_of(ast::kid_at(ast::b_of(e), i)), m)) {
          i = i + 1;
        } else {
          last = i;
        }
      }
      let base = cg_depth.read();
      let code = int_list();
      let at = int_list();
      let tys = int_list();
      var out = types::ty_never();
      i = 0;
      while i <= last {
        let arm = ast::kid_at(ast::b_of(e), i);
        at.push(code.length());
        if i < last {
          op_local_get(code, local_slot(tmp, 0));
          op_i32_const(code, types::unit_code(arm_head_any(ast::a_of(arm), m)));
          code.push(70);
          cg_depth.write(base + i + 1);
        } else {
          cg_depth.write(base + i);
        }
        at.push(code.length());
        let ty = emit_match_arm_body(code, arm, m, sty, tmp, want);
        tys.push(ty);
        at.push(code.length());
        let tj = branch_ty(ast::b_of(arm), ty, want);
        if i < last {
          if !is_never(tj) {
            op_if_ty(code, tj);
          }
        }
        at.push(code.length());
        out = result_ty(out, tj, want);
        i = i + 1;
      }
      out = check_arms(e, m, sty, tmp, last + 1, want, out);
      cg_depth.write(base);
      i = 0;
      while i <= last {
        let k = i * 4;
        push_slice(body, code, at.get(k), at.get(k + 1));
        if i < last {
          if at.get(k + 2) == at.get(k + 3) {
            op_if_ty(body, out);
          } else {
            push_slice(body, code, at.get(k + 2), at.get(k + 3));
          }
        }
        push_slice(body, code, at.get(k + 1), at.get(k + 2));
        settle(body, tys.get(i), out);
        if i < last {
          op_else(body);
        }
        i = i + 1;
      }
      i = 0;
      while i < last {
        op_end(body);
        i = i + 1;
      }
      finish_ty(out, want)
    }

    fn emit_match_arm_body(
      body: IntList, arm: Int, m: Int, sty: Int, tmp: Int, want: Int
    ): Int {
      let mark = lc_visible.read();
      let pat = ast::a_of(arm);
      check_member(pat, m, sty);
      if ast::kind_of(pat) == ast::k_pt_record() {
        # The payload sits beside the discriminant, in the scrutinee's
        # temporary.
        let rec = pattern_record(arm_payload(pat, m, sty));
        if record_pattern_ok(pat, rec, m) {
          bind_record_fields(body, pat, rec, m, tmp, union_offset(sty, arm_head_any(pat, m)));
        } else {
          cg_error(c_unsupported(), ast::none());
        }
      }
      if ast::kind_of(pat) == ast::k_pt_path() {
        let sub = ast::b_of(pat);
        if ast::is_some(sub) {
          # Only a bare name takes the payload; `Tag(_)` names nothing, so
          # it needs no local.
          if ast::kind_of(sub) == ast::k_pt_path() {
            if !ast::is_some(ast::b_of(sub)) {
              let payload = arm_payload(pat, m, sty);
              var j = 0;
              while j < width(payload) {
                op_local_get(body, local_slot(tmp, j + union_offset(sty, arm_head_any(pat, m))));
                j = j + 1;
              }
              bind_here(body, ast::path_last(ast::a_of(sub)), payload);
            }
          }
        } else if !ast::is_some(arm_head_any(pat, m)) {
          load_local(body, tmp);
          bind_here(body, ast::path_last(ast::a_of(pat)), sty);
        }
      }
      let ty = emit_as(body, ast::b_of(arm), m, want);
      close_scope(mark);
      ty
    }

    # A unit *or* a tag: both discriminate, and a tag also carries.
    fn arm_head_any(pat: Int, m: Int): Int {
      if ast::kind_of(pat) == ast::k_pt_record() {
        if !ast::is_some(ast::a_of(pat)) {
          return ast::none();
        }
      } else if ast::kind_of(pat) != ast::k_pt_path() {
        return ast::none();
      }
      let sym = prog::resolve_path(m, ast::a_of(pat));
      if !ast::is_some(sym) {
        return ast::none();
      }
      if prog::sym_kind.get(sym) == prog::sk_unit() {
        return sym;
      }
      if prog::sym_kind.get(sym) == prog::sk_tag() {
        return sym;
      }
      ast::none()
    }

    # What the member this pattern selects carries.
    fn arm_payload(pat: Int, m: Int, sty: Int): Int {
      let head = arm_head_any(pat, m);
      if !ast::is_some(head) {
        return ty_none();
      }
      let member = types::member_with_head(sty, head);
      if !ast::is_some(member) {
        return ty_none();
      }
      types::member_payload(member)
    }

    # A bind statement is walked once per pass, and the passes have to
    # agree on what it does, including inside a functor it applies. The
    # mode is what is left of a third walk that counted its locals before
    # emission created them; `bw_emit` is the only mode now.
    fn bw_emit(): Int { 0 }

    # Coherence (D62, D71): a callee's val, fn or method need is met only
    # by a provision made at the instantiation the callee means — the
    # callee's own app for that need, read through this frame's generic
    # environment, must equal the provision's, symbol for symbol. The
    # bootstrap's `require_needs` is the same rule. A need with no
    # provision in the generic environment is not met at all (`e_absent`),
    # used or not; a direct call of a provision needs no check, as
    # it is typed by the provision's own signature.
    fn check_callee(f: Int) { check_callee_at(f, ast::none()); }

    # `recv_ty`: an attached method's receiver type, whose type arguments
    # are in force for the call (rule B); none for anything else.
    fn check_callee_at(f: Int, recv_ty: Int) {
      if !ast::is_some(f) {
        return ();
      }
      if !is_defined_fn(f) {
        if !is_defined_method(f) {
          return ();
        }
      }
      lower::lower_needs(f);
      let genv = cg_genv.read();
      let base = lower::env_of(cg_where.read());
      let fbase = lower::env_of(f);
      # A sibling called with nothing bound since: the same environment,
      # so the same provisions at the same apps.
      if genv == base {
        if fbase == base {
          return ();
        }
      }
      requirements_in_force(f, genv, fbase, recv_ty);
      if checked(lower::need_start(f), genv) {
        return ();
      }
      let merged = lower::merge_conflict(genv, f);
      if ast::is_some(merged) {
        prog::error(prog::e_merge(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(merged));
      }
      # The types this frame has bound, and those the callee has in force
      # that this frame's declaration does not: an app's symbol outside
      # both cannot read differently on the two sides.
      let moved = int_list();
      var e = genv;
      while ast::is_some(e) {
        if e == base {
          e = ast::none();
        } else {
          if lower::env_kind_of(e) == lower::ek_type() {
            types::push_new(moved, lower::env_sym_of(e));
          }
          e = lower::env_next_of(e);
        }
      }
      let bound_here = moved.length() > 0;
      e = fbase;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          if !lower::env_has(base, lower::ek_type(), ast::none(), lower::env_sym_of(e)) {
            types::push_new(moved, lower::env_sym_of(e));
          }
        }
        e = lower::env_next_of(e);
      }
      let incoherent = int_list();
      var i = 0;
      while i < lower::needs_count(f) {
        let r = lower::need_recv_at(f, i);
        let s = lower::need_sym_at(f, i);
        let key = need_key_recv(f, genv, r);
        let row = lower::env_find(genv, lower::need_kind(s), key, s);
        # D84 (O2): a functor is compared like any need, used or not.
        if ast::is_some(row) {
          let want = lower::need_app_at(f, i);
          let have = lower::env_b_of(row);
          if !coherent(s, want, fbase, have, base, genv, moved, bound_here, true) {
            incoherent.push(s);
          } else if !ast::is_some(merged) {
            # Where the callee's merges fail here, its types do not read
            # as one; that is the error to report.
            if !provision_fits(s, r, key, row, fbase, genv) {
              incoherent.push(s);
            }
          }
        } else {
          # D20, D16: a callee requires everything its declaration
          # assumes, whether or not its body uses it — what a call needs
          # is read off the declaration, as the bootstrap's
          # `require_needs` reads it, not off what reaching the body finds.
          prog::error(prog::e_absent(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(s));
        }
        i = i + 1;
      }
      if incoherent.length() > 0 {
        report_incoherent(f, incoherent);
      }
    }

    # Rule B (criteria sections 2 and 3): using an item — calling a
    # defined fn or attached method, or binding one as a provider — needs
    # each type its assume nesting requires in force here: assumed or
    # bound in the generic environment `genv` (for an attached method,
    # also a type argument of its receiver), or in force through the
    # item's merge class in its own context `fbase` (a member in force
    # here, or a structured type all of whose symbols are). Otherwise a
    # requirement the caller leaves unbound would be read as itself, and
    # a family demand could key a provision at a type out of force.
    fn requirements_in_force(f: Int, genv: Int, fbase: Int, recv_ty: Int) {
      if is_lambda(f) {
        return ();
      }
      if lower::is_root_fn(f) {
        return ();
      }
      let reqs = int_list();
      lower::nest_types(prog::sym_mod.get(f), prog::sym_asm.get(f), prog::sym_nasm.get(f), reqs, int_list());
      let given = int_list();
      if ast::is_some(recv_ty) {
        if types::kind_of(recv_ty) == types::kd_nominal() {
          if types::member_count(recv_ty) > 0 {
            types::reqs_of(types::sym_of(recv_ty), given);
          }
        }
      }
      let members = int_list();
      var e = fbase;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          types::push_new(members, lower::env_sym_of(e));
        }
        e = lower::env_next_of(e);
      }
      var i = 0;
      while i < reqs.length() {
        types::push_new(members, reqs.get(i));
        i = i + 1;
      }
      i = 0;
      while i < reqs.length() {
        let r = reqs.get(i);
        if !type_in_force(r, genv, given) {
          if !in_force_through(r, genv, given, fbase, members) {
            prog::error(prog::e_absent(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(r));
          }
        }
        i = i + 1;
      }
    }

    fn type_in_force(t: Int, genv: Int, given: IntList): Bool {
      if lower::env_has(genv, lower::ek_type(), ast::none(), t) {
        return true;
      }
      types::contains_sym(given, t)
    }

    fn in_force_through(r: Int, genv: Int, given: IntList, fbase: Int, members: IntList): Bool {
      let z = lower::canon(fbase, types::ty_of_symbol(types::kd_abstract(), r));
      var i = 0;
      while i < members.length() {
        let y = members.get(i);
        if type_in_force(y, genv, given) {
          if lower::canon(fbase, types::ty_of_symbol(types::kd_abstract(), y)) == z {
            return true;
          }
        }
        i = i + 1;
      }
      if lower::is_variable(z) {
        return false;
      }
      let syms = int_list();
      lower::abstracts_in(z, syms);
      i = 0;
      while i < syms.length() {
        var t = syms.get(i);
        if ast::is_some(prog::origin_of(t)) {
          t = prog::origin_of(t);
        }
        if !type_in_force(t, genv, given) {
          return false;
        }
        i = i + 1;
      }
      true
    }

    # AUDIT-CHANGES #4 (E25): the provision a need selects has the type,
    # or the signature, the callee reads it at — the callee's own row
    # (`own`, in its declaration's terms) instantiated here — not only
    # the same app over its dependencies. A val whose type mentions a
    # type symbol that is not one of its requirements (`val v: T` with no
    # `assume T`) was provided while `T` meant one type, and is read by a
    # callee after `T` was rebound to another.
    fn provision_fits(s: Int, r: Int, key: Int, row: Int, fbase: Int, genv: Int): Bool {
      let own = lower::env_find(fbase, lower::need_kind(s), r, s);
      if !ast::is_some(own) {
        return true;
      }
      let ofrom = lower::env_a_of(own);
      let hfrom = lower::env_a_of(row);
      if !ast::is_some(ofrom) {
        return true;
      }
      if !ast::is_some(hfrom) {
        return true;
      }
      if prog::sym_kind.get(s) == prog::sk_val() {
        return callee_read(genv, fbase, ofrom) == canon_in(genv, hfrom);
      }
      if prog::sym_kind.get(s) == prog::sk_functor() {
        return true;
      }
      let d = prog::sym_decl.get(s);
      let home = prog::sym_mod.get(s);
      var i = 0;
      while i <= ast::fn_nparams(d) {
        var t = ast::fn_ret(d);
        if i < ast::fn_nparams(d) {
          t = ast::b_of(ast::kid_at(ast::fn_params(d), i));
        }
        if ast::is_some(t) {
          let want = callee_read(genv, fbase, sig_ty(ofrom, t, home, r));
          let have = canon_in(genv, sig_ty(hfrom, t, home, key));
          if want != have {
            return false;
          }
        }
        i = i + 1;
      }
      true
    }

    # A type in the callee's terms (its declaration's parameters), read
    # at a call here through the call's principal instantiation (#50): a
    # parameter whose symbol is in force here means what it means here;
    # one that is not means what a member of its merge class in the
    # callee's context `fbase` that is in force here means; any other is
    # read as itself.
    fn callee_read(genv: Int, fbase: Int, t: Int): Int {
      let c = lower::canon(fbase, t);
      let from = int_list();
      lower::params_in(c, from);
      let to = int_list();
      var i = 0;
      while i < from.length() {
        let p = from.get(i);
        let o = prog::origin_of(p);
        var v = ast::none();
        if lower::env_has(genv, lower::ek_type(), ast::none(), o) {
          v = lower::canon(genv, types::ty_of_symbol(types::kd_abstract(), o));
        } else {
          let pt = types::ty_of_symbol(types::kd_abstract(), p);
          var e = fbase;
          while ast::is_some(e) {
            if lower::env_kind_of(e) == lower::ek_type() {
              let y = lower::env_sym_of(e);
              if !ast::is_some(v) {
                if lower::env_has(genv, lower::ek_type(), ast::none(), y) {
                  if lower::canon(fbase, types::ty_of_symbol(types::kd_abstract(), y)) == pt {
                    v = lower::canon(genv, types::ty_of_symbol(types::kd_abstract(), y));
                  }
                }
              }
            }
            e = lower::env_next_of(e);
          }
          if !ast::is_some(v) {
            v = lower::canon(genv, types::ty_of_symbol(types::kd_abstract(), o));
          }
        }
        to.push(v);
        i = i + 1;
      }
      lower::canon(genv, types::subst(c, from, to))
    }

    # Every incoherent need is an error, used or not (D20), but the ones
    # worth naming are those the callee's code reaches, not every item of
    # a context it assumes (D79: a WASI function needs all of `Wasi`, and
    # what it calls is `fd_write`, not `args_get`). So name the ones used
    # along some path, or the first, when it uses none of them. The
    # bootstrap's `report_incoherent` makes the same choice.
    fn report_incoherent(f: Int, incoherent: IntList) {
      let used = int_list();
      uses_into(f, int_list(), used);
      let m = prog::sym_mod.get(cg_where.read());
      var named = false;
      var i = 0;
      while i < incoherent.length() {
        let s = incoherent.get(i);
        if types::contains_sym(used, s) {
          prog::error(prog::e_incoherent(), m, prog::sym_name.get(s));
          named = true;
        }
        i = i + 1;
      }
      if !named {
        prog::error(prog::e_incoherent(), m, prog::sym_name.get(incoherent.get(0)));
      }
    }

    # The symbols a function's body names, and those of the defined
    # functions it calls or binds, transitively: read off the syntax, as
    # a diagnostic only needs. A method is selected by its receiver's
    # type, which this does not know, so a method need is never found.
    fn uses_into(f: Int, seen: IntList, out: IntList) {
      if types::contains_sym(seen, f) {
        return ();
      }
      seen.push(f);
      uses_walk(ast::fn_body(prog::sym_decl.get(f)), prog::sym_mod.get(f), seen, out);
    }

    fn uses_run(run: Int, n: Int, m: Int, seen: IntList, out: IntList) {
      var i = 0;
      while i < n {
        uses_walk(ast::kid_at(run, i), m, seen, out);
        i = i + 1;
      }
    }

    fn uses_walk(e: Int, m: Int, seen: IntList, out: IntList) {
      if !ast::is_some(e) {
        return ();
      }
      let k = ast::kind_of(e);
      let a = ast::a_of(e);
      let b = ast::b_of(e);
      let c = ast::c_of(e);
      if k == ast::k_ex_path() {
        let sym = prog::resolve_quietly(m, a);
        if ast::is_some(sym) {
          types::push_new(out, sym);
          if is_defined_fn(sym) {
            uses_into(sym, seen, out);
          }
        }
      } else if k == ast::k_ex_call() {
        uses_walk(a, m, seen, out);
        uses_run(b, c, m, seen, out);
      } else if k == ast::k_ex_method() {
        uses_walk(a, m, seen, out);
        uses_run(c, ast::d_of(e), m, seen, out);
      } else if k == ast::k_ex_record() {
        uses_run(b, c, m, seen, out);
      } else if k == ast::k_ex_match() {
        uses_walk(a, m, seen, out);
        uses_run(b, c, m, seen, out);
      } else if k == ast::k_ex_block() {
        uses_run(a, b, m, seen, out);
        uses_walk(c, m, seen, out);
      } else if k == ast::k_st_bind() {
        uses_run(a, b, m, seen, out);
      } else if k == ast::k_ex_binary() {
        uses_walk(b, m, seen, out);
        uses_run(c, 1, m, seen, out);
      } else if k == ast::k_ex_if() {
        uses_walk(a, m, seen, out);
        uses_walk(b, m, seen, out);
        uses_walk(c, m, seen, out);
      } else if k == ast::k_st_while() {
        uses_walk(a, m, seen, out);
        uses_walk(b, m, seen, out);
      } else if k == ast::k_ex_field() {
        uses_walk(a, m, seen, out);
      } else if k == ast::k_ex_return() {
        uses_walk(a, m, seen, out);
      } else if k == ast::k_st_loop() {
        uses_walk(a, m, seen, out);
      } else if k == ast::k_st_expr() {
        uses_walk(a, m, seen, out);
      } else if k == ast::k_st_let() {
        uses_walk(c, m, seen, out);
      } else if k == ast::k_st_var() {
        uses_walk(c, m, seen, out);
      } else if k == ast::k_st_assign() {
        uses_walk(b, m, seen, out);
      } else if k == ast::k_ex_rfield() {
        uses_walk(b, m, seen, out);
      } else if k == ast::k_arm() {
        uses_walk(b, m, seen, out);
      } else if k == ast::k_st_item() {
        uses_walk(b, m, seen, out);
      } else if k == ast::k_ex_unary() {
        uses_walk(b, m, seen, out);
      } else if k == ast::k_ex_lambda() {
        uses_walk(ast::d_of(e), m, seen, out);
      }
    }

    fn checked(run: Int, genv: Int): Bool {
      let key = genv + 1;
      while ch_head.length() <= key {
        ch_head.push(0);
      }
      var r = ch_head.get(key);
      while r > 0 {
        if ch_run.get(r - 1) == run {
          return true;
        }
        r = ch_link.get(r - 1);
      }
      ch_run.push(run);
      ch_link.push(ch_head.get(key));
      ch_head.set(key, ch_run.length());
      false
    }

    # One need: `want` is the callee's app for item `s`, read against its
    # declaration's environment `wbase`; `have` the provision's, against
    # `hbase`. A declaration's app states its types in terms of its own
    # parameters, read as the generations in force here (D72); one made
    # in this frame (`declared` false) is in this frame's terms already. Most needs are the same assumed item on both sides with
    # nothing rebound, and are settled without reading a symbol.
    fn coherent(
      s: Int, want: Int, wbase: Int, have: Int, hbase: Int, genv: Int,
      moved: IntList, bound_here: Bool, declared: Bool
    ): Bool {
      let deps = int_list();
      lower::item_deps(s, deps);
      var quick = false;
      if !bound_here {
        quick = want == have;
      } else if !ast::is_some(want) {
        quick = !ast::is_some(have);
      }
      if quick {
        var clear = true;
        var i = 0;
        while i < deps.length() {
          if types::contains_sym(moved, deps.get(i)) {
            clear = false;
          }
          i = i + 1;
        }
        if clear {
          return true;
        }
      }
      var i = 0;
      while i < deps.length() {
        let t = deps.get(i);
        let wv = lower::app_get(want, t, wbase);
        var need = ast::none();
        if ast::is_some(wv) {
          if declared {
            need = instantiate_in(genv, wv);
          } else {
            need = lower::canon(genv, wv);
          }
        } else if lower::env_has(genv, lower::ek_type(), ast::none(), t) {
          # Not in force where the callee was declared: it means whatever
          # this frame means by it.
          need = lower::canon(genv, types::ty_of_symbol(types::kd_abstract(), t));
        }
        if need != lower::app_get(have, t, hbase) {
          return false;
        }
        i = i + 1;
      }
      true
    }

    # D66's forwarder for `g` assumes the types `g` depends on and `g`
    # itself, so it needs `g` at those types as they are here.
    fn check_forwarded(g: Int) {
      let genv = cg_genv.read();
      let row = lower::env_find(genv, lower::ek_fn(), ast::none(), g);
      if !ast::is_some(row) {
        return ();
      }
      let want = lower::full_app(g, genv);
      let empty = int_list();
      if !coherent(
        g, want, genv, lower::env_b_of(row), lower::env_of(cg_where.read()), genv,
        empty, true, false
      ) {
        prog::error(prog::e_incoherent(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(g));
      }
    }

    # Record a bind's provision in the generic environment, with the app
    # it is made at, and — for a fn or a method — the environment its
    # signature is read through there (`view`, with the bind's brackets),
    # which types a call of it from now on (lower.moss).
    fn provided_at(kind: Int, recv: Int, sym: Int, view: Int) {
      cg_genv.write(lower::env_push(
        cg_genv.read(), kind, recv, sym, view, lower::full_app(sym, view)
      ));
    }

    # The same for a val, which is typed by the type it was provided at.
    fn provided_val(sym: Int, ty: Int) {
      let genv = cg_genv.read();
      cg_genv.write(lower::env_push(
        genv, lower::ek_val(), ast::none(), sym, ty, lower::full_app(sym, genv)
      ));
    }

    fn walk_binds(body: IntList, s: Int, m: Int, mode: Int) {
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(s)) { prog::location.write(s + 1); }
      walk_binds_inner(body, s, m, mode);
      prog::location.write(saved);
    }

    fn walk_binds_inner(body: IntList, s: Int, m: Int, mode: Int) {
      var i = 0;
      while i < ast::b_of(s) {
        walk_bind_item(body, ast::kid_at(ast::a_of(s), i), m, 0, mode);
        i = i + 1;
      }
    }

    fn walk_bind_item(body: IntList, item: Int, m: Int, depth: Int, mode: Int) {
      if depth > 8 {
        semantic_error(prog::e_deep(), ast::none());
        return ();
      }
      let spec = ast::a_of(item);
      let value = ast::b_of(item);
      # No `=`: applying a functor of that name (D55).
      if !ast::is_some(value) {
        apply_functor(body, spec, m, depth, mode);
        return ();
      }
      # A receiver dot: providing a detached method at that receiver.
      if ast::is_some(ast::b_of(spec)) {
        bind_method(body, spec, value, m, depth, mode);
        return ();
      }
      if !ast::is_some(ast::a_of(spec)) {
        cg_error(c_unsupported(), ast::none());
        return ();
      }
      let sym = prog::resolve_path(m, ast::a_of(spec));
      if !ast::is_some(sym) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(spec)));
        return ();
      }
      let kind = prog::sym_kind.get(sym);
      if kind == prog::sk_functor() {
        bind_functor(sym, value, m, depth, mode);
        return ();
      }
      if kind == prog::sk_val() {
        # A val is data: evaluate it once into a local (D2). Nameless: a
        # provision is found by its *symbol*, through `provide`, and a
        # name here would shadow a program local that happened to share
        # it — `val n: Char;` against a parameter `n`.
        # Checked, and provided, at its declared type as the bind reads it.
        let want = elab_ty(ast::b_of(prog::sym_decl.get(sym)), prog::sym_mod.get(sym));
        if mode == bw_emit() {
          emit_as(body, value, m, want);
          let l = reveal(ast::none(), want);
          store_local(body, l);
          provide(ast::none(), sym, l);
        }
        provided_val(sym, want);
        return ();
      }
      if kind == prog::sk_type() {
        let ty = named_type(value, m);
        if !ast::is_some(ty) {
          cg_error(c_bad_type(), prog::sym_name.get(sym));
          return ();
        }
        cg_env.write(lower::env_push(
          cg_env.read(), lower::ek_type(), ast::none(), sym, ty, ast::none()
        ));
        cg_genv.write(lower::env_push(
          cg_genv.read(), lower::ek_type(), ast::none(), sym,
          lower::canon(cg_genv.read(), named_type_raw(value, m)), ast::none()
        ));
        return ();
      }
      if kind == prog::sk_fn() {
        if ast::is_kind(value, ast::k_ex_lambda()) {
          let lam = bind_lambda(spec, value, sym, ast::none(), m, depth, body);
          provided_at(lower::ek_fn(), ast::none(), sym, cg_genv.read());
          let map = int_list();
          let penv = callee_env(lam, map);
          cg_env.write(lower::env_push(
            cg_env.read(), lower::ek_fn(), ast::none(), sym, lam, penv
          ));
          capture(cg_env.read(), map, mode);
          return ();
        }
        let provider = named_fn(value, m);
        if !ast::is_some(provider) {
          bind_contextual(sym, value, m, mode);
          return ();
        }
        check_callee(provider);
        # The provider's own context is captured here, at the bind site.
        let map = int_list();
        let penv = callee_env(provider, map);
        cg_env.write(lower::env_push(
          cg_env.read(), lower::ek_fn(), ast::none(), sym, provider, penv
        ));
        capture(cg_env.read(), map, mode);
        provided_at(lower::ek_fn(), ast::none(), sym, cg_genv.read());
        return ();
      }
      cg_error(c_unsupported(), prog::sym_name.get(sym));
    }

    # D66: `bind f = g;` where `g` is an abstract fn the context provides
    # is sugar for binding a defined forwarder, `fn _(xs) { g(xs) }`
    # under `assume g`. Compiled in this environment, that forwarder
    # calls whatever provides `g` here, with the values that provision
    # captured — so `f` gets exactly that provision: the same provider,
    # under the environment it was bound in, its captured values read
    # here as a call to `g` would read them. A later rebind of `g`, here
    # or further down, is a new entry and cannot reach this one.
    #
    # A primitive `g` (an instruction, a WASI import) has no provision to
    # copy, and the entry names `g` itself; a call through it is then a
    # call to the primitive.
    fn bind_contextual(sym: Int, value: Int, m: Int, mode: Int) {
      if ast::kind_of(value) != ast::k_ex_path() {
        cg_error(c_unsupported(), prog::sym_name.get(sym));
        return ();
      }
      if ast::d_of(value) == 1 {
        cg_error(c_unsupported(), prog::sym_name.get(sym));
        return ();
      }
      let g = prog::resolve_path(m, ast::a_of(value));
      if !ast::is_some(g) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(value)));
        return ();
      }
      if prog::sym_kind.get(g) != prog::sk_fn() {
        cg_error(c_unsupported(), prog::sym_name.get(sym));
        return ();
      }
      # The forwarder assumes `g` at the types it depends on, as they are
      # here: so `g` must have been provided at them.
      check_forwarded(g);
      provided_at(lower::ek_fn(), ast::none(), sym, cg_genv.read());
      let bound = lower::env_find(cg_env.read(), lower::ek_fn(), ast::none(), g);
      if ast::is_some(bound) {
        if ast::is_some(lower::env_a_of(bound)) {
          cg_env.write(lower::env_push(
            cg_env.read(), lower::ek_fn(), ast::none(), sym,
            lower::env_a_of(bound), lower::env_b_of(bound)
          ));
          recapture(cg_env.read(), bound, mode);
          return ();
        }
      }
      var primitive = in_wasm(g);
      if !primitive {
        primitive = in_wasi(g);
      }
      if !primitive {
        primitive = is_i32_bool(g);
      }
      # Only if this function has it: assumed, since nothing bound it.
      if primitive {
        primitive = lower::env_has(
          lower::env_of(cg_where.read()), lower::ek_fn(), ast::none(), g
        );
      }
      if !primitive {
        # The check pass: `g` is provided generically, by nothing here.
        if checking() {
          if lower::env_has(cg_genv.read(), lower::ek_fn(), ast::none(), g) {
            return ();
          }
        }
        cg_error(c_unbound(), prog::sym_name.get(g));
        return ();
      }
      cg_env.write(lower::env_push(
        cg_env.read(), lower::ek_fn(), ast::none(), sym, g, lower::env_empty()
      ));
    }

    # `bind Horn.loud = Horn.blast;` — a detached method provided at a
    # receiver. The key is the receiver's head, so calls find it there.
    fn bind_method(body: IntList, spec: Int, value: Int, m: Int, depth: Int, mode: Int) {
      let recv_sym = prog::resolve_path(m, ast::a_of(spec));
      if !ast::is_some(recv_sym) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(spec)));
        return ();
      }
      # Keyed by the receiver's whole type as the bindings in force and the
      # bind's own brackets make it (D61, D62): `bind Box.peek[Elem=Char]`
      # provides at `Box[Elem=Char]`, as `bind Elem = Char;` before it would.
      # In both environments that is the type as written, so a provision
      # at one generation is not one at another that this specialization
      # happens to make the same type.
      let gview = lower::app_view(cg_genv.read(), m, spec);
      let recv = lower::canon(gview, types::ty_of_decl(recv_sym));
      let head = types::head_of(recv);
      let detached = lower::find_method_decl(m, recv_sym, ast::b_of(spec));
      if !ast::is_some(detached) {
        semantic_error(prog::e_method(), ast::b_of(spec));
        return ();
      }
      # A union or a record takes a detached method only (as in
      # lower.moss's `add_method_item`).
      if !ast::is_some(head) {
        if ast::is_some(prog::sym_recv.get(detached)) {
          semantic_error(prog::e_method(), ast::b_of(spec));
          return ();
        }
      }
      if !ast::is_some(detached) {
        semantic_error(prog::e_method(), ast::b_of(spec));
        return ();
      }
      # Q3 (AUDIT-CHANGES #70): `R.m` names `R`'s attached method where
      # `R` has one, and a defined one is called directly (D61 rule 1), so
      # a provision of it could never be used.
      if ast::is_some(ast::fn_body(prog::sym_decl.get(detached))) {
        semantic_error(prog::e_bind_defined(), ast::b_of(spec));
        return ();
      }
      # D84 rule 7 (O3 a): a member of a family in force is not bound
      # directly — except by the binds of a binding (a closure's), which
      # are how the family is provided.
      if !ast::is_some(cl_base.read()) {
        let fts = int_list();
        let ftt = int_list();
        if ast::is_some(family_member(recv, detached, fts, ftt)) {
          prog::error(prog::e_family(), m, ast::b_of(spec));
          return ();
        }
      }
      var provider = ast::none();
      if ast::is_kind(value, ast::k_ex_lambda()) {
        provider = bind_lambda(spec, value, detached, recv_sym, m, depth, body);
      } else {
        provider = named_fn(value, m);
        if !ast::is_some(provider) {
          cg_error(c_unsupported(), ast::b_of(spec));
          return ();
        }
        check_method_sig(spec, recv_sym, detached, provider, m);
        check_callee(provider);
      }
      let map = int_list();
      let penv = callee_env(provider, map);
      cg_env.write(lower::env_push(
        cg_env.read(), lower::ek_fn(), recv, detached, provider, penv
      ));
      capture(cg_env.read(), map, mode);
      # In the generic environment: made at the method's application
      # there, brackets included.
      provided_at(lower::ek_fn(), recv, detached, gview);
    }

    # A type in a signature, read through `env` in module `home`, with a
    # bare `This` standing for `this_ty`. (`This` inside another type is
    # not read here; nothing in the library writes one.)
    fn sig_ty(env: Int, t: Int, home: Int, this_ty: Int): Int {
      if ast::is_kind(t, ast::k_ty_this()) {
        return this_ty;
      }
      canon_in(env, types::elab(t, home))
    }

    # The method `method`'s declared parameter `i` (or its result, for
    # `i` none) as a bind with brackets `spec` at `recv` reads it (D27,
    # D61): through the generic environment and the bind's own
    # application, with `This` the receiver.
    fn method_sig_at(spec: Int, recv: Int, method: Int, i: Int, m: Int): Int {
      let gview = lower::app_view(cg_genv.read(), m, spec);
      let md = prog::sym_decl.get(method);
      var t = ast::fn_ret(md);
      if ast::is_some(i) {
        t = ast::b_of(ast::kid_at(ast::fn_params(md), i));
      }
      sig_ty(gview, t, prog::sym_mod.get(method), recv)
    }

    # D27, D54: a method provider's parameters and result are the
    # method's declared ones as the bind reads them — the receiver
    # excluded. An attached provider takes the receiver as `this`; a plain
    # function cannot see it, and widening one to take it is a mismatch,
    # as in the bootstrap's `match_fn_sig`. Checked on the program as
    # written, through the generic environment, like coherence.
    fn check_method_sig(spec: Int, recv_sym: Int, method: Int, provider: Int, m: Int) {
      let genv = cg_genv.read();
      let recv = lower::canon(lower::app_view(genv, m, spec), types::ty_of_decl(recv_sym));
      let pd = prog::sym_decl.get(provider);
      let phome = prog::sym_mod.get(provider);
      var pthis = ast::none();
      if takes_receiver(provider) {
        pthis = lower::canon(genv, types::ty_of_decl(prog::sym_recv.get(provider)));
      }
      let n = ast::fn_nparams(prog::sym_decl.get(method));
      var ok = ast::fn_nparams(pd) == n;
      var i = 0;
      while i < n {
        if ok {
          let got = sig_ty(genv, ast::b_of(ast::kid_at(ast::fn_params(pd), i)), phome, pthis);
          ok = got == method_sig_at(spec, recv, method, i, m);
        }
        i = i + 1;
      }
      if ok {
        ok = sig_ty(genv, ast::fn_ret(pd), phome, pthis)
          == method_sig_at(spec, recv, method, ast::none(), m);
      }
      if !ok {
        prog::error(prog::e_signature(), m, prog::sym_name.get(method));
      }
    }

    # D70: an anonymous function at a bind of `bound` — a fn, or the
    # method `bound` at receiver `recv_sym` with the bind's brackets in
    # `spec`. Pure sugar over the calculus, as the bootstrap elaborates
    # it: each local of the frame its body names is bound, here and by
    # value, to a fresh val (EBindVal); the function is a fresh defined
    # one assuming everything in context here, those vals included, with
    # the bound declaration's signature as the bind reads it (D27) and,
    # for a method, the receiver first (TBindMthR); and it is provided
    # as any defined provider is. Returns it.
    fn bind_lambda(
      spec: Int, value: Int, bound: Int, recv_sym: Int, m: Int, depth: Int, body: IntList
    ): Int {
      let genv = cg_genv.read();
      let bd = prog::sym_decl.get(bound);
      let home = prog::sym_mod.get(bound);
      let n = ast::fn_nparams(bd);
      # The receiver, as written; none for a fn.
      var grecv = ast::none();
      var gview = genv;
      if ast::is_some(recv_sym) {
        gview = lower::app_view(genv, m, spec);
        grecv = lower::canon(gview, types::ty_of_decl(recv_sym));
      }
      # The signature: the declaration's, never inferred from (D27).
      var ok = ast::b_of(value) == n;
      var i = 0;
      while i < n {
        if ok {
          let ann = ast::b_of(ast::kid_at(ast::a_of(value), i));
          if ast::is_some(ann) {
            ok = sig_ty(genv, ann, m, grecv)
              == sig_ty(gview, ast::b_of(ast::kid_at(ast::fn_params(bd), i)), home, grecv);
          }
        }
        i = i + 1;
      }
      if ok {
        if ast::is_some(ast::c_of(value)) {
          ok = sig_ty(genv, ast::c_of(value), m, grecv)
            == sig_ty(gview, ast::fn_ret(bd), home, grecv);
        }
      }
      if !ok {
        prog::error(prog::e_signature(), m, prog::sym_name.get(bound));
      }
      # One function per bind site and generic environment: its signature
      # and its captured locals' types are the frame's as written, and
      # what they are in a specialization is the specialization's business
      # (`callee_env`), as for any function.
      var row = ast::none();
      i = 0;
      while i < lm_node.length() {
        if lm_node.get(i) == value {
          if lm_genv.get(i) == genv {
            row = i;
          }
        }
        i = i + 1;
      }
      if !ast::is_some(row) {
        row = make_lambda(value, bound, grecv, gview, genv, m, depth);
      }
      # The captured locals' vals, bound to their values now.
      var j = 0;
      while j < lm_clen.get(row) {
        let at = lm_cstart.get(row) + j * 2;
        let l = find_local(lm_cap.get(at));
        let v = lm_cap.get(at + 1);
        if ast::is_some(l) {
          load_local(body, l);
          let held = reveal(ast::none(), lc_type.get(l));
          store_local(body, held);
          provide(ast::none(), v, held);
        }
        j = j + 1;
      }
      lm_sym.get(row)
    }

    # Whether an anonymous function bound in a functor's binds needs the
    # entry `e`: one those binds made (`made`, the rows above the body's
    # base), or one of the functor's inputs, by symbol (`ins_sym`). The
    # symbol alone over-approximates a method input to every receiver,
    # which is safe (more needs, never fewer) and reads no types.
    fn lambda_keeps(e: Int, made: IntList, ins_sym: IntList): Bool {
      types::contains_sym(made, e) | types::contains_sym(ins_sym, lower::env_sym_of(e))
    }

    # The function an anonymous function is, made once per bind site and
    # generic environment. `view` reads the bound declaration's types
    # here, generically.
    fn make_lambda(
      value: Int, bound: Int, recv: Int, view: Int, genv: Int, m: Int, depth: Int
    ): Int {
      let bd = prog::sym_decl.get(bound);
      let home = prog::sym_mod.get(bound);
      let lbody = ast::d_of(value);
      # Its parameters: the receiver, unnamed so that only `this` reads
      # it, then the bound declaration's, under the anonymous names.
      let ps = int_list();
      if ast::is_some(recv) {
        ps.push(ast::node2(ast::k_param(), ast::none(), known(recv)));
      }
      var i = 0;
      while i < ast::fn_nparams(bd) {
        let t = sig_ty(view, ast::b_of(ast::kid_at(ast::fn_params(bd), i)), home, recv);
        ps.push(ast::node2(
          ast::k_param(), ast::a_of(ast::kid_at(ast::a_of(value), i)), known(t)
        ));
        i = i + 1;
      }
      var ret = ast::none();
      if ast::is_some(ast::fn_ret(bd)) {
        ret = known(sig_ty(view, ast::fn_ret(bd), home, recv));
      }
      let decl = ast::make_fn(
        ast::recv_plain(), prog::sym_name.get(bound), ast::commit(ps), ps.length(),
        ret, lbody
      );
      let lam = prog::add_symbol(m, prog::sym_name.get(bound), prog::sk_fn(), decl, ast::none(), ast::none(), 0);
      # The frame's locals the body names, but not its own parameters'
      # names; a functor's binds are a declaration's, with no locals.
      let caps = int_list();
      if depth == 0 {
        let names = int_list();
        lambda_names(lbody, names);
        var k = 0;
        while k < names.length() {
          let nm = names.get(k);
          var param = false;
          var q = 0;
          while q < ast::b_of(value) {
            if ast::a_of(ast::kid_at(ast::a_of(value), q)) == nm {
              param = true;
            }
            q = q + 1;
          }
          if !param {
            let l = find_local(nm);
            if ast::is_some(l) {
              let vd = ast::node3(ast::k_d_val(), nm, known(lc_type.get(l)), ast::none());
              caps.push(nm);
              caps.push(prog::add_symbol(m, nm, prog::sk_val(), vd, ast::none(), ast::none(), 0));
            }
          }
          k = k + 1;
        }
      }
      # Its context: everything in force here, as written — this frame's
      # generic environment, whose keys and types are in this frame's
      # terms, which are the function's too — and the vals.
      var lenv = genv;
      let recvs = int_list();
      let syms = int_list();
      let apps = int_list();
      # In a functor's binds, only that functor's inputs and what its
      # earlier binds made (D84 3b): everything else its application
      # captured is not the anonymous function's to need, and needing it
      # would carry values captured by providers it never calls.
      let fbody = cg_fbody.read() - 1;
      let ins_recv = int_list();
      let ins_sym = int_list();
      let made = int_list();
      if depth > 0 {
        if ast::is_some(fbody) {
          let fd = prog::sym_decl.get(fbody);
          lower::assume_items(prog::sym_mod.get(fbody), ast::fu_args(fd), ast::fu_nargs(fd), ins_recv, ins_sym);
          # And what it provides: its binds are as if written in place,
          # so a provision they bind can name the one it shadows, which
          # it captures (`functor_shadowed_provision`). As a need, that
          # provider's own captured vals travel with it as slots.
          let rkinds = int_list();
          let rrecvs = int_list();
          result_keys(prog::sym_mod.get(fbody), ast::fu_res(fd), ast::fu_nres(fd), genv, rkinds, rrecvs, ins_sym, 0);
          var x = genv;
          while ast::is_some(x) {
            if x == cg_gbase.read() {
              x = ast::none();
            } else {
              made.push(x);
              x = lower::env_next_of(x);
            }
          }
        }
      }
      var e = lenv;
      while ast::is_some(e) {
        let kind = lower::env_kind_of(e);
        var keep = kind != lower::ek_type();
        if keep {
          if depth > 0 {
            if ast::is_some(fbody) {
              keep = lambda_keeps(e, made, ins_sym);
            }
          }
        }
        if keep {
          var seen = false;
          var q = 0;
          while q < syms.length() {
            if syms.get(q) == lower::env_sym_of(e) {
              if recvs.get(q) == lower::env_recv_of(e) {
                seen = true;
              }
            }
            q = q + 1;
          }
          if !seen {
            recvs.push(lower::env_recv_of(e));
            syms.push(lower::env_sym_of(e));
            apps.push(lower::env_b_of(e));
          }
        }
        e = lower::env_next_of(e);
      }
      var k = 0;
      while k < caps.length() {
        let v = caps.get(k + 1);
        lenv = lower::env_push(
          lenv, lower::ek_val(), ast::none(), v, need_type_raw(v), lower::env_empty()
        );
        recvs.push(ast::none());
        syms.push(v);
        apps.push(lower::env_empty());
        k = k + 2;
      }
      lower::set_needs(lam, lenv, recvs, syms, apps);
      # What it reaches, for `need_used`.
      while un_head.length() < prog::sym_count() {
        un_head.push(0);
        un_mark.push(0);
        un_last.push(0);
        un_fstart.push(0);
      }
      uw_node(lam, lbody, m);
      k = 0;
      while k < caps.length() {
        uw_row(lam, caps.get(k + 1));
        k = k + 2;
      }
      lm_node.push(value);
      lm_genv.push(genv);
      lm_sym.push(lam);
      if ast::is_some(recv) {
        lm_recv.push(1);
      } else {
        lm_recv.push(0);
      }
      lm_cstart.push(lm_cap.length());
      lm_clen.push(caps.length() / 2);
      k = 0;
      while k < caps.length() {
        lm_cap.push(caps.get(k));
        k = k + 1;
      }
      lm_sym.length() - 1
    }

    # Just the type bindings of an environment, in order, as one
    # (hash-consed) environment of their own.
    fn types_of(env: Int): Int {
      let chain = int_list();
      var e = env;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          chain.push(e);
        }
        e = lower::env_next_of(e);
      }
      var out = lower::env_empty();
      var i = chain.length();
      while i > 0 {
        i = i - 1;
        let t = chain.get(i);
        out = lower::env_push(
          out, lower::ek_type(), lower::env_recv_of(t), lower::env_sym_of(t),
          lower::env_a_of(t), lower::env_b_of(t)
        );
      }
      out
    }

    # A type already elaborated, as a declaration's type node.
    fn known(t: Int): Int {
      ast::node1(ast::k_ty_known(), t)
    }

    # A captured val's type, as its declaration holds it.
    fn need_type_raw(v: Int): Int {
      ast::a_of(ast::b_of(prog::sym_decl.get(v)))
    }

    # Every single-segment name an expression reads or assigns as a local
    # might be — over-approximated, as the bootstrap's `free_names` is: a
    # name the body binds itself, or a context item's, is collected too.
    fn lambda_names(e: Int, out: IntList) {
      if !ast::is_some(e) {
        return ();
      }
      let k = ast::kind_of(e);
      if k == ast::k_ex_path() {
        if ast::path_len(ast::a_of(e)) == 1 {
          if ast::d_of(e) != 1 {
            types::push_new(out, ast::path_at(ast::a_of(e), 0));
          }
        }
      } else if k == ast::k_ex_call() {
        lambda_names_run(ast::b_of(e), ast::c_of(e), out);
      } else if k == ast::k_ex_field() {
        lambda_names(ast::a_of(e), out);
      } else if k == ast::k_ex_method() {
        lambda_names(ast::a_of(e), out);
        lambda_names_run(ast::c_of(e), ast::d_of(e), out);
      } else if k == ast::k_ex_record() {
        var i = 0;
        while i < ast::c_of(e) {
          let field = ast::kid_at(ast::b_of(e), i);
          if ast::is_some(ast::b_of(field)) {
            lambda_names(ast::b_of(field), out);
          } else {
            types::push_new(out, ast::a_of(field));
          }
          i = i + 1;
        }
      } else if k == ast::k_ex_if() {
        lambda_names(ast::a_of(e), out);
        lambda_names(ast::b_of(e), out);
        lambda_names(ast::c_of(e), out);
      } else if k == ast::k_ex_match() {
        lambda_names(ast::a_of(e), out);
        var i = 0;
        while i < ast::c_of(e) {
          lambda_names(ast::b_of(ast::kid_at(ast::b_of(e), i)), out);
          i = i + 1;
        }
      } else if k == ast::k_ex_return() {
        lambda_names(ast::a_of(e), out);
      } else if k == ast::k_ex_block() {
        lambda_names_run(ast::a_of(e), ast::b_of(e), out);
        lambda_names(ast::c_of(e), out);
      } else if k == ast::k_ex_unary() {
        lambda_names(ast::b_of(e), out);
      } else if k == ast::k_ex_binary() {
        lambda_names(ast::b_of(e), out);
        lambda_names_run(ast::c_of(e), 1, out);
      } else if k == ast::k_ex_lambda() {
        lambda_names(ast::d_of(e), out);
      } else if k == ast::k_st_let() {
        lambda_names(ast::c_of(e), out);
      } else if k == ast::k_st_var() {
        lambda_names(ast::c_of(e), out);
      } else if k == ast::k_st_assign() {
        types::push_new(out, ast::a_of(e));
        lambda_names(ast::b_of(e), out);
      } else if k == ast::k_st_expr() {
        lambda_names(ast::a_of(e), out);
      } else if k == ast::k_st_while() {
        lambda_names(ast::a_of(e), out);
        lambda_names(ast::b_of(e), out);
      } else if k == ast::k_st_loop() {
        lambda_names(ast::a_of(e), out);
      } else if k == ast::k_st_bind() {
        var i = 0;
        while i < ast::b_of(e) {
          lambda_names(ast::b_of(ast::kid_at(ast::a_of(e), i)), out);
          i = i + 1;
        }
      }
    }

    fn lambda_names_run(run: Int, n: Int, out: IntList) {
      var i = 0;
      while i < n {
        lambda_names(ast::kid_at(run, i), out);
        i = i + 1;
      }
    }

    # A functor application is a run of binds, inlined where it is
    # written, with the paths inside resolved in the functor's module.
    fn apply_functor(body: IntList, spec: Int, m: Int, depth: Int, mode: Int) {
      if !ast::is_some(ast::a_of(spec)) {
        cg_error(c_unsupported(), ast::none());
        return ();
      }
      let sym = prog::resolve_path(m, ast::a_of(spec));
      if !ast::is_some(sym) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(spec)));
        return ();
      }
      if prog::sym_kind.get(sym) != prog::sk_functor() {
        cg_error(c_unsupported(), prog::sym_name.get(sym));
        return ();
      }
      if !ast::is_some(ast::fu_binds(prog::sym_decl.get(sym))) {
        apply_abstract(body, spec, sym, depth, mode);
        return ();
      }
      check_functor_total(sym, 0);
      run_functor(body, sym, depth, mode);
    }

    # A functor's binds, run here, with the paths inside resolved in the
    # functor's module (D55).
    fn run_functor(body: IntList, sym: Int, depth: Int, mode: Int) {
      let held = cg_gbase.read();
      cg_gbase.write(cg_genv.read());
      let held_fbody = cg_fbody.read();
      cg_fbody.write(sym + 1);
      let d = prog::sym_decl.get(sym);
      let home = prog::sym_mod.get(sym);
      var i = 0;
      while i < ast::fu_nbinds(d) {
        let stmt = ast::kid_at(ast::fu_binds(d), i);
        var j = 0;
        while j < ast::b_of(stmt) {
          walk_bind_item(
            body, ast::kid_at(ast::a_of(stmt), j), home, depth + 1, mode
          );
          j = j + 1;
        }
        i = i + 1;
      }
      cg_fbody.write(held_fbody);
      cg_gbase.write(held);
    }

    # D78: `bind F;` for an abstract `F` applies whichever functor `F` is
    # bound to in this specialization — a row of the environment, or, for
    # one lib/wasm.moss declares and nothing has bound, the platform's own
    # — and its binds are elaborated here, at this application's inputs,
    # which is what makes a binding serve every instantiation of them.
    # The application needs `F` in the generic environment (assumed or
    # bound) and `F`'s argument signature there. The functor's binds run
    # in a scope of their own, of which only `F`'s result survives: each
    # item is pushed again on the environment as it was before, with the
    # values its provider captured (`recapture`), and in the generic
    # environment it is made where it is written, at the inputs here.
    fn check_functor_inputs(fu: Int) {
      let d = prog::sym_decl.get(fu);
      let recv = int_list();
      let syms = int_list();
      let own = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(d), ast::fu_nargs(d), recv, syms);
      let genv = cg_genv.read();
      let base = cg_gbase.read();
      let merged = lower::merge_conflict_env(genv, own);
      if ast::is_some(merged) {
        prog::error(prog::e_merge(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(merged));
      }
      let moved = int_list();
      var e = genv;
      while ast::is_some(e) {
        if e == base {
          e = ast::none();
        } else {
          if lower::env_kind_of(e) == lower::ek_type() {
            types::push_new(moved, lower::env_sym_of(e));
          }
          e = lower::env_next_of(e);
        }
      }
      let bound_here = moved.length() > 0;
      let bad = int_list();
      var i = 0;
      while i < syms.length() {
        let s = syms.get(i);
        let r = recv.get(i);
        let key = need_key_recv(fu, genv, r);
        let have = lower::env_find(genv, lower::need_kind(s), key, s);
        let want = lower::env_find(own, lower::need_kind(s), r, s);
        if ast::is_some(have) {
          if ast::is_some(want) {
            if !coherent(s, lower::env_b_of(want), own, lower::env_b_of(have), base, genv, moved, bound_here, true) {
              bad.push(s);
            }
          }
        } else {
          prog::error(prog::e_absent(), prog::sym_mod.get(cg_where.read()), prog::sym_name.get(s));
        }
        i = i + 1;
      }
      if bad.length() > 0 {
        report_incoherent(fu, bad);
      }
    }

    fn apply_abstract(body: IntList, spec: Int, fu: Int, depth: Int, mode: Int) {
      let d = prog::sym_decl.get(fu);
      let home = prog::sym_mod.get(fu);
      if !lower::env_has(cg_genv.read(), lower::ek_fn(), ast::none(), fu) {
        cg_error(c_unbound(), prog::sym_name.get(fu));
        return ();
      }
      var i = 0;
      while i < ast::fu_nargs(d) {
        if !platform_needs(ast::kid_at(ast::fu_args(d), i), home, 0) {
          return ();
        }
        i = i + 1;
      }
      check_functor_inputs(fu);
      var provider = ast::none();
      let row = lower::env_find(cg_env.read(), lower::ek_fn(), ast::none(), fu);
      if ast::is_some(row) {
        provider = lower::env_a_of(row);
      }
      if !ast::is_some(provider) {
        if in_wasm(fu) {
          provider = fu;
        }
      }
      var captured = lower::env_empty();
      if ast::is_some(row) {
        captured = lower::env_b_of(row);
      }
      # D84: its fixed inputs as where it was provided (none, unbracketed);
      # its binding was checked where it was made, so nothing is scanned.
      if !check_stale(fu) {
        return ();
      }
      if !ast::is_some(provider) {
        if checking() {
          apply_generic(body, spec, d, home);
          return ();
        }
        cg_error(c_unbound(), prog::sym_name.get(fu));
        return ();
      }
      apply_closure_at(body, spec, fu, provider, captured, cg_env.read(), cg_genv.read(), depth, mode);
    }


    # D84 rule 7: families, whose members code gets on demand. A family
    # is an abstract functor whose result is method items only, each of
    # whose keys (receiver and brackets) determines every symbol of
    # `P(F)` the item mentions. Its result's leaves, contexts flattened,
    # into `mods`/`specs`; false where one is not a method.
    fn family_leaves(m: Int, run: Int, n: Int, mods: IntList, specs: IntList, depth: Int): Bool {
      if depth > 2 * prog::sym_count() {
        return false;
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        let s = prog::resolve_path(m, ast::a_of(spec));
        if !ast::is_some(s) {
          return false;
        }
        if ast::is_some(ast::b_of(spec)) {
          mods.push(m);
          specs.push(spec);
        } else if prog::sym_kind.get(s) == prog::sk_context() {
          if ast::d_of(spec) > 0 {
            return false;
          }
          let d = prog::sym_decl.get(s);
          if !family_leaves(prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), mods, specs, depth + 1) {
            return false;
          }
        } else {
          return false;
        }
        i = i + 1;
      }
      true
    }

    fn family_params(fu: Int, out: IntList) {
      if ast::fu_bracketed(prog::sym_decl.get(fu)) {
        lower::functor_params(fu, out);
      } else {
        lower::functor_mentions(fu, out);
      }
    }

    fn is_family(fu: Int): Bool {
      if prog::sym_kind.get(fu) != prog::sk_functor() {
        return false;
      }
      let d = prog::sym_decl.get(fu);
      if ast::is_some(ast::fu_binds(d)) {
        return false;
      }
      let mods = int_list();
      let specs = int_list();
      if !family_leaves(prog::sym_mod.get(fu), ast::fu_res(d), ast::fu_nres(d), mods, specs, 0) {
        return false;
      }
      let ps = int_list();
      family_params(fu, ps);
      var i = 0;
      while i < specs.length() {
        let m = mods.get(i);
        let spec = specs.get(i);
        let r = prog::resolve_path(m, ast::a_of(spec));
        let method = lower::find_method_decl(m, r, ast::b_of(spec));
        if !ast::is_some(method) {
          return false;
        }
        let keyed = int_list();
        types::free_syms_ref(ast::a_of(spec), ast::none(), 0, m, keyed);
        let said = int_list();
        lower::signature_syms(method, said);
        let bound = int_list();
        var b = 0;
        while b < ast::d_of(spec) {
          let lhs = prog::resolve_path(m, ast::a_of(ast::kid_at(ast::c_of(spec), b)));
          if ast::is_some(lhs) {
            bound.push(lhs);
          }
          b = b + 1;
        }
        let all = int_list();
        var j = 0;
        while j < said.length() {
          if !types::contains_sym(bound, said.get(j)) {
            all.push(said.get(j));
          }
          j = j + 1;
        }
        b = 0;
        while b < ast::d_of(spec) {
          let rhs = ast::b_of(ast::kid_at(ast::c_of(spec), b));
          types::free_syms_ref(ast::a_of(rhs), ast::c_of(rhs), ast::d_of(rhs), m, all);
          b = b + 1;
        }
        j = 0;
        while j < all.length() {
          if types::contains_sym(ps, all.get(j)) {
            if !types::contains_sym(keyed, all.get(j)) {
              return false;
            }
          }
          j = j + 1;
        }
        i = i + 1;
      }
      true
    }

    # `pat`, a type over the symbols `ps`, matched against `t`: what each
    # of `ps` it mentions is there, into `th_s`/`th_t`.
    fn ty_match(pat: Int, t: Int, ps: IntList, th_s: IntList, th_t: IntList) {
      if pat == t {
        return ();
      }
      let k = types::kind_of(pat);
      if k == types::kd_abstract() {
        if types::contains_sym(ps, types::sym_of(pat)) {
          if !types::contains_sym(th_s, types::sym_of(pat)) {
            th_s.push(types::sym_of(pat));
            th_t.push(t);
          }
          return ();
        }
      }
      if k == types::kd_record() {
        return ();
      }
      if types::kind_of(t) != k {
        return ();
      }
      if types::sym_of(t) != types::sym_of(pat) {
        return ();
      }
      if types::member_count(t) != types::member_count(pat) {
        return ();
      }
      var i = 0;
      while i < types::member_count(pat) {
        ty_match(types::member_at(pat, i), types::member_at(t, i), ps, th_s, th_t);
        i = i + 1;
      }
    }

    # Whether the family `fu` produces the method key `(recv_ty, sym)` in
    # the generic environment `genv`, and at which `P(F)` (θ, read off the
    # key, into `ts`/`tt`).
    fn family_theta(fu: Int, recv_ty: Int, sym: Int, genv: Int, ts: IntList, tt: IntList): Bool {
      let d = prog::sym_decl.get(fu);
      let mods = int_list();
      let specs = int_list();
      family_leaves(prog::sym_mod.get(fu), ast::fu_res(d), ast::fu_nres(d), mods, specs, 0);
      let ps = int_list();
      family_params(fu, ps);
      var found = false;
      var i = 0;
      while i < specs.length() {
        let m = mods.get(i);
        let spec = specs.get(i);
        let r = prog::resolve_path(m, ast::a_of(spec));
        if lower::find_method_decl(m, r, ast::b_of(spec)) == sym {
          var penv = genv;
          var j = 0;
          while j < ps.length() {
            penv = lower::env_push(
              penv, lower::ek_type(), ast::none(), ps.get(j),
              types::ty_of_symbol(types::kd_abstract(), ps.get(j)), ast::none()
            );
            j = j + 1;
          }
          let pat = lower::canon(lower::app_view(penv, m, spec), types::ty_of_decl(r));
          let s1 = int_list();
          let t1 = int_list();
          ty_match(pat, recv_ty, ps, s1, t1);
          var venv = genv;
          j = 0;
          while j < s1.length() {
            venv = lower::env_push(venv, lower::ek_type(), ast::none(), s1.get(j), t1.get(j), ast::none());
            j = j + 1;
          }
          if lower::canon(lower::app_view(venv, m, spec), types::ty_of_decl(r)) == recv_ty {
            if found {
              # D84 rule 7 (strengthened): two items of one family share
              # this instance of their key.
              semantic_error(prog::e_family(), prog::sym_name.get(sym));
              return true;
            }
            found = true;
            j = 0;
            while j < s1.length() {
              ts.push(s1.get(j));
              tt.push(t1.get(j));
              j = j + 1;
            }
          }
        }
        i = i + 1;
      }
      found
    }

    # Rule B for a family demand (`MatchingInForce`): the matching read
    # off the demanded key is in force here, each symbol it mentions one
    # that a type in force here means.
    fn matching_in_force(tt: IntList) {
      let genv = cg_genv.read();
      let meant = int_list();
      var e = genv;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          let x = lower::env_sym_of(e);
          types::push_new(meant, x);
          lower::abstracts_in(lower::canon(genv, types::ty_of_symbol(types::kd_abstract(), x)), meant);
        }
        e = lower::env_next_of(e);
      }
      var i = 0;
      while i < tt.length() {
        let syms = int_list();
        lower::abstracts_in(lower::canon(genv, tt.get(i)), syms);
        var j = 0;
        while j < syms.length() {
          let a = syms.get(j);
          if !types::contains_sym(meant, a) {
            var named = a;
            if ast::is_some(prog::origin_of(a)) {
              named = prog::origin_of(a);
            }
            semantic_error(prog::e_absent(), prog::sym_name.get(named));
            return ();
          }
          j = j + 1;
        }
        i = i + 1;
      }
    }

    # D84 rule 7: the family in force (in the generic environment) that
    # produces the key `(recv_ty, sym)`, with θ, or none. Two families
    # producing it is an error, as two imports of one name are (D44).
    fn family_member(recv_ty: Int, sym: Int, ts: IntList, tt: IntList): Int {
      let genv = cg_genv.read();
      let seen = int_list();
      var found = ast::none();
      var e = genv;
      while ast::is_some(e) {
        let s = lower::env_sym_of(e);
        if lower::env_kind_of(e) == lower::ek_fn() {
          if !ast::is_some(lower::env_recv_of(e)) {
            if !contains(seen, s) {
              seen.push(s);
              if is_family(s) {
                let s1 = int_list();
                let t1 = int_list();
                if family_theta(s, recv_ty, sym, genv, s1, t1) {
                  if ast::is_some(found) {
                    semantic_error(prog::e_family(), prog::sym_name.get(sym));
                    return ast::none();
                  }
                  found = s;
                  var j = 0;
                  while j < s1.length() {
                    ts.push(s1.get(j));
                    tt.push(t1.get(j));
                    j = j + 1;
                  }
                }
              }
            }
          }
        }
        e = lower::env_next_of(e);
      }
      found
    }

    # D84 rule 7 for a callee's needs: each method need of `f` — listed
    # in its assumes, or by a context it assumes — whose key nothing in
    # the generic environment provides but a family in force produces is
    # applied on demand, as a call of that member is (`emit_on_demand`):
    # `bind F;` at the θ read off the key, one application per family and
    # θ, emitted before the call. θ holds for the application only: the
    # types of `P(F)` mean what they meant before for the call, wherever
    # they were bound before. The caller restores the environments after
    # the call (`demand_restore`). The bootstrap's `demand_needs` is the
    # same.
    fn demand_needs(body: IntList, f: Int, e: Int) {
      lower::lower_needs(f);
      let fus = int_list();
      let starts = int_list();
      let ts = int_list();
      let tt = int_list();
      var i = 0;
      while i < lower::needs_count(f) {
        let r = lower::need_recv_at(f, i);
        let s = lower::need_sym_at(f, i);
        if ast::is_some(r) {
          let genv = cg_genv.read();
          let key = need_key_recv(f, genv, r);
          if !ast::is_some(lower::env_find(genv, lower::need_kind(s), key, s)) {
            let s1 = int_list();
            let t1 = int_list();
            let fu = family_member(key, s, s1, t1);
            if ast::is_some(fu) {
              matching_in_force(t1);
              if !demand_seen(fus, starts, ts, tt, fu, s1, t1) {
                fus.push(fu);
                starts.push(ts.length());
                var j = 0;
                while j < s1.length() {
                  ts.push(s1.get(j));
                  tt.push(t1.get(j));
                  j = j + 1;
                }
              }
            }
          }
        }
        i = i + 1;
      }
      var k = 0;
      while k < fus.length() {
        var end = ts.length();
        if k + 1 < fus.length() {
          end = starts.get(k + 1);
        }
        let ebefore = cg_env.read();
        let gbefore = cg_genv.read();
        var j = starts.get(k);
        while j < end {
          cg_env.write(lower::env_push(cg_env.read(), lower::ek_type(), ast::none(), ts.get(j), spec(tt.get(j)), ast::none()));
          cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), ts.get(j), tt.get(j), ast::none()));
          j = j + 1;
        }
        apply_abstract(body, e, fus.get(k), 0, bw_emit());
        j = starts.get(k);
        while j < end {
          let pe = lower::env_find(ebefore, lower::ek_type(), ast::none(), ts.get(j));
          if ast::is_some(pe) {
            cg_env.write(lower::env_push(cg_env.read(), lower::ek_type(), ast::none(), ts.get(j), lower::env_a_of(pe), ast::none()));
          }
          let pg = lower::env_find(gbefore, lower::ek_type(), ast::none(), ts.get(j));
          if ast::is_some(pg) {
            cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), ts.get(j), lower::env_a_of(pg), ast::none()));
          }
          j = j + 1;
        }
        k = k + 1;
      }
    }

    # Whether the application of `fu` at θ (`s1`, `t1`) is among those
    # `demand_needs` has gathered.
    fn demand_seen(
      fus: IntList, starts: IntList, ts: IntList, tt: IntList, fu: Int,
      s1: IntList, t1: IntList
    ): Bool {
      var k = 0;
      while k < fus.length() {
        if fus.get(k) == fu {
          var end = ts.length();
          if k + 1 < fus.length() {
            end = starts.get(k + 1);
          }
          if end - starts.get(k) == s1.length() {
            var same = true;
            var j = 0;
            while j < s1.length() {
              if ts.get(starts.get(k) + j) != s1.get(j) {
                same = false;
              }
              if tt.get(starts.get(k) + j) != t1.get(j) {
                same = false;
              }
              j = j + 1;
            }
            if same {
              return true;
            }
          }
        }
        k = k + 1;
      }
      false
    }

    # The call, as if preceded by `bind F;` with `P(F)` at θ, in a scope
    # of its own: `{ bind F at θ; recv.sym(args) }`.
    fn emit_on_demand(
      body: IntList, recv: IntList, recv_ty: Int, sym: Int, run: Int, n: Int, m: Int,
      e: Int, fu: Int, ts: IntList, tt: IntList
    ): Int {
      let emark = cg_env.read();
      let gmark = cg_genv.read();
      let pmark = pv_top.read();
      let floor = pv_floor.read();
      let smark = es_top.read();
      let aon = cg_aon.read();
      let aenv = cg_aenv.read();
      let agenv = cg_agenv.read();
      cg_aenv.write(emark);
      cg_agenv.write(gmark);
      let concrete = int_list();
      var i = 0;
      while i < ts.length() {
        concrete.push(spec(tt.get(i)));
        i = i + 1;
      }
      i = 0;
      while i < ts.length() {
        cg_env.write(lower::env_push(cg_env.read(), lower::ek_type(), ast::none(), ts.get(i), concrete.get(i), ast::none()));
        cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), ts.get(i), tt.get(i), ast::none()));
        i = i + 1;
      }
      apply_abstract(body, e, fu, 0, bw_emit());
      var ret = ty_none();
      if ast::is_some(generic_row(recv_ty, sym)) {
        cg_aon.write(1);
        ret = emit_provided_method(body, recv, recv_ty, sym, run, n, m, e);
      } else {
        semantic_error(prog::e_method(), prog::sym_name.get(sym));
      }
      cg_aon.write(aon);
      cg_aenv.write(aenv);
      cg_agenv.write(agenv);
      cg_env.write(emark);
      cg_genv.write(gmark);
      pv_top.write(pmark);
      pv_floor.write(floor);
      es_top.write(smark);
      ret
    }

    # What a call of a family's member on demand yields: its declared
    # return, read where `F`'s result is provided at θ.
    fn on_demand_ret(recv_ty: Int, sym: Int): Int {
      let ts = int_list();
      let tt = int_list();
      let fu = family_member(recv_ty, sym, ts, tt);
      if !ast::is_some(fu) {
        return ty_none();
      }
      let gmark = cg_genv.read();
      var i = 0;
      while i < ts.length() {
        cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), ts.get(i), tt.get(i), ast::none()));
        i = i + 1;
      }
      let d = prog::sym_decl.get(fu);
      result_generic(prog::sym_mod.get(fu), ast::fu_res(d), ast::fu_nres(d), 0);
      var ret = ty_none();
      let grow = lower::env_find(cg_genv.read(), lower::ek_fn(), recv_ty, sym);
      if ast::is_some(grow) {
        ret = sig_ret(row_view(grow), sym, recv_ty);
      }
      cg_genv.write(gmark);
      ret
    }

    # D84 (draft): `bind F;` where `F` is bound to `provider`, whose
    # binding captured `captured` (none: D78's, which captures nothing).
    fn apply_closure_at(
      body: IntList, spec: Int, fu: Int, provider: Int, captured: Int, senv: Int,
      genv: Int, depth: Int, mode: Int
    ) {
      let held = cl_cur.read();
      cl_cur.write(captured);
      apply_bound(body, spec, fu, provider, depth, mode);
      cl_cur.write(held);
    }

    # D84 (draft): the environments a captured binding's binds run in —
    # the captured ones, with each type the application supplies (`P(F)`
    # and `F`'s input types outside `X(F)`) as it is here, and `F`'s input
    # vals as they are here, above a floor. Returns the specialized one.
    fn captured_target(fallback: Int, captured: Int): Int {
      if ast::is_some(captured) {
        if lower::env_kind_of(captured) == lower::ek_capture() {
          return lower::env_a_of(captured);
        }
      }
      fallback
    }

    fn closure_env(target: Int, captured: Int): Int {
      # Copies retain the original link's input domain. A wider abstract
      # target must not turn a private captured type into a supplied input.
      let fu = captured_target(target, captured);
      let real = cg_env.read();
      let greal = cg_genv.read();
      var out = captured;
      var gout = captured_genv(captured);
      if !ast::is_some(gout) {
        gout = greal;
      }
      let gcap = gout;
      let per = int_list();
      lower::functor_poly(fu, per);
      var i = 0;
      while i < per.length() {
        let t = per.get(i);
        let gr = lower::env_find(greal, lower::ek_type(), ast::none(), t);
        if ast::is_some(gr) {
          gout = lower::env_push(gout, lower::ek_type(), ast::none(), t, lower::env_a_of(gr), ast::none());
          # What the generic type names, as this specialization has it.
          let syms = int_list();
          abstract_syms(lower::env_a_of(gr), syms);
          var j = 0;
          while j < syms.length() {
            let r = lower::env_find(real, lower::ek_type(), ast::none(), syms.get(j));
            if ast::is_some(r) {
              out = lower::env_push(out, lower::ek_type(), ast::none(), syms.get(j), lower::env_a_of(r), ast::none());
            }
            j = j + 1;
          }
        }
        let r = lower::env_find(real, lower::ek_type(), ast::none(), t);
        if ast::is_some(r) {
          out = lower::env_push(out, lower::ek_type(), ast::none(), t, lower::env_a_of(r), ast::none());
        }
        i = i + 1;
      }
      # D84 3b: `F`'s other inputs are linked — each application supplies
      # them, as they are here: vals by their locals, fns, methods and
      # abstract functors by the application's entries, with what those
      # carry.
      let d = prog::sym_decl.get(fu);
      let nrecv = int_list();
      let nsym = int_list();
      let decl_env = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(d), ast::fu_nargs(d), nrecv, nsym);
      let val_syms = int_list();
      let val_locals = int_list();
      let new_rows = int_list();
      let old_rows = int_list();
      var e = decl_env;
      while ast::is_some(e) {
        let kind = lower::env_kind_of(e);
        let sym = lower::env_sym_of(e);
        if kind == lower::ek_val() {
          # Generically at the types applications supply (D84 3c).
          let vd = prog::sym_decl.get(sym);
          let vty = lower::elab(gout, ast::b_of(vd), prog::sym_mod.get(sym));
          var l = provision_of(ast::none(), sym);
          if cl_check.read() == 1 {
            # At the bind, a val is an application's, at a fresh type:
            # a local of that type, in dead code.
            l = reveal(ast::none(), vty);
          }
          if ast::is_some(l) {
            val_syms.push(sym);
            val_locals.push(l);
          }
          gout = lower::env_push(gout, lower::ek_val(), ast::none(), sym, vty, lower::full_app(sym, gout));
        } else if kind == lower::ek_fn() {
          var key = lower::env_recv_of(e);
          var key0 = key;
          if ast::is_some(key) {
            key = instantiate_in(greal, key);
            key0 = instantiate_in(gcap, key0);
          }
          var here = lower::env_find(real, lower::ek_fn(), key, sym);
          if !ast::is_some(here) {
            # At the bind, where what applications supply is fresh, the
            # entry is the one in force here at the types as they are.
            here = lower::env_find(real, lower::ek_fn(), key0, sym);
          }
          if ast::is_some(here) {
            out = lower::env_push(out, lower::ek_fn(), key, sym, lower::env_a_of(here), lower::env_b_of(here));
            new_rows.push(out);
            old_rows.push(here);
          }
          # Generically, provided at the types applications supply (D84
          # 3c): read through the closure's own view, where each is the
          # application's (or, at the bind, fresh).
          # Keyed as the binds read it: a type `F` is fixed in as where it
          # was provided, one applications supply as here (`gout`), so a
          # linked `Int.size` is found at the `Int` the binds see.
          let view = view_over(lower::env_a_of(e), decl_env, gout);
          var gkey = lower::env_recv_of(e);
          if ast::is_some(gkey) {
            gkey = instantiate_in(gout, gkey);
          }
          gout = lower::env_push(gout, lower::ek_fn(), gkey, sym, view, lower::full_app(sym, view));
        }
        e = lower::env_next_of(e);
      }
      # What the linked providers carry, read before anything is pushed.
      let cap_key = int_list();
      let cap_local = int_list();
      var k = 0;
      while k < new_rows.length() {
        let r = new_rows.get(k);
        let vals = int_list();
        if prog::sym_kind.get(lower::env_sym_of(r)) == prog::sk_functor() {
          functor_slots(r, vals, 0);
        } else if ast::is_some(lower::env_a_of(r)) {
          val_slots(vals, lower::env_a_of(r), lower::env_b_of(r), 0);
        }
        var j = 0;
        while j < vals.length() {
          let l = provision_of(ast::none(), ck_slot(old_rows.get(k), vals.get(j)));
          if ast::is_some(l) {
            cap_key.push(ck_slot(r, vals.get(j)));
            cap_local.push(l);
          }
          j = j + 1;
        }
        k = k + 1;
      }
      # D84 6: the vals the binding captured, under their own keys again,
      # from the entry `F` is bound by here, which carried them (from the
      # frame that bound it, or across frames as parameters). For a copy
      # (`bind F2 = F;`) that is `F2`'s entry, the one applied, though the
      # closure is still read at its original target's inputs (`fu`).
      let own = lower::env_find(real, lower::ek_fn(), ast::none(), target);
      if ast::is_some(own) {
        let slots = int_list();
        functor_slots(own, slots, 0);
        var j = 0;
        while j < slots.length() {
          let l = provision_of(ast::none(), ck_slot(own, slots.get(j)));
          if ast::is_some(l) {
            cap_key.push(slots.get(j));
            cap_local.push(l);
          }
          j = j + 1;
        }
      }
      # Provided again on top: what the binds use was checked where they
      # were bound.
      i = 0;
      while i < val_syms.length() {
        provide(ast::none(), val_syms.get(i), val_locals.get(i));
        i = i + 1;
      }
      i = 0;
      while i < cap_key.length() {
        provide(ast::none(), cap_key.get(i), cap_local.get(i));
        i = i + 1;
      }
      cg_env.write(out);
      cg_genv.write(gout);
      out
    }

    # The type rows an item's view has above the declaration environment
    # `base` (its own brackets, and its contexts'), pushed onto `onto`,
    # outermost first, each read in `onto`'s terms.
    fn view_over(view: Int, base: Int, onto: Int): Int {
      let syms = int_list();
      let tys = int_list();
      var v = view;
      while ast::is_some(v) {
        if in_chain(v, base) {
          v = ast::none();
        } else {
          if lower::env_kind_of(v) == lower::ek_type() {
            syms.push(lower::env_sym_of(v));
            tys.push(lower::env_a_of(v));
          }
          v = lower::env_next_of(v);
        }
      }
      var out = onto;
      var i = syms.length();
      while i > 0 {
        i = i - 1;
        out = lower::env_push(out, lower::ek_type(), ast::none(), syms.get(i), instantiate_in(onto, tys.get(i)), ast::none());
      }
      out
    }

    # The abstract symbols a type mentions.
    fn abstract_syms(t: Int, out: IntList) {
      if !ast::is_some(t) {
        return ();
      }
      let k = types::kind_of(t);
      if k == types::kd_abstract() {
        types::push_new(out, types::sym_of(t));
        return ();
      }
      if k == types::kd_record() {
        var i = 0;
        while i < types::field_count(t) {
          abstract_syms(types::field_type_at(t, i), out);
          i = i + 1;
        }
        return ();
      }
      if k == types::kd_nominal() {
        var i = 0;
        while i < types::member_count(t) {
          abstract_syms(types::member_at(t, i), out);
          i = i + 1;
        }
        return ();
      }
      if k == types::kd_union() {
        var i = 0;
        while i < types::member_count(t) {
          abstract_syms(types::member_at(t, i), out);
          i = i + 1;
        }
      }
    }

    # Whether `F`'s result keys `recvs`/`syms`, as an application files
    # them, collide only where `F`'s own reading of its result, in its
    # input context with its merges, does (`CollidesOnlyAs`).
    fn results_distinct(fu: Int, recvs: IntList, syms: IntList): Bool {
      let d = prog::sym_decl.get(fu);
      let home = prog::sym_mod.get(fu);
      let nrecv = int_list();
      let nsym = int_list();
      let own = lower::assume_items(home, ast::fu_args(d), ast::fu_nargs(d), nrecv, nsym);
      let okinds = int_list();
      let orecvs = int_list();
      let osyms = int_list();
      result_keys(home, ast::fu_res(d), ast::fu_nres(d), own, okinds, orecvs, osyms, 0);
      if osyms.length() != syms.length() {
        return true;
      }
      var j = 0;
      while j < syms.length() {
        var k = j + 1;
        while k < syms.length() {
          if syms.get(j) == syms.get(k) {
            if recvs.get(j) == recvs.get(k) {
              if orecvs.get(j) != orecvs.get(k) {
                semantic_error(prog::e_result_collide(), prog::sym_name.get(syms.get(j)));
                return false;
              }
            }
          }
          k = k + 1;
        }
        j = j + 1;
      }
      true
    }

    # `bind F;` where `F` is bound to `provider`.
    fn apply_bound(body: IntList, spec: Int, fu: Int, provider: Int, depth: Int, mode: Int) {
      let d = prog::sym_decl.get(fu);
      let home = prog::sym_mod.get(fu);
      let emark = cg_env.read();
      let gmark = cg_genv.read();
      let pmark = pv_top.read();
      # The types of the result, which the binds make first.
      let tsyms = int_list();
      result_types(home, ast::fu_res(d), ast::fu_nres(d), tsyms, 0);
      let floor = pv_floor.read();
      var base = emark;
      var bmark = pmark;
      let captured = cl_cur.read();
      cl_cur.write(lower::env_empty());
      # D84: every binding with a body is a closure, checked where it was
      # made (`check_at_bind`).
      let closed = ast::is_some(ast::fu_binds(prog::sym_decl.get(provider)));
      if closed {
        let held_base = cl_base.read();
        base = closure_env(fu, captured);
        cl_base.write(captured_base(captured));
        bmark = pv_top.read();
        run_functor(body, provider, depth, mode);
        cl_base.write(held_base);
      } else {
        platform_functor(prog::sym_decl.get(provider), prog::sym_mod.get(provider));
      }
      let made = cg_env.read();
      let gmade = cg_genv.read();
      # D84 3d covers abstract applications as well as direct type binds:
      # the provider must preserve the result's polymorphic input types.
      if closed & (cl_check.read() == 1) {
        let mentions = int_list();
        let fixed = int_list();
        lower::functor_mentions(fu, mentions);
        lower::functor_fixed(fu, fixed);
        var i = 0;
        while i < mentions.length() {
          let t = mentions.get(i);
          if !types::contains_sym(fixed, t) {
            let at = types::ty_of_symbol(types::kd_abstract(), t);
            if lower::canon(gmade, at) != lower::canon(gmark, at) {
              cg_error(prog::e_functor_sig(), prog::sym_name.get(t));
              cg_env.write(emark);
              cg_genv.write(gmark);
              pv_top.write(pmark);
              pv_floor.write(floor);
              return ();
            }
          }
          i = i + 1;
        }
      }
      # The type each of the result's types was made (D78). Here, in a
      # specialization, it is that type; to the code after this, checked
      # once against the generic environment, it is a fresh generation
      # (D72), one per application and type (`fresh_gen`), which this
      # environment also maps to the type made, since the code after this
      # gives it to values and keys provisions by it.
      var site = emark;
      var gsite = gmark;
      var k = 0;
      while k < tsyms.length() {
        let t = tsyms.get(k);
        let r = lower::env_find(made, lower::ek_type(), ast::none(), t);
        var fresh = ast::is_some(r);
        if fresh {
          fresh = !in_chain(r, base);
        }
        if !fresh {
          cg_error(c_unbound(), prog::sym_name.get(t));
          cg_env.write(emark);
          cg_genv.write(gmark);
          pv_top.write(pmark);
          pv_floor.write(floor);
          return ();
        }
        let made_ty = lower::env_a_of(r);
        let gen = fresh_gen(spec, t);
        let gen_ty = types::ty_of_symbol(types::kd_abstract(), gen);
        site = lower::env_push(site, lower::ek_type(), ast::none(), t, made_ty, ast::none());
        site = lower::env_push(site, lower::ek_type(), ast::none(), gen, made_ty, ast::none());
        gsite = lower::env_push(gsite, lower::ek_type(), ast::none(), t, gen_ty, ast::none());
        live_type(t, gen_ty);
        k = k + 1;
      }
      # The rest of the result's keys: where the binds made each item, in
      # the terms of the generic environment they left, and where the code
      # after this finds it, at the fresh generations. Two applications
      # are two sets of keys, whatever types this specialization made.
      let kinds = int_list();
      let mrecvs = int_list();
      let msyms = int_list();
      result_keys(home, ast::fu_res(d), ast::fu_nres(d), gmade, kinds, mrecvs, msyms, 0);
      let gkinds = int_list();
      let recvs = int_list();
      let syms = int_list();
      result_keys(home, ast::fu_res(d), ast::fu_nres(d), gsite, gkinds, recvs, syms, 0);
      # AUDIT-CHANGES #58 (E40, D84 rule 7): two result items distinct in
      # `F`'s own reading are distinct here too. Where the caller's
      # meanings file them under one key (`A.m` and `B.m` with `A` and
      # `B` both `Int`), which one the key gets would be a convention.
      # Reported, and the application goes on, so that what follows it
      # is not reported as unprovided too.
      results_distinct(fu, recvs, syms);
      # What the binds made for each item: an environment row, and for a
      # val, the local holding it.
      let rows = int_list();
      let locals = int_list();
      k = 0;
      while k < syms.length() {
        var r = ast::none();
        var l = ast::none();
        var fresh = false;
        if kinds.get(k) == lower::ek_val() {
          # A val is a local, provided above the mark by its bind.
          l = provision_above(syms.get(k), bmark);
          fresh = ast::is_some(l);
        } else {
          r = lower::env_find(made, kinds.get(k), mrecvs.get(k), syms.get(k));
          fresh = ast::is_some(r);
          if fresh {
            fresh = !in_chain(r, base);
          }
          if !fresh {
            if checking() {
              # The check pass: made generically, by a bind of something
              # nothing here provides (`bind_contextual`).
              let gr = lower::env_find(gmade, kinds.get(k), mrecvs.get(k), syms.get(k));
              if ast::is_some(gr) {
                if !in_chain(gr, gmark) {
                  fresh = true;
                  r = ast::none();
                }
              }
            }
          }
        }
        if !fresh {
          cg_error(c_unbound(), prog::sym_name.get(syms.get(k)));
          cg_env.write(emark);
          cg_genv.write(gmark);
          pv_top.write(pmark);
          pv_floor.write(floor);
          return ();
        }
        rows.push(r);
        locals.push(l);
        k = k + 1;
      }
      # The values the providers captured, read before the scope closes.
      let cap_entry = int_list();
      let cap_slot = int_list();
      let cap_local = int_list();
      if mode == bw_emit() {
        k = 0;
        while k < syms.length() {
          if kinds.get(k) != lower::ek_val() {
            let r = rows.get(k);
            let vals = int_list();
            if !ast::is_some(r) {
              # Nothing provides it here (the check pass).
            } else if prog::sym_kind.get(syms.get(k)) == prog::sk_functor() {
              # D84 6: a result functor's binding carries what it captured.
              functor_slots(r, vals, 0);
            } else {
              val_slots(vals, lower::env_a_of(r), lower::env_b_of(r), 0);
            }
            var j = 0;
            while j < vals.length() {
              cap_entry.push(k);
              cap_slot.push(vals.get(j));
              cap_local.push(provision_of(ast::none(), ck_slot(r, vals.get(j))));
              j = j + 1;
            }
          }
          k = k + 1;
        }
      }
      cg_env.write(site);
      cg_genv.write(gsite);
      result_generic(home, ast::fu_res(d), ast::fu_nres(d), 0);
      pv_top.write(pmark);
      pv_floor.write(floor);
      k = 0;
      while k < syms.length() {
        if kinds.get(k) == lower::ek_val() {
          if mode == bw_emit() {
            if ast::is_some(locals.get(k)) {
              # Its value is the local the bind made; its type, to the
              # code after this, is the one the application promises.
              let promised = lower::env_find(cg_genv.read(), lower::ek_val(), ast::none(), syms.get(k));
              lc_type.set(locals.get(k), lower::env_a_of(promised));
              provide(ast::none(), syms.get(k), locals.get(k));
            }
          }
        } else if ast::is_some(rows.get(k)) {
          let r = rows.get(k);
          cg_env.write(lower::env_push(
            cg_env.read(), kinds.get(k), recvs.get(k), syms.get(k),
            lower::env_a_of(r), lower::env_b_of(r)
          ));
          var j = 0;
          while j < cap_entry.length() {
            if cap_entry.get(j) == k {
              if ast::is_some(cap_local.get(j)) {
                provide(ast::none(), ck_slot(cg_env.read(), cap_slot.get(j)), cap_local.get(j));
              }
            }
            j = j + 1;
          }
        }
        k = k + 1;
      }
      result_generic(home, ast::fu_res(d), ast::fu_nres(d), 0);
      # Each item made at the type the code after this is checked
      # against, the fresh generations read as the binds made them: a
      # functor that binds, inside, a type `F`'s result mentions but does
      # not hold (`WasiFloats` binds `Int`, which `float` takes) would
      # otherwise provide an item at a type the caller does not have. As
      # the bootstrap checks each branch, but here for the one bound.
      let gens = int_list();
      let made_tys = int_list();
      k = 0;
      while k < tsyms.length() {
        gens.push(fresh_gen(spec, tsyms.get(k)));
        made_tys.push(lower::canon(gmade, types::ty_of_symbol(types::kd_abstract(), tsyms.get(k))));
        k = k + 1;
      }
      if closed {
        # D84 (draft): checked where it was bound (`check_at_bind`), and
        # not here, where the binds' generic terms are the binding's.
        if cl_check.read() == 0 {
          return ();
        }
        # D84 3d: after the binds each type `F` is fixed in denotes
        # exactly what it denotes here (a pin is a manifest equation).
        let xs = int_list();
        lower::functor_fixed(fu, xs);
        k = 0;
        while k < xs.length() {
          let at = types::ty_of_symbol(types::kd_abstract(), xs.get(k));
          if lower::canon(gmade, at) != lower::canon(gmark, at) {
            semantic_error(prog::e_functor_sig(), prog::sym_name.get(xs.get(k)));
          }
          k = k + 1;
        }
      }
      k = 0;
      while k < syms.length() {
        let want = lower::env_find(cg_genv.read(), kinds.get(k), recvs.get(k), syms.get(k));
        let got = lower::env_find(gmade, kinds.get(k), mrecvs.get(k), syms.get(k));
        if ast::is_some(want) {
          if ast::is_some(got) {
            if !made_as_promised(kinds.get(k), syms.get(k), got, mrecvs.get(k), want, recvs.get(k), gens, made_tys) {
              semantic_error(prog::e_functor_sig(), prog::sym_name.get(syms.get(k)));
            }
          }
        }
        k = k + 1;
      }
    }

    # The check pass's `bind F;`, where nothing provides `F`: what the
    # code after it sees of any application, which is all it is checked
    # against — a fresh generation of each type in the result, and each
    # item provided generically at the inputs here, a val in a local of
    # the type promised.
    fn apply_generic(body: IntList, spec: Int, d: Int, home: Int) {
      let tsyms = int_list();
      result_types(home, ast::fu_res(d), ast::fu_nres(d), tsyms, 0);
      var gsite = cg_genv.read();
      var k = 0;
      while k < tsyms.length() {
        let t = tsyms.get(k);
        let gen_ty = types::ty_of_symbol(types::kd_abstract(), fresh_gen(spec, t));
        gsite = lower::env_push(gsite, lower::ek_type(), ast::none(), t, gen_ty, ast::none());
        live_type(t, gen_ty);
        k = k + 1;
      }
      let kinds = int_list();
      let recvs = int_list();
      let syms = int_list();
      result_keys(home, ast::fu_res(d), ast::fu_nres(d), gsite, kinds, recvs, syms, 0);
      cg_genv.write(gsite);
      result_generic(home, ast::fu_res(d), ast::fu_nres(d), 0);
      k = 0;
      while k < syms.length() {
        if kinds.get(k) == lower::ek_val() {
          let promised = lower::env_find(cg_genv.read(), lower::ek_val(), ast::none(), syms.get(k));
          let l = reveal(ast::none(), lower::env_a_of(promised));
          provide(ast::none(), syms.get(k), l);
        }
        k = k + 1;
      }
    }

    # Whether a provision the binds made (row `got` of the generic
    # environment they left, keyed at `grecv`) has the type the
    # application promises (row `want`, at `wrecv`), once each fresh
    # generation `gens` is read as the type `made` says the binds made it.
    fn made_as_promised(
      kind: Int, sym: Int, got: Int, grecv: Int, want: Int, wrecv: Int,
      gens: IntList, made: IntList
    ): Bool {
      if kind == lower::ek_val() {
        return lower::env_a_of(got) == types::subst(lower::env_a_of(want), gens, made);
      }
      # A returned functor keeps the fixed meanings captured when bound.
      # Compare its snapshot to the promised fresh output generations.
      if prog::sym_kind.get(sym) == prog::sk_functor() {
        let fixed = int_list();
        lower::functor_fixed(sym, fixed);
        var j = 0;
        while j < fixed.length() {
          let t = fixed.get(j);
          let have = lower::app_get(lower::env_b_of(got), t, row_view(got));
          var need = lower::app_get(lower::env_b_of(want), t, row_view(want));
          if ast::is_some(need) {
            need = types::subst(need, gens, made);
          }
          if have != need {
            return false;
          }
          j = j + 1;
        }
        return true;
      }
      let gp = sig_params(row_view(got), sym, grecv);
      let wp = sig_params(row_view(want), sym, wrecv);
      var i = 0;
      while i < gp.length() {
        if gp.get(i) != types::subst(wp.get(i), gens, made) {
          return false;
        }
        i = i + 1;
      }
      sig_ret(row_view(got), sym, grecv) == types::subst(sig_ret(row_view(want), sym, wrecv), gens, made)
    }

    # The local a val was provided in since the provision stack stood at
    # `mark`, or none.
    fn provision_above(sym: Int, mark: Int): Int {
      var i = pv_top.read();
      while i > mark {
        i = i - 1;
        if pv_sym.get(i) == sym {
          if !ast::is_some(pv_recv.get(i)) {
            return pv_local.get(i);
          }
        }
      }
      ast::none()
    }

    # The types an abstract functor's result holds, in order.
    fn result_types(m: Int, run: Int, n: Int, out: IntList, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        if !ast::is_some(ast::b_of(spec)) {
          let s = prog::resolve_path(m, ast::a_of(spec));
          if ast::is_some(s) {
            let kind = prog::sym_kind.get(s);
            if kind == prog::sk_type() {
              types::push_new(out, s);
            } else if kind == prog::sk_context() {
              let d = prog::sym_decl.get(s);
              result_types(prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), out, depth + 1);
            }
          }
        }
        i = i + 1;
      }
    }

    # The fresh generation of type `t` that the application `spec` makes:
    # a symbol of its own, the same one each time that application is
    # compiled, so that the generic environment says the same thing in
    # every specialization and both passes.
    fn fresh_gen(spec: Int, t: Int): Int {
      var i = 0;
      while i < fr_spec.length() {
        if fr_spec.get(i) == spec {
          if fr_type.get(i) == t {
            return fr_sym.get(i);
          }
        }
        i = i + 1;
      }
      let g = prog::add_symbol(
        prog::sym_mod.get(t), prog::sym_name.get(t), prog::sk_type(),
        prog::sym_decl.get(t), ast::none(), ast::none(), 0
      );
      fr_spec.push(spec);
      fr_type.push(t);
      fr_sym.push(g);
      g
    }

    # D78: a generation an application made, live to the end of the block
    # that made it.
    fn live_type(t: Int, gen_ty: Int) {
      if es_top.read() < es_made.length() {
        es_made.set(es_top.read(), gen_ty);
        es_sym.set(es_top.read(), t);
      } else {
        es_made.push(gen_ty);
        es_sym.push(t);
      }
      es_top.write(es_top.read() + 1);
    }

    # D78: no value of a type an application made may leave the block
    # that made it — the existential's unpack. Checked on the type the
    # block yields as the code is written, where the generation is a type
    # of its own whatever this specialization made it, as the bootstrap
    # checks it.
    fn check_escape(ty: Int, mark: Int) {
      var i = mark;
      while i < es_top.read() {
        if ty_mentions(ty, es_made.get(i)) {
          semantic_error(prog::e_escape(), prog::sym_name.get(es_sym.get(i)));
        }
        i = i + 1;
      }
    }

    # Whether type `t` is `target` or has it inside.
    fn ty_mentions(t: Int, target: Int): Bool {
      if t == target {
        return true;
      }
      let k = types::kind_of(t);
      if k == types::kd_record() {
        var i = 0;
        while i < types::field_count(t) {
          if ty_mentions(types::field_type_at(t, i), target) {
            return true;
          }
          i = i + 1;
        }
        return false;
      }
      if k == types::kd_nominal() {
        var i = 0;
        while i < types::member_count(t) {
          if ty_mentions(types::member_at(t, i), target) {
            return true;
          }
          i = i + 1;
        }
        return false;
      }
      if k == types::kd_union() {
        var i = 0;
        while i < types::member_count(t) {
          if ty_mentions(types::member_at(t, i), target) {
            return true;
          }
          i = i + 1;
        }
      }
      false
    }

    # Whether `row` is one of the rows of the chain `env`.
    fn in_chain(row: Int, env: Int): Bool {
      var e = env;
      while ast::is_some(e) {
        if e == row {
          return true;
        }
        e = lower::env_next_of(e);
      }
      false
    }

    # The keys of an abstract functor's result in the environment `env`:
    # a val's, a fn's, an abstract functor's (its symbol), and a method's
    # (its receiver as the item and its brackets read here, and the
    # method). Its types are made apart, first (`result_types`).
    fn result_keys(
      m: Int, run: Int, n: Int, env: Int, kinds: IntList, recvs: IntList,
      syms: IntList, depth: Int
    ) {
      result_keys_at(m, run, n, env, kinds, recvs, syms, int_list(), depth);
    }

    fn result_keys_at(
      m: Int, run: Int, n: Int, env: Int, kinds: IntList, recvs: IntList,
      syms: IntList, over: IntList, depth: Int
    ) {
      if depth > 2 * prog::sym_count() {
        semantic_error(prog::e_deep(), ast::none());
        return ();
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        let outer = lower::overlay(env, over);
        let inner = lower::app_view(outer, m, spec);
        let s = prog::resolve_path(m, ast::a_of(spec));
        if !ast::is_some(s) {
          semantic_error(prog::e_scope(), ast::path_last(ast::a_of(spec)));
          return ();
        }
        if ast::is_some(ast::b_of(spec)) {
          let method = lower::find_method_decl(m, s, ast::b_of(spec));
          if !ast::is_some(method) {
            semantic_error(prog::e_method(), ast::b_of(spec));
            return ();
          }
          kinds.push(lower::ek_fn());
          recvs.push(lower::canon(inner, types::ty_of_decl(s)));
          syms.push(method);
        } else {
          let kind = prog::sym_kind.get(s);
          let d = prog::sym_decl.get(s);
          if kind == prog::sk_context() {
            let inside = int_list();
            var j = 0;
            while j < over.length() { inside.push(over.get(j)); j = j + 1; }
            lower::bracket_pairs(inner, outer, inside);
            result_keys_at(prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), env, kinds, recvs, syms, inside, depth + 1);
          } else if kind == prog::sk_val() {
            if !ast::is_some(ast::c_of(d)) {
              kinds.push(lower::ek_val());
              recvs.push(ast::none());
              syms.push(s);
            }
          } else if kind == prog::sk_fn() {
            if !ast::is_some(ast::fn_body(d)) {
              kinds.push(lower::ek_fn());
              recvs.push(ast::none());
              syms.push(s);
            }
          } else if kind == prog::sk_functor() {
            if !ast::is_some(ast::fu_binds(d)) {
              kinds.push(lower::ek_fn());
              recvs.push(ast::none());
              syms.push(s);
            }
          }
        }
        i = i + 1;
      }
    }

    # An abstract functor's result, provided in the generic environment
    # where it is applied, each item at the inputs there.
    fn result_generic(m: Int, run: Int, n: Int, depth: Int) {
      result_generic_at(m, run, n, int_list(), depth);
    }

    fn result_generic_at(m: Int, run: Int, n: Int, over: IntList, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        let s = prog::resolve_path(m, ast::a_of(spec));
        if ast::is_some(s) {
          let genv = cg_genv.read();
          let outer = lower::overlay(genv, over);
          let gview = lower::app_view(outer, m, spec);
          if ast::is_some(ast::b_of(spec)) {
            let method = lower::find_method_decl(m, s, ast::b_of(spec));
            if ast::is_some(method) {
              provided_at(
                lower::ek_fn(), lower::canon(gview, types::ty_of_decl(s)), method, gview
              );
            }
          } else {
            let kind = prog::sym_kind.get(s);
            let d = prog::sym_decl.get(s);
            if kind == prog::sk_context() {
              let inside = int_list();
              var j = 0;
              while j < over.length() { inside.push(over.get(j)); j = j + 1; }
              lower::bracket_pairs(gview, outer, inside);
              result_generic_at(prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), inside, depth + 1);
            } else if kind == prog::sk_val() {
              if !ast::is_some(ast::c_of(d)) {
                cg_genv.write(lower::env_push(
                  genv, lower::ek_val(), ast::none(), s,
                  lower::elab(gview, ast::b_of(d), prog::sym_mod.get(s)),
                  lower::full_app(s, gview)
                ));
              }
            } else if kind == prog::sk_fn() {
              if !ast::is_some(ast::fn_body(d)) {
                provided_at(lower::ek_fn(), ast::none(), s, gview);
              }
            } else if kind == prog::sk_functor() {
              if !ast::is_some(ast::fu_binds(d)) {
                provided_at(lower::ek_fn(), ast::none(), s, gview);
              }
            }
          }
        }
        i = i + 1;
      }
    }

    # D78: `bind F = G;` provides the abstract functor `F` with `G` — a
    # functor with a body, or another abstract functor, which then
    # provides `F` with whatever it is bound to here (the platform's own,
    # for one lib/wasm.moss declares and nothing has bound). Static, like
    # a fn bind, and capturing nothing: `G`'s binds run where `F` is
    # applied. `G` may need fewer inputs than `F` takes, and must provide
    # exactly `F`'s result (`check_binding`).
    fn bind_functor(fu: Int, value: Int, m: Int, depth: Int, mode: Int) {
      if ast::is_some(ast::fu_binds(prog::sym_decl.get(fu))) {
        cg_error(c_unsupported(), prog::sym_name.get(fu));
        return ();
      }
      if ast::kind_of(value) != ast::k_ex_path() {
        cg_error(c_unsupported(), prog::sym_name.get(fu));
        return ();
      }
      let g = prog::resolve_path(m, ast::a_of(value));
      if !ast::is_some(g) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(value)));
        return ();
      }
      if prog::sym_kind.get(g) != prog::sk_functor() {
        cg_error(c_unsupported(), prog::sym_name.get(g));
        return ();
      }
      var provider = g;
      var captured = lower::env_empty();
      if !ast::is_some(ast::fu_binds(prog::sym_decl.get(g))) {
        if !lower::env_has(cg_genv.read(), lower::ek_fn(), ast::none(), g) {
          cg_error(c_unbound(), prog::sym_name.get(g));
          return ();
        }
        # D84 (draft): a copy needs `H` usable here, and polymorphic in at
        # least what `F` promises to be.
        if !check_stale(g) {
          return ();
        }
        if !params_within(fu, g, m) {
          return ();
        }
        let row = lower::env_find(cg_env.read(), lower::ek_fn(), ast::none(), g);
        provider = ast::none();
        if ast::is_some(row) {
          provider = lower::env_a_of(row);
          captured = lower::env_b_of(row);
        }
        if !ast::is_some(provider) {
          if in_wasm(g) {
            provider = g;
          }
        }
        if !ast::is_some(provider) {
          if !checking() {
            cg_error(c_unbound(), prog::sym_name.get(g));
            return ();
          }
        }
      }
      # Its fixed inputs (none, unbracketed) must be in force here.
      let xs = int_list();
      lower::functor_fixed(fu, xs);
      var x = 0;
      while x < xs.length() {
        if !lower::env_has(cg_genv.read(), lower::ek_type(), ast::none(), xs.get(x)) {
          cg_error(c_unbound(), prog::sym_name.get(xs.get(x)));
          return ();
        }
        x = x + 1;
      }
      let bodied = ast::is_some(ast::fu_binds(prog::sym_decl.get(g)));
      var source = ast::none();
      if bodied {
        # Rule B for the closure: `G`'s input types that `F` does not take
        # are captured here, each read as its meaning here, so each must
        # be in force here (those `F` takes are linked at each
        # application).
        closure_types_in_force(fu, g);
        if !check_captured_values(fu, g, m) {
          return ();
        }
        # Inputs `F` does not take are captured here (D84 3b), so only the
        # result is compared.
        if !check_outputs(fu, g, m) {
          return ();
        }
        check_functor_total(g, 0);
        let allowed = int_list();
        let gd = prog::sym_decl.get(g);
        result_types(prog::sym_mod.get(g), ast::fu_args(gd), ast::fu_nargs(gd), allowed, 0);
        if !check_bound_types(g, allowed, m, 0) {
          return ();
        }
        if !check_self_application(fu, g, m) {
          return ();
        }
        if !check_family_binding(fu, g, m) {
          return ();
        }
        if !contains(fb_sym, g) {
          fb_sym.push(g);
        }
        # D84 3: the binding captures this environment, both of them, and
        # its binds are checked here once, generic in what applications
        # supply.
        # A private environment marker keeps the original target through
        # abstract copies. Its generic-view key also distinguishes captures
        # with the same specialized values but different generic meanings.
        captured = lower::env_push(cg_env.read(), lower::ek_capture(),
          ast::none(), ast::none(), fu, cg_genv.read());
        remember_capture(captured, cg_genv.read());
        check_at_bind(value, fu, g, captured, depth, mode);
      } else {
        if !check_binding(fu, g, m) {
          return ();
        }
        if !check_copy_outputs(value, fu, g) { return (); }
        source = lower::env_find(cg_env.read(), lower::ek_fn(), ast::none(), g);
      }
      cg_env.write(lower::env_push(
        cg_env.read(), lower::ek_fn(), ast::none(), fu, provider, captured
      ));
      provided_at(lower::ek_fn(), ast::none(), fu, cg_genv.read());
      # D84 6: the vals the binding captured travel with `F` across
      # frames, as a fn provider's captured context does: each provided
      # again under the entry just made.
      if mode == bw_emit() {
        let row = cg_env.read();
        let slots = int_list();
        functor_slots(row, slots, 0);
        var i = 0;
        while i < slots.length() {
          var l = ast::none();
          if ast::is_some(source) {
            l = provision_of(ast::none(), ck_slot(source, slots.get(i)));
          }
          if !ast::is_some(l) {
            l = provision_of(ast::none(), slots.get(i));
          }
          if ast::is_some(l) {
            provide(ast::none(), ck_slot(row, slots.get(i)), l);
          }
          i = i + 1;
        }
      }
    }

    fn closure_types_in_force(fu: Int, g: Int) {
      let fd = prog::sym_decl.get(fu);
      let gd = prog::sym_decl.get(g);
      let fenv = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), int_list(), int_list());
      let genv_g = lower::assume_items(prog::sym_mod.get(g), ast::fu_args(gd), ast::fu_nargs(gd), int_list(), int_list());
      # And the polymorphic inputs it lists (or mentions), which each
      # application supplies.
      let poly = int_list();
      family_params(fu, poly);
      let here = cg_genv.read();
      let members = int_list();
      var e = genv_g;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          types::push_new(members, lower::env_sym_of(e));
        }
        e = lower::env_next_of(e);
      }
      e = genv_g;
      while ast::is_some(e) {
        if lower::env_kind_of(e) == lower::ek_type() {
          let t = lower::env_sym_of(e);
          var taken = lower::env_has(fenv, lower::ek_type(), ast::none(), t);
          if !taken {
            taken = types::contains_sym(poly, t);
          }
          if !taken {
            taken = type_in_force(t, here, int_list());
          }
          if !taken {
            # Or through `G`'s merge class of it.
            taken = in_force_through(t, here, int_list(), genv_g, members);
          }
          if !taken {
            semantic_error(prog::e_absent(), prog::sym_name.get(t));
          }
        }
        e = lower::env_next_of(e);
      }
    }

    # D84 rule 7 (O3 c, strengthened): a family's bindings bind no vals
    # and apply no functor but a family, so where an application is
    # placed on demand cannot be observed.
    fn check_family_binding(fu: Int, g: Int, m: Int): Bool {
      if !is_family(fu) {
        return true;
      }
      let gd = prog::sym_decl.get(g);
      let home = prog::sym_mod.get(g);
      var i = 0;
      while i < ast::fu_nbinds(gd) {
        let stmt = ast::kid_at(ast::fu_binds(gd), i);
        var j = 0;
        while j < ast::b_of(stmt) {
          let item = ast::kid_at(ast::a_of(stmt), j);
          let spec = ast::a_of(item);
          if ast::is_some(ast::a_of(spec)) {
            if !ast::is_some(ast::b_of(spec)) {
              let s = prog::resolve_path(home, ast::a_of(spec));
              if ast::is_some(s) {
                var bad = false;
                if ast::is_some(ast::b_of(item)) {
                  bad = prog::sym_kind.get(s) == prog::sk_val();
                } else {
                  bad = !is_family(s);
                }
                if bad {
                  prog::error(prog::e_family(), m, prog::sym_name.get(s));
                  return false;
                }
              }
            }
          }
          j = j + 1;
        }
        i = i + 1;
      }
      true
    }

    # D84 3f (D55): `G` applies `F`, and `F` is among `F`'s own inputs,
    # so each application would reach itself. Otherwise an application of
    # `F` in `G`'s binds is of the binding captured here (a polyfill).
    fn check_self_application(fu: Int, g: Int, m: Int): Bool {
      let fd = prog::sym_decl.get(fu);
      let frecv = int_list();
      let fsym = int_list();
      lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), frecv, fsym);
      if !contains(fsym, fu) {
        return true;
      }
      let gd = prog::sym_decl.get(g);
      var i = 0;
      while i < ast::fu_nbinds(gd) {
        let stmt = ast::kid_at(ast::fu_binds(gd), i);
        var j = 0;
        while j < ast::b_of(stmt) {
          let item = ast::kid_at(ast::a_of(stmt), j);
          if !ast::is_some(ast::b_of(item)) {
            let spec = ast::a_of(item);
            if ast::is_some(ast::a_of(spec)) {
              if prog::resolve_path(prog::sym_mod.get(g), ast::a_of(spec)) == fu {
                prog::error(prog::e_self_apply(), m, prog::sym_name.get(fu));
                return false;
              }
            }
          }
          j = j + 1;
        }
        i = i + 1;
      }
      true
    }

    # D84 6: the vals a functor binding's entry `e` captured, which travel
    # with it: each input of its functor `G` that `F` does not take — a
    # val, by value, and what a captured provider (or binding) carries in
    # turn, under that provider's entry in the captured environment.
    fn functor_slots(e: Int, out: IntList, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      let g = lower::env_a_of(e);
      let cap = lower::env_b_of(e);
      let fu = captured_target(lower::env_sym_of(e), cap);
      if !ast::is_some(g) {
        return ();
      }
      if prog::sym_kind.get(g) != prog::sk_functor() {
        return ();
      }
      let gd = prog::sym_decl.get(g);
      if !ast::is_some(ast::fu_binds(gd)) {
        return ();
      }
      if cap == lower::env_empty() {
        return ();
      }
      let fd = prog::sym_decl.get(fu);
      let frecv = int_list();
      let fsym = int_list();
      lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), frecv, fsym);
      let grecv = int_list();
      let gsym = int_list();
      lower::assume_items(prog::sym_mod.get(g), ast::fu_args(gd), ast::fu_nargs(gd), grecv, gsym);
      var genv = captured_genv(cap);
      if !ast::is_some(genv) {
        genv = cg_genv.read();
      }
      var i = 0;
      while i < gsym.length() {
        let s = gsym.get(i);
        if !contains(fsym, s) {
          if passed_need(grecv.get(i), s) {
            vs_append(out, s);
          } else if lower::need_kind(s) == lower::ek_fn() {
            var key = grecv.get(i);
            if ast::is_some(key) {
              key = instantiate_in(genv, key);
            }
            let r = lower::env_find(cap, lower::ek_fn(), key, s);
            if ast::is_some(r) {
              if ast::is_some(lower::env_a_of(r)) {
                let inner = int_list();
                if prog::sym_kind.get(s) == prog::sk_functor() {
                  functor_slots(r, inner, depth + 1);
                } else if prog::sym_kind.get(lower::env_a_of(r)) != prog::sk_functor() {
                  let row = vs_row(lower::env_a_of(r), lower::env_b_of(r), depth + 1);
                  var j = 0;
                  while j < vs_len.get(row) {
                    inner.push(vs_pool.get(vs_start.get(row) + j));
                    j = j + 1;
                  }
                }
                var j = 0;
                while j < inner.length() {
                  vs_append(out, ck_slot(r, inner.get(j)));
                  j = j + 1;
                }
              }
            }
          }
        }
        i = i + 1;
      }
    }

    # D84 (draft): the generic environment captured beside a specialized
    # one.
    fn remember_capture(senv: Int, genv: Int) {
      var i = 0;
      while i < cl_env.length() {
        if cl_env.get(i) == senv {
          return ();
        }
        i = i + 1;
      }
      cl_env.push(senv);
      cl_genv.push(genv);
      cl_bases.push(frame_base());
    }

    # What an assumed row's app is read against here.
    fn frame_base(): Int {
      if ast::is_some(cl_base.read()) {
        return cl_base.read();
      }
      lower::env_of(cg_where.read())
    }

    fn captured_base(senv: Int): Int {
      var i = 0;
      while i < cl_env.length() {
        if cl_env.get(i) == senv {
          return cl_bases.get(i);
        }
        i = i + 1;
      }
      ast::none()
    }

    fn captured_genv(senv: Int): Int {
      var i = 0;
      while i < cl_env.length() {
        if cl_env.get(i) == senv {
          return cl_genv.get(i);
        }
        i = i + 1;
      }
      ast::none()
    }

    # D84 (draft): `bind F = G;` with `F` bracketed — `G`'s binds run here,
    # as dead code, in the environment they capture, with each of `P(F)` a
    # fresh type; what they make is compared with what `F`, read here,
    # promises (`cl_check`), so a pin of a fixed input that disagrees with
    # it here is refused here, once.
    fn check_at_bind(spec: Int, fu: Int, g: Int, captured: Int, depth: Int, mode: Int) {
      let emark = cg_env.read();
      let gmark = cg_genv.read();
      let pmark = pv_top.read();
      let floor = pv_floor.read();
      let smark = es_top.read();
      # D84 3c: every type each application supplies is fresh — `P(F)`
      # and `F`'s input types outside `X(F)` — one per class `F`'s inputs
      # merge (D43).
      let ps = int_list();
      lower::functor_poly(fu, ps);
      let fd = prog::sym_decl.get(fu);
      let nrecv = int_list();
      let nsym = int_list();
      let decl_env = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), nrecv, nsym);
      let reps = int_list();
      let gens = int_list();
      var i = 0;
      while i < ps.length() {
        let p = ps.get(i);
        let rep = lower::canon(decl_env, types::ty_of_symbol(types::kd_abstract(), p));
        var gty = ast::none();
        var j = 0;
        while j < reps.length() {
          if reps.get(j) == rep {
            gty = gens.get(j);
          }
          j = j + 1;
        }
        if !ast::is_some(gty) {
          gty = types::ty_of_symbol(types::kd_abstract(), fresh_gen(0 - 2 * spec - 2, p));
          reps.push(rep);
          gens.push(gty);
        }
        cg_env.write(lower::env_push(cg_env.read(), lower::ek_type(), ast::none(), p, gty, ast::none()));
        cg_genv.write(lower::env_push(cg_genv.read(), lower::ek_type(), ast::none(), p, gty, ast::none()));
        i = i + 1;
      }
      let was = dead();
      let held = cl_check.read();
      cl_check.write(1);
      # A bound provider has no caller return frame. Check the actual
      # expanded body; separately queued lambda bodies get their own frame.
      let return_frame = cg_ret.read();
      cg_ret.write(ast::none());
      apply_closure_at(int_list(), spec, fu, g, captured, cg_env.read(), cg_genv.read(), depth, mode);
      cg_ret.write(return_frame);
      cl_check.write(held);
      alive(was);
      cg_env.write(emark);
      cg_genv.write(gmark);
      pv_top.write(pmark);
      pv_floor.write(floor);
      es_top.write(smark);
    }

    # D84 (draft): the fixed inputs of a bracketed `F` mean here what they
    # meant where `F` was provided (its generic row's app), or it cannot
    # be used here.
    fn check_stale(fu: Int): Bool {
      let xs = int_list();
      lower::functor_fixed(fu, xs);
      if xs.length() == 0 {
        return true;
      }
      let genv = cg_genv.read();
      let row = lower::env_find(genv, lower::ek_fn(), ast::none(), fu);
      if !ast::is_some(row) {
        return true;
      }
      let base = frame_base();
      var i = 0;
      while i < xs.length() {
        let x = xs.get(i);
        let have = lower::app_get(lower::env_b_of(row), x, base);
        var now = ast::none();
        let at = types::ty_of_symbol(types::kd_abstract(), x);
        if lower::env_has(genv, lower::ek_type(), ast::none(), x) {
          now = lower::canon(genv, at);
        }
        # The symbol itself and its parameter are both "as assumed".
        if now == at {
          now = lower::as_assumed(x);
        }
        var had = have;
        if had == at {
          had = lower::as_assumed(x);
        }
        if had != now {
          semantic_error(prog::e_incoherent(), prog::sym_name.get(fu));
          return false;
        }
        i = i + 1;
      }
      true
    }

    # D84: `P(F)` within `P(H)` for a copy `bind F = H;`, where each is
    # all of `M` when it has no brackets.
    fn params_within(fu: Int, h: Int, m: Int): Bool {
      if !ast::fu_bracketed(prog::sym_decl.get(h)) {
        return true;
      }
      let mine = int_list();
      if ast::fu_bracketed(prog::sym_decl.get(fu)) {
        lower::functor_params(fu, mine);
      } else {
        lower::functor_mentions(fu, mine);
      }
      let theirs = int_list();
      lower::functor_params(h, theirs);
      var i = 0;
      while i < mine.length() {
        if !types::contains_sym(theirs, mine.get(i)) {
          prog::error(prog::e_functor_sig(), m, prog::sym_name.get(mine.get(i)));
          return false;
        }
        i = i + 1;
      }
      true
    }

    # A captured value's type is read through the provider's input
    # merges before looking for a type supplied by each application.
    fn check_captured_values(fu: Int, g: Int, m: Int): Bool {
      let fd = prog::sym_decl.get(fu);
      let gd = prog::sym_decl.get(g);
      let fenv = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), int_list(), int_list());
      let genv = lower::assume_items(prog::sym_mod.get(g), ast::fu_args(gd), ast::fu_nargs(gd), int_list(), int_list());
      let inputs = int_list();
      result_types(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), inputs, 0);
      lower::functor_mentions(fu, inputs);
      let fixed = int_list();
      lower::functor_fixed(fu, fixed);
      var e = genv;
      while ast::is_some(e) {
        let v = lower::env_sym_of(e);
        if lower::env_kind_of(e) == lower::ek_val() {
          if !lower::env_has(fenv, lower::ek_val(), ast::none(), v) {
            let mentioned = int_list();
            abstract_syms(lower::canon(genv, lower::env_a_of(e)), mentioned);
            var i = 0;
            while i < mentioned.length() {
              var t = mentioned.get(i);
              let origin = prog::origin_of(t);
              if ast::is_some(origin) { t = origin; }
              if types::contains_sym(inputs, t) {
                if !types::contains_sym(fixed, t) {
                  prog::error(prog::e_functor_sig(), m, prog::sym_name.get(v));
                  return false;
                }
              }
              i = i + 1;
            }
          }
        }
        e = lower::env_next_of(e);
      }
      true
    }

    # `G`'s result exactly `F`'s, as leaf items.
    fn check_outputs(fu: Int, g: Int, m: Int): Bool {
      let fd = prog::sym_decl.get(fu);
      let gd = prog::sym_decl.get(g);
      let f_out_s = int_list();
      let f_out_d = int_list();
      let g_out_s = int_list();
      let g_out_d = int_list();
      sig_items(prog::sym_mod.get(fu), ast::fu_res(fd), ast::fu_nres(fd), f_out_s, f_out_d, 0);
      sig_items(prog::sym_mod.get(g), ast::fu_res(gd), ast::fu_nres(gd), g_out_s, g_out_d, 0);
      if !sig_within(f_out_s, f_out_d, g_out_s, g_out_d, m) {
        return false;
      }
      sig_within(g_out_s, g_out_d, f_out_s, f_out_d, m)
    }

    # D78: the types a functor bound to an abstract one names must be its
    # own: among its argument signature's (`allowed` on entry), or bound
    # by its own binds before they are named. What its binds call or read
    # is checked where it runs, in an environment of its inputs alone
    # (`restrict_to_args`); a type cannot be, since every type binding is
    # kept there, so this walks what its binds name instead: each bind's
    # left-hand side — a method's receiver, and the declared signature of
    # what is bound — and each functor it applies (its inputs needed, its
    # result's types then its own). Reports the first type out of place,
    # with the code of a signature mismatch.
    fn check_bound_types(g: Int, allowed: IntList, m: Int, depth: Int): Bool {
      if depth > 8 {
        return true;
      }
      let d = prog::sym_decl.get(g);
      let home = prog::sym_mod.get(g);
      var i = 0;
      while i < ast::fu_nbinds(d) {
        let stmt = ast::kid_at(ast::fu_binds(d), i);
        var j = 0;
        while j < ast::b_of(stmt) {
          let item = ast::kid_at(ast::a_of(stmt), j);
          let spec = ast::a_of(item);
          let named = int_list();
          var bound = ast::none();
          let s = prog::resolve_path(home, ast::a_of(spec));
          if ast::is_some(s) {
            if ast::is_some(ast::b_of(spec)) {
              if prog::sym_kind.get(s) == prog::sk_type() {
                named.push(s);
              }
              let method = lower::find_method_decl(home, s, ast::b_of(spec));
              if ast::is_some(method) {
                let said = int_list();
                lower::signature_syms(method, said);
                # What the bind's own brackets fix (`[Elem=Float]`) is not
                # named from outside.
                let fixed = int_list();
                var b = 0;
                while b < ast::d_of(spec) {
                  let lhs = prog::resolve_path(home, ast::a_of(ast::kid_at(ast::c_of(spec), b)));
                  if ast::is_some(lhs) {
                    fixed.push(lhs);
                  }
                  b = b + 1;
                }
                var q = 0;
                while q < said.length() {
                  if !types::contains_sym(fixed, said.get(q)) {
                    named.push(said.get(q));
                  }
                  q = q + 1;
                }
              }
            } else if !ast::is_some(ast::b_of(item)) {
              # An application: its inputs' types must be in force, and
              # its result's are then.
              if prog::sym_kind.get(s) == prog::sk_functor() {
                let fd = prog::sym_decl.get(s);
                result_types(prog::sym_mod.get(s), ast::fu_args(fd), ast::fu_nargs(fd), named, 0);
                if ast::is_some(ast::fu_binds(fd)) {
                  if !check_bound_types(s, allowed, m, depth + 1) {
                    return false;
                  }
                } else {
                  result_types(prog::sym_mod.get(s), ast::fu_res(fd), ast::fu_nres(fd), allowed, 0);
                }
              }
            } else {
              let kind = prog::sym_kind.get(s);
              if kind == prog::sk_type() {
                bound = s;
              } else if kind == prog::sk_val() {
                types::free_syms(ast::b_of(prog::sym_decl.get(s)), prog::sym_mod.get(s), named);
              } else if kind == prog::sk_fn() {
                lower::signature_syms(s, named);
              }
            }
          }
          var k = 0;
          while k < named.length() {
            if !types::contains_sym(allowed, named.get(k)) {
              prog::error(prog::e_functor_sig(), m, prog::sym_name.get(named.get(k)));
              return false;
            }
            k = k + 1;
          }
          if ast::is_some(bound) {
            types::push_new(allowed, bound);
          }
          j = j + 1;
        }
        i = i + 1;
      }
      true
    }

    # `G`'s inputs must be among `F`'s, and its result exactly `F`'s, as
    # leaf items: contexts flattened, and what needs no provision (a
    # unit, a tag, a defined fn or val) left out. Reports the first item
    # out of place.
    fn check_binding(fu: Int, g: Int, m: Int): Bool {
      let fd = prog::sym_decl.get(fu);
      let gd = prog::sym_decl.get(g);
      let f_in_s = int_list();
      let f_in_d = int_list();
      let g_in_s = int_list();
      let g_in_d = int_list();
      sig_items(prog::sym_mod.get(fu), ast::fu_args(fd), ast::fu_nargs(fd), f_in_s, f_in_d, 0);
      sig_items(prog::sym_mod.get(g), ast::fu_args(gd), ast::fu_nargs(gd), g_in_s, g_in_d, 0);
      if !sig_within(g_in_s, g_in_d, f_in_s, f_in_d, m) {
        return false;
      }
      let f_out_s = int_list();
      let f_out_d = int_list();
      let g_out_s = int_list();
      let g_out_d = int_list();
      sig_items(prog::sym_mod.get(fu), ast::fu_res(fd), ast::fu_nres(fd), f_out_s, f_out_d, 0);
      sig_items(prog::sym_mod.get(g), ast::fu_res(gd), ast::fu_nres(gd), g_out_s, g_out_d, 0);
      if !sig_within(f_out_s, f_out_d, g_out_s, g_out_d, m) {
        return false;
      }
      sig_within(g_out_s, g_out_d, f_out_s, f_out_d, m)
    }

    # Only formal variables can be solved; caller generations stay rigid.
    fn copy_match(pat: Int, actual: Int, vars: IntList, solved: IntList, values: IntList): Bool {
      let k = types::kind_of(pat);
      if k == types::kd_abstract() {
        let x = types::sym_of(pat);
        if contains(vars, x) {
          var i = 0;
          while i < solved.length() {
            if solved.get(i) == x { return values.get(i) == actual; }
            i = i + 1;
          }
          solved.push(x); values.push(actual); return true;
        }
      }
      if k != types::kind_of(actual) { return false; }
      if types::sym_of(pat) != types::sym_of(actual) { return false; }
      if types::member_count(pat) != types::member_count(actual) { return false; }
      var i = 0;
      if k == types::kd_record() {
        while i < types::field_count(pat) {
          if types::field_name_at(pat, i) != types::field_name_at(actual, i) { return false; }
          if !copy_match(types::field_type_at(pat, i), types::field_type_at(actual, i), vars, solved, values) { return false; }
          i = i + 1;
        }
      } else {
        while i < types::member_count(pat) {
          if !copy_match(types::member_at(pat, i), types::member_at(actual, i), vars, solved, values) { return false; }
          i = i + 1;
        }
      }
      true
    }

    fn copy_domain(fu: Int, out: IntList) {
      let d = prog::sym_decl.get(fu);
      result_types(prog::sym_mod.get(fu), ast::fu_args(d), ast::fu_nargs(d), out, 0);
      lower::functor_mentions(fu, out);
    }

    fn copy_formal(fu: Int, keys: IntList): Int {
      let d = prog::sym_decl.get(fu);
      let recv = int_list(); let syms = int_list();
      var env = lower::assume_items(prog::sym_mod.get(fu), ast::fu_args(d), ast::fu_nargs(d), recv, syms);
      var i = 0;
      while i < keys.length() {
        let t = keys.get(i);
        if !lower::env_has(env, lower::ek_type(), ast::none(), t) {
          env = lower::env_push(env, lower::ek_type(), ast::none(), t, lower::as_assumed(t), ast::none());
        }
        i = i + 1;
      }
      env
    }

    # Check final output slots for every future target application, with
    # separate brands for linked inputs and newly produced output roles.
    fn check_copy_outputs(spec: Int, fu: Int, g: Int): Bool {
      let held = cg_genv.read();
      let fk = int_list(); let gk = int_list();
      copy_domain(fu, fk); copy_domain(g, gk);
      let fe = copy_formal(fu, fk); let ge = copy_formal(g, gk);
      let vars = int_list();
      var i = 0;
      while i < fk.length() {
        abstract_syms(lower::canon(fe, lower::as_assumed(fk.get(i))), vars);
        i = i + 1;
      }
      let solved = int_list(); let values = int_list();
      let fixed = int_list(); lower::functor_fixed(fu, fixed);
      i = 0;
      while i < fixed.length() {
        let t = fixed.get(i);
        let actual = lower::canon(held, types::ty_of_symbol(types::kd_abstract(), t));
        if !copy_match(lower::canon(fe, lower::as_assumed(t)), actual, vars, solved, values) {
          semantic_error(prog::e_functor_sig(), prog::sym_name.get(fu)); return false;
        }
        i = i + 1;
      }
      let replacements = int_list();
      i = 0;
      while i < vars.length() {
        var replacement = ast::none(); var j = 0;
        while j < solved.length() {
          if solved.get(j) == vars.get(i) { replacement = values.get(j); }
          j = j + 1;
        }
        if !ast::is_some(replacement) {
          replacement = types::ty_of_symbol(types::kd_abstract(), fresh_gen(0 - 2 * spec - 2, vars.get(i)));
        }
        replacements.push(replacement); i = i + 1;
      }
      var fv = held; var gv = held;
      i = 0;
      while i < fk.length() {
        let t = fk.get(i);
        fv = lower::env_push(fv, lower::ek_type(), ast::none(), t,
          types::subst(lower::canon(fe, lower::as_assumed(t)), vars, replacements), ast::none());
        i = i + 1;
      }
      i = 0;
      while i < gk.length() {
        let t = gk.get(i);
        let ty = types::subst(lower::canon(ge, lower::as_assumed(t)), vars, replacements);
        let want = lower::canon(fv, types::ty_of_symbol(types::kd_abstract(), t));
        if !contains(fk, t) { semantic_error(prog::e_functor_sig(), prog::sym_name.get(t)); return false; }
        if ty != want { semantic_error(prog::e_functor_sig(), prog::sym_name.get(t)); return false; }
        gv = lower::env_push(gv, lower::ek_type(), ast::none(), t, ty, ast::none());
        i = i + 1;
      }
      let fd = prog::sym_decl.get(fu); let gd = prog::sym_decl.get(g);
      let outputs = int_list();
      result_types(prog::sym_mod.get(fu), ast::fu_res(fd), ast::fu_nres(fd), outputs, 0);
      i = 0;
      while i < outputs.length() {
        let t = outputs.get(i);
        let role = types::ty_of_symbol(types::kd_abstract(), fresh_gen(0 - 2 * spec - 3, t));
        fv = lower::env_push(fv, lower::ek_type(), ast::none(), t, role, ast::none());
        gv = lower::env_push(gv, lower::ek_type(), ast::none(), t, role, ast::none());
        i = i + 1;
      }
      cg_genv.write(fv); result_generic(prog::sym_mod.get(fu), ast::fu_res(fd), ast::fu_nres(fd), 0); fv = cg_genv.read();
      cg_genv.write(gv); result_generic(prog::sym_mod.get(g), ast::fu_res(gd), ast::fu_nres(gd), 0); gv = cg_genv.read();
      cg_genv.write(held);
      let kinds = int_list(); let recvs = int_list(); let syms = int_list();
      let hkinds = int_list(); let hrecvs = int_list(); let hsyms = int_list();
      result_keys(prog::sym_mod.get(fu), ast::fu_res(fd), ast::fu_nres(fd), fv, kinds, recvs, syms, 0);
      result_keys(prog::sym_mod.get(g), ast::fu_res(gd), ast::fu_nres(gd), gv, hkinds, hrecvs, hsyms, 0);
      i = syms.length();
      while i > 0 {
        i = i - 1;
        let sym = syms.get(i); let recv = recvs.get(i); let kind = kinds.get(i);
        var later = false; var j = i + 1;
        while j < syms.length() {
          if kinds.get(j) == kind { if syms.get(j) == sym { if recvs.get(j) == recv { later = true; } } }
          j = j + 1;
        }
        if !later {
          var found = false; j = hsyms.length();
          while j > 0 {
            j = j - 1;
            if !found { if hkinds.get(j) == kind { if hsyms.get(j) == sym { if hrecvs.get(j) == recv {
              found = true;
              let want = lower::env_find(fv, kind, recv, sym);
              let got = lower::env_find(gv, kind, recv, sym);
              if !made_as_promised(kind, sym, got, recv, want, recv, int_list(), int_list()) {
                semantic_error(prog::e_functor_sig(), prog::sym_name.get(sym)); return false;
              }
              let deps = int_list(); lower::item_deps(sym, deps); var d = 0;
              while d < deps.length() {
                let t = deps.get(d);
                if lower::app_get(lower::env_b_of(got), t, gv) != lower::app_get(lower::env_b_of(want), t, fv) {
                  semantic_error(prog::e_functor_sig(), prog::sym_name.get(sym)); return false;
                }
                d = d + 1;
              }
            } } } }
          }
          if !found { semantic_error(prog::e_functor_sig(), prog::sym_name.get(sym)); return false; }
        }
      }
      true
    }

    # D55, D22: a functor with binds must bind every leaf item of its
    # result signature itself — a bind whose left-hand side is that item,
    # or an application of a functor whose result holds it. A type bind
    # binds the type and nothing it then makes reachable: `bind Base =
    # Int;` does not bind a promised `Base.add`, though `Int.add` is what
    # `Base.add` would then resolve to. Checked once per functor, where it
    # is applied or bound to an abstract one, as the bootstrap's
    # `check_functor_total`; each item missing is `e_partial`, in the
    # functor's module, named as `sig_within` names one.
    fn check_functor_total(fu: Int, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      if contains(ft_sym, fu) {
        return ();
      }
      ft_sym.push(fu);
      let d = prog::sym_decl.get(fu);
      if !ast::is_some(ast::fu_binds(d)) {
        return ();
      }
      let home = prog::sym_mod.get(fu);
      let want_s = int_list();
      let want_d = int_list();
      sig_items(home, ast::fu_res(d), ast::fu_nres(d), want_s, want_d, 0);
      let got_s = int_list();
      let got_d = int_list();
      var i = 0;
      while i < ast::fu_nbinds(d) {
        let stmt = ast::kid_at(ast::fu_binds(d), i);
        var j = 0;
        while j < ast::b_of(stmt) {
          let item = ast::kid_at(ast::a_of(stmt), j);
          let spec = ast::a_of(item);
          let s = prog::resolve_path(home, ast::a_of(spec));
          if ast::is_some(s) {
            if ast::is_some(ast::b_of(item)) {
              got_s.push(s);
              got_d.push(ast::b_of(spec));
            } else if prog::sym_kind.get(s) == prog::sk_functor() {
              # An application provides its own result signature.
              check_functor_total(s, depth + 1);
              let sd = prog::sym_decl.get(s);
              sig_items(prog::sym_mod.get(s), ast::fu_res(sd), ast::fu_nres(sd), got_s, got_d, 0);
            }
          }
          j = j + 1;
        }
        i = i + 1;
      }
      i = 0;
      while i < want_s.length() {
        var found = false;
        var j = 0;
        while j < got_s.length() {
          if got_s.get(j) == want_s.get(i) {
            if got_d.get(j) == want_d.get(i) {
              found = true;
            }
          }
          j = j + 1;
        }
        if !found {
          if ast::is_some(want_d.get(i)) {
            prog::error(prog::e_partial(), home, want_d.get(i));
          } else {
            prog::error(prog::e_partial(), home, prog::sym_name.get(want_s.get(i)));
          }
        }
        i = i + 1;
      }
    }

    # Whether every item of the first list is in the second; the first
    # that is not is reported, by its name (a method's, without the dot).
    fn sig_within(xs: IntList, xd: IntList, ys: IntList, yd: IntList, m: Int): Bool {
      var i = 0;
      while i < xs.length() {
        var found = false;
        var j = 0;
        while j < ys.length() {
          if ys.get(j) == xs.get(i) {
            if yd.get(j) == xd.get(i) {
              found = true;
            }
          }
          j = j + 1;
        }
        if !found {
          if ast::is_some(xd.get(i)) {
            prog::error(prog::e_functor_sig(), m, xd.get(i));
          } else {
            prog::error(prog::e_functor_sig(), m, prog::sym_name.get(xs.get(i)));
          }
          return false;
        }
        i = i + 1;
      }
      true
    }

    # The leaf items of a signature: (symbol, none) for a plain item, and
    # (receiver symbol, method name) for a method item.
    fn sig_items(m: Int, run: Int, n: Int, syms: IntList, dots: IntList, depth: Int) {
      if depth > 2 * prog::sym_count() {
        return ();
      }
      var i = 0;
      while i < n {
        let spec = ast::kid_at(run, i);
        let s = prog::resolve_path(m, ast::a_of(spec));
        if ast::is_some(s) {
          if ast::is_some(ast::b_of(spec)) {
            syms.push(s);
            dots.push(ast::b_of(spec));
          } else {
            let kind = prog::sym_kind.get(s);
            let d = prog::sym_decl.get(s);
            var leaf = true;
            if kind == prog::sk_context() {
              sig_items(prog::sym_mod.get(s), ast::b_of(d), ast::c_of(d), syms, dots, depth + 1);
              leaf = false;
            } else if kind == prog::sk_unit() {
              leaf = false;
            } else if kind == prog::sk_tag() {
              leaf = false;
            } else if kind == prog::sk_alias() {
              leaf = false;
            } else if kind == prog::sk_val() {
              leaf = !ast::is_some(ast::c_of(d));
            } else if kind == prog::sk_fn() {
              leaf = !ast::is_some(ast::fn_body(d));
            }
            if leaf {
              syms.push(s);
              dots.push(ast::none());
            }
          }
        }
        i = i + 1;
      }
    }

    # D75: a functor with no body that lib/wasm.moss declares is provided
    # by the platform (D78: as it provides that file's abstract fns).
    # Applying it — through `apply_abstract`, which has checked its
    # argument signature here — provides each method of its result
    # signature at the receiver that item names, read here — as a
    # hand-written method bind would, in both environments, so coherence
    # sees it like any provision — except that the provider is the method
    # itself, which has no body: `platform_prim` says which instructions
    # a call through it is.
    fn platform_functor(d: Int, home: Int) {
      var i = 0;
      while i < ast::fu_nres(d) {
        let spec = ast::kid_at(ast::fu_res(d), i);
        let recv_sym = prog::resolve_path(home, ast::a_of(spec));
        var method = ast::none();
        if ast::is_some(recv_sym) {
          if ast::is_some(ast::b_of(spec)) {
            method = lower::find_method_decl(home, recv_sym, ast::b_of(spec));
          }
        }
        if ast::is_some(method) { runtime_primitive(method); }
        if platform_prim(method) == 0 {
          cg_error(c_unsupported(), ast::b_of(spec));
          return ();
        }
        let genv = cg_genv.read();
        let recv = lower::canon(genv, types::ty_of_decl(recv_sym));
        cg_env.write(lower::env_push(
          cg_env.read(), lower::ek_fn(), recv, method, method, lower::env_empty()
        ));
        provided_at(lower::ek_fn(), recv, method, genv);
        i = i + 1;
      }
    }

    # Whether one item of an abstract functor's argument signature is in
    # force here: a type assumed or bound, an abstract val, fn or functor
    # assumed or bound.
    # The first that is not is reported, and it says whether all were.
    fn platform_needs(spec: Int, m: Int, depth: Int): Bool {
      if depth > 2 * prog::sym_count() {
        semantic_error(prog::e_deep(), ast::none());
        return false;
      }
      if ast::is_some(ast::b_of(spec)) {
        return true;
      }
      let s = prog::resolve_path(m, ast::a_of(spec));
      if !ast::is_some(s) {
        semantic_error(prog::e_scope(), ast::path_last(ast::a_of(spec)));
        return false;
      }
      let kind = prog::sym_kind.get(s);
      let genv = cg_genv.read();
      var have = true;
      if kind == prog::sk_context() {
        let cd = prog::sym_decl.get(s);
        var i = 0;
        while i < ast::c_of(cd) {
          if !platform_needs(ast::kid_at(ast::b_of(cd), i), prog::sym_mod.get(s), depth + 1) {
            return false;
          }
          i = i + 1;
        }
      } else if kind == prog::sk_type() {
        have = lower::env_has(genv, lower::ek_type(), ast::none(), s);
      } else if kind == prog::sk_val() {
        if !ast::is_some(ast::c_of(prog::sym_decl.get(s))) {
          have = lower::env_has(genv, lower::ek_val(), ast::none(), s);
        }
      } else if kind == prog::sk_fn() {
        if !ast::is_some(ast::fn_body(prog::sym_decl.get(s))) {
          have = lower::env_has(genv, lower::ek_fn(), ast::none(), s);
        }
      } else if kind == prog::sk_functor() {
        if !ast::is_some(ast::fu_binds(prog::sym_decl.get(s))) {
          have = lower::env_has(genv, lower::ek_fn(), ast::none(), s);
        }
      }
      if !have {
        cg_error(c_unbound(), prog::sym_name.get(s));
      }
      have
    }

    # The type or the function a bind's right-hand side names.
    fn named_type(value: Int, m: Int): Int {
      let raw = named_type_raw(value, m);
      if !ast::is_some(raw) {
        return raw;
      }
      lower::canon(cg_env.read(), raw)
    }

    # The same, before any environment substitutes into it.
    fn named_type_raw(value: Int, m: Int): Int {
      if ast::kind_of(value) != ast::k_ex_path() {
        return ast::none();
      }
      let sym = prog::resolve_path(m, ast::a_of(value));
      if !ast::is_some(sym) {
        return ast::none();
      }
      # `bind U = Box[Elem=Char];` — the right side's brackets apply, as
      # they do in a type position; dropping them was a silent wrong type.
      if ast::d_of(value) == 1 {
        return types::apply(sym, ast::b_of(value), ast::c_of(value), m);
      }
      types::ty_of_decl(sym)
    }

    fn named_fn(value: Int, m: Int): Int {
      if ast::kind_of(value) == ast::k_ex_path() {
        # A provider names code; its substitutions come from the bind.
        if ast::d_of(value) == 1 {
          return ast::none();
        }
        let sym = prog::resolve_path(m, ast::a_of(value));
        if ast::is_some(sym) {
          if is_compilable(sym) {
            return sym;
          }
        }
        return ast::none();
      }
      # `bind Int.add = Num.add;` parses as a field access, since the
      # receiver is a type rather than a value.
      if ast::kind_of(value) == ast::k_ex_field() {
        let obj = ast::a_of(value);
        if ast::kind_of(obj) == ast::k_ex_path() {
          if ast::d_of(obj) == 1 {
            return ast::none();
          }
          let recv = prog::resolve_path(m, ast::a_of(obj));
          if ast::is_some(recv) {
            let found = prog::find_attached(
              prog::sym_mod.get(recv), recv, ast::b_of(value)
            );
            if ast::is_some(found) {
              return found;
            }
          }
        }
      }
      ast::none()
    }

    # Two entries a loop: the depth a `break` leaves it to, and whether
    # one does — a `loop` that no `break` leaves does not fall through.
    fn push_loop(level: Int) {
      let top = 2 * cg_ntop.read();
      if top < cg_loops.length() {
        cg_loops.set(top, level);
        cg_loops.set(top + 1, 0);
      } else {
        cg_loops.push(level);
        cg_loops.push(0);
      }
      cg_ntop.write(cg_ntop.read() + 1);
    }

    fn loop_broken(): Bool {
      cg_loops.get(2 * cg_ntop.read() - 1) != 0
    }

    # Emits a statement, and says whether it cannot fall through, as the
    # bootstrap's `check_stmt` decides it: a `loop` no `break` leaves, or
    # an expression of type `|`.
    fn emit_stmt(body: IntList, s: Int, m: Int): Bool {
      let saved = prog::location.read();
      if ast::is_some(ast::source_start(s)) { prog::location.write(s + 1); }
      let result = emit_stmt_inner(body, s, m);
      prog::location.write(saved);
      result
    }

    fn emit_stmt_inner(body: IntList, s: Int, m: Int): Bool {
      let k = ast::kind_of(s);
      if k == ast::k_st_let() {
        emit_binding(body, s, m);
      } else if k == ast::k_st_var() {
        emit_binding(body, s, m);
      } else if k == ast::k_st_assign() {
        let local = find_local(ast::a_of(s));
        if contains(cg_capt, local) {
          # D70: captured by value, so an assignment could only change
          # the copy; it is refused rather than silently lost.
          prog::error(prog::e_lambda(), m, ast::a_of(s));
        }
        if ast::is_some(local) {
          emit_as(body, ast::b_of(s), m, lc_type.get(local));
          store_local(body, local);
        } else {
          emit_expr(body, ast::b_of(s), m);
          semantic_error(prog::e_scope(), ast::a_of(s));
        }
      } else if k == ast::k_st_while() {
        op_block(body, bt_empty());
        cg_depth.write(cg_depth.read() + 1);
        let exit = cg_depth.read();
        push_loop(exit);
        op_loop(body, bt_empty());
        cg_depth.write(cg_depth.read() + 1);
        emit_expr(body, ast::a_of(s), m);
        body.push(69);
        op_br_if(body, cg_depth.read() - exit);
        drop_value(body, emit_expr(body, ast::b_of(s), m));
        op_br(body, 0);
        op_end(body);
        cg_depth.write(cg_depth.read() - 1);
        op_end(body);
        cg_depth.write(cg_depth.read() - 1);
        cg_ntop.write(cg_ntop.read() - 1);
      } else if k == ast::k_st_loop() {
        op_block(body, bt_empty());
        cg_depth.write(cg_depth.read() + 1);
        push_loop(cg_depth.read());
        op_loop(body, bt_empty());
        cg_depth.write(cg_depth.read() + 1);
        drop_value(body, emit_expr(body, ast::a_of(s), m));
        op_br(body, 0);
        op_end(body);
        cg_depth.write(cg_depth.read() - 1);
        op_end(body);
        cg_depth.write(cg_depth.read() - 1);
        let broken = loop_broken();
        cg_ntop.write(cg_ntop.read() - 1);
        return !broken;
      } else if k == ast::k_st_bind() {
        walk_binds(body, s, m, bw_emit());
      } else if k == ast::k_st_expr() {
        let ty = emit_expr(body, ast::a_of(s), m);
        drop_value(body, ty);
        return is_never(ty);
      } else {
        cg_error(c_unsupported(), ast::none());
      }
      false
    }

    fn emit_binding(body: IntList, s: Int, m: Int) {
      var want = ast::none();
      if ast::is_some(ast::b_of(s)) {
        want = elab_ty(ast::b_of(s), m);
      }
      let got = emit_as(body, ast::c_of(s), m, want);
      var ty = want;
      if !ast::is_some(want) {
        ty = got;
      }
      store_local(body, reveal(ast::a_of(s), ty));
    }

    fn compile_one(qi: Int) {
      compile_frame(qi, fq_sym.get(qi), fq_env.get(qi));
    }

    # One frame: `sym` specialized in `env`, at queue position `qi` — or,
    # in the check pass, at none.
    fn compile_frame(qi: Int, sym: Int, env: Int) {
      let d = prog::sym_decl.get(sym);
      let m = prog::sym_mod.get(sym);
      cg_where.write(sym);
      prog::location.write(d + 1);
      lc_base.write(lc_name.length());
      lc_visible.write(lc_name.length());
      cg_depth.write(0);
      cg_ntop.write(0);
      # One frame at a time, so the provisions start empty.
      pv_top.write(0);
      pv_floor.write(0);
      es_top.write(0);
      cl_cur.write(lower::env_empty());
      cl_base.write(ast::none());
      cg_env.write(env);
      cg_genv.write(lower::env_of(sym));
      cg_gbase.write(cg_genv.read());
      if is_defined_method(sym) {
        let t = this_type_in(cg_genv.read(), sym);
        add_local(ast::none(), t, spec(t));
      }
      var i = 0;
      while i < ast::fn_nparams(d) {
        let p = ast::kid_at(ast::fn_params(d), i);
        let t = elab_ty(ast::b_of(p), m);
        add_local(ast::a_of(p), t, spec(t));
        i = i + 1;
      }
      # Then the needs that travel as data, in the same order the
      # signature declared them, each provided from its own parameter.
      var nparams = lc_name.length() - lc_base.read();
      let vals = int_list();
      val_slots(vals, sym, env, 0);
      i = 0;
      while i < vals.length() {
        let ns = vals.get(i);
        # Nameless, like a `bind`'s local: these are reached by symbol.
        # Laid out as the signature has it; typed, where this frame names
        # it, as its provision in the generic environment says.
        let sty = need_type_in(cg_env.read(), ns);
        provide(ast::none(), ns, add_local(ast::none(), need_gtype(ns, sty), sty));
        nparams = nparams + 1;
        i = i + 1;
      }
      # An anonymous function reads each local it captured (D70) by the
      # local's name, from the val that carries it. Local ids are never
      # reused (`lc_base` only grows), so `cg_capt` need not be emptied.
      let row = lambda_row(sym);
      if ast::is_some(row) {
        var j = 0;
        while j < lm_clen.get(row) {
          let at = lm_cstart.get(row) + j * 2;
          let l = provision_of(ast::none(), lm_cap.get(at + 1));
          if ast::is_some(l) {
            lc_name.set(l, lm_cap.get(at));
            cg_capt.push(l);
          }
          j = j + 1;
        }
      }
      # The body's own locals: none yet in the first pass, which creates
      # them as it goes; in the second, exactly the ones the first made.
      if cg_real.read() == 1 {
        var j = 0;
        while j < fl_len.get(qi) {
          let sty = fl_types.get(fl_start.get(qi) + j);
          add_local(ast::none(), sty, sty);
          j = j + 1;
        }
      }
      lc_visible.write(lc_base.read() + nparams);
      let counts = assign_slots(nparams);
      let body = int_list();
      let want = elab_ty(ast::fn_ret(d), m);
      cg_ret.write(want);
      let got = emit_as(body, ast::fn_body(d), m, want);
      if width(want) == 0 {
        drop_value(body, got);
      } else if width(got) == 0 {
        # The body always jumped out; the validator still wants a value.
        op_unreachable(body);
      }
      op_end(body);
      if cg_real.read() == 1 {
        if lc_visible.read() != lc_name.length() {
          # Fewer revealed than the first pass made: they disagree.
          cg_error(c_missing(), prog::sym_name.get(sym));
        }
        emit::set_body(fq_index.get(qi), counts, body);
      } else if !checking() {
        while fl_start.length() <= qi {
          fl_start.push(0);
          fl_len.push(0);
        }
        fl_start.set(qi, fl_types.length());
        var j = lc_base.read() + nparams;
        while j < lc_name.length() {
          fl_types.push(lc_spec.get(j));
          j = j + 1;
        }
        fl_len.set(qi, lc_name.length() - (lc_base.read() + nparams));
      }
    }

    # Drain the queue. It grows while it is walked, since emitting a call
    # is what notices the callee.
    fn compile_all() {
      var i = 0;
      while i < fq_sym.length() {
        compile_one(i);
        i = i + 1;
      }
    }

    # D16: no post-monomorphization checks. Typing happens as a body is
    # emitted, so a function the program never reaches would never be
    # checked; the bootstrap checks every one. So each defined function
    # and method that no specialization reached is walked once more, in
    # its own generic environment, specialized as itself: the types its
    # generic environment binds, each assumed one its own parameter, which
    # is laid out as one scalar, as the bootstrap's back end has it, and
    # no provision, since nothing provides one to the code as written. So is
    # each anonymous function a bind made that nothing called, including
    # the ones this pass makes, which come after it in symbol order. What
    # is reached was checked already: typing is generic, so every
    # specialization of a frame says the same thing.
    fn check_unreached() {
      let reached = int_list();
      var i = 0;
      while i < fq_sym.length() {
        let f = fq_sym.get(i);
        while reached.length() <= f {
          reached.push(0);
        }
        reached.set(f, 1);
        i = i + 1;
      }
      cg_real.write(2);
      var f = 0;
      var g = 0;
      loop {
        if f < prog::sym_count() {
          var done = false;
          if f < reached.length() {
            done = reached.get(f) == 1;
          }
          if !done {
            if is_compilable(f) {
              compile_frame(ast::none(), f, types_of(lower::env_of(f)));
            }
          }
          f = f + 1;
        } else if g < fb_sym.length() {
          check_functor_body(fb_sym.get(g));
          g = g + 1;
        } else {
          break;
        }
      }
      cg_real.write(1);
      cg_where.write(ast::none());
    }

    # D78: a functor bound to an abstract one may rely only on its own
    # argument signature, which is all an application promises it. Where
    # an application is reached, its binds run restricted to that
    # (`restrict_to_args`); here they run once more, as a frame of their
    # own, as the bootstrap checks them: as though the functor were a
    # function assuming exactly its arguments, whose body is its binds —
    # so they are checked though no application is ever reached.
    fn check_functor_body(g: Int) {
      let d = prog::sym_decl.get(g);
      let home = prog::sym_mod.get(g);
      let nrecv = int_list();
      let nsym = int_list();
      var genv = lower::env_empty();
      var i = 0;
      while i < ast::fu_nargs(d) {
        genv = lower::add_assume_item(genv, home, ast::kid_at(ast::fu_args(d), i), nrecv, nsym);
        i = i + 1;
      }
      let apps = int_list();
      i = 0;
      while i < nsym.length() {
        let row = lower::env_find(genv, lower::need_kind(nsym.get(i)), nrecv.get(i), nsym.get(i));
        if ast::is_some(row) {
          apps.push(lower::env_b_of(row));
        } else {
          apps.push(lower::env_empty());
        }
        i = i + 1;
      }
      lower::set_needs(g, genv, nrecv, nsym, apps);
      cg_where.write(g);
      prog::location.write(d + 1);
      lc_base.write(lc_name.length());
      lc_visible.write(lc_name.length());
      cg_depth.write(0);
      cg_ntop.write(0);
      pv_top.write(0);
      pv_floor.write(0);
      es_top.write(0);
      cl_cur.write(lower::env_empty());
      cl_base.write(ast::none());
      cg_genv.write(genv);
      cg_gbase.write(genv);
      cg_env.write(types_of(genv));
      cg_ret.write(ty_none());
      # Its input vals, each in a local of the type it is assumed at.
      i = 0;
      while i < nsym.length() {
        let ns = nsym.get(i);
        if passed_need(nrecv.get(i), ns) {
          let sty = need_type_in(cg_env.read(), ns);
          provide(ast::none(), ns, reveal(ast::none(), need_gtype(ns, sty)));
        }
        i = i + 1;
      }
      run_functor(int_list(), g, 0, bw_emit());
    }

    # The whole module. `_start` is a wrapper rather than `main` itself,
    # so that the heap pointer the library's allocator reads is set
    # before anything runs — the same layout the bootstrap backend uses.
    fn heap_base(): Int { 1 << 10 }

    fn heap_pointer(): Int { 16 }

    # What `main` is specialized in: nothing, but for the one platform
    # type a program may rebind (D79). `Memory` there is the main memory,
    # a symbol of its own that no environment binds — not `Memory`, which
    # a later `bind Memory = Scratch;` would reach back into, nor its
    # parameter, which a callee generic over `Memory` binds to its own
    # (D72) — so that `bind Source = Memory;` in `main` names the main
    # memory wherever it is read.
    fn root_env(): Int {
      let mem = cg_memory.read();
      if !ast::is_some(mem) {
        return lower::env_empty();
      }
      let given = main_memory();
      let env = lower::env_push(
        lower::env_empty(), lower::ek_type(), ast::none(), mem, given, ast::none()
      );
      lower::env_push(
        env, lower::ek_type(), ast::none(), prog::param_of(mem), given, ast::none()
      )
    }

    fn main_memory(): Int {
      types::ty_of_symbol(
        types::kd_abstract(), prog::param_of(prog::param_of(cg_memory.read()))
      )
    }

    fn compile(entry: Int, out: IntList) {
      cg_entry.write(entry);
      prog::location.write(0);
      cg_where.write(ast::none());
      find_primitive_modules();
      wops::install_wasm_ops();
      lower::desugar_call_brackets();
      # Every defined function's requirement list, which is what the
      # calling convention below is built from.
      lower::lower_all();
      lower::check_listed();
      cg_real.write(1);
      check_runtime_library();
      cg_real.write(0);
      uses_init();
      let mn = spelled();
      sp_main(mn);
      let main = prog::lookup(entry, prog::ns_name(), intern::intern_chars(mn));
      # Entry-point validation is a reporting phase, not the silent
      # specialization-discovery pass. Missing/invalid main used to leave
      # the compiler's output empty because cg_error was suppressed here.
      cg_real.write(1);
      if !ast::is_some(main) {
        cg_error(c_no_main(), ast::none());
        return ();
      }
      if !is_defined_fn(main) {
        cg_error(c_no_main(), ast::none());
        return ();
      }
      cg_real.write(1);
      var rk = 0;
      while rk < lower::needs_count(main) {
        let key = lower::need_sym_at(main, rk);
        runtime_primitive(key);
        runtime_entry_view(key, lower::env_of(main));
        rk = rk + 1;
      }
      # D39: `main` takes no parameters and returns the unit type, which
      # is what lets `_start` call it directly.
      let md = prog::sym_decl.get(main);
      prog::location.write(md + 1);
      if ast::fn_nparams(md) > 0 {
        cg_error(c_no_main(), ast::none());
        return ();
      }
      if ast::is_some(ast::fn_ret(md)) {
        if width(types::elab(ast::fn_ret(md), prog::sym_mod.get(main))) > 0 {
          cg_error(c_no_main(), ast::none());
          return ();
        }
      }
      # `main` assumes only the primitive context, so it starts empty.
      cg_env.write(lower::env_empty());
      cg_real.write(0);
      reach(main, root_env());
      compile_all();
      # Only now is the function index space fixed: it counts the imports
      # first, and which ones the program calls is what the pass above
      # found out.
      declare_all();
      cg_real.write(1);
      let starter = emit::add_func(emit::type_i32(0));
      compile_all();
      check_unreached();
      # The heap pointer in every memory (D79: each memory's allocator
      # keeps its state in that memory).
      let boot = int_list();
      var k = 0;
      while k < emit::memory_count() {
        op_i32_const(boot, heap_pointer());
        op_i32_const(boot, heap_base());
        op_mem_at(boot, 54, 2, k);
        k = k + 1;
      }
      op_call(boot, fq_index.get(0));
      op_end(boot);
      emit::set_body(starter, emit::no_locals(), boot);
      emit::mem_pages.write(1);
      emit::export_start(starter);
      emit::export_memory();
      emit::module(out);
    }
  }
}
