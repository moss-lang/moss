import "./bytes.moss" use *;
import "./lex.moss" use Token;
import "./token.moss" use *;

# Token kinds as Ints.
#
# `Token` is a union of sixty units, which is the right type for the
# lexer to return and the wrong one for a recursive-descent parser to
# carry: a parser compares the current token against a handful of
# expected ones per production, and a match arm per comparison is
# unreadable. The cursor holds an Int instead, converted here once per
# token.
#
# Generated by bootstrap/mossc/gensrc.py; regenerate rather than edit.

assume Std {
  fn tk_eof(): Int { 0 }
  fn tk_bad(): Int { 1 }
  fn tk_exclam(): Int { 2 }
  fn tk_percent(): Int { 3 }
  fn tk_ampersand(): Int { 4 }
  fn tk_lparen(): Int { 5 }
  fn tk_rparen(): Int { 6 }
  fn tk_star(): Int { 7 }
  fn tk_plus(): Int { 8 }
  fn tk_comma(): Int { 9 }
  fn tk_hyphen(): Int { 10 }
  fn tk_dot(): Int { 11 }
  fn tk_slash(): Int { 12 }
  fn tk_colon(): Int { 13 }
  fn tk_semi(): Int { 14 }
  fn tk_less(): Int { 15 }
  fn tk_equal(): Int { 16 }
  fn tk_greater(): Int { 17 }
  fn tk_lbracket(): Int { 18 }
  fn tk_rbracket(): Int { 19 }
  fn tk_caret(): Int { 20 }
  fn tk_lbrace(): Int { 21 }
  fn tk_pipe(): Int { 22 }
  fn tk_rbrace(): Int { 23 }
  fn tk_exclam_equal(): Int { 24 }
  fn tk_colon_colon(): Int { 25 }
  fn tk_equal_greater(): Int { 26 }
  fn tk_less_less(): Int { 27 }
  fn tk_less_equal(): Int { 28 }
  fn tk_equal_equal(): Int { 29 }
  fn tk_greater_equal(): Int { 30 }
  fn tk_greater_greater(): Int { 31 }
  fn tk_hyphen_greater(): Int { 32 }
  fn tk_as(): Int { 33 }
  fn tk_assume(): Int { 34 }
  fn tk_bind(): Int { 35 }
  fn tk_break(): Int { 36 }
  fn tk_context(): Int { 37 }
  fn tk_else(): Int { 38 }
  fn tk_fn(): Int { 39 }
  fn tk_for(): Int { 40 }
  fn tk_functor(): Int { 41 }
  fn tk_if(): Int { 42 }
  fn tk_import(): Int { 43 }
  fn tk_let(): Int { 44 }
  fn tk_loop(): Int { 45 }
  fn tk_match(): Int { 46 }
  fn tk_return(): Int { 47 }
  fn tk_this_type(): Int { 48 }
  fn tk_this_value(): Int { 49 }
  fn tk_type(): Int { 50 }
  fn tk_unit(): Int { 51 }
  fn tk_use(): Int { 52 }
  fn tk_val(): Int { 53 }
  fn tk_var(): Int { 54 }
  fn tk_while(): Int { 55 }
  fn tk_name(): Int { 56 }
  fn tk_str(): Int { 57 }
  fn tk_integer(): Int { 58 }
  fn tk_decimal(): Int { 59 }

  fn token_code(t: Token): Int {
    match t {
      Eof => tk_eof(),
      Bad => tk_bad(),
      Exclam => tk_exclam(),
      Percent => tk_percent(),
      Ampersand => tk_ampersand(),
      LParen => tk_lparen(),
      RParen => tk_rparen(),
      Star => tk_star(),
      Plus => tk_plus(),
      Comma => tk_comma(),
      Hyphen => tk_hyphen(),
      Dot => tk_dot(),
      Slash => tk_slash(),
      Colon => tk_colon(),
      Semi => tk_semi(),
      Less => tk_less(),
      Equal => tk_equal(),
      Greater => tk_greater(),
      LBracket => tk_lbracket(),
      RBracket => tk_rbracket(),
      Caret => tk_caret(),
      LBrace => tk_lbrace(),
      Pipe => tk_pipe(),
      RBrace => tk_rbrace(),
      ExclamEqual => tk_exclam_equal(),
      ColonColon => tk_colon_colon(),
      EqualGreater => tk_equal_greater(),
      LessLess => tk_less_less(),
      LessEqual => tk_less_equal(),
      EqualEqual => tk_equal_equal(),
      GreaterEqual => tk_greater_equal(),
      GreaterGreater => tk_greater_greater(),
      HyphenGreater => tk_hyphen_greater(),
      As => tk_as(),
      Assume => tk_assume(),
      Bind => tk_bind(),
      Break => tk_break(),
      Context => tk_context(),
      Else => tk_else(),
      Fn => tk_fn(),
      For => tk_for(),
      Functor => tk_functor(),
      If => tk_if(),
      Import => tk_import(),
      Let => tk_let(),
      Loop => tk_loop(),
      Match => tk_match(),
      Return => tk_return(),
      ThisType => tk_this_type(),
      ThisValue => tk_this_value(),
      Type => tk_type(),
      Unit => tk_unit(),
      Use => tk_use(),
      Val => tk_val(),
      Var => tk_var(),
      While => tk_while(),
      Name => tk_name(),
      Str => tk_str(),
      Integer => tk_integer(),
      Decimal => tk_decimal(),
    }
  }
