import "./bytes.moss" use *;
import "./lex.moss" use Token;
import "./token.moss" use *;

# Token kinds as Ints.
#
# `Token` is a union of sixty units, which is the right type for the
# lexer to return and the wrong one for a recursive-descent parser to
# carry: a parser compares the current token against a handful of
# expected ones per production, and a match arm per comparison is
# unreadable. The cursor holds an Int instead, converted here once per
# token.
#
# Generated by bootstrap/mossc/gensrc.py; regenerate rather than edit.

assume Std {
  fn tk_eof(): Int { zero }
  fn tk_bad(): Int { one }
  fn tk_exclam(): Int { n2() }
  fn tk_percent(): Int { n3() }
  fn tk_ampersand(): Int { n4() }
  fn tk_lparen(): Int { n5() }
  fn tk_rparen(): Int { n6() }
  fn tk_star(): Int { n7() }
  fn tk_plus(): Int { n8() }
  fn tk_comma(): Int { n9() }
  fn tk_hyphen(): Int { n10() }
  fn tk_dot(): Int { n11() }
  fn tk_slash(): Int { n12() }
  fn tk_colon(): Int { n13() }
  fn tk_semi(): Int { n14() }
  fn tk_less(): Int { n15() }
  fn tk_equal(): Int { hex(one, zero) }
  fn tk_greater(): Int { hex(one, one) }
  fn tk_lbracket(): Int { hex(one, n2()) }
  fn tk_rbracket(): Int { hex(one, n3()) }
  fn tk_caret(): Int { hex(one, n4()) }
  fn tk_lbrace(): Int { hex(one, n5()) }
  fn tk_pipe(): Int { hex(one, n6()) }
  fn tk_rbrace(): Int { hex(one, n7()) }
  fn tk_exclam_equal(): Int { hex(one, n8()) }
  fn tk_colon_colon(): Int { hex(one, n9()) }
  fn tk_equal_greater(): Int { hex(one, n10()) }
  fn tk_less_less(): Int { hex(one, n11()) }
  fn tk_less_equal(): Int { hex(one, n12()) }
  fn tk_equal_equal(): Int { hex(one, n13()) }
  fn tk_greater_equal(): Int { hex(one, n14()) }
  fn tk_greater_greater(): Int { hex(one, n15()) }
  fn tk_hyphen_greater(): Int { hex(n2(), zero) }
  fn tk_as(): Int { hex(n2(), one) }
  fn tk_assume(): Int { hex(n2(), n2()) }
  fn tk_bind(): Int { hex(n2(), n3()) }
  fn tk_break(): Int { hex(n2(), n4()) }
  fn tk_context(): Int { hex(n2(), n5()) }
  fn tk_else(): Int { hex(n2(), n6()) }
  fn tk_fn(): Int { hex(n2(), n7()) }
  fn tk_for(): Int { hex(n2(), n8()) }
  fn tk_functor(): Int { hex(n2(), n9()) }
  fn tk_if(): Int { hex(n2(), n10()) }
  fn tk_import(): Int { hex(n2(), n11()) }
  fn tk_let(): Int { hex(n2(), n12()) }
  fn tk_loop(): Int { hex(n2(), n13()) }
  fn tk_match(): Int { hex(n2(), n14()) }
  fn tk_return(): Int { hex(n2(), n15()) }
  fn tk_this_type(): Int { hex(n3(), zero) }
  fn tk_this_value(): Int { hex(n3(), one) }
  fn tk_type(): Int { hex(n3(), n2()) }
  fn tk_unit(): Int { hex(n3(), n3()) }
  fn tk_use(): Int { hex(n3(), n4()) }
  fn tk_val(): Int { hex(n3(), n5()) }
  fn tk_var(): Int { hex(n3(), n6()) }
  fn tk_while(): Int { hex(n3(), n7()) }
  fn tk_name(): Int { hex(n3(), n8()) }
  fn tk_str(): Int { hex(n3(), n9()) }

  fn token_code(t: Token): Int {
    match t {
      Eof => tk_eof(),
      Bad => tk_bad(),
      Exclam => tk_exclam(),
      Percent => tk_percent(),
      Ampersand => tk_ampersand(),
      LParen => tk_lparen(),
      RParen => tk_rparen(),
      Star => tk_star(),
      Plus => tk_plus(),
      Comma => tk_comma(),
      Hyphen => tk_hyphen(),
      Dot => tk_dot(),
      Slash => tk_slash(),
      Colon => tk_colon(),
      Semi => tk_semi(),
      Less => tk_less(),
      Equal => tk_equal(),
      Greater => tk_greater(),
      LBracket => tk_lbracket(),
      RBracket => tk_rbracket(),
      Caret => tk_caret(),
      LBrace => tk_lbrace(),
      Pipe => tk_pipe(),
      RBrace => tk_rbrace(),
      ExclamEqual => tk_exclam_equal(),
      ColonColon => tk_colon_colon(),
      EqualGreater => tk_equal_greater(),
      LessLess => tk_less_less(),
      LessEqual => tk_less_equal(),
      EqualEqual => tk_equal_equal(),
      GreaterEqual => tk_greater_equal(),
      GreaterGreater => tk_greater_greater(),
      HyphenGreater => tk_hyphen_greater(),
      As => tk_as(),
      Assume => tk_assume(),
      Bind => tk_bind(),
      Break => tk_break(),
      Context => tk_context(),
      Else => tk_else(),
      Fn => tk_fn(),
      For => tk_for(),
      Functor => tk_functor(),
      If => tk_if(),
      Import => tk_import(),
      Let => tk_let(),
      Loop => tk_loop(),
      Match => tk_match(),
      Return => tk_return(),
      ThisType => tk_this_type(),
      ThisValue => tk_this_value(),
      Type => tk_type(),
      Unit => tk_unit(),
      Use => tk_use(),
      Val => tk_val(),
      Var => tk_var(),
      While => tk_while(),
      Name => tk_name(),
      Str => tk_str(),
    }
  }
}
