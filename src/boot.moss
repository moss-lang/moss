import "./ast.moss" as ast;
import "./codegen.moss" as codegen;
import "./emit.moss" as emit;
import "./intern.moss" as intern;
import "./lex.moss" as lexer;
import "./lower.moss" as lower;
import "./prog.moss" as prog;
import "./syntax.moss" as syntax;
import "./types.moss" as types;
import "./wasmops.moss" as wops;

# The compiler's own state, in one place.
#
# Every stage keeps its arenas as abstract vals, so that a driver can run
# a stage twice over different inputs — which is what `bind` is for. The
# cost is that starting the compiler means binding forty of them, and
# that is exactly what a functor is (D55): one declaration that maps the
# `Std` it needs to build the arenas into the whole compiler context.
#
# `lexer::src` is deliberately not here. It is the one piece of state
# that is rebound per file, by the loader, as each module is read.

context Compiler = ast::Ast, intern::Interner, lexer::at, lexer::mark,
  syntax::Cursor, prog::Prog, emit::Emit, wops::WasmOps, codegen::Codegen,
  types::Types, lower::Lower;

functor Boot: Std -> Compiler {
  bind ast::nkind = int_list();
  bind ast::na = int_list();
  bind ast::nb = int_list();
  bind ast::nc = int_list();
  bind ast::nd = int_list();
  bind ast::kids = int_list();
  bind ast::pnames = int_list();
  bind ast::pstart = int_list();
  bind ast::plen = int_list();
  bind ast::itexts = str_list();

  bind intern::ichars = int_list();
  bind intern::istarts = int_list();
  bind intern::ilens = int_list();
  bind intern::ibuckets = int_list();
  bind intern::ilink = int_list();
  bind intern::imask = cell_int();

  bind lexer::at = cell_int();
  bind lexer::mark = cell_int();

  bind syntax::tok = cell_int();
  bind syntax::tstart = cell_int();
  bind syntax::tend = cell_int();
  bind syntax::tok2 = cell_int();
  bind syntax::t2start = cell_int();
  bind syntax::t2end = cell_int();
  bind syntax::errs = cell_int();
  bind syntax::errpos = cell_int();

  bind prog::mpaths = str_list();
  bind prog::mroots = int_list();
  bind prog::mnroots = int_list();
  bind prog::mstate = int_list();
  bind prog::pinfo = str_list();
  bind prog::sym_mod = int_list();
  bind prog::sym_name = int_list();
  bind prog::sym_kind = int_list();
  bind prog::sym_decl = int_list();
  bind prog::sym_recv = int_list();
  bind prog::sym_asm = int_list();
  bind prog::sym_nasm = int_list();
  bind prog::ent_mod = int_list();
  bind prog::ent_ns = int_list();
  bind prog::ent_name = int_list();
  bind prog::ent_to = int_list();
  bind prog::ent_pub = int_list();
  bind prog::ent_head = int_list();
  bind prog::ent_link = int_list();
  bind prog::att_mod = int_list();
  bind prog::att_recv = int_list();
  bind prog::att_name = int_list();
  bind prog::att_sym = int_list();
  bind prog::err_code = int_list();
  bind prog::err_mod = int_list();
  bind prog::err_name = int_list();

  bind emit::ty_params = int_list();
  bind emit::ty_pstart = int_list();
  bind emit::ty_plen = int_list();
  bind emit::ty_res = int_list();
  bind emit::ty_rstart = int_list();
  bind emit::ty_rlen = int_list();
  bind emit::nchars = int_list();
  bind emit::im_mstart = int_list();
  bind emit::im_mlen = int_list();
  bind emit::im_fstart = int_list();
  bind emit::im_flen = int_list();
  bind emit::im_type = int_list();
  bind emit::fn_type = int_list();
  bind emit::fn_l32 = int_list();
  bind emit::fn_l64 = int_list();
  bind emit::fn_bstart = int_list();
  bind emit::fn_blen = int_list();
  bind emit::insns = int_list();
  bind emit::ex_start = int_list();
  bind emit::ex_len = int_list();
  bind emit::ex_kind = int_list();
  bind emit::ex_index = int_list();
  bind emit::mem_pages = cell_int();

  bind wops::op_names = int_list();
  bind wops::op_codes = int_list();
  bind wops::op_kinds = int_list();
  bind wops::op_aligns = int_list();
  bind wops::op_res = int_list();

  bind codegen::fq_sym = int_list();
  bind codegen::fq_env = int_list();
  bind codegen::cg_env = cell_int();
  bind codegen::cg_real = cell_int();
  bind codegen::cg_ret = cell_int();
  bind codegen::fq_index = int_list();
  bind codegen::wi_sym = int_list();
  bind codegen::wi_index = int_list();
  bind codegen::lc_name = int_list();
  bind codegen::lc_type = int_list();
  bind codegen::lc_start = int_list();
  bind codegen::lc_slots = int_list();
  bind codegen::lc_base = cell_int();
  bind codegen::lc_visible = cell_int();
  bind codegen::pv_recv = int_list();
  bind codegen::pv_sym = int_list();
  bind codegen::pv_local = int_list();
  bind codegen::pv_top = cell_int();
  bind codegen::cg_depth = cell_int();
  bind codegen::cg_loops = int_list();
  bind codegen::cg_ntop = cell_int();
  bind codegen::cg_wasm = cell_int();
  bind codegen::cg_wasi = cell_int();
  bind codegen::cg_bool = cell_int();
  bind codegen::cg_std = cell_int();
  bind codegen::cg_i32 = cell_int();
  bind codegen::cg_i64 = cell_int();
  bind codegen::cg_boolty = cell_int();
  bind codegen::cg_errs = int_list();
  bind codegen::cg_err_name = int_list();

  bind types::ty_kind = int_list();
  bind types::ty_sym = int_list();
  bind types::ty_mstart = int_list();
  bind types::ty_mlen = int_list();
  bind types::ty_mem = int_list();
  bind types::ty_unit_row = cell_int();
  bind types::ty_never_row = cell_int();
  bind types::ty_by_sym = int_list();
  bind types::elab_memo = int_list();
  bind types::unit_syms = int_list();
  bind types::unit_codes = int_list();

  bind lower::en_kind = int_list();
  bind lower::en_recv = int_list();
  bind lower::en_sym = int_list();
  bind lower::en_a = int_list();
  bind lower::en_b = int_list();
  bind lower::en_next = int_list();
  bind lower::nd_recv = int_list();
  bind lower::nd_sym = int_list();
  bind lower::nd_start = int_list();
  bind lower::nd_len = int_list();
  bind lower::nd_env = int_list();
  bind lower::asm_run = int_list();
  bind lower::asm_len = int_list();
  bind lower::asm_env = int_list();
  bind lower::asm_nstart = int_list();
  bind lower::asm_nlen = int_list();
}
