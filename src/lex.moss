import "./token.moss" use *;

type Token =
  | Eof
  | Bad
  | Exclam
  | Percent
  | Ampersand
  | LParen
  | RParen
  | Star
  | Plus
  | Comma
  | Hyphen
  | Dot
  | Slash
  | Colon
  | Semi
  | Less
  | Equal
  | Greater
  | LBracket
  | RBracket
  | Caret
  | LBrace
  | Pipe
  | RBrace
  | ExclamEqual
  | ColonColon
  | EqualGreater
  | LessLess
  | LessEqual
  | EqualEqual
  | GreaterEqual
  | GreaterGreater
  | HyphenGreater
  | As
  | Assume
  | Bind
  | Break
  | Context
  | Else
  | Fn
  | For
  | Functor
  | If
  | Import
  | In
  | Let
  | Loop
  | Match
  | Return
  | Tag
  | ThisType
  | ThisValue
  | Type
  | Use
  | Val
  | Var
  | While
  | Name
  | Str
  | Integer
  | Decimal
  | Underscore
;

assume Std {
  # `Char | Eof` directly would put an abstract type in a union (D15), so
  # the character is wrapped in a nominal tag.
  tag Read(Char);

  # The lexer owns its input and position; the driver binds these. After
  # lex() returns a token, `mark` holds the token's start offset (its end
  # is wherever `at` stands).
  val src: String;
  val at: CellInt;
  val mark: CellInt;

  assume src, at, mark {
    fn peek(): Read | Eof {
      let i = at.read();
      if i >= src.length() {
        Eof
      } else {
        Read(src.get(i))
      }
    }

    fn advance() {
      at.write(at.read() + 1);
    }

    # Consume the next character only if it is `want`.
    fn take(want: Char): Bool {
      match peek() {
        Eof => false,
        Read(c) => {
          if c == want {
            advance();
            true
          } else {
            false
          }
        }
      }
    }

    fn is_space(c: Char): Bool {
      if c == char::space {
        true
      } else if c == char::newline {
        true
      } else if c == char::tab {
        true
      } else {
        c == char::cr
      }
    }

    # Letters, digits, and underscore, leaning on ASCII order:
    # digits < uppercase < underscore < lowercase.
    fn is_name_char(c: Char): Bool {
      if c >= char::a {
        c <= char::z
      } else if c >= char::A {
        if c <= char::Z {
          true
        } else {
          c == char::underscore
        }
      } else if c >= char::digit0 {
        c <= char::digit9
      } else {
        false
      }
    }

    fn lex(): Token {
      loop {
        match peek() {
          Eof => { mark.write(at.read()); return Eof; },
          Read(c) => {
            advance();
            if is_space(c) {
              ()
            } else if c == char::octothorpe {
              skip_comment();
            } else {
              mark.write(at.read() - 1);
              return token_at(c);
            }
          }
        }
      }
    }

    # A `#` comment runs to the end of the line.
    fn skip_comment() {
      loop {
        match peek() {
          Eof => break,
          Read(c) => {
            advance();
            if c == char::newline {
              break
            }
          }
        }
      }
    }

    # Dispatch on a consumed non-space character.
    fn token_at(c: Char): Token {
      if c == char::exclam {
        two(char::equal, ExclamEqual, Exclam)
      } else if c == char::colon {
        two(char::colon, ColonColon, Colon)
      } else if c == char::equal {
        equal_token()
      } else if c == char::less {
        less_token()
      } else if c == char::greater {
        if raw_line_start(mark.read()) { raw_string_token() }
        else { greater_token() }
      } else if c == char::percent {
        Percent
      } else if c == char::ampersand {
        Ampersand
      } else if c == char::lparen {
        LParen
      } else if c == char::rparen {
        RParen
      } else if c == char::star {
        Star
      } else if c == char::plus {
        Plus
      } else if c == char::comma {
        Comma
      } else if c == char::hyphen {
        two(char::greater, HyphenGreater, Hyphen)
      } else if c == char::dot {
        Dot
      } else if c == char::slash {
        Slash
      } else if c == char::semi {
        Semi
      } else if c == char::lbracket {
        LBracket
      } else if c == char::rbracket {
        RBracket
      } else if c == char::caret {
        Caret
      } else if c == char::lbrace {
        LBrace
      } else if c == char::pipe {
        Pipe
      } else if c == char::rbrace {
        RBrace
      } else if c == char::quote {
        string_token()
      } else if is_digit(c) {
        number_token()
      } else if is_name_char(c) {
        name_or_keyword(c)
      } else {
        Bad
      }
    }

    fn two(want: Char, yes: Token, no: Token): Token {
      if take(want) {
        yes
      } else {
        no
      }
    }

    fn equal_token(): Token {
      if take(char::equal) {
        EqualEqual
      } else if take(char::greater) {
        EqualGreater
      } else {
        Equal
      }
    }

    fn less_token(): Token {
      if take(char::less) {
        LessLess
      } else if take(char::equal) {
        LessEqual
      } else {
        Less
      }
    }

    fn greater_token(): Token {
      if take(char::greater) {
        GreaterGreater
      } else if take(char::equal) {
        GreaterEqual
      } else {
        Greater
      }
    }

    # A raw marker is line-leading, followed by one space or end of line.
    fn raw_line_start(start: Int): Bool {
      let next = start + 1;
      if next < src.length() {
        let c = src.get(next);
        if c != char::space {
          if c != char::newline { if c != char::cr { return false; } }
        }
      }
      var i = start;
      while i > 0 {
        i = i - 1;
        let c = src.get(i);
        if c == char::newline { return true; }
        if c == char::cr { return true; }
        if c != char::space { if c != char::tab { return false; } }
      }
      true
    }

    fn raw_string_token(): Token {
      loop {
        match peek() {
          Eof => return Str,
          Read(c) => {
            if c == char::newline {
              if !raw_string_next() { return Str; }
            } else if c == char::cr {
              if !raw_string_next() { return Str; }
            } else { advance(); }
          },
        }
      }
    }

    # Only consume a line ending and indentation when another marker follows.
    fn raw_string_next(): Bool {
      var i = at.read();
      if src.get(i) == char::cr {
        i = i + 1;
        if i < src.length() { if src.get(i) == char::newline { i = i + 1; } }
      } else { i = i + 1; }
      while i < src.length() {
        let c = src.get(i);
        if c != char::space { if c != char::tab { break; } }
        i = i + 1;
      }
      if i < src.length() {
        if src.get(i) == char::greater {
          if raw_line_start(i) {
            at.write(i + 1);
            return true;
          }
        }
      }
      false
    }

    fn string_escape(c: Char): Bool {
      if c == char::quote { return true; }
      if c == char::backslash { return true; }
      if c == char::n { return true; }
      if c == char::r { return true; }
      c == char::t
    }

    fn string_token(): Token {
      loop {
        match peek() {
          Eof => return Bad,
          Read(c) => {
            advance();
            if c == char::quote {
              return Str;
            } else if c == char::newline {
              return Bad;
            } else if c == char::backslash {
              match peek() {
                Eof => return Bad,
                Read(e) => {
                  advance();
                  if !string_escape(e) { return Bad; }
                },
              }
            }
          }
        }
      }
    }

    fn is_digit(c: Char): Bool {
      if c >= char::digit0 {
        c <= char::digit9
      } else {
        false
      }
    }

    # The character `ahead` past the cursor, if it is a digit.
    fn digit_ahead(ahead: Int): Bool {
      let i = at.read() + ahead;
      if i >= src.length() {
        false
      } else {
        is_digit(src.get(i))
      }
    }

    fn skip_digits() {
      while digit_ahead(0) {
        advance();
      }
    }

    # D68: a digit run, then `.` and a digit, is a decimal literal; a `.`
    # followed by anything else is not part of it, so `1.add(2)` calls a
    # method on `1`. Either may take an exponent — `e` or `E`, a sign
    # perhaps, and digits — which makes it decimal, and whose value is at
    # most 999. A name character straight after is no suffix but an
    # error, as is a sign with no digit after it. Nothing else about a
    # literal is checked: it means whatever the arithmetic it is made of
    # computes.
    fn number_token(): Token {
      skip_digits();
      var decimal = take_dot_digit();
      if decimal {
        skip_digits();
      }
      let lead = exponent_lead();
      if lead < 0 {
        return Bad;
      }
      if lead > 0 {
        decimal = true;
        var i = 0;
        while i < lead {
          advance();
          i = i + 1;
        }
        if !take_exponent_digits() {
          return Bad;
        }
      }
      match peek() {
        Eof => (),
        Read(c) => {
          if is_name_char(c) {
            return Bad;
          }
        }
      }
      if decimal {
        Decimal
      } else {
        Integer
      }
    }

    # The character `ahead` past the cursor, if it is `want`.
    fn char_ahead(ahead: Int, want: Char): Bool {
      let i = at.read() + ahead;
      if i >= src.length() {
        false
      } else {
        src.get(i) == want
      }
    }

    # How long an exponent's `e` and sign are, if a digit follows them; 0
    # if no exponent starts here, -1 if a sign follows the `e` but no
    # digit follows the sign.
    fn exponent_lead(): Int {
      if !char_ahead(0, char::e) {
        if !char_ahead(0, char::E) {
          return 0;
        }
      }
      var lead = 1;
      if char_ahead(1, char::plus) {
        lead = 2;
      } else if char_ahead(1, char::hyphen) {
        lead = 2;
      }
      if digit_ahead(lead) {
        lead
      } else if lead == 2 {
        -1
      } else {
        0
      }
    }

    # An exponent's digits, and whether their value is within the bound.
    fn take_exponent_digits(): Bool {
      var value = 0;
      while digit_ahead(0) {
        if value <= 999 {
          value = value * 10 + (src.get(at.read()).code() - char::digit0.code());
        }
        advance();
      }
      value <= 999
    }

    fn take_dot_digit(): Bool {
      let i = at.read();
      if i + 1 >= src.length() {
        return false;
      }
      if src.get(i) == char::dot {
        if is_digit(src.get(i + 1)) {
          advance();
          return true;
        }
      }
      false
    }

    # Consume the rest of a name run.
    fn rest_of_name(): Token {
      loop {
        match peek() {
          Eof => return Name,
          Read(c) => {
            if is_name_char(c) {
              advance();
            } else {
              return Name;
            }
          }
        }
      }
    }

    # True when the name run ends here (so a keyword spelling counts).
    fn boundary(): Bool {
      match peek() {
        Eof => true,
        Read(c) => {
          if is_name_char(c) {
            false
          } else {
            true
          }
        }
      }
    }

    fn kw(t: Token): Token {
      if boundary() {
        t
      } else {
        rest_of_name()
      }
    }

    # Match the remaining characters of one keyword spelling. On any
    # mismatch, everything consumed so far was name characters, so the run
    # just continues as a name — no pushback needed.
    fn kw1(a: Char, t: Token): Token {
      if take(a) {
        kw(t)
      } else {
        rest_of_name()
      }
    }

    fn kw2(a: Char, b: Char, t: Token): Token {
      if take(a) {
        kw1(b, t)
      } else {
        rest_of_name()
      }
    }

    fn kw3(a: Char, b: Char, c: Char, t: Token): Token {
      if take(a) {
        kw2(b, c, t)
      } else {
        rest_of_name()
      }
    }

    fn kw4(a: Char, b: Char, c: Char, d: Char, t: Token): Token {
      if take(a) {
        kw3(b, c, d, t)
      } else {
        rest_of_name()
      }
    }

    fn kw5(a: Char, b: Char, c: Char, d: Char, e: Char, t: Token): Token {
      if take(a) {
        kw4(b, c, d, e, t)
      } else {
        rest_of_name()
      }
    }

    fn kw6(a: Char, b: Char, c: Char, d: Char, e: Char, f: Char, t: Token): Token {
      if take(a) {
        kw5(b, c, d, e, f, t)
      } else {
        rest_of_name()
      }
    }

    # The keyword trie compares characters without allocating strings. `c0` was already
    # consumed by token_at.
    fn name_or_keyword(c0: Char): Token {
      if c0 == char::a {
        if take(char::s) {
          if take(char::s) {
            kw3(char::u, char::m, char::e, Assume)
          } else {
            kw(As)
          }
        } else {
          rest_of_name()
        }
      } else if c0 == char::b {
        if take(char::i) {
          kw2(char::n, char::d, Bind)
        } else if take(char::r) {
          kw3(char::e, char::a, char::k, Break)
        } else {
          rest_of_name()
        }
      } else if c0 == char::c {
        kw6(char::o, char::n, char::t, char::e, char::x, char::t, Context)
      } else if c0 == char::e {
        kw3(char::l, char::s, char::e, Else)
      } else if c0 == char::f {
        if take(char::n) {
          kw(Fn)
        } else if take(char::o) {
          kw1(char::r, For)
        } else if take(char::u) {
          kw5(char::n, char::c, char::t, char::o, char::r, Functor)
        } else {
          rest_of_name()
        }
      } else if c0 == char::i {
        if take(char::f) {
          kw(If)
        } else if take(char::m) {
          kw4(char::p, char::o, char::r, char::t, Import)
        } else if take(char::n) {
          kw(In)
        } else {
          rest_of_name()
        }
      } else if c0 == char::l {
        if take(char::e) {
          kw1(char::t, Let)
        } else if take(char::o) {
          kw2(char::o, char::p, Loop)
        } else {
          rest_of_name()
        }
      } else if c0 == char::m {
        kw4(char::a, char::t, char::c, char::h, Match)
      } else if c0 == char::r {
        kw5(char::e, char::t, char::u, char::r, char::n, Return)
      } else if c0 == char::T {
        kw3(char::h, char::i, char::s, ThisType)
      } else if c0 == char::t {
        if take(char::a) {
          kw1(char::g, Tag)
        } else if take(char::h) {
          kw2(char::i, char::s, ThisValue)
        } else if take(char::y) {
          kw2(char::p, char::e, Type)
        } else {
          rest_of_name()
        }
      } else if c0 == char::u {
        if take(char::s) {
          kw1(char::e, Use)
        } else {
          rest_of_name()
        }
      } else if c0 == char::v {
        if take(char::a) {
          if take(char::l) {
            kw(Val)
          } else if take(char::r) {
            kw(Var)
          } else {
            rest_of_name()
          }
        } else {
          rest_of_name()
        }
      } else if c0 == char::w {
        kw4(char::h, char::i, char::l, char::e, While)
      } else if c0 == char::underscore {
        kw(Underscore)
      } else {
        rest_of_name()
      }
    }
  }
}
