import "./ast.moss" as ast;
import "./bytes.moss" use *;
import "./intern.moss" as intern;
import "./lex.moss" as lexer;
import "./spell.moss" use *;
import "./tcode.moss" use *;

# Recursive descent over the whole grammar —
# types, expressions, statements, patterns and declarations — building
# the arenas of ast.moss.
#
# The cursor holds one token with a second buffered on demand. A brace in
# expression position may also look ahead to the first field separator.

assume Std {
  # The current token, as a code from tcode.moss, and its span in the
  # source. `tok2` is the buffered lookahead, or `none()`.
  val tok: CellInt;
  val tstart: CellInt;
  val tend: CellInt;
  val previous_end: CellInt;
  val tok2: CellInt;
  val t2start: CellInt;
  val t2end: CellInt;

  # Syntax errors: how many, and where the first one was.
  val errs: CellInt;
  val errpos: CellInt;
  val errend: CellInt;
  val expected: CellInt;

  context Cursor = tok, tstart, tend, previous_end, tok2, t2start, t2end, errs, errpos, errend, expected;

  assume Cursor, lexer::src, lexer::at, lexer::mark, intern::Interner, ast::Ast {
    fn advance() {
      previous_end.write(tend.read());
      if tok2.read() >= 0 {
        tok.write(tok2.read());
        tstart.write(t2start.read());
        tend.write(t2end.read());
        tok2.write(ast::none());
      } else {
        tok.write(token_code(lexer::lex()));
        tstart.write(lexer::mark.read());
        tend.write(lexer::at.read());
      }
    }

    # The token after the current one, lexed once and kept.
    fn peek2(): Int {
      if tok2.read() < 0 {
        tok2.write(token_code(lexer::lex()));
        t2start.write(lexer::mark.read());
        t2end.write(lexer::at.read());
      }
      tok2.read()
    }

    fn here(k: Int): Bool {
      tok.read() == k
    }

    fn accept(k: Int): Bool {
      if here(k) {
        advance();
        true
      } else {
        false
      }
    }

    fn fail() { fail_expected(ast::none()); }

    fn fail_expected(want: Int) {
      if errs.read() == 0 {
        errpos.write(tstart.read());
        errend.write(tend.read());
        expected.write(want);
      }
      errs.write(errs.read() + 1);
    }

    fn expect(k: Int) {
      if accept(k) {
        ()
      } else {
        fail_expected(k);
      }
    }

    # Recovery: never spin. Anything that reports an error and cannot
    # consume the offending token asks for this.
    fn skip_one() {
      if here(tk_eof()) {
        ()
      } else {
        advance();
      }
    }

    fn empty_name(): Int {
      intern::intern(0, 0)
    }

    fn name_here(): Int {
      intern::intern(tstart.read(), tend.read() - tstart.read())
    }

    fn take_name(): Int {
      if here(tk_name()) {
        let id = name_here();
        advance();
        id
      } else {
        fail_expected(tk_name());
        empty_name()
      }
    }

    # Names and applications.

    fn parse_path(): Int {
      let xs = int_list();
      xs.push(take_name());
      while accept(tk_colon_colon()) {
        xs.push(take_name());
      }
      ast::path_of(xs)
    }

    # `[` List[Binding] `]`, the opening bracket already consumed.
    fn parse_app(xs: IntList) {
      loop {
        if here(tk_rbracket()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        let p = parse_path();
        expect(tk_equal());
        let s = parse_spec();
        xs.push(ast::node2(ast::k_binding(), p, s));
        if !accept(tk_comma()) {
          break;
        }
      }
      expect(tk_rbracket());
    }

    fn parse_spec(): Int {
      let start = tstart.read();
      let node = parse_spec_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_spec_inner(): Int {
      var p = ast::none();
      var dot = ast::none();
      if accept(tk_dot()) {
        dot = take_name();
      } else {
        p = parse_path();
        if accept(tk_dot()) {
          dot = take_name();
        }
      }
      var run = ast::none();
      var n = 0;
      if accept(tk_lbracket()) {
        let xs = int_list();
        parse_app(xs);
        run = ast::commit(xs);
        n = xs.length();
      }
      ast::node4(ast::k_spec(), p, dot, run, n)
    }

    # An assume item is a spec without an application (D24).
    fn parse_assume_item(): Int {
      let start = tstart.read();
      let node = parse_assume_item_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_assume_item_inner(): Int {
      let start = tstart.read();
      let p = parse_path();
      var dot = ast::none();
      if accept(tk_dot()) {
        dot = take_name();
        return ast::node4(ast::k_spec(), p, dot, ast::none(), 0);
      }
      if here(tk_lbracket()) {
        return parse_equation(type_ref_after(p, start));
      }
      if here(tk_equal()) {
        return parse_equation(type_ref_after(p, start));
      }
      ast::node4(ast::k_spec(), p, dot, ast::none(), 0)
    }

    # D90: a type equation's side, `p` or `p[...]`, its path already read.
    fn type_ref_after(p: Int, start: Int): Int {
      var run = ast::none();
      var n = 0;
      var applied = 0;
      if accept(tk_lbracket()) {
        let xs = int_list();
        parse_app(xs);
        run = ast::commit(xs);
        n = xs.length();
        applied = 1;
      }
      ast::located(ast::node4(ast::k_ty_ref(), p, run, n, applied), start, previous_end.read())
    }

    fn parse_type_ref(): Int {
      let start = tstart.read();
      if !here(tk_name()) {
        fail();
        skip_one();
        return ast::located(ast::node0(ast::k_ty_unit()), start, previous_end.read());
      }
      type_ref_after(parse_path(), start)
    }

    # D90: `l = r`, the left side read; the `=` follows it, outside any
    # brackets (in `f[T=A] = B` the first `=` is the bracket's).
    fn parse_equation(lhs: Int): Int {
      expect(tk_equal());
      let rhs = parse_type_ref();
      let heads = int_list();
      written_refs(ast::a_of(lhs), ast::b_of(lhs), ast::c_of(lhs), heads);
      if ast::is_kind(rhs, ast::k_ty_ref()) {
        written_refs(ast::a_of(rhs), ast::b_of(rhs), ast::c_of(rhs), heads);
      }
      ast::node4(ast::k_eq(), lhs, rhs, ast::commit(heads), heads.length())
    }

    # The references `path[run]` writes, as unbracketed specs: its head,
    # then those of its brackets' right sides (D90).
    fn written_refs(path: Int, run: Int, n: Int, out: IntList) {
      out.push(ast::node4(ast::k_spec(), path, ast::none(), ast::none(), 0));
      var i = 0;
      while i < n {
        let side = ast::b_of(ast::kid_at(run, i));
        if !ast::is_some(ast::b_of(side)) {
          if ast::is_some(ast::a_of(side)) {
            written_refs(ast::a_of(side), ast::c_of(side), ast::d_of(side), out);
          }
        }
        i = i + 1;
      }
    }

    # A context's item: a spec, or a type equation (D90) when `=` follows
    # a spec that is a type reference.
    fn parse_ctx_item(): Int {
      let start = tstart.read();
      let sp = parse_spec();
      if !here(tk_equal()) {
        return sp;
      }
      if ast::is_some(ast::b_of(sp)) {
        fail();
        return sp;
      }
      if !ast::is_some(ast::a_of(sp)) {
        fail();
        return sp;
      }
      var applied = 0;
      if ast::is_some(ast::c_of(sp)) {
        applied = 1;
      }
      let lhs = ast::located(ast::node4(ast::k_ty_ref(), ast::a_of(sp), ast::c_of(sp), ast::d_of(sp), applied),
        start, previous_end.read());
      let node = parse_equation(lhs);
      ast::located(node, start, previous_end.read())
    }

    # Types.

    fn at_type_start(): Bool {
      if here(tk_name()) {
        true
      } else if here(tk_this_type()) {
        true
      } else if here(tk_lparen()) {
        true
      } else {
        here(tk_lbrace())
      }
    }

    fn parse_type(): Int {
      let start = tstart.read();
      let node = parse_type_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_type_inner(): Int {
      let leading = accept(tk_pipe());
      if leading {
        if !at_type_start() {
          return ast::node0(ast::k_ty_never());
        }
      }
      let first = parse_type_atom();
      if !here(tk_pipe()) {
        return first;
      }
      let xs = int_list();
      xs.push(first);
      while accept(tk_pipe()) {
        xs.push(parse_type_atom());
      }
      ast::node2(ast::k_ty_union(), ast::commit(xs), xs.length())
    }

    # The first element and its comma may already have been consumed.
    fn parse_types_to_paren(types: IntList) {
      while !here(tk_rparen()) {
        if here(tk_eof()) { break; }
        types.push(parse_type());
        if !accept(tk_comma()) { break; }
      }
      expect(tk_rparen());
    }

    fn tuple_type(types: IntList): Int {
      if types.length() == 0 { return ast::node0(ast::k_ty_unit()); }
      let fields = int_list();
      var i = 0;
      while i < types.length() {
        fields.push(ast::node2(ast::k_ty_field(), tuple_label(i), types.get(i)));
        i = i + 1;
      }
      ast::node2(ast::k_ty_record(), ast::commit(fields), fields.length())
    }

    fn parse_type_atom(): Int {
      let start = tstart.read();
      let node = parse_type_atom_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_type_atom_inner(): Int {
      if accept(tk_this_type()) {
        return ast::node0(ast::k_ty_this());
      }
      if accept(tk_lparen()) {
        if accept(tk_rparen()) {
          return ast::node0(ast::k_ty_unit());
        }
        let inner = parse_type();
        if accept(tk_comma()) {
          let types = int_list();
          types.push(inner);
          parse_types_to_paren(types);
          return tuple_type(types);
        }
        expect(tk_rparen());
        return inner;
      }
      if accept(tk_lbrace()) {
        let xs = int_list();
        loop {
          if here(tk_rbrace()) {
            break;
          }
          if here(tk_eof()) {
            break;
          }
          let nm = take_name();
          expect(tk_colon());
          xs.push(ast::node2(ast::k_ty_field(), nm, parse_type()));
          if !accept(tk_comma()) {
            break;
          }
        }
        expect(tk_rbrace());
        return ast::node2(ast::k_ty_record(), ast::commit(xs), xs.length());
      }
      if !here(tk_name()) {
        fail();
        skip_one();
        return ast::node0(ast::k_ty_unit());
      }
      let p = parse_path();
      var run = ast::none();
      var n = 0;
      var applied = 0;
      if accept(tk_lbracket()) {
        let xs = int_list();
        parse_app(xs);
        run = ast::commit(xs);
        n = xs.length();
        applied = 1;
      }
      ast::node4(ast::k_ty_ref(), p, run, n, applied)
    }

    # Expressions.

    fn parse_expr(): Int {
      parse_expr_at(false)
    }

    # `no_rec` forbids a record expression at the top level, which is
    # what keeps `match x { ... }` from reading its arms as fields.
    fn parse_expr_at(no_rec: Bool): Int {
      let start = tstart.read();
      let node = parse_expr_at_inner(no_rec);
      ast::located(node, start, previous_end.read())
    }

    fn parse_expr_at_inner(no_rec: Bool): Int {
      if accept(tk_if()) {
        return parse_if();
      }
      if accept(tk_match()) {
        return parse_match();
      }
      if accept(tk_return()) {
        if at_value_end() {
          return ast::node1(ast::k_ex_return(), ast::none());
        }
        return ast::node1(ast::k_ex_return(), parse_expr_at(no_rec));
      }
      if accept(tk_break()) {
        return ast::node0(ast::k_ex_break());
      }
      parse_operators(no_rec)
    }

    # Operators (D68). Precedence is a partial order, drawn exactly as
    # bootstrap/mossc/parse.py draws it: where habits differ, two
    # operators are not ordered, and one following the other without
    # parentheses is a syntax error.
    #
    #   comparison:  operand (cmp operand)?          -- does not chain
    #   operand:     unary (<< | >>) unary           -- shifts take unaries
    #              | additive
    #   additive:    term ((+ | -) term)*
    #   term:        unary (* unary)* ((/ | %) unary)?
    #   bitwise:     unary (& unary)*, likewise ^ and |, each alone

    fn fam_mul(): Int { 0 }
    fn fam_frac(): Int { 1 }
    fn fam_add(): Int { 2 }
    fn fam_shift(): Int { 3 }
    fn fam_cmp(): Int { 4 }
    fn fam_bit(): Int { 5 }

    # A binary operator's family, or none for any other token.
    fn op_family(t: Int): Int {
      if t == tk_star() {
        fam_mul()
      } else if t == tk_slash() {
        fam_frac()
      } else if t == tk_percent() {
        fam_frac()
      } else if t == tk_plus() {
        fam_add()
      } else if t == tk_hyphen() {
        fam_add()
      } else if t == tk_less_less() {
        fam_shift()
      } else if t == tk_greater_greater() {
        fam_shift()
      } else if t == tk_equal_equal() {
        fam_cmp()
      } else if t == tk_exclam_equal() {
        fam_cmp()
      } else if t == tk_less() {
        fam_cmp()
      } else if t == tk_greater() {
        fam_cmp()
      } else if t == tk_less_equal() {
        fam_cmp()
      } else if t == tk_greater_equal() {
        fam_cmp()
      } else if t == tk_ampersand() {
        fam_bit()
      } else if t == tk_caret() {
        fam_bit()
      } else if t == tk_pipe() {
        fam_bit()
      } else {
        ast::none()
      }
    }

    fn at_op(): Bool { ast::is_some(op_family(tok.read())) }

    fn at_family(f: Int): Bool { op_family(tok.read()) == f }

    # The operator under the cursor, consumed.
    fn take_op(): Int {
      let op = tok.read();
      advance();
      op
    }

    fn binary(op: Int, lhs: Int, rhs: Int): Int {
      let xs = int_list();
      xs.push(rhs);
      let node = ast::node3(ast::k_ex_binary(), op, lhs, ast::commit(xs));
      ast::located(node, ast::source_start(lhs), ast::source_end(rhs))
    }

    fn parse_operators(no_rec: Bool): Int {
      let first = parse_unary(no_rec);
      if at_family(fam_bit()) {
        let op = tok.read();
        var e = first;
        while here(op) {
          advance();
          e = binary(op, e, parse_unary(no_rec));
        }
        if at_op() {
          fail();
        }
        return e;
      }
      let lhs = parse_operand(first, no_rec);
      if !at_family(fam_cmp()) {
        if at_op() {
          fail();
        }
        return lhs;
      }
      let op = take_op();
      let rhs = parse_operand(parse_unary(no_rec), no_rec);
      if at_op() {
        fail();
      }
      binary(op, lhs, rhs)
    }

    # A comparison's operand: one shift, or arithmetic. Whatever operator
    # follows it is the caller's to accept or refuse.
    fn parse_operand(first: Int, no_rec: Bool): Int {
      if at_family(fam_shift()) {
        let op = take_op();
        return binary(op, first, parse_unary(no_rec));
      }
      var e = parse_term(first, no_rec);
      while at_family(fam_add()) {
        let op = take_op();
        e = binary(op, e, parse_term(parse_unary(no_rec), no_rec));
      }
      e
    }

    # `*` chains; `/` and `%` are a fraction bar, taking a single unary on
    # the right, once.
    fn parse_term(first: Int, no_rec: Bool): Int {
      var e = first;
      while here(tk_star()) {
        advance();
        e = binary(tk_star(), e, parse_unary(no_rec));
      }
      if at_family(fam_frac()) {
        let op = take_op();
        e = binary(op, e, parse_unary(no_rec));
        if at_family(fam_mul()) {
          fail();
        } else if at_family(fam_frac()) {
          fail();
        }
      }
      e
    }

    fn at_literal(): Bool {
      if here(tk_integer()) {
        true
      } else {
        here(tk_decimal())
      }
    }

    fn parse_unary(no_rec: Bool): Int {
      let start = tstart.read();
      let node = parse_unary_inner(no_rec);
      ast::located(node, start, previous_end.read())
    }

    fn parse_unary_inner(no_rec: Bool): Int {
      if here(tk_hyphen()) {
        advance();
        # `-1.abs()` would be `-(1.abs())`, which nobody means (D68).
        if at_literal() {
          if peek2() == tk_dot() {
            fail();
          }
        }
        return ast::node2(ast::k_ex_unary(), tk_hyphen(), parse_unary(no_rec));
      }
      if here(tk_exclam()) {
        advance();
        return ast::node2(ast::k_ex_unary(), tk_exclam(), parse_unary(no_rec));
      }
      parse_postfix(no_rec)
    }

    # Where a value cannot follow, so `return` stands alone.
    fn at_value_end(): Bool {
      if here(tk_semi()) {
        true
      } else if here(tk_comma()) {
        true
      } else if here(tk_rbrace()) {
        true
      } else {
        here(tk_rparen())
      }
    }

    fn parse_if(): Int {
      let cond = parse_expr_at(true);
      expect(tk_lbrace());
      let then = parse_block();
      var els = ast::none();
      if accept(tk_else()) {
        if accept(tk_if()) {
          els = parse_if();
        } else {
          expect(tk_lbrace());
          els = parse_block();
        }
      }
      ast::node3(ast::k_ex_if(), cond, then, els)
    }

    fn opens_delimiter(k: Int): Bool {
      if k == tk_lparen() { return true; }
      if k == tk_lbracket() { return true; }
      k == tk_lbrace()
    }

    fn closes_delimiter(k: Int): Bool {
      if k == tk_rparen() { return true; }
      if k == tk_rbracket() { return true; }
      k == tk_rbrace()
    }

    # Look from the current lexer position through a field initializer,
    # ignoring separators inside its nested delimiters.
    fn record_separator(): Bool {
      var depth = 0;
      loop {
        let k = token_code(lexer::lex());
        if k == tk_eof() { return false; }
        if depth == 0 {
          if k == tk_comma() { return true; }
          if k == tk_rbrace() { return true; }
          if k == tk_semi() { return false; }
          if k == tk_rparen() { return false; }
          if k == tk_rbracket() { return false; }
        }
        if opens_delimiter(k) {
          depth = depth + 1;
        } else if closes_delimiter(k) {
          depth = depth - 1;
        }
      }
    }

    # Called at `{`. Preserve the lexer position and the buffered token.
    fn bare_record_ahead(): Bool {
      let first = peek2();
      if first == tk_rbrace() { return true; }
      if first != tk_name() { return false; }
      let saved_at = lexer::at.read();
      let saved_mark = lexer::mark.read();
      let next = token_code(lexer::lex());
      var record = next == tk_comma();
      if next == tk_equal() {
        record = record_separator();
      }
      lexer::at.write(saved_at);
      lexer::mark.write(saved_mark);
      record
    }

    fn bare_block_ahead(): Bool {
      if here(tk_lbrace()) { return !bare_record_ahead(); }
      false
    }

    fn parse_match(): Int {
      let subject = parse_expr_at(true);
      expect(tk_lbrace());
      let xs = int_list();
      loop {
        if here(tk_rbrace()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        let pat = parse_pattern();
        expect(tk_equal_greater());
        if bare_block_ahead() {
          advance();
          let body = parse_block();
          xs.push(ast::node2(ast::k_arm(), pat, body));
          accept(tk_comma());
        } else {
          let body = parse_expr();
          xs.push(ast::node2(ast::k_arm(), pat, body));
          # The last arm may drop its comma.
          if !here(tk_rbrace()) {
            expect(tk_comma());
          }
        }
      }
      expect(tk_rbrace());
      ast::node3(ast::k_ex_match(), subject, ast::commit(xs), xs.length())
    }

    fn parse_postfix(no_rec: Bool): Int {
      let start = tstart.read();
      let node = parse_postfix_inner(no_rec);
      ast::located(node, start, previous_end.read())
    }

    fn parse_postfix_inner(no_rec: Bool): Int {
      var e = parse_primary(no_rec);
      loop {
        if !accept(tk_dot()) {
          break;
        }
        let p = parse_path();
        if accept(tk_lparen()) {
          let xs = int_list();
          parse_exprs(xs, tk_rparen());
          e = ast::node4(ast::k_ex_method(), e, p, ast::commit(xs), xs.length());
        } else {
          e = ast::node2(ast::k_ex_field(), e, ast::path_last(p));
        }
      }
      e
    }

    # A literal's digits, as values, where the point fell, and its
    # exponent's value if it has one (D68).
    fn parse_literal(): Int {
      let start = tstart.read();
      let node = parse_literal_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_literal_inner(): Int {
      let decimal = here(tk_decimal());
      let xs = int_list();
      var fraction = 0;
      var point = false;
      var exponent = false;
      var negative = false;
      var power = 0;
      var i = tstart.read();
      while i < tend.read() {
        let c = lexer::src.get(i);
        if exponent {
          if c == char::hyphen {
            negative = true;
          } else if c >= char::digit0 {
            power = power * 10 + (c.code() - char::digit0.code());
          }
        } else if c == char::dot {
          point = true;
        } else if c == char::e {
          exponent = true;
        } else if c == char::E {
          exponent = true;
        } else {
          xs.push(c.code() - char::digit0.code());
          if point {
            fraction = fraction + 1;
          }
        }
        i = i + 1;
      }
      advance();
      var frac = ast::none();
      if decimal {
        frac = fraction;
      }
      let digits = ast::commit(xs);
      var scale = ast::none();
      if exponent {
        let ps = int_list();
        if negative {
          ps.push(0 - power);
        } else {
          ps.push(power);
        }
        scale = ast::commit(ps);
      }
      ast::node4(ast::k_ex_lit(), digits, xs.length(), frac, scale)
    }

    fn parse_exprs(xs: IntList, close: Int) {
      loop {
        if here(close) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        xs.push(parse_expr());
        if !accept(tk_comma()) {
          break;
        }
      }
      expect(close);
    }

    # String expressions are ordinary contextual calls, like their explicit
    # spelling. A keyword local cannot collide with a source binding. Keeping
    # writes in a flat block avoids AST depth proportional to byte length.
    fn integer_node(value: Int): Int {
      let reverse = int_list();
      var n = value;
      loop {
        reverse.push(n % 10);
        n = n / 10;
        if n == 0 { break; }
      }
      let digits = int_list();
      var i = reverse.length();
      while i > 0 { i = i - 1; digits.push(reverse.get(i)); }
      ast::node4(ast::k_ex_lit(), ast::commit(digits), digits.length(), ast::none(), ast::none())
    }

    fn tuple_label(i: Int): Int {
      let cs = int_list();
      cs.push(37);
      push_name_index(cs, i);
      intern::intern_chars(cs)
    }

    fn tuple_expr(values: IntList): Int {
      let fields = int_list();
      var i = 0;
      while i < values.length() {
        fields.push(ast::node2(ast::k_ex_rfield(), tuple_label(i), values.get(i)));
        i = i + 1;
      }
      ast::node3(ast::k_ex_record(), ast::none(), ast::commit(fields), fields.length())
    }

    fn string_call(which: Int, args: IntList): Int {
      let name = int_list();
      if which == 0 { sp_string_begin(name); }
      else if which == 1 { sp_string_write1(name); }
      else if which == 2 { sp_string_write2(name); }
      else if which == 3 { sp_string_write3(name); }
      else if which == 4 { sp_string_write4(name); }
      else { sp_string_finish(name); }
      ast::node3(ast::k_ex_call(), local_ref(intern::intern_chars(name)), ast::commit(args), args.length())
    }

    # Payload bytes are contextual values, not integer literal expressions.
    # Hexadecimal names cover every UTF-8 byte without extra arithmetic in
    # the desugared program.
    fn byte_digit(value: Int): Char {
      if value < 10 { (char::digit0.code() + value).char() }
      else { (char::a.code() + value - 10).char() }
    }

    fn byte_path(name: IntList): Int {
      let namespace = int_list();
      sp_byte(namespace);
      let path = int_list();
      path.push(intern::intern_chars(namespace));
      path.push(intern::intern_chars(name));
      ast::node4(ast::k_ex_path(), ast::path_of(path), ast::none(), 0, 0)
    }

    fn byte_node(value: Int): Int {
      let name = int_list();
      push_char(name, char::x);
      push_char(name, byte_digit(value / 16));
      push_char(name, byte_digit(value % 16));
      byte_path(name)
    }

    # Prefix constructors express the correlated first/second-byte ranges
    # of three- and four-byte scalars using ordinary record/tag types.
    fn byte_prefix(first: Int, second: Int, width: Int): Int {
      let name = int_list();
      if width == 3 {
        if first == 224 { sp_ThreeE0(name); }
        else if first == 237 { sp_ThreeED(name); }
        else { sp_ThreeOrdinary(name); }
      } else {
        if first == 240 { sp_FourF0(name); }
        else if first == 244 { sp_FourF4(name); }
        else { sp_FourMiddle(name); }
      }
      let fields = int_list();
      let lead = int_list();
      sp_lead(lead);
      fields.push(ast::node2(ast::k_ex_rfield(), intern::intern_chars(lead), byte_node(first)));
      let next = int_list();
      sp_second(next);
      fields.push(ast::node2(ast::k_ex_rfield(), intern::intern_chars(next), byte_node(second)));
      ast::node3(ast::k_ex_record(), byte_path(name), ast::commit(fields), fields.length())
    }

    fn utf8_continuation(bytes: IntList, index: Int): Bool {
      if index >= bytes.length() { return false; }
      let value = bytes.get(index);
      if value < 128 { false } else { value <= 191 }
    }

    # Width of one Unicode scalar, or zero for an invalid encoding. The
    # restricted second bytes exclude overlong forms, surrogates, and values
    # above U+10FFFF.
    fn utf8_width(bytes: IntList, index: Int): Int {
      let first = bytes.get(index);
      if first < 128 { return 1; }
      if first < 194 { return 0; }
      if first > 244 { return 0; }
      if !utf8_continuation(bytes, index + 1) { return 0; }
      if first < 224 { return 2; }
      if !utf8_continuation(bytes, index + 2) { return 0; }
      let second = bytes.get(index + 1);
      if first == 224 { if second < 160 { return 0; } }
      if first == 237 { if second > 159 { return 0; } }
      if first < 240 { return 3; }
      if !utf8_continuation(bytes, index + 3) { return 0; }
      if first == 240 { if second < 144 { return 0; } }
      if first == 244 { if second > 143 { return 0; } }
      4
    }

    fn raw_string_line(bytes: IntList, start: Int): Int {
      bytes.push(char::newline.code());
      var i = start;
      while i < tend.read() {
        if lexer::src.get(i) == char::greater { break; }
        i = i + 1;
      }
      i = i + 1;
      if i < tend.read() { if lexer::src.get(i) == char::space { i = i + 1; } }
      i
    }

    fn parse_string_literal(): Int {
      let start = tstart.read();
      let node = parse_string_literal_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_string_literal_inner(): Int {
      let bytes = int_list();
      var i = tstart.read() + 1;
      if lexer::src.get(tstart.read()) == char::greater {
        if i < tend.read() { if lexer::src.get(i) == char::space { i = i + 1; } }
        while i < tend.read() {
          let c = lexer::src.get(i);
          i = i + 1;
          if c == char::newline { i = raw_string_line(bytes, i); }
          else if c == char::cr {
            if i < tend.read() { if lexer::src.get(i) == char::newline { i = i + 1; } }
            i = raw_string_line(bytes, i);
          } else { bytes.push(c.code()); }
        }
        bytes.push(char::newline.code());
      } else {
        let stop = tend.read() - 1;
        while i < stop {
          var c = lexer::src.get(i);
          i = i + 1;
          if c == char::backslash {
            c = lexer::src.get(i);
            i = i + 1;
            if c == char::n { c = char::newline; }
            else if c == char::r { c = char::cr; }
            else if c == char::t { c = char::tab; }
          }
          bytes.push(c.code());
        }
      }
      advance();
      let keyword = int_list();
      sp_return(keyword);
      let builder = intern::intern_chars(keyword);
      let statements = int_list();
      let begin_args = int_list();
      begin_args.push(integer_node(bytes.length()));
      statements.push(ast::node3(ast::k_st_var(), builder, ast::none(), string_call(0, begin_args)));
      i = 0;
      while i < bytes.length() {
        let width = utf8_width(bytes, i);
        if width == 0 { fail(); return ast::node0(ast::k_ex_unit()); }
        let write_args = int_list();
        write_args.push(local_ref(builder));
        write_args.push(integer_node(i));
        var offset = 0;
        if width >= 3 {
          write_args.push(byte_prefix(bytes.get(i), bytes.get(i + 1), width));
          offset = 2;
        }
        while offset < width {
          write_args.push(byte_node(bytes.get(i + offset)));
          offset = offset + 1;
        }
        statements.push(ast::node2(ast::k_st_assign(), builder, string_call(width, write_args)));
        i = i + width;
      }
      let finish_args = int_list();
      finish_args.push(local_ref(builder));
      ast::node3(ast::k_ex_block(), ast::commit(statements), statements.length(), string_call(5, finish_args))
    }

    # Look past the balanced parameter list to distinguish it from grouping.
    fn lambda_ahead(): Bool {
      var next = peek2();
      if next != tk_name() {
        if next != tk_lbrace() {
          if next != tk_lparen() {
            if next != tk_rparen() { return false; }
          }
        }
      }
      let saved_at = lexer::at.read();
      let saved_mark = lexer::mark.read();
      var depth = 0;
      while next != tk_eof() {
        if next == tk_rparen() {
          if depth == 0 { break; }
          depth = depth - 1;
        } else if next == tk_lparen() {
          depth = depth + 1;
        }
        next = token_code(lexer::lex());
      }
      var lambda = false;
      if next == tk_rparen() {
        next = token_code(lexer::lex());
        lambda = at_lambda_tail(next);
      }
      lexer::at.write(saved_at);
      lexer::mark.write(saved_mark);
      lambda
    }

    fn parse_primary(no_rec: Bool): Int {
      let start = tstart.read();
      let node = parse_primary_inner(no_rec);
      ast::located(node, start, previous_end.read())
    }

    fn parse_primary_inner(no_rec: Bool): Int {
      if here(tk_str()) { return parse_string_literal(); }
      if accept(tk_this_value()) {
        return ast::node0(ast::k_ex_this());
      }
      if at_literal() {
        return parse_literal();
      }
      if here(tk_lparen()) {
        let lambda = lambda_ahead();
        advance();
        if lambda { return parse_lambda_rest(parse_binding_forms()); }
        if accept(tk_rparen()) { return ast::node0(ast::k_ex_unit()); }
        let e = parse_expr();
        if accept(tk_comma()) {
          let items = int_list();
          items.push(e);
          parse_exprs(items, tk_rparen());
          return tuple_expr(items);
        }
        expect(tk_rparen());
        return e;
      }
      # A bare block (D65), except where a record expression is also
      # forbidden: there the brace opens the body of an `if` or `while`.
      if !no_rec {
        if here(tk_lbrace()) {
          let record = bare_record_ahead();
          advance();
          if record { return parse_record(ast::none()); }
          return parse_block();
        }
      }
      if !here(tk_name()) {
        fail();
        skip_one();
        return ast::node0(ast::k_ex_unit());
      }
      let p = parse_path();
      var run = ast::none();
      var n = 0;
      var applied = 0;
      if accept(tk_lbracket()) {
        let xs = int_list();
        parse_app(xs);
        run = ast::commit(xs);
        n = xs.length();
        applied = 1;
      }
      let callee = ast::node4(ast::k_ex_path(), p, run, n, applied);
      if accept(tk_lparen()) {
        let xs = int_list();
        parse_exprs(xs, tk_rparen());
        return ast::node3(ast::k_ex_call(), callee, ast::commit(xs), xs.length());
      }
      if !no_rec {
        if accept(tk_lbrace()) {
          return parse_record(callee);
        }
      }
      callee
    }

    # The opening brace is consumed. A bare record has no constructor.
    fn parse_record(callee: Int): Int {
      let xs = int_list();
      while !here(tk_rbrace()) {
        if here(tk_eof()) { break; }
        let nm = take_name();
        var value = ast::none();
        if accept(tk_equal()) {
          value = parse_expr();
        }
        xs.push(ast::node2(ast::k_ex_rfield(), nm, value));
        if !accept(tk_comma()) { break; }
      }
      expect(tk_rbrace());
      ast::node3(ast::k_ex_record(), callee, ast::commit(xs), xs.length())
    }

    fn at_lambda_tail(next: Int): Bool {
      if next == tk_equal_greater() { true } else { next == tk_colon() }
    }

    fn parse_binding_items(forms: IntList, close: Int) {
      while !here(close) {
        if here(tk_eof()) { break; }
        forms.push(parse_binding_form());
        if !accept(tk_comma()) { break; }
      }
    }

    # The opening parenthesis is already consumed by the caller.
    fn parse_binding_forms(): IntList {
      let forms = int_list();
      parse_binding_items(forms, tk_rparen());
      expect(tk_rparen());
      forms
    }

    fn tuple_binding(forms: IntList, ann: Int): Int {
      let fields = int_list();
      var i = 0;
      while i < forms.length() {
        fields.push(ast::node2(ast::k_bind_field(), tuple_label(i), forms.get(i)));
        i = i + 1;
      }
      ast::node3(ast::k_bind_tuple(), ast::commit(fields), fields.length(), ann)
    }

    fn annotate_binding(form: Int, ann: Int): Int {
      if !ast::is_some(ann) { return form; }
      if ast::kind_of(form) == ast::k_param() {
        if ast::is_some(ast::b_of(form)) { fail(); }
        return ast::node2(ast::k_param(), ast::a_of(form), ann);
      }
      if ast::is_some(ast::c_of(form)) { fail(); }
      ast::node3(ast::kind_of(form), ast::a_of(form), ast::b_of(form), ann)
    }

    fn parse_binding_annotation(): Int {
      if accept(tk_colon()) { parse_type() } else { ast::none() }
    }

    fn parse_binding_form(): Int {
      let start = tstart.read();
      let form = parse_binding_form_inner();
      ast::located(form, start, previous_end.read())
    }

    fn parse_binding_form_inner(): Int {
      if accept(tk_lbrace()) {
        let fields = int_list();
        while !here(tk_rbrace()) {
          if here(tk_eof()) { break; }
          let field = take_name();
          let sub = if accept(tk_equal()) {
            parse_binding_form()
          } else {
            ast::node2(ast::k_param(), field, parse_binding_annotation())
          };
          fields.push(ast::node2(ast::k_bind_field(), field, sub));
          if !accept(tk_comma()) { break; }
        }
        expect(tk_rbrace());
        return ast::node3(ast::k_bind_record(), ast::commit(fields), fields.length(), parse_binding_annotation());
      }
      if accept(tk_lparen()) {
        if accept(tk_rparen()) {
          return tuple_binding(int_list(), parse_binding_annotation());
        }
        let first = parse_binding_form();
        if accept(tk_comma()) {
          let forms = int_list();
          forms.push(first);
          parse_binding_items(forms, tk_rparen());
          expect(tk_rparen());
          return tuple_binding(forms, parse_binding_annotation());
        }
        expect(tk_rparen());
        return annotate_binding(first, parse_binding_annotation());
      }
      let name = take_name();
      ast::node2(ast::k_param(), name, parse_binding_annotation())
    }

    fn binding_type(form: Int): Int {
      if ast::kind_of(form) == ast::k_param() { return ast::b_of(form); }
      if ast::is_some(ast::c_of(form)) { return ast::c_of(form); }
      if (ast::kind_of(form) == ast::k_bind_tuple()) & (ast::b_of(form) == 0) {
        return ast::node0(ast::k_ty_unit());
      }
      let fields = int_list();
      var i = 0;
      while i < ast::b_of(form) {
        let field = ast::kid_at(ast::a_of(form), i);
        let ty = binding_type(ast::b_of(field));
        if !ast::is_some(ty) { return ast::none(); }
        fields.push(ast::node2(ast::k_ty_field(), ast::a_of(field), ty));
        i = i + 1;
      }
      ast::node2(ast::k_ty_record(), ast::commit(fields), fields.length())
    }

    fn add_binding_name(names: IntList, name: Int) {
      var i = 0;
      while i < names.length() {
        if names.get(i) == name {
          fail();
          return ();
        }
        i = i + 1;
      }
      names.push(name);
    }

    fn check_binding_names(form: Int, names: IntList) {
      if ast::kind_of(form) == ast::k_param() {
        add_binding_name(names, ast::a_of(form));
        return ();
      }
      let fields = int_list();
      var i = 0;
      while i < ast::b_of(form) {
        let field = ast::kid_at(ast::a_of(form), i);
        add_binding_name(fields, ast::a_of(field));
        check_binding_names(ast::b_of(field), names);
        i = i + 1;
      }
    }

    fn push_name_index(cs: IntList, i: Int) {
      if i >= 10 { push_name_index(cs, i / 10); }
      cs.push(char::digit0.code() + i % 10);
    }

    fn parameter_name(form: Int, i: Int): Int {
      if ast::kind_of(form) == ast::k_param() { return ast::a_of(form); }
      let cs = int_list();
      push_string(cs, "%parameter");
      push_name_index(cs, i);
      intern::intern_chars(cs)
    }

    fn nested_binding_name(root: Int, field: Int): Int {
      let cs = int_list();
      intern::put_chars(cs, root);
      cs.push(37);
      intern::put_chars(cs, field);
      intern::intern_chars(cs)
    }

    # Checking a synthesized singleton record compares its field type
    # exactly, including when the explicit annotation is a union.
    fn checked_binding_field(ann: Int, value: Int): Int {
      if !ast::is_some(ann) { return value; }
      let cs = int_list();
      push_string(cs, "%field");
      let key = intern::intern_chars(cs);
      let entries = int_list();
      entries.push(ast::node2(ast::k_ex_rfield(), key, value));
      let record = ast::node3(ast::k_ex_record(), ast::none(), ast::commit(entries), 1);
      let actual = int_list();
      actual.push(ast::node3(ast::k_st_let(), key, ast::none(), record));
      let expression = ast::node3(ast::k_ex_block(), ast::commit(actual), 1, local_ref(key));
      let types = int_list();
      types.push(ast::node2(ast::k_ty_field(), key, ann));
      let ty = ast::node2(ast::k_ty_record(), ast::commit(types), 1);
      let checked = int_list();
      checked.push(ast::node3(ast::k_st_let(), key, ty, expression));
      let field = ast::node2(ast::k_ex_field(), local_ref(key), key);
      ast::node3(ast::k_ex_block(), ast::commit(checked), 1, field)
    }

    fn check_tuple_shape(stmts: IntList, root: Int, form: Int) {
      let cs = int_list();
      push_string(cs, "%shape");
      let check = intern::intern_chars(cs);
      stmts.push(ast::node3(ast::k_st_var(), check, ast::none(), local_ref(root)));
      let values = int_list();
      var i = 0;
      while i < ast::b_of(form) {
        let field = ast::kid_at(ast::a_of(form), i);
        values.push(ast::node2(ast::k_ex_field(), local_ref(root), ast::a_of(field)));
        i = i + 1;
      }
      let rebuilt = if values.length() == 0 { ast::node0(ast::k_ex_unit()) } else { tuple_expr(values) };
      stmts.push(ast::node2(ast::k_st_assign(), check, rebuilt));
    }

    fn bind_components(stmts: IntList, kind: Int, root: Int, form: Int) {
      if ast::kind_of(form) == ast::k_param() { return (); }
      if ast::kind_of(form) == ast::k_bind_tuple() { check_tuple_shape(stmts, root, form); }
      var i = 0;
      while i < ast::b_of(form) {
        let field = ast::kid_at(ast::a_of(form), i);
        let name = ast::a_of(field);
        let sub = ast::b_of(field);
        let projection = ast::node2(ast::k_ex_field(), local_ref(root), name);
        if ast::kind_of(sub) == ast::k_param() {
          let ann = ast::b_of(sub);
          stmts.push(ast::node3(kind, ast::a_of(sub), ann, checked_binding_field(ann, projection)));
        } else {
          let ann = ast::c_of(sub);
          let child = nested_binding_name(root, name);
          stmts.push(ast::node3(ast::k_st_let(), child, ann, checked_binding_field(ann, projection)));
          bind_components(stmts, kind, child, sub);
        }
        i = i + 1;
      }
    }

    fn check_abstract_binding(form: Int, covered: Bool) {
      let named = ast::kind_of(form) == ast::k_param();
      let ann = if named { ast::b_of(form) } else { ast::c_of(form) };
      let annotated = ast::is_some(ann);
      if covered & annotated { fail(); }
      if !named {
        var i = 0;
        while i < ast::b_of(form) {
          let field = ast::kid_at(ast::a_of(form), i);
          check_abstract_binding(ast::b_of(field), covered | annotated);
          i = i + 1;
        }
      }
    }

    fn lower_parameters(forms: IntList, ps: IntList, stmts: IntList, strict: Bool) {
      var destructures = false;
      var i = 0;
      while i < forms.length() {
        let form = forms.get(i);
        if ast::kind_of(form) == ast::k_param() {
          if strict & !ast::is_some(ast::b_of(form)) { fail_expected(tk_colon()); }
          ps.push(form);
        } else {
          destructures = true;
          let root = parameter_name(form, i);
          let ty = binding_type(form);
          if strict & !ast::is_some(ty) { fail_expected(tk_colon()); }
          ps.push(ast::node2(ast::k_param(), root, ty));
          bind_components(stmts, ast::k_st_let(), root, form);
        }
        i = i + 1;
      }
      if destructures {
        let names = int_list();
        i = 0;
        while i < forms.length() {
          check_binding_names(forms.get(i), names);
          i = i + 1;
        }
      }
    }

    fn parse_lambda_rest(forms: IntList): Int {
      let ret = parse_binding_annotation();
      expect(tk_equal_greater());
      var body = parse_expr();
      let ps = int_list();
      let stmts = int_list();
      lower_parameters(forms, ps, stmts, false);
      if stmts.length() > 0 {
        body = ast::node3(ast::k_ex_block(), ast::commit(stmts), stmts.length(), body);
      }
      ast::node4(ast::k_ex_lambda(), ast::commit(ps), ps.length(), ret, body)
    }

    # Patterns.

    fn parse_pattern(): Int {
      let start = tstart.read();
      let node = parse_pattern_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_pattern_inner(): Int {
      if accept(tk_lbrace()) {
        return parse_record_pattern(ast::none());
      }
      # `_` is its own token, never a name.
      if accept(tk_underscore()) {
        return ast::node0(ast::k_pt_wild());
      }
      if !here(tk_name()) {
        fail();
        skip_one();
        return ast::node0(ast::k_pt_wild());
      }
      let p = parse_path();
      if accept(tk_lbrace()) {
        return parse_record_pattern(p);
      }
      if accept(tk_lparen()) {
        let items = int_list();
        while !here(tk_rparen()) {
          if here(tk_eof()) { break; }
          items.push(parse_pattern());
          if !accept(tk_comma()) { break; }
        }
        expect(tk_rparen());
        if items.length() == 0 { return ast::node2(ast::k_pt_path(), p, ast::none()); }
        if items.length() == 1 { return ast::node2(ast::k_pt_path(), p, items.get(0)); }
        let fields = int_list();
        var i = 0;
        while i < items.length() {
          fields.push(ast::node2(ast::k_pt_field(), tuple_label(i), items.get(i)));
          i = i + 1;
        }
        return ast::node4(ast::k_pt_record(), p, ast::commit(fields), fields.length(), 1);
      }
      ast::node2(ast::k_pt_path(), p, ast::none())
    }

    fn parse_record_pattern(p: Int): Int {
      let xs = int_list();
      loop {
        if here(tk_rbrace()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        let nm = take_name();
        var sub = ast::none();
        if accept(tk_equal()) {
          sub = parse_pattern();
        }
        xs.push(ast::node2(ast::k_pt_field(), nm, sub));
        if !accept(tk_comma()) {
          break;
        }
      }
      expect(tk_rbrace());
      ast::node3(ast::k_pt_record(), p, ast::commit(xs), xs.length())
    }

    # Statements and blocks. The opening brace is consumed by the caller,
    # which is what lets `if`, `while` and `match` tell a block from a
    # record expression.

    fn parse_block(): Int {
      let start = tstart.read();
      let node = parse_block_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_block_inner(): Int {
      let stmts = int_list();
      var tail = ast::none();
      loop {
        if here(tk_rbrace()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        let statement_start = tstart.read();
        let statement_index = stmts.length();
        if here(tk_let()) {
          advance();
          parse_binding_stmt(stmts, ast::k_st_let());
        } else if here(tk_var()) {
          advance();
          parse_binding_stmt(stmts, ast::k_st_var());
        } else if here(tk_bind()) {
          advance();
          stmts.push(parse_bind());
        } else if here(tk_while()) {
          advance();
          let cond = parse_expr_at(true);
          expect(tk_lbrace());
          stmts.push(ast::node2(ast::k_st_while(), cond, parse_block()));
        } else if here(tk_loop()) {
          advance();
          expect(tk_lbrace());
          stmts.push(ast::node1(ast::k_st_loop(), parse_block()));
        } else if here(tk_for()) {
          advance();
          stmts.push(parse_for());
        } else if at_assign() {
          let nm = take_name();
          expect(tk_equal());
          let value = parse_expr();
          expect(tk_semi());
          stmts.push(ast::node2(ast::k_st_assign(), nm, value));
        } else {
          let braced = if here(tk_if()) {
            true
          } else if here(tk_match()) {
            true
          } else {
            bare_block_ahead()
          };
          let e = parse_expr();
          if accept(tk_semi()) {
            stmts.push(ast::node1(ast::k_st_expr(), e));
          } else if here(tk_rbrace()) {
            tail = e;
            break;
          } else if braced {
            # `if`, `match` and a bare block may stand as statements
            # without a `;`.
            stmts.push(ast::node1(ast::k_st_expr(), e));
          } else {
            fail_expected(tk_semi());
            stmts.push(ast::node1(ast::k_st_expr(), e));
          }
        }
        if stmts.length() > statement_index {
          ast::located(stmts.get(statement_index), statement_start, previous_end.read());
        }
      }
      expect(tk_rbrace());
      ast::node3(ast::k_ex_block(), ast::commit(stmts), stmts.length(), tail)
    }

    # `for x in e { body }` (draft), `for` already consumed: sugar for
    #
    #     { let c = e; var i = c.begin();
    #       while c.more(i) { let x = c.get(i); i = c.after(i); body } }
    #
    # with `c` and `i` spelled `for` and `while`, which no program can
    # write as names, and the calls operator nodes (`ast::op_begin` and
    # on), so that they mean access.moss's methods whatever is in scope.
    fn parse_for(): Int {
      let start = tstart.read();
      let node = parse_for_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_for_inner(): Int {
      let nm = take_name();
      expect(tk_in());
      let coll = parse_expr_at(true);
      expect(tk_lbrace());
      let body = parse_block();
      let cs = int_list();
      sp_for(cs);
      let c = intern::intern_chars(cs);
      let is = int_list();
      sp_while(is);
      let i = intern::intern_chars(is);
      let inner = int_list();
      inner.push(ast::node3(ast::k_st_let(), nm, ast::none(), for_call(ast::op_get(), c, i)));
      inner.push(ast::node2(ast::k_st_assign(), i, for_call(ast::op_after(), c, i)));
      inner.push(ast::node1(ast::k_st_expr(), body));
      let step = ast::node3(ast::k_ex_block(), ast::commit(inner), inner.length(), ast::none());
      let outer = int_list();
      outer.push(ast::node3(ast::k_st_let(), c, ast::none(), coll));
      outer.push(ast::node3(
        ast::k_st_var(), i, ast::none(), ast::node2(ast::k_ex_unary(), ast::op_begin(), local_ref(c))
      ));
      outer.push(ast::node2(ast::k_st_while(), for_call(ast::op_more(), c, i), step));
      ast::node1(
        ast::k_st_expr(),
        ast::node3(ast::k_ex_block(), ast::commit(outer), outer.length(), ast::none())
      )
    }

    fn local_ref(nm: Int): Int {
      let ps = int_list();
      ps.push(nm);
      ast::node4(ast::k_ex_path(), ast::path_of(ps), ast::none(), 0, 0)
    }

    # `c.m(i)` for one of `for`'s binary operators.
    fn for_call(op: Int, c: Int, i: Int): Int {
      let rhs = int_list();
      rhs.push(local_ref(i));
      ast::node3(ast::k_ex_binary(), op, local_ref(c), ast::commit(rhs))
    }

    # In a block, `x = e;` is an assignment, while `x.m();` and `x`
    # are expressions.
    fn at_assign(): Bool {
      if !here(tk_name()) {
        false
      } else {
        peek2() == tk_equal()
      }
    }

    fn parse_binding_stmt(stmts: IntList, kind: Int) {
      var form = parse_binding_form();
      if accept(tk_comma()) {
        let forms = int_list();
        forms.push(form);
        parse_binding_items(forms, tk_equal());
        form = tuple_binding(forms, ast::none());
      }
      expect(tk_equal());
      let value = parse_expr();
      expect(tk_semi());
      if ast::kind_of(form) == ast::k_param() {
        stmts.push(ast::node3(kind, ast::a_of(form), ast::b_of(form), value));
      } else {
        check_binding_names(form, int_list());
        let cs = int_list();
        push_string(cs, "%binding");
        let root = intern::intern_chars(cs);
        stmts.push(ast::node3(ast::k_st_let(), root, binding_type(form), value));
        bind_components(stmts, kind, root, form);
      }
    }

    # `bind` List[Spec (`=` Expr)?] `;`. An item with no `=` applies a
    # functor of that name (D55).
    fn parse_bind(): Int {
      let start = tstart.read();
      let node = parse_bind_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_bind_inner(): Int {
      let xs = int_list();
      loop {
        if here(tk_semi()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        let spec = parse_spec();
        var value = ast::none();
        if accept(tk_equal()) {
          value = parse_expr();
        }
        xs.push(ast::node2(ast::k_st_item(), spec, value));
        if !accept(tk_comma()) {
          break;
        }
      }
      expect(tk_semi());
      ast::node2(ast::k_st_bind(), ast::commit(xs), xs.length())
    }

    # Declarations.

    fn parse_import(): Int {
      let start = tstart.read();
      let node = parse_import_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_import_inner(): Int {
      var text = lexer::src.slice(0, 0);
      if here(tk_str()) {
        if lexer::src.get(tstart.read()) != char::quote { fail(); }
        # The token's span covers the quotes; the path is inside them.
        let s = tstart.read() + 1;
        text = lexer::src.slice(s, tend.read() - s - 1);
        advance();
      } else {
        fail();
      }
      var alias = ast::none();
      if accept(tk_as()) {
        alias = take_name();
      }
      var star = 0;
      let xs = int_list();
      if accept(tk_use()) {
        if accept(tk_star()) {
          star = 1;
        } else {
          loop {
            if here(tk_semi()) {
              break;
            }
            if here(tk_eof()) {
              break;
            }
            var dotted = 0;
            if accept(tk_dot()) {
              dotted = 1;
            }
            let nm = take_name();
            var renamed = ast::none();
            if accept(tk_as()) {
              accept(tk_dot());
              renamed = take_name();
            }
            xs.push(nm);
            xs.push(dotted);
            xs.push(renamed);
            if !accept(tk_comma()) {
              break;
            }
          }
        }
      }
      expect(tk_semi());
      let n = xs.length() / 3;
      ast::make_import(text, alias, star, ast::commit(xs), n)
    }

    fn parse_fn(): Int {
      let start = tstart.read();
      let node = parse_fn_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_fn_inner(): Int {
      var recv = ast::recv_plain();
      var nm = empty_name();
      if accept(tk_dot()) {
        recv = ast::recv_detached();
        nm = take_name();
      } else {
        nm = take_name();
        if accept(tk_dot()) {
          recv = nm;
          nm = take_name();
        }
      }
      expect(tk_lparen());
      let forms = parse_binding_forms();
      let ret = parse_binding_annotation();
      let ps = int_list();
      let stmts = int_list();
      lower_parameters(forms, ps, stmts, true);
      var body = ast::none();
      if accept(tk_lbrace()) {
        body = parse_block();
        if stmts.length() > 0 {
          var i = 0;
          while i < ast::b_of(body) {
            stmts.push(ast::kid_at(ast::a_of(body), i));
            i = i + 1;
          }
          body = ast::node3(ast::k_ex_block(), ast::commit(stmts), stmts.length(), ast::c_of(body));
        }
      } else {
        expect(tk_semi());
        var i = 0;
        while i < forms.length() {
          check_abstract_binding(forms.get(i), false);
          i = i + 1;
        }
      }
      ast::make_fn(recv, nm, ast::commit(ps), ps.length(), ret, body)
    }

    fn parse_specs(xs: IntList, close: Int) {
      loop {
        if here(close) {
          break;
        }
        if here(tk_semi()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        xs.push(parse_spec());
        if !accept(tk_comma()) {
          break;
        }
      }
    }

    # A context's items (D90: specs and type equations).
    fn parse_ctx_items(xs: IntList) {
      loop {
        if here(tk_semi()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        xs.push(parse_ctx_item());
        if !accept(tk_comma()) {
          break;
        }
      }
    }

    fn parse_functor(): Int {
      let start = tstart.read();
      let node = parse_functor_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_functor_inner(): Int {
      let nm = take_name();
      # D84 (draft): an abstract functor's polymorphic type inputs.
      var ps = ast::none();
      var np = 0 - 1;
      if accept(tk_lbracket()) {
        let xs = int_list();
        loop {
          if here(tk_rbracket()) {
            break;
          }
          if here(tk_eof()) {
            break;
          }
          xs.push(take_name());
          if !accept(tk_comma()) {
            break;
          }
        }
        expect(tk_rbracket());
        ps = ast::commit(xs);
        np = xs.length();
      }
      expect(tk_colon());
      let args = int_list();
      parse_specs(args, tk_hyphen_greater());
      expect(tk_hyphen_greater());
      let res = int_list();
      parse_specs(res, tk_lbrace());
      let ar = ast::commit(args);
      let rr = ast::commit(res);
      # No body: an abstract functor, a requirement (D78).
      if accept(tk_semi()) {
        return ast::make_functor(
          nm, ar, args.length(), rr, res.length(), ast::none(), 0, ps, np
        );
      }
      if np >= 0 {
        fail();
      }
      expect(tk_lbrace());
      let binds = int_list();
      loop {
        if here(tk_rbrace()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        if accept(tk_bind()) {
          binds.push(parse_bind());
        } else {
          fail();
          skip_one();
        }
      }
      expect(tk_rbrace());
      let br = ast::commit(binds);
      ast::make_functor(
        nm, ar, args.length(), rr, res.length(), br, binds.length(), ps, np
      )
    }

    fn parse_assume(): Int {
      let start = tstart.read();
      let node = parse_assume_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_assume_inner(): Int {
      let items = int_list();
      loop {
        if here(tk_lbrace()) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        items.push(parse_assume_item());
        if !accept(tk_comma()) {
          break;
        }
      }
      expect(tk_lbrace());
      let inner = int_list();
      parse_decls(inner, tk_rbrace());
      expect(tk_rbrace());
      let ir = ast::commit(items);
      let dr = ast::commit(inner);
      ast::node4(ast::k_d_assume(), ir, items.length(), dr, inner.length())
    }

    # A nominal type has no fields, a positional payload, or a record
    # payload. Retain the positional arity alongside the lowered type.
    fn parse_tag(): Int {
      let start = tstart.read();
      let node = parse_tag_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_tag_inner(): Int {
      let nm = take_name();
      let params = int_list();
      var listed = false;
      # D73: a tag's listed parameters, which its payload need not
      # mention.
      if accept(tk_lbracket()) {
        loop {
          if here(tk_rbracket()) {
            break;
          }
          if here(tk_eof()) {
            break;
          }
          params.push(take_name());
          if !accept(tk_comma()) {
            break;
          }
        }
        expect(tk_rbracket());
        listed = true;
      }
      # A unit tag has no brackets, not even empty ones (D73): `tag X[];`
      # is refused.
      if !listed {
        if accept(tk_semi()) {
          return ast::node1(ast::k_d_unit(), nm);
        }
      }
      var arity = ast::none();
      var ty = ast::none();
      if here(tk_lbrace()) {
        ty = parse_type_atom();
      } else {
        expect(tk_lparen());
        let types = int_list();
        parse_types_to_paren(types);
        arity = types.length();
        if arity == 1 {
          ty = types.get(0);
        } else {
          ty = tuple_type(types);
        }
      }
      expect(tk_semi());
      let n = params.length();
      params.push(arity);
      ast::node4(ast::k_d_tag(), nm, ty, ast::commit(params), n)
    }

    fn parse_decl(): Int {
      let start = tstart.read();
      let node = parse_decl_inner();
      ast::located(node, start, previous_end.read())
    }

    fn parse_decl_inner(): Int {
      if accept(tk_import()) {
        return parse_import();
      }
      if accept(tk_assume()) {
        return parse_assume();
      }
      if accept(tk_type()) {
        # D83: abstract or an alias; a nominal type is a `tag`.
        let nm = take_name();
        if accept(tk_semi()) {
          return ast::node1(ast::k_d_type(), nm);
        }
        expect(tk_equal());
        let ty = parse_type();
        expect(tk_semi());
        return ast::node2(ast::k_d_alias(), nm, ty);
      }
      if accept(tk_tag()) {
        return parse_tag();
      }
      if accept(tk_val()) {
        let nm = take_name();
        expect(tk_colon());
        let ty = parse_type();
        var init = ast::none();
        if accept(tk_equal()) {
          init = parse_expr();
        }
        expect(tk_semi());
        return ast::node3(ast::k_d_val(), nm, ty, init);
      }
      if accept(tk_fn()) {
        return parse_fn();
      }
      if accept(tk_context()) {
        let nm = take_name();
        expect(tk_equal());
        let xs = int_list();
        parse_ctx_items(xs);
        expect(tk_semi());
        return ast::node3(ast::k_d_context(), nm, ast::commit(xs), xs.length());
      }
      if accept(tk_functor()) {
        return parse_functor();
      }
      fail();
      skip_one();
      ast::node0(ast::k_d_bad())
    }

    fn parse_decls(out: IntList, close: Int) {
      loop {
        if here(close) {
          break;
        }
        if here(tk_eof()) {
          break;
        }
        out.push(parse_decl());
      }
    }

    # One file: the cursor is primed here, so a driver only has to bind
    # the source and reset the lexer's position.
    fn parse_file(out: IntList) {
      tok2.write(ast::none());
      tend.write(0);
      advance();
      parse_decls(out, tk_eof());
    }
  }
}
