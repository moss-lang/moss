# The declaration-level AST, stored data-oriented: one row per node across
# parallel IntList arenas, child node ids contiguous per parent in `kids`.
# Node ids and kind codes are Ints (no integer literals — D4 — so kinds are
# named constructor functions).

assume Std {
  fn k_import(): Int { zero }
  fn k_assume(): Int { one }
  fn k_type(): Int { one.add(one) }
  fn k_unit(): Int { k_type().add(one) }
  fn k_val(): Int { k_unit().add(one) }
  fn k_context(): Int { k_val().add(one) }
  fn k_fn(): Int { k_context().add(one) }
  fn k_bad(): Int { k_fn().add(one) }

  val kinds: IntList;
  val starts: IntList;
  val lens: IntList;
  val kids: IntList;
  val name_ids: IntList;

  # References collected from declaration payloads, as interned name ids.
  val ref_ids: IntList;

  # One row per import: the interned path, the names it brings into scope
  # (a span into `imp_names`), and whether it was `use *`.
  val imp_paths: IntList;
  val imp_starts: IntList;
  val imp_lens: IntList;
  val imp_names: IntList;
  val imp_stars: IntList;

  # Names are interned ids, never spans: a node outlives the source it was
  # parsed from, so it cannot point into it.
  context Tree =
    kinds, starts, lens, kids, name_ids, ref_ids,
    imp_paths, imp_starts, imp_lens, imp_names, imp_stars;

  assume Tree {
    fn node(kind: Int, start: Int, len: Int, nid: Int): Int {
      let id = kinds.length();
      kinds.push(kind);
      starts.push(start);
      lens.push(len);
      name_ids.push(nid);
      id
    }

    fn leaf(kind: Int, nid: Int): Int {
      node(kind, zero, zero, nid)
    }

    # An import declares no name of its own (`nid` is the empty name, so
    # it stays out of duplicate and resolution checks), and parks its row
    # index in the `start` slot that only assume nodes use.
    fn import_node(ix: Int, nid: Int): Int {
      node(k_import(), ix, zero, nid)
    }

    fn import_index_of(id: Int): Int {
      starts.get(id)
    }

    # Start an import row. Its names accumulate at the end of `imp_names`,
    # so a row has to be finished before the next one starts — which the
    # parser does, since imports are parsed one at a time.
    fn begin_import(path: Int): Int {
      let ix = imp_paths.length();
      imp_paths.push(path);
      imp_starts.push(imp_names.length());
      imp_lens.push(zero);
      imp_stars.push(zero);
      ix
    }

    fn import_add(ix: Int, nid: Int) {
      imp_names.push(nid);
      imp_lens.set(ix, imp_lens.get(ix).add(one));
    }

    # `A as B` names B locally, so B replaces the A just recorded.
    fn import_rename(ix: Int, nid: Int) {
      if imp_lens.get(ix).gt(zero) {
        imp_names.set(imp_names.length().sub(one), nid);
      } else {
        import_add(ix, nid);
      }
    }

    fn import_star_set(ix: Int) {
      imp_stars.set(ix, one);
    }

    fn import_count(): Int {
      imp_paths.length()
    }

    fn import_path(ix: Int): Int {
      imp_paths.get(ix)
    }

    fn import_star(ix: Int): Bool {
      imp_stars.get(ix).eq(one)
    }

    fn import_name_count(ix: Int): Int {
      imp_lens.get(ix)
    }

    fn import_name_at(ix: Int, i: Int): Int {
      imp_names.get(imp_starts.get(ix).add(i))
    }

    fn kind_of(id: Int): Int {
      kinds.get(id)
    }

    fn start_of(id: Int): Int {
      starts.get(id)
    }

    fn len_of(id: Int): Int {
      lens.get(id)
    }

    fn kid_mark(): Int {
      kids.length()
    }

    fn kid_push(id: Int) {
      kids.push(id);
    }

    fn kid_at(index: Int): Int {
      kids.get(index)
    }

    fn name_id_of(id: Int): Int {
      name_ids.get(id)
    }
  }
}
