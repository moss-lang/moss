# The declaration-level AST, stored data-oriented: one row per node across
# parallel IntList arenas, child node ids contiguous per parent in `kids`.
# Node ids and kind codes are Ints (no integer literals — D4 — so kinds are
# named constructor functions).

assume Std {
  fn k_import(): Int { zero }
  fn k_assume(): Int { one }
  fn k_type(): Int { one.add(one) }
  fn k_unit(): Int { k_type().add(one) }
  fn k_val(): Int { k_unit().add(one) }
  fn k_context(): Int { k_val().add(one) }
  fn k_fn(): Int { k_context().add(one) }
  fn k_bad(): Int { k_fn().add(one) }

  val kinds: IntList;
  val starts: IntList;
  val lens: IntList;
  val kids: IntList;
  val name_ids: IntList;

  # References collected from declaration payloads, as interned name ids.
  val ref_ids: IntList;

  # Names are interned ids, never spans: a node outlives the source it was
  # parsed from, so it cannot point into it.
  context Tree = kinds, starts, lens, kids, name_ids, ref_ids;

  assume Tree {
    fn node(kind: Int, start: Int, len: Int, nid: Int): Int {
      let id = kinds.length();
      kinds.push(kind);
      starts.push(start);
      lens.push(len);
      name_ids.push(nid);
      id
    }

    fn leaf(kind: Int, nid: Int): Int {
      node(kind, zero, zero, nid)
    }

    fn kind_of(id: Int): Int {
      kinds.get(id)
    }

    fn start_of(id: Int): Int {
      starts.get(id)
    }

    fn len_of(id: Int): Int {
      lens.get(id)
    }

    fn kid_mark(): Int {
      kids.length()
    }

    fn kid_push(id: Int) {
      kids.push(id);
    }

    fn kid_at(index: Int): Int {
      kids.get(index)
    }

    fn name_id_of(id: Int): Int {
      name_ids.get(id)
    }
  }
}
