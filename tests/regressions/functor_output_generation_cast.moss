# A fresh output shadows an old input. Its caller generation must retain
# the body's I32 meaning so a checked GC cast agrees with that concrete type.
import "../../lib/wasm.moss" as w use Wasm, Gc, Boxed, StructRef, .boxed;
assume Wasm, Gc {
 type Fresh;
 assume Fresh { val fresh: Fresh; }
 functor F[]: Wasm, Fresh -> Fresh, fresh;
 functor Make: Wasm, Fresh -> Fresh, fresh { bind Fresh=w::I32; bind fresh=w::i32_one; }
 fn main() {
  bind Fresh=w::F64;
  bind F=Make; bind F;
  bind Boxed=Fresh; bind w::Heap;
  let r=fresh.boxed();
  let h=match r { w::Ref(h)=>h };
  bind Boxed=w::I32;
  let b=w::Ref(h); b.deref();
 }
}
