import "../../lib/wasm.moss" use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi;
import "../../lib/wasistd.moss" use WasiConsole, Console, Branch;
import "../../lib/string.moss" use print, first_arg;

# Written against `Console` alone: no Wasm, no Wasi, no native Std.
assume Console {
  fn echo() { print(first_arg()); print(first_arg()); }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiConsole;
    echo();
  }
}
