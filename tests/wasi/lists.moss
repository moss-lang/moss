import "../../lib/wasi.moss" use WasiStd;
import "../../lib/array.moss" use .arrayed;
import "../../lib/wasistd.moss" use Branch, WasiFloats32;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# A packed `IntList` (D69) beside a fixed-size array of `Float` (D84,
# draft: `Std`'s `Array[Item=Float]`, which replaced `FloatList`), so
# `report` is written once and runs at f64 under `WasiStd` and at f32 in
# the block that binds `WasiFloats32`, whose arrays come on demand from
# `Std`'s `Arrays` at the new `Float` (D84 rule 7). Pushing far past the first capacity grows the int
# list; the array is made at its length.

assume Std {
  fn print_int(n: Int) {
    if n < 0 {
      putchar(char::hyphen);
      print_int(-n);
      return;
    }
    if n >= 10 {
      print_int(n / 10);
    }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn num(n: Int) {
    print_int(n);
    putchar(char::space);
  }

  fn report() {
    let ints = int_list();
    let xs = 0.1.arrayed(1000.size());
    var i = 0;
    while i < 1000 {
      ints.push(i * i);
      xs.set(i.size(), 0.1);
      i = i + 1;
    }
    # The sums of a thousand 0.1s and of the squares below 1000, read
    # back: the array by iterating it, the list with `.get`. Arrays are
    # indexed by `Size` and lists by `Int`, so one index serves both
    # only through `.size()`.
    var sum = 0.0;
    for x in xs {
      sum = sum + x;
    }
    var total = 0;
    i = 0;
    while i < ints.length() {
      total = total + ints.get(i);
      i = i + 1;
    }
    num(xs.length().int());
    num(ints.length());
    num((sum * 1000000.0).round());
    num(total);
    putchar(char::newline);
    # `.set`, then the neighbours, to see an element overwrote nothing
    # but itself: a third, scaled by 10^9.
    xs.set(500.size(), 1.0 / 3.0);
    ints.set(500, -7);
    num((xs.get(500.size()) * 1000000000.0).round());
    num((xs.get(499.size()) * 10.0).round());
    num((xs.get(501.size()) * 10.0).round());
    num(ints.get(500));
    num(ints.get(501));
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    report();
    {
      bind WasiFloats32;
      report();
    }
  }
}
