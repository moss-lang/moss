# Moved from bootstrap/examples/sameneed-link.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# Cross-context need identity (AUDIT-CHANGES.md #51; criteria.md section 2,
# coherence). F's and G's contexts both merge X with Y (two readings of
# `A.gimme`), in opposite orders, so each may pick its own representative:
# F can spell its needs `Y.m` and `vx: Y` where G spells `X.m` and `vx: X`.
# F links X.m, vx and A.gimme (X is polymorphic in F); G's body uses none of
# them. tests/wasi/sameneed_link_agree.moss is this program with the orders agreeing.
# - Oracle (representative: the later reading): rejects ("`G`, bound to `F`,
#   captures `X.m`, which mentions a type each application of `F` supplies
#   (D84 3b)"). The agreeing order prints 7.
# - Native: prints 7, in both orders.
# - Audit before: the verdict depended on the orientation. Accepted when F
#   and G chose the same representative; rejected otherwise (LinkBody
#   compared the linked provisions syntactically: A.gimme's `Foo` and vx read
#   Y in F and X in G; and 3b: X.m, then captured, mentions an input of F).
# - Audit now: accepts under every orientation and prints 7. G's needs are
#   read through F's merge, so X.m, vx and A.gimme are linked.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;
val vx: X;
fn .m(): Bool;

assume Std {
  fn run(): Int;
}

context MergeXY = A, X, Y, A.gimme[Foo=X], A.gimme[Foo=Y];
context MergeYX = A, X, Y, A.gimme[Foo=Y], A.gimme[Foo=X];

functor F: Std, MergeXY, vx, X.m -> run;

functor G: Std, MergeYX, vx, X.m -> run {
  bind run = () => 7;
}

assume Std, MergeXY, vx, X.m, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Char;
    bind A.gimme = () => this;
    bind vx = char::a;
    bind X.m = () => true;
    bind F = G;
    bind X.m = () => false;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
