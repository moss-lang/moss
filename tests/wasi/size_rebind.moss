# `Size` (draft, over D84's Rule A): arrays are fixed in `Size` and their
# handle, not in `Int`, so a library over `Std` alone (saturating.moss)
# can rebind `Int` and arrays of the new `Int` are still derived from the
# `GcArrays` that `WasiStd` bound. `Size` stays the root `Int`'s
# generation (D72); at the root the two are one type, `Num`, and in the
# block two. Output: a wrapped sum, a wrapped `at2`, and the saturated
# arithmetic of the block, carried out of it as a `Size`.

import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;
import "../../lib/access.moss" use Elem, .get, .set, .length;
import "../../lib/array.moss" use Item, Array, ArrayHandle, Arrays, .arrayed;
import "./saturating.moss" use Saturating;
import "../../lib/int.moss" use IntOps;
import "../../lib/size.moss" use Sizes;

# Arrays of whatever `Int` is in force, as a context; and code over it
# that never names an index.
assume Int, Size, ArrayHandle {
  context IntArrays =
    ArrayHandle,
    Item.arrayed[Item=Int],
    Array.get[Item=Int, Elem=Int, Int=Size],
    Array.set[Item=Int, Elem=Int, Int=Size],
    Array.length[Item=Int, Int=Size],
    Array.begin[Item=Int, Int=Size],
    Array.more[Item=Int, Int=Size],
    Array.after[Item=Int, Int=Size];
}

assume Int, zero, one, IntOps, Size, Int.size, IntArrays {
  fn big(): Int { 2000000000 }
  fn fill(n: Int): Array[Item=Int] {
    let xs = big().arrayed(n.size());
    xs
  }
  # Both types as parameters: at the root they are one type, `Num`, and
  # in the block two.
  fn at2(xs: Array[Item=Int], i: Int, j: Size): Int { xs.get(i.size()) + xs.get(j) }
  fn sum(xs: Array[Item=Int]): Int {
    var s = 0;
    for x in xs { s = s + x; }
    s
  }
}

assume Std {
  fn pr(n: Int) {
    if n < 0 { putchar(45.char()); pr(-n); return; }
    if n >= 10 { pr(n / 10); }
    putchar((n % 10 + 48).char());
  }
  fn nl() { putchar(10.char()); }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Item = Int;
    bind Arrays;
    pr(sum(fill(3))); nl();                  # wraps: 6000000000 mod 2^32
    let outer = fill(2);
    pr(at2(outer, 0, 1.size())); nl();       # wraps
    let r = {
      bind Saturating;
      bind Item = Int;
      bind Arrays;                           # derived from WasiStd's GcArrays
      let s = sum(fill(3));                  # saturates at 2^31 - 1
      let n = outer.length();                # a Size: the root Int's generation
      let k: Int = n.int();                  # the new Int, by the rebound Size.int
      # Here, outside generic code, a `Size` is still `Num`, with the
      # root `Int`'s arithmetic, which was provided at `Num` (D72).
      let j = outer.length() - 1.size();
      let t = at2(fill(2), 0, j);            # saturates: 2^31 - 1
      (s - k - t).size()                        # leaves the block as a Size
    };
    pr(r.int()); nl();
  }
}
