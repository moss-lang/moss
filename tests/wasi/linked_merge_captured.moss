# Moved from bootstrap/examples/linked-merge-captured.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# LinkMergesOk (PublicBodySlice) is false. `bind F = G;` where G's context
# merges Y, which F does not take (so G captures it), into X, which F links:
# the two readings of `A.gimme` give the merge Y := X (the oracle orients a
# merge from the earlier reading to the later one; Audit's MostGeneralMerge
# allows either). G reads the linked `A.gimme` as F does, so LinkBody holds,
# and no captured item mentions X (3b). But the merge {Y, X} has X among F's
# inputs, not fixed (F is unbracketed and its result mentions no type), and
# Y outside them. At run time the body reads X from the application (Char)
# and Y from the bind site (Bool), so its environment does not absorb G's
# merge; nothing in the body reads Y, so the program is safe. Oracle and
# native both accept it and print 7. With the readings in the other order
# (merge X := Y) the oracle rejects it ("linked input interpretation
# differs", cf. tests/errors/linked_merge.moss).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;

assume Std {
  fn run(): Int;
}

context Merge = A, X, Y, A.gimme[Foo=Y], A.gimme[Foo=X];
context Lin = A, X, A.gimme[Foo=X];

functor F: Std, Lin -> run;

functor G: Std, Merge, X, Y -> run {
  bind run = () => 7;
}

assume Std, Lin, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Bool;
    bind X = Bool;
    bind Y = Bool;
    bind A.gimme = () => true;
    bind F = G;
    bind X = Char;
    bind Foo = Char;
    bind A.gimme = () => this;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
