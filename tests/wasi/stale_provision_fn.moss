import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

# AUDIT-CHANGES #4 (E25), for a fn: `g`'s signature mentions `T`, which
# it does not require. It was provided by `giveq` while `T` meant `Char`;
# after `T` is rebound to `Bool`, `f` would read its result as a `Bool`.
# Refused, as stale_provision.moss is.

type T;
fn g(): T;

assume T, g {
  fn f(): T { g() }
}

assume Std {
  fn giveq(): Char { char::x }

  fn demo() {
    bind T = Char;
    bind g = giveq;
    bind T = Bool;
    if f() { putchar(char::t) } else { putchar(char::f) }
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
