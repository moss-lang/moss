import "../../lib/float.moss" use Floats;
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, WasiFloats, WasiFloats32;
import "../../lib/wasm.moss" use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi;

# D78: an abstract functor whose result holds types. `Fast` promises
# `Floats` — the type `Float` and everything over
# them — and the kernel below marks its inner loop `bind Fast;`. There
# `Float` is a fresh generation (D72) that the kernel is checked against
# once, knowing nothing of what it is; whoever binds `Fast` decides:
# `WasiFloats` makes it f64, `WasiFloats32` f32. No value of the fresh
# type leaves the block: the kernel returns an `I32`.
#
# `Fast` lists no polymorphic inputs (D84, draft): it is fixed in `Int`,
# which `Floats` mentions (`float`, `.round`), so a binding is made where
# `Int` is in force and captures it, and the library's float functors,
# which bind `Int` to `Num` inside, can be bound only where `Int` is
# `Num`. The kernel assumes `Std` for `Int`, and never rebinds it, so
# every application of `Fast` is at the `Int` it was bound at.
#
# Output: √2 and √3 to nine places, at f64 and then at f32, which rounds
# sooner.

functor Fast[]: Wasm, Branch -> Floats;

assume Std, Wasm, Branch, Fast {
  # The square root of `n` by Newton's method, scaled by a billion.
  fn root(n: Int): Int {
    bind Fast;
    let x = float(n);
    var r = x;
    var i = 0;
    while i < 30 {
      r = (r + x / r) / 2.0;
      i = i + 1;
    }
    (r * 1000000000.0).round()
  }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 {
      print_int(n / 10);
    }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std, Wasm, Branch, Fast {
  fn report() {
    print_int(root(one + one));
    putchar(char::newline);
    print_int(root(one + one + one));
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    {
      bind Fast = WasiFloats;
      report();
    }
    {
      bind Fast = WasiFloats32;
      report();
    }
  }
}
