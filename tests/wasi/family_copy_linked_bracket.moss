# Moved from bootstrap/examples/family-copy-linked-bracket.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# FamilyCopyApplyOk counterexample before the caller-keyed install
# (hunt-family t11, no platform code). Family F's item A.len[W = Z]
# carries a bracket on a fixed input; F is bound as a copy of family H,
# whose item A.len is unbracketed (key theta W := W). (A.wid makes W a
# fixed input of F too.) The copy is made in main, where Z and W both
# mean Concrete, so CopyOutputs holds. In use_it, Z and W are distinct
# symbols: the demand true.len() is keyed [W := Z], but H's linked body
# G installed its result at H's key read by theta, [W := W].
# Oracle: stuck (XErr 6), exit 3. Native: exit 0.
# Audit (callerkeys, scratch/orch/callerkeys2-AUDIT.md): the family
# application installs each of F's positions under the caller's key
# ([W := Z]), read from the root's source through the copy's positions,
# so the demand finds it, as native.
type A;
type W;
type Z;
tag Concrete;
assume W, A { fn .len(): W; fn .wid(): W; }
fn mkw(): W;
functor F[A]: A, W, Z -> A.len[W = Z], A.wid;
functor H[A]: A, W -> A.len, A.wid;
functor G: A, W, mkw -> A.len, A.wid { bind A.len = () => mkw(); bind A.wid = () => mkw(); }
assume W, Z, F { fn use_it() { let y: Z = true.len(); } }
fn main() {
  bind W = Concrete;
  bind Z = Concrete;
  bind mkw = () => Concrete;
  bind H = G;
  bind F = H;
  use_it();
}
