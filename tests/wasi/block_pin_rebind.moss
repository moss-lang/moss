# Moved from bootstrap/examples/block-pin-rebind.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# Pins scope (proposals item 3). Like tests/wasi/block_kept_output_pin.moss, but the
# block nested in G's body rebinds the pin itself: `bind seven = { bind T =
# Char; 7 };`. M(F) = {T} (F's result lists `tick`, a defined fn under
# `assume T`). Until item 3, BTypeBind asked `~ In t (fr_pins F)` in every
# frame derived from the linked body's, nested blocks included, while
# lambda bodies were unconstrained (LambdaProvider leaves the body frame's
# pins free): an incoherent scope, and Audit rejected this program. Now a
# nested block runs without pins (BlkECheck, `without_pins`), as a lambda
# body does: the rebind is local to the block and its value (an Int) does
# not mention T, so no result of G reads it. The same rebind at the top of
# G's body is still rejected (tests/errors/block_pin_rebind_top.moss).
# Verdicts: Audit accepts (since item 3; before: rejected); oracle prints 7;
# native prints 7.
# Oracle (moss_m2 at ob-consol): prints 7, exit 0.
# Native (moss-safety target/release/moss, MOSS_SEED
#   /nix/store/1h1710x0...-mossc.wasm): prints 7, exit 0.
# The same rebind at the top of G's body (`bind T = Char; bind seven = 7;`):
#   Audit rejects (D84 3d), native rejects ("compilation failed: `T`"), and
#   the oracle accepts and prints 7.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type T;
fn .num(): Int;
val seven: Int;
assume T {
  fn tick() {}
}
functor Make: Std -> T, T.num;
functor Maker: Std -> T, T.num {
  bind T = Char;
  bind T.num = () => this.code();
}
functor F: Std -> tick, seven;
functor G: Make, Std -> tick, seven {
  bind seven = { bind T = Char; 7 };
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std {
  fn demo() {
    bind T = Bool;
    bind Make = Maker;
    bind F = G;
    bind F;
    print_int(seven);
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
