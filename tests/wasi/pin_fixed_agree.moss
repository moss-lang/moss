# From the copy that was bootstrap/examples/pin-fixed-agree.moss (removed; its
# oracle verdicts are the old Rocq oracle's, historical):
# Q6 (semantics.typ, "pins of fixed inputs"; AUDIT-CHANGES #71), the
# thesis example 08b-fixed. `MakeTok[]` lists no polymorphic types, so it
# is fixed in every type its result mentions, `Tok` included. `CharTok`'s
# body pins `Tok` to `Char`: it relies on `Tok` meaning `Char`, and it is
# bound where `Tok` means `Char`, so the pin agrees with the bind site.
# Verdicts: Audit accepts (since #73; before #71 it rejected, since the
# pin set was M(F) ∋ Tok, and the standard library's GcArrays, bound to
# the family Arrays, pins Arrays' fixed `Size` and `ArrayHandle` the same
# way, so every program using StdBase was rejected; under #71 alone
# GcArrays' key `Array.get`, read through the pinned `ArrayHandle`, was
# still not provided, tests/wasi/pin_fixed_key.moss); oracle prints q;
# native prints q.
# Q6 (AUDIT-CHANGES #71), from tests/wasi/pin_fixed_agree.moss:
# `MakeTok[]` is fixed in `Tok`; `CharTok`'s body pins `Tok` to `Char`,
# and it is bound where `Tok` means `Char`, so the pin agrees with the
# bind site. Prints `q`.
type Tok;

assume Std, Tok {
  fn tok(): Tok;
}

functor MakeTok[]: Std -> tok;
functor CharTok: Std -> tok {
  bind Tok = Char;            # a pin: Tok must mean Char where CharTok is bound
  bind tok = () => char::q;
}

assume ReferenceBase {
  fn main() {
    bind StdBase;
    bind Tok = Char;
    bind MakeTok = CharTok;
    bind MakeTok;
    putchar(tok());
    putchar(char::newline);
  }
}
