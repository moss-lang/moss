import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D20: `mid` assumes the method item `W.m`, whose signature mentions T,
# without T in force. Both compilers reject the assume.

type T;

assume Std {
  type Point { x: Char, y: Char };
}

assume Std, T {
  type W Char;
  fn .m(): T;
}

assume Std {
  fn W.get(): Char { match this { W c => c } }
}

assume Std, T, W.m {
  fn use_it(w: W): T { w.m() }
}

assume Std, W.m {
  fn mid() {
    bind T = Point;
    let p: Point = use_it(W (char::a));
    putchar(p.x);
    putchar(p.y);
    putchar(char::newline);
  }
}

assume Std {
  fn demo() {
    bind T = Char;
    bind W.m = W.get;
    mid();
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
