import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, Chr, Numerics, Containers, WasiNumerics,
  WasiContainers, heap_mark, heap_reset;
import "../../lib/wasm.moss" use Gc, Wasm, Memory;
import "../../lib/wasip1.moss" use Wasi;

# D78, D79: arena.moss's arena, with a list made in it leaving its block
# inside a record. `Run`'s identity is its relevant parameters (D71), so a
# `Run` made in the block is a `Run` over the fresh `IntList`, and the
# escape check sees through it: refused in both compilers.

tag Scratch;

functor Arena[]: -> Memory, Containers;

functor InScratch: Wasm, Branch -> Memory, Containers {
  bind Memory = Scratch;
  bind WasiNumerics;
  bind Char = Chr;
  bind WasiContainers;
}

assume Char, Numerics, Containers {
  fn countdown(n: Int): IntList {
    let xs = int_list();
    var i = n;
    while i > 0 {
      xs.push(i);
      i = i - 1;
    }
    xs
  }
}

assume Char, Numerics, Containers {
  tag Run { start: Int, path: IntList };
}

assume Std, Wasm, Gc, Wasi, Branch, Arena {
  fn report() {
    let run = {
      bind Arena;
      Run { start = 3, path = countdown(3) }
    };
  }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Arena = InScratch;
    report();
  }
}
