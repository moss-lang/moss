import "../../lib/wasi.moss" use WasiStd;
import "../../lib/array.moss" use FloatArraysOf;
import "../../lib/wasistd.moss" use Branch, WasiFloats32;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# Exponent notation (D68). `1e-9` is `float(1)` over `10^9`, exactly what
# `0.000000001` is; `2.5e10` is `float(25)` times `10^9`; a literal whose
# exponent cancels its fractional digits is `float(m)` alone. Any literal
# with an exponent is `Float`. As in literals.moss, `report` is written
# once and run at f64 and then, under `WasiFloats32`, at f32. Each line of
# output is one group; the comment beside it says what it must be.

assume Std {
  fn print_int(n: Int) {
    if n < 0 {
      putchar(char::hyphen);
      print_int(-n);
      return;
    }
    if n >= 10 {
      print_int(n / 10);
    }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn num(n: Int) {
    print_int(n);
    putchar(char::space);
  }

  fn yes(b: Bool) {
    if b { putchar(char::y); } else { putchar(char::n); }
  }

  fn scaled(x: Float, scale: Int) {
    num((x * float(scale)).round());
  }

  fn report() {
    # Each form against its positional spelling, at either precision:
    # yyyyyyyyy
    yes(1e-9 == 0.000000001);
    yes(2.5e10 == 25000000000.0);
    yes(1e0 == 1.0);
    yes(1E3 == 1000.0);
    yes(1.5e+3 == 1500.0);
    yes(1.5e1 == 15.0);
    yes(2.5e-3 == 0.0025);
    yes(0e5 == 0.0);
    yes(0.000123E-0004 == 0.0000000123);
    putchar(char::newline);

    # Scaled to `Int`s: 1500 125 1 250 -42 100000 602
    scaled(1.5e3, 1);
    scaled(1.25E-2, 10000);
    scaled(1e-9 * 1e9, 1);
    scaled(2.5e10 / 1e10, 100);
    scaled(-4.2e1, 1);
    scaled(1e5.abs(), 1);
    scaled(6.02E23 / 1e21, 1);
    putchar(char::newline);

    # Where spellings and precisions part. `6.02E23` is 602 times
    # `10^21`, which is exact at f64, so it rounds once, to the nearest
    # f64; `602000000000000000000000.0` sums 25 digits in `Float`, then
    # divides by ten, and is an ulp off at either precision. `1e39`
    # overflows f32 (to inf, and inf times zero is NaN) and `1e-46`
    # underflows it, while f64 holds both; `1e999` overflows either, and
    # `1e-999`, one over that, is zero at either. f64: n nn yy; f32: n yy
    # yy.
    yes(6.02E23 == 602000000000000000000000.0);
    putchar(char::space);
    yes(1e39 * 0.0 != 0.0);
    yes(1e-46 == 0.0);
    putchar(char::space);
    yes(1e999 > 1e38);
    yes(1e-999 == 0.0);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    report();
    {
      bind WasiFloats32;
      bind FloatArraysOf;
      report();
    }
  }
}
