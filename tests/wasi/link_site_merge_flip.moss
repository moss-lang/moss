# F fixes T and U to Int where G is bound, so G can use its merged input
# at every application of F. The application supplies showT, which prints
# 1006 through out rather than using the earlier captured implementation.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type P; type T; type U;
assume P { val v: P; }
fn showT(x: T): Int;
assume Std { fn out(a: T, b: U): Int; }
context Fc = T, U, v[P=T], showT;
context Gc = T, U, v[P=U], v[P=T], showT;
functor F[]: Std, Fc -> out;
functor G: Std, Gc -> out { bind out = (a, b) => showT(b); }

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind T = Int; bind U = Int; bind P = Int; bind v = 1;
    bind showT = (n) => n + 1;
    bind F = G;
    bind P = Int; bind v = 2;
    bind showT = (n) => n + 1000;
    bind F;
    print_int(out(5, 6));
    putchar(char::newline);
  }
}
assume Wasm, Wasi, Branch { fn main() { bind WasiStd; demo(); } }
