import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm, Boxed, Ref, Heap, .boxed;
import "../../lib/wasip1.moss" use Wasi;

# Reference and scalar union payloads occupy separate typed lanes. Recursive
# boxing, matching and field access must agree on that physical layout.

assume Std, Wasm, Gc {
  tag Leaf(Int);
  tag Node { l: Ref[Boxed=Tree], r: Ref[Boxed=Tree] };
  type Tree = Leaf | Node;

  fn sum(tree: Tree): Int {
    bind Boxed = Tree;
    bind Heap;
    match tree {
      Leaf(value) => value,
      Node { l, r } => sum(l.deref()) + sum(r.deref()),
    }
  }

  fn demo() {
    bind Boxed = Tree;
    bind Heap;
    let leaf: Tree = Leaf(1);
    let l = leaf.boxed();
    let node: Tree = Node { l, r = l };
    let t = node.boxed();
    putchar((sum(t.deref()) + 48).char());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
