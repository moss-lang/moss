# The copy reads the method need through T = U at the binding site.
# The two fixtures swap H's and G's A.gimme entries (AUDIT-CHANGES #119).
# Applying the copy invokes the method selected from F's inputs.
type T; type U; type A; type Foo; tag Old;
fn .gimme(): Foo;
fn .m(): Old;
assume T, U { fn out(a: T, b: U); }
functor F[]: T, U, A, A.gimme[Foo=T], T.m -> out;
functor H[]: T, U, A, A.gimme[Foo=U], A.gimme[Foo=T], T.m -> out;
functor G: T, U, A, A.gimme[Foo=U], A.gimme[Foo=T], T.m -> out { bind out = (a, b) => { a.m(); }; }
fn main() { bind T = Old; bind U = Old; bind A = Old; bind Foo = Old; bind A.gimme = () => this; bind T.m = () => this; bind H = G; bind F = H; bind F; out(Old, Old); }
