import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use WasiCore, proc_exit;

# Binding a struct tag's payload gives a bare record type (Audit note 35),
# which a parameter can name. Exits 3.
tag P { a: I32, b: I32 };

assume Wasm, WasiCore {
  fn get(r: { a: I32, b: I32 }): I32 { r.b }

  fn main() {
    let one = w::i32_one;
    let three = w::i32_add(w::i32_add(one, one), one);
    let p = P { a = one, b = three };
    match p {
      P(y) => proc_exit(get(y)),
    }
  }
}
