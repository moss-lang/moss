import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D84 rule 7 (O3 d): two families producing one method key (`A.m`) in
# one context. Expected: refused (at the context, or at the call).
type A;
assume A { fn .m(): A; }
functor F1[A]: -> A.m;
functor F2[A]: -> A.m;
functor Id: A -> A.m { bind A.m = () => this; }

assume Std, F1, F2 {
  fn use_it() { bind A = Int; let x = one.m(); putchar((x + char::digit0.code()).char()); }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() { bind WasiStd; bind F1 = Id; bind F2 = Id; use_it(); putchar(char::newline); }
}
