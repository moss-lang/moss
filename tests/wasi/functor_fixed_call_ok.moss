import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;
type T;
assume Std, T {
  fn out(): T;
  fn make(): T;
}
functor F[]: Std, T -> out;
functor G: Std, T, make -> out { bind out = make; }
assume Std, T, F {
  fn call(): T { bind F; out() }
}
assume Std {
  tag Box(Int);
  fn makebox(): Box { Box(0) }
  fn demo() {
    bind T = Box;
    bind make = makebox;
    bind F = G;
    let value = match call() { Box(v) => v };
    putchar((value + char::digit0.code()).char());
  }
}
assume Wasm, Gc, WasiCore, Branch {
  fn main() { bind WasiStd; demo(); }
}
