import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D26, D70: an anonymous provider captures a val whose type mentions a
# type bound beside it (`Holder[Item]`, with `Item = Float`), and a
# function generic over the provided fn calls it. `twice` only passes the
# capture on, and knows nothing of `Item`; the capture's type is read
# where it was captured, so `twice` takes it as the f64 `bump` reads.
# `quad` takes it through two captures: `bump4`'s provider captured
# `bump`'s. Read in the callee's own environment, `Holder[Item]` was one
# i32 and the module did not validate. Prints 15, 29 and 15.

type Item;

assume Item {
  tag Holder { x: Item };
  val held: Holder;
}

assume Int {
  fn bump(n: Int): Int;
  fn bump4(n: Int): Int;
}

assume Std, bump {
  fn twice(n: Int): Int { bump(bump(n)) }
}

assume Std, bump4 {
  fn quad(n: Int): Int { bump4(n) }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn demo() {
    bind Item = Float;
    bind held = Holder { x = 7.0 };
    bind bump = (n) => n + held.x.round();
    print_int(twice(1));
    putchar(char::newline);
    bind bump4 = (n) => twice(twice(n));
    print_int(quad(1));
    putchar(char::newline);
    print_int(bump(bump(1)));
    putchar(char::newline);
  }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
