import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D43: `Ctx3` merges `B` with `C`, so it requires them to be one type,
# and `go`, which assumes it, returns the `B` that `A.gimme` gives as a
# `C`. `demo` binds `B` and `C` to two different types and calls it:
# rejected in both compilers, at the call.

type Foo;
type A;
type B;
type C;

fn .gimme(): Foo;

context Ctx1 = A, B, A.gimme[Foo=B];
context Ctx2 = A, C, A.gimme[Foo=C];
context Ctx3 = Ctx1, Ctx2;

assume Std, Ctx3 {
  fn go(a: A): C { a.gimme() }
}

assume Std {
  fn giveq(): Char { char::q }

  fn demo() {
    bind Foo = Char;
    bind A = Char;
    bind B = Char;
    bind C = Int;
    bind A.gimme = giveq;
    go(char::m);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
