import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, Num, raw;
import "../../lib/wasm.moss" as w use Wasm, I32, Arrayed, Array, Arrays, .arrayed;
import "../../lib/wasip1.moss" use WasiCore;

# The Base cast recovers the precise GC type from an erased ArrayRef.
# Int succeeds. Char has a different heap type and traps.
# Output: 42, then a trap.

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind Arrayed = Int;
    bind Arrays;
    bind Arrayed = Char;
    bind Arrays;
    let n = 42;
    let xs = n.arrayed(raw(3));
    let bare = match xs { Array(a) => a };
    let ys = w::ArrayCast[Arrayed=Int](bare).cast();
    print_int(ys.get(raw(2)));
    putchar(char::newline);
    let cs = w::ArrayCast[Arrayed=Char](bare).cast();
    putchar(cs.get(raw(0)));
  }
}
