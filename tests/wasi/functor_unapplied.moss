import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D78 and D16: `Tally`, bound to the abstract `Trace`, relies on
# `counter`, which `Trace`'s argument signature does not give it — as in
# functor_body.moss, but here nothing ever applies `Trace`, so no
# application exists to show it. A functor bound to an abstract one is
# checked against its own argument signature where it is bound.

assume Std {
  fn note(value: Int);
  val counter: CellInt;
}

assume Std, counter {
  fn count(value: Int) { counter.write(counter.read() + value); }
}

functor Trace: Std -> note;

functor Tally: Std -> note {
  bind note = count;
}

assume Std {
  fn demo() {
    bind counter = cell_int();
    bind Trace = Tally;
    putchar(char::a);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
