# A `Std`-only library that rebinds `Int`: saturating 32-bit arithmetic
# over the `Int` in force where it is applied (the "narrow" one). It
# imports nothing from wasistd.moss or wasm.moss.

import "../../lib/int.moss" use Int, zero, one, IntOps;
import "../../lib/size.moss" use Size, Sizes, .size, .int;
import "../../lib/bool.moss" use Bool, true, false;
import "../../lib/float.moss" use Float, float, .trunc, .round;
import "../../lib/char.moss" use Char, .code, .char;
import "../../lib/string.moss" use String, arg_count, arg_at, .slice, string_begin, string_write1, string_write2, string_write3, string_write4, string_finish;
import "../../lib/strlist.moss" use StrList, str_list;
import "../../lib/cell.moss" use CellInt, cell_int, .write;
import "../../lib/list.moss" use IntList;
import "../../lib/access.moss" use Elem, Index, .get, .set, .length, .push, .read;

type Narrow;

assume Narrow {
  val nzero: Narrow;
  val none: Narrow;
  context NarrowOps =
    Narrow, nzero, none,
    Narrow.add, Narrow.sub, Narrow.mul, Narrow.div, Narrow.rem, Narrow.neg,
    Narrow.and, Narrow.or, Narrow.xor, Narrow.shl, Narrow.shr,
    Narrow.eq, Narrow.ne, Narrow.lt, Narrow.gt, Narrow.le, Narrow.ge;
}

assume NarrowOps {
  tag Sat(Narrow);

  fn nar(x: Sat): Narrow { match x { Sat(n) => n } }
  fn hi(): Narrow {
    let thirty = (none + none + none) * (none + none + none + none + none + none + none + none + none + none);
    let half = none << thirty;
    half - none + half
  }
  fn lo(): Narrow { -hi() - none }

  fn sat_add(a: Narrow, b: Narrow): Sat {
    let r = a + b;
    if b > nzero { if r < a { return Sat(hi()); } }
    if b < nzero { if r > a { return Sat(lo()); } }
    Sat(r)
  }
  fn sat_sub(a: Narrow, b: Narrow): Sat {
    let r = a - b;
    if b < nzero { if r < a { return Sat(hi()); } }
    if b > nzero { if r > a { return Sat(lo()); } }
    Sat(r)
  }
  fn sat_mul(a: Narrow, b: Narrow): Sat {
    if a == nzero { return Sat(nzero); }
    let r = a * b;
    if r / a != b {
      if a < nzero { if b < nzero { return Sat(hi()); } return Sat(lo()); }
      if b < nzero { return Sat(lo()); }
      return Sat(hi());
    }
    Sat(r)
  }
}

functor SaturatingInt: Int, zero, one, IntOps, Sizes -> Int, zero, one, IntOps, Int.size, Size.int {
  bind Narrow = Int;
  bind nzero = zero;
  bind none = one;
  bind Int = Sat;
  bind zero = Sat(nzero);
  bind one = Sat(none);
  bind Int.add = (r) => sat_add(nar(this), nar(r));
  bind Int.sub = (r) => sat_sub(nar(this), nar(r));
  bind Int.mul = (r) => sat_mul(nar(this), nar(r));
  bind Int.div = (r) => Sat(nar(this) / nar(r));
  bind Int.rem = (r) => Sat(nar(this) % nar(r));
  bind Int.neg = () => sat_sub(nzero, nar(this));
  bind Int.and = (r) => Sat(nar(this) & nar(r));
  bind Int.or = (r) => Sat(nar(this) | nar(r));
  bind Int.xor = (r) => Sat(nar(this) ^ nar(r));
  bind Int.shl = (r) => Sat(nar(this) << nar(r));
  bind Int.shr = (r) => Sat(nar(this) >> nar(r));
  bind Int.eq = (r) => nar(this) == nar(r);
  bind Int.ne = (r) => nar(this) != nar(r);
  bind Int.lt = (r) => nar(this) < nar(r);
  bind Int.gt = (r) => nar(this) > nar(r);
  bind Int.le = (r) => nar(this) <= nar(r);
  bind Int.ge = (r) => nar(this) >= nar(r);
  # `Size` is not rebound: it stays the generation it was (D72). Only
  # the conversions that mention `Int` follow it.
  bind Int.size = () => nar(this).size();
  bind Size.int = () => Sat(this.int());
}

# All of `Std` that mentions `Int`, at the saturating `Int`: what a
# library over `Std` alone must provide for code under all of `Std` to
# run in its block. Every one of these is a provision at a receiver the
# library did not rebind (`Char`, `Float`, `String`, `IntList`, ...),
# rebound with the new `Int` in its signature, by converting at the edge.
functor Saturating: Std -> Int, zero, one, IntOps, Int.size, Size.int,
  float, Float.trunc, Float.round, Char.code, Int.char,
  String.length[Index=Int], String.get[Elem=Char, Index=Int], String.slice, string_begin, string_write1, string_write2, string_write3, string_write4, string_finish, arg_count, arg_at,
  StrList.get[Elem=String, Index=Int], StrList.length[Index=Int],
  str_list, cell_int, CellInt.read[Elem=Int], CellInt.write,
  IntList.push[Elem=Int], IntList.get[Elem=Int, Index=Int], IntList.set[Elem=Int, Index=Int], IntList.length[Index=Int] {
  bind SaturatingInt;
  bind float = (n) => float(nar(n));
  bind Float.trunc = () => Sat(this.trunc());
  bind Float.round = () => Sat(this.round());
  bind Char.code = () => Sat(this.code());
  bind Int.char = () => nar(this).char();
  bind String.length[Index=Int] = () => Sat(this.length());
  bind String.get[Elem=Char, Index=Int] = (i) => this.get(nar(i));
  bind String.slice = (a, n) => this.slice(nar(a), nar(n));
  bind string_begin = (n) => string_begin(nar(n));
  bind string_write1 = (b, i, v) => string_write1(b, nar(i), v);
  bind string_write2 = (b, i, a, c) => string_write2(b, nar(i), a, c);
  bind string_write3 = (b, i, prefix, last) => string_write3(b, nar(i), prefix, last);
  bind string_write4 = (b, i, prefix, third, last) => string_write4(b, nar(i), prefix, third, last);
  bind string_finish = (b) => string_finish(b);
  bind arg_count = () => Sat(arg_count());
  bind arg_at = (i) => arg_at(nar(i));
  bind StrList.get[Elem=String, Index=Int] = (i) => this.get(nar(i));
  bind StrList.length[Index=Int] = () => Sat(this.length());
  bind str_list = () => str_list();
  bind cell_int = () => cell_int();
  bind CellInt.read[Elem=Int] = () => Sat(this.read());
  bind CellInt.write = (v) => this.write(nar(v));
  bind IntList.push[Elem=Int] = (v) => this.push(nar(v));
  bind IntList.get[Elem=Int, Index=Int] = (i) => Sat(this.get(nar(i)));
  bind IntList.set[Elem=Int, Index=Int] = (i, v) => this.set(nar(i), nar(v));
  bind IntList.length[Index=Int] = () => Sat(this.length());
}
