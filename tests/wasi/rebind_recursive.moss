import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# A recursive function that rebinds one of its own fn needs on its own
# recursive path. Compiled under `Loud`, `count`'s body binds `Loud`
# again, so every specialization would demand another if it were keyed by
# everything in scope: the provision bound here captures the one it
# shadows, which nothing it calls can reach. Keyed by what the provider
# and the callee reach, the second `bind Loud` makes the same
# specialization as the first, and there are two in all. `count` returns
# a `Float` and calls itself before its body is compiled, which the
# bootstrap back end has to learn rather than assume an i32. Output:
# `2`, `1`, `0`, `11`.

assume Std {
  fn note(n: Int);

  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn print_line(n: Int) {
    print_int(n);
    putchar(char::newline);
  }
}

functor Loud: Std -> note {
  bind note = (n) => print_line(n);
}

assume Std, note {
  fn count(n: Int): Float {
    if n == 0 {
      note(n);
      return 0.5;
    }
    note(n);
    if n == 3 {
      bind Loud;
      count(n - 1) + 1.0
    } else {
      count(n - 1) + 1.0
    }
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind note = (n) => {};
    print_line((count(5) * 2.0).round());
  }
}
