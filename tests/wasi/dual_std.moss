import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;
import "../../lib/float.moss" use Floats;
import "../../lib/access.moss" use Elem, .get, .set, .length;
import "../../lib/array.moss" use .arrayed;

# Differentiating code written the ordinary way. `f` assumes all of `Std`
# and uses what numeric code uses — an array it makes itself, literals,
# a comparison, `.sqrt` — with nothing in it written for being
# differentiated. `Dualize` provides all of `Floats` at duals over the
# `Float` in force: every item of `Std` that mentions `Float`, so a
# function that assumes `Std` can be called under it, and under it twice.
# Output, times a million: f(2), f'(2), f''(2), for
# f(x) = sqrt(x + x^2 + x^3).

assume Std {
  fn f(x: Float): Float {
    let powers = x.arrayed(3.size());
    powers.set(1.size(), x * x);
    powers.set(2.size(), x * x * x);
    var total = 0.0;
    for p in powers {
      total = total + p;
    }
    if total < 0.0 { 0.0 } else { total.sqrt() }
  }
}

# What duals are made of: the `Float` in force where `Dualize` is applied.
type Scalar;

assume Int, Scalar {
  fn lift(n: Int): Scalar;

  context BaseOps =
    Scalar, lift,
    Scalar.add, Scalar.sub, Scalar.mul, Scalar.div, Scalar.neg, Scalar.sqrt, Scalar.abs,
    Scalar.eq, Scalar.ne, Scalar.lt, Scalar.gt, Scalar.le, Scalar.ge, Scalar.trunc, Scalar.round,
  ;
}

assume Int, zero, one, BaseOps {
  tag Dual { v: Scalar, d: Scalar };

  fn constant(n: Int): Dual { Dual { v = lift(n), d = lift(zero) } }
  fn variable(x: Scalar): Dual { Dual { v = x, d = lift(one) } }
}

# All of `Floats` at duals: arithmetic by the usual rules, comparisons and
# rounding by the value alone. Arrays of duals need no line here: they
# are `Std`'s `Arrays` at `Item=Dual`, on demand (D84 rule 7).
functor Dualize: Std -> Floats {
  bind Scalar = Float;
  bind lift = float;
  bind Float = Dual;
  bind float = constant;
  bind Float.add = (r) => Dual { v = this.v + r.v, d = this.d + r.d };
  bind Float.sub = (r) => Dual { v = this.v - r.v, d = this.d - r.d };
  bind Float.mul = (r) => Dual { v = this.v * r.v, d = this.d * r.v + this.v * r.d };
  bind Float.div = (r) => Dual { v = this.v / r.v, d = (this.d * r.v - this.v * r.d) / (r.v * r.v) };
  bind Float.neg = () => Dual { v = -this.v, d = -this.d };
  bind Float.sqrt = () => {
    let s = this.v.sqrt();
    Dual { v = s, d = this.d / (s + s) }
  };
  bind Float.abs = () => if this.v < lift(zero) { Dual { v = -this.v, d = -this.d } } else { this };
  bind Float.eq = (r) => this.v == r.v;
  bind Float.ne = (r) => this.v != r.v;
  bind Float.lt = (r) => this.v < r.v;
  bind Float.gt = (r) => this.v > r.v;
  bind Float.le = (r) => this.v <= r.v;
  bind Float.ge = (r) => this.v >= r.v;
  bind Float.trunc = () => this.v.trunc();
  bind Float.round = () => this.v.round();
}

assume Std {
  fn print_int(n: Int) {
    if n < 0 {
      putchar(char::hyphen);
      print_int(-n);
      return;
    }
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn show(x: Float) {
    print_int((x * 1000000.0).round());
    putchar(char::newline);
  }

  fn derivatives(x: Float) {
    show(f(x));
    show({
      bind Dualize;
      f(variable(x)).d
    });
    show({
      bind Dualize;
      let x1 = variable(x);
      {
        bind Dualize;
        f(variable(x1)).d.d
      }
    });
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    derivatives(2.0);
  }
}
