# Moved from bootstrap/examples/assume-method-after-type.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# Control for tests/errors/assume_method_before_type.moss (AUDIT-CHANGES #59): T is listed
# before T.m, and g calls x.m().
# Audit before and now: accepts (argued).
# Oracle (moss_m2): accepts. Native (ob-family moss, seed 1h1710x0): accepts.
type T;
fn .m(): This;
assume T, T.m { fn g(x: T): T { x.m() } }
fn main() {}
