import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;

# D84 rule 7 (strengthened): `F[A, B]: -> A.m, B.m` and a call at
# A = B: two items of one family share an instance of their key.
# Expected: refused at the call (ambiguity).
type A;
type B;
assume Std { fn .m(): Int; }
functor F[A, B]: Std -> A.m, B.m;
functor G: Std, A, B -> A.m, B.m { bind A.m = () => 1; bind B.m = () => 2; }

assume Std, F {
  fn use_it() { let x = one.m(); putchar((x + char::digit0.code()).char()); }
}

assume Wasm, Gc, WasiCore, Branch {
  fn main() { bind WasiStd; bind F = G; use_it(); putchar(char::newline); }
}
