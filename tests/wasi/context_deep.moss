context C60 = C59;
context C61 = C60;
context C62 = C61;
context C63 = C62;
context C64 = C63;
context C65 = C64;
context C66 = C65;
context C67 = C66;
context C68 = C67;
context C69 = C68;

assume C69 {
  tag Box[T](T);
  fn open(b: Box): T { match b { Box(x) => x, } }
}

assume Wasm, Wasi {
  fn main() {
    bind T = I32;
    proc_exit(open(Box(w::i32_add(w::i32_one, w::i32_one))));
  }
}
