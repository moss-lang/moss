import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi, proc_exit;

# Contexts nest to any depth (Audit note 30): `T` is seventy contexts down,
# both for what `Box` and `open` require and for the context `open`'s body
# is checked in. Exits 2.

type T;
context C0 = T;
context C1 = C0;
context C2 = C1;
context C3 = C2;
context C4 = C3;
context C5 = C4;
context C6 = C5;
context C7 = C6;
context C8 = C7;
context C9 = C8;
context C10 = C9;
context C11 = C10;
context C12 = C11;
context C13 = C12;
context C14 = C13;
context C15 = C14;
context C16 = C15;
context C17 = C16;
context C18 = C17;
context C19 = C18;
context C20 = C19;
context C21 = C20;
context C22 = C21;
context C23 = C22;
context C24 = C23;
context C25 = C24;
context C26 = C25;
context C27 = C26;
context C28 = C27;
context C29 = C28;
context C30 = C29;
context C31 = C30;
context C32 = C31;
context C33 = C32;
context C34 = C33;
