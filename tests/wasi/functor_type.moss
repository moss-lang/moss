import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# D78: an abstract functor's result may hold types, and a functor bound
# to it must provide exactly its result — the types included. `Pick`
# promises the type `Scalar` and `.twice` on it; `Twice` provides only
# `.twice`, leaving `Scalar` to whatever it already was, so it cannot be
# bound to `Pick`. Refused where the bind is written.

type Scalar;

assume Scalar {
  fn .twice(): Scalar;
}

functor Pick: Std -> Scalar, Scalar.twice;

functor Twice: Std -> Scalar.twice {
  bind Scalar.twice = () => this;
}

assume Std {
  fn demo() {
    bind Pick = Twice;
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
