import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi, fd_write;
import "../../lib/wasistd.moss" use Branch, i32_bool;

# A union two scalars wide: `Read` carries a Char-shaped payload and
# `Eof` is a unit, so a value is a discriminant beside room for the
# payload — the shape src/lex.moss's `peek()` returns.
type Read I32;
unit Eof;

assume Wasm, Wasi, Branch {
  fn two(): I32 { w::i32_add(w::i32_one, w::i32_one) }
  fn four(): I32 { w::i32_add(two(), two()) }
  fn eight(): I32 { w::i32_add(four(), four()) }
  fn six(): I32 { w::i32_add(four(), two()) }
  fn emit(c: I32) {
    w::i32_store(w::i32_zero, eight());
    w::i32_store(four(), w::i32_one);
    w::i32_store8(eight(), c);
    fd_write(w::i32_one, w::i32_zero, w::i32_one, w::i32_add(eight(), four()));
  }
  fn upper_a(): I32 { w::i32_add(w::i32_shl(w::i32_one, six()), w::i32_one) }
  fn newline(): I32 { w::i32_add(eight(), two()) }

  # Both branches inject into the union, and the function returns two
  # scalars.
  fn peek(n: I32): Read | Eof {
    if i32_bool(w::i32_ge_u(n, four())) {
      Eof
    } else {
      Read (n)
    }
  }

  fn show(r: Read | Eof): I32 {
    match r {
      Read c => w::i32_add(upper_a(), c),
      Eof => newline(),
    }
  }

  fn main() {
    var i = w::i32_zero;
    while i32_bool(w::i32_lt_u(i, w::i32_add(four(), w::i32_one))) {
      emit(show(peek(i)));
      i = w::i32_add(i, w::i32_one);
    }
  }
}
