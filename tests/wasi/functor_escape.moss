import "../../lib/float.moss" use Floats;
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, WasiFloats32;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

# D78: `bind Fast;` makes `Float` a fresh generation for the rest of its
# block, and no value of that type may leave the block — here as the
# block's result, kept in `r` past it. Refused in both compilers, which
# check it generically (here `Fast` is bound to f32 while `Float` outside
# the block is no f32, so the two also differ in the specialization; see
# functor_escape_same.moss for when they do not). `Fast` is fixed in
# `Int` (D84), which the binding captures in `main`.

functor Fast[]: Int -> Floats;

assume Std, Fast {
  fn leak(n: Int): Int {
    let r = {
      bind Fast;
      float(n)
    };
    n
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind Fast = WasiFloats32;
    leak(one);
  }
}
