# Moved from bootstrap/examples/copy-extra-key.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# H's result has two items on the leaf (Box, m), at T=Bool and at T=Char;
# F's has only the first. Both results have the same leaves (SameResult),
# and each key of F's result is one of H's with the same provision, which
# is what the oracle's copy_outputs_match and Audit's CopyOutputs check,
# so `bind F = H;` is accepted. `bind F;` keeps exactly F's result:
# native does, and prints 31.
# The oracle runs G's body and installs every key of H's result, so the
# extra key Box[T=Char].m overwrites demo's own binding, and it prints 21
# (E32, an oracle bug).
# Audit (callerkeys, scratch/orch/callerkeys2-AUDIT.md): an application
# installs exactly F's declared result, position by position under the
# caller's keys (Audit.result_selection); the copy records, for each of
# F's positions, H's position it reads (CopyOutputs, BCopyFunctor). So
# the extra key is never installed and Audit's run prints 31, as native.
# (results4 had made Audit reject this copy instead; that is reverted.)
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;

assume Std, T {
  tag Box(T);
  fn .m(): Int;
}
assume Std { val kk: Int; }

functor F[]: Std -> kk, Box.m[T=Bool];
functor H[]: Std -> kk, Box.m[T=Bool], Box.m[T=Char];
functor G: Std -> kk, Box.m[T=Bool], Box.m[T=Char] {
  bind kk = 5;
  bind Box.m[T=Bool] = () => 1;
  bind Box.m[T=Char] = () => 2;
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind H = G;
    bind F = H;
    bind Box.m[T=Char] = () => 3;
    bind F;
    let b = Box[T=Char](char::a);
    print_int(b.m());
    let c = Box[T=Bool](true);
    print_int(c.m());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
