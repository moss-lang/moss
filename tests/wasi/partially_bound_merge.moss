# From the copy that was bootstrap/examples/partially-bound-merge.moss (removed; its
# oracle verdicts are the old Rocq oracle's, historical):
# D43 merging is symmetric, so the order of an assume list does not
# matter. `B.w[Foo=X]` and `C.w[Foo=Y]` are assumed before the contexts
# that merge `B` with `C`; once they are merged the two are one key,
# `w` at the merged type, and merging its two bindings makes `X` and
# `Y` one type too, so `f` may return its `X` as a `Y`. Accepted by
# both compilers (the bootstrap used to key `B.w` and `C.w` apart when
# they came first, and rejected `f`). Prints `k`.
#
# Principal θ (AUDIT-CHANGES #50): demo binds X but not Y; X and Y are
# one merge class in f's context, so θ Y is read through X as Char, and
# the need `C.w[Foo=Y]` is wanted at Foo = Char, which demo provides.
# Audit: accepts. Native: prints `k`. Oracle: prints `k` since #60
# (principal_env reads Y through X); it rejected from 61040f2 to #60
# ("needs `Char.w` at another instantiation", D62).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# Principal θ (AUDIT-CHANGES #50), from bootstrap/examples: `f`'s context
# merges `X` with `Y` (through `B.w` and `C.w` once `B` and `C` are one),
# and `demo` binds `X` but not `Y`, so `f` reads `C.w`'s `Foo = Y` as the
# `Char` `X` means here, which `giveq` was provided at. The check that a
# provision has the callee's type (E25) reads the callee's types through
# that θ too. Prints `k`, as the oracle does since AUDIT-CHANGES #60 (E24).
type Foo;
type A;
type B;
type C;
type X;
type Y;

fn .gimme(): Foo;
fn .w(): Foo;

context Ctx1 = A, B, A.gimme[Foo=B];
context Ctx2 = A, C, A.gimme[Foo=C];
context K0 = B, C, X, Y, B.w[Foo=X], C.w[Foo=Y];

assume Std, K0, Ctx1, Ctx2 {
  fn f(x: X): X { x }
}

assume Std {
  fn giveq(): Char { char::q }

  fn demo() {
    bind Foo = Char;
    bind A = Char;
    bind B = Char;
    bind C = Char;
    bind X = Char;
    bind A.gimme = giveq;
    bind C.w = giveq;
    putchar(f(char::k));
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
