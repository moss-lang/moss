import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi;

# D43, Audit.v note 59: a type merged with `|` is `|`. `B` is merged with
# `N = |`, so a statement `x;` of type `B` cannot fall through, and the
# block it ends needs no tail. Prints `ok`.

type Foo;
type A;
type B;
type N = |;

fn .gimme(): Foo;

context Ctx1 = A, B, A.gimme[Foo=B];
context Ctx2 = A, A.gimme[Foo=N];

assume Std, Wasm, Ctx1, Ctx2 {
  fn absurd(x: B): I32 { x; }
  fn absurd_unit(x: B) { if true { x; } }
}

assume Std {
  fn demo() {
    putchar(char::o);
    putchar(char::k);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
