# Moved from bootstrap/examples/wrapped-main-root.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# A fn in scope as `main` runs in the root context, with `Gc`; this one
# uses `Heap`. tests/wasi/wrapped_main.moss calls it directly and as a wrapped
# method provider. Expected: 2, twice.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, Boxed, Ref, Heap, .boxed;
import "../../lib/wasip1.moss" use Wasi;

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Boxed = Int;
    bind Heap;
    let r = (42).boxed();
    putchar((r.deref() % 10 + char::digit0.code()).char());
    putchar(char::newline);
  }
}
