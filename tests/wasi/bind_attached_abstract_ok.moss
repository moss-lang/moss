# Moved from bootstrap/examples/bind-attached-abstract-ok.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# Q3 control (AUDIT-CHANGES #70). An *abstract* attached method,
# `fn Meter.describe();`, is a key the context provides (D36,
# MCAttachedAbstract): binding it is how it gets a meaning, so it stays
# legal. Verdicts: Audit accepts; oracle prints x; native prints x.
tag Meter(Int);

assume Std {
  fn Meter.describe();
}

assume Std, Meter.describe {
  fn show(d: Meter) { d.describe(); }
}

assume ReferenceBase {
  fn main() {
    bind StdBase;
    bind Meter.describe = () => putchar(char::x);
    show(Meter(3));
    putchar(char::newline);
  }
}
