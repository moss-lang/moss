import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, Boxed, Ref;
import "../../lib/wasip1.moss" use Wasi;

# D71: `B` mentions only `A`, and `A` mentions `T`, so `T` is a relevant
# parameter of both and `B[T=Int]` is a legal application — even when
# `A` is the one computed first, as here, which is the order an
# in-progress shortcut got wrong (it gave `B` no parameters, so binding
# `T` on it would be an irrelevant application). `A` holds `B` through a
# `Ref` (whose brackets the relevance closure reads too): a tag that
# contains itself unboxed has no layout and is rejected even when nothing
# builds it (D58, AUDIT-CHANGES #90), so the cycle may not be unboxed.

type T;
type U;
type V;

assume T, Wasm {
  tag A { b: Ref[Boxed=B], t: T };
  tag B { a: A };
}

assume Std, Wasm {
  fn demo() {
    bind U = A[T=Int];
    bind V = B[T=Int];
    putchar(char::y);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
