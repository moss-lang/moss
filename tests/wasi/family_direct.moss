import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;
import "../../lib/array.moss" use Item, Array, .arrayed;
import "../../lib/access.moss" use Elem, Index, .get;

# D84 rule 7 (O3 a): a member of a family in force is not bound directly.
# Expected: refused at the bind of `Array.get`.
assume Wasm, Gc, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind Array.get[Item=Int, Elem=Int, Index=Size] = (i) => 7;
    let xs = 1.arrayed(3.size());
    putchar((xs.get(0.size()) + char::digit0.code()).char());
    putchar(char::newline);
  }
}
