import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;
import "../../lib/num.moss" use .add;

# D55: a functor must bind everything its result promises. `Over`
# promises `Scalar.add` but binds only `Scalar`, which leaves `Scalar.add` to
# resolve to `Int.add` through `Scalar = Int` — a provision nobody made.
# Rejected at the functor, in both compilers; the self-hosted one used to
# accept it and print 5.

type Scalar;

assume Scalar {
  context BaseAdd = Scalar, Scalar.add;
}

functor Over: Std -> BaseAdd {
  bind Scalar = Int;
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn demo() {
    bind Over;
    print_int(2 + 3);
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
