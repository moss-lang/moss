# Moved from bootstrap/examples/args-context-provision-wins.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# Q4 (AUDIT-CHANGES #72): every call checks its arguments in the caller's
# context Γ, never with the families the call demands in force (Γ ⊕ D).
# `f` and `Meter.g` both need the detached `.describe` at Meter (through
# Q), which only the family `Desc` supplies, on demand. The argument
# `d.describe()` resolves by D77: the provision of the detached
# `.describe` wins over the attached method where the context provides
# it, and a family that would supply it on demand does not count. Checked
# in Γ, as `let a = d.describe(); f(a)` would be, it is the attached
# method (m), for the fn call as for the attached method call.
# Verdicts: Audit mm; oracle mm; native xx (a native bug, E72: it checks
# a fn call's and a defined attached call's arguments in Γ ⊕ D).
#   Before #72: Audit and oracle xm (ExCallD read the arguments in Γ ⊕ D,
#   MCAttachedDefined in Γ).
tag Meter(Int);
type Q;
fn .describe(): Char;

assume Std, Q, Q.describe {
  fn f(c: Char) { putchar(c); }
  fn Meter.g(c: Char) { putchar(c); }
}

assume Std {
  fn Meter.describe(): Char { char::m }
}

functor Desc[Q]: Std, Q -> Q.describe;
functor ByX: Std, Q -> Q.describe {
  bind Q.describe = () => char::x;
}

assume Base {
  fn main() {
    bind StdBase;
    bind Desc = ByX;
    bind Q = Meter;
    let d = Meter(3);
    f(d.describe());
    d.g(d.describe());
    putchar(char::newline);
  }
}
