import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, WasiContainers, Numerics, Containers,
  heap_mark, heap_reset, ints_addr, Num, i32_bool, raw;
import "../../lib/wasm.moss" as w use Wasm, Memory;
import "../../lib/wasip1.moss" use WasiCore;

# D79: an arena. `Scratch` is a memory of its own, so resetting its
# allocator drops everything made there at once and leaves the main
# memory's data alone. The first list made in `Scratch` is at the start
# of its heap, address 1024, though the main memory has already allocated
# there; after the reset the next list reuses the same address and
# overwrites the dropped one, and the main list still sums as before.

tag Scratch;

tag Report { first: Int, second: Int, at: Int, reused: Bool, pages: Int };

assume Std {
  fn print_int(n: Int) {
    if n >= 10 {
      print_int(n / 10);
    }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn line(n: Int) {
    print_int(n);
    putchar(char::newline);
  }
}

assume Char, Numerics, Containers {
  fn fill(xs: IntList, from: Int, count: Int) {
    var i = 0;
    while i < count {
      xs.push(from + i);
      i = i + 1;
    }
  }

  fn sum(xs: IntList): Int {
    var total = 0;
    var i = 0;
    while i < xs.length() {
      total = total + xs.get(i);
      i = i + 1;
    }
    total
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    let xs = int_list();
    fill(xs, 1, 100);
    let report = {
      bind Memory = Scratch;
      bind WasiContainers;
      let start = heap_mark();
      let ys = int_list();
      fill(ys, 1000, 50);
      let first = sum(ys);
      let at = ints_addr(ys);
      heap_reset(start);
      let zs = int_list();
      fill(zs, 1, 10);
      # Grow Scratch alone, then store and load just past its old end.
      let old_pages = w::memory_grow(w::i32_one);
      let extra = w::i32_mul(old_pages, raw(65536));
      w::i32_store(extra, w::i32_one);
      Report {
        first = first,
        second = sum(zs),
        at = Num(at),
        reused = i32_bool(w::i32_eq(at, ints_addr(zs))),
        pages = Num(w::i32_add(w::memory_size(), w::i32_load(extra))),
      }
    };
    line(report.first);
    line(report.second);
    line(report.at);
    if report.reused { line(1); } else { line(0); }
    line(sum(xs));
    line(report.pages);
    line(Num(w::memory_size()));
  }
}
