import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# The coherence premise on val and fn requirements (CoreMoss.v deviation
# 8): `seed` and `make` are provided while T = Char, then T is rebound
# [D25] and generic functions that require them are called at T = Int.
# Both compilers reject it.

type T;

assume Std, T {
  val seed: T;
  fn make(): T;
}

assume Std, T, seed {
  fn get_seed(): T { seed }
}
assume Std, T, make {
  fn get_made(): T { make() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn mk(): Char { char::b }
  fn demo() {
    bind T = Char;
    bind seed = char::a;
    bind make = mk;
    bind T = Int;
    let n: Int = get_seed();
    print_int(n);
    putchar(char::newline);
    let k: Int = get_made();
    print_int(k);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
