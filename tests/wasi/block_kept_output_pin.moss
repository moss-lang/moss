# Moved from bootstrap/examples/block-kept-output-pin.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# consol: ACCEPTED by Audit, as by both implementations. A block nested in
# a linked body applies an abstract functor whose output is a pin of F.
# M(F) = {T}: F's result lists `tick`, a defined fn under `assume T`, so T
# is a requirement of a result item (RMValFn). G does not take T, and
# `tick` is not a leaf (it is already provided), so G never needs T. G's
# `bind seven = { bind Make; 7 };` keeps Make's output T inside the block:
# T is not in force there, and nothing in the context mentions it. The
# block's write of T is local to the block, and its value (an Int) does
# not mention T, so no result of G, and no key the caller files, reads T
# at the body's meaning. LinkBody's made clause concerns only the body's
# own binds (the block's `made` stays in the block, BlkECheck).
# Before consol, BApplyAbstract's kept-output case also required
# `~ In t (fr_pins F)` (realize2), which rejected this program.
# Oracle (moss_m2 at ob-consol): prints 7, exit 0.
# Native (moss-safety target/release/moss, MOSS_SEED
#   /nix/store/1h1710x0...-mossc.wasm): prints 7, exit 0.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type T;
fn .num(): Int;
val seven: Int;
assume T {
  fn tick() {}
}
functor Make: Std -> T, T.num;
functor Maker: Std -> T, T.num {
  bind T = Char;
  bind T.num = () => this.code();
}
functor F: Std -> tick, seven;
functor G: Make, Std -> tick, seven {
  bind seven = { bind Make; 7 };
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std {
  fn demo() {
    bind T = Bool;
    bind Make = Maker;
    bind F = G;
    bind F;
    print_int(seven);
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
