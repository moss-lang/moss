import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, Boxed, Ref, Heap, .boxed;
import "../../lib/wasip1.moss" use Wasi;

# D78: allocation strategy as one bind. An allocator stores a `Boxed` and
# hands back a `Handle` to load it from; what a handle *is* is the
# allocator's business, so `Handle` is a type in the abstract `Alloc`'s
# result. The library below applies `Alloc` once per type it stores —
# each application makes a fresh generation of `Handle` (D72), which it is
# checked against once, knowing nothing of what it is — and `main` binds
# `Alloc` in one block to `Gc`, whose handles are references into the GC
# heap (`Heap`), and in another to `Pool`, whose handles are indices into
# a list of packed values. Neither needs all of `Alloc`'s inputs: `Gc`
# does not pack, and `Pool` does not need `Wasm`. No handle leaves the
# block that made its type. Output: the same three lines from each block.
#
# `alloc` is a plain fn, so the library's second application replaces
# the first one's (the library allocates each type in turn), while
# `.load` is keyed by its receiver, so both stay. The pool's providers
# are named functions (functor_same_handle.moss has anonymous ones). Both
# types are one scalar wide, since the bootstrap's back end compiles
# `pool_alloc` once.

type Handle;

assume Std, Boxed {
  # How a pool stores a value: as one `Int`, and back.
  fn .pack(): Int;
  fn unpack(n: Int): Boxed;
}

assume Boxed, Handle {
  fn alloc(value: Boxed): Handle;
  fn .load(): Boxed;        # detached: provided at receiver `Handle`
}

functor Alloc: Std, Wasm, Boxed, Boxed.pack, unpack -> Handle, alloc, Handle.load;

# Handles into the GC heap: a `Ref` to what is stored.
functor Gc: Wasm, Boxed -> Handle, alloc, Handle.load {
  bind Handle = Ref;
  bind Heap;
  bind alloc = (value) => value.boxed();
  bind Handle.load = () => this.deref();
}

# Handles into a pool: an index into a list of packed values, one list
# per application. A slot lists what it holds (D73), so slots for two
# types are two types.
assume Std, Boxed {
  type Slot[Boxed] Int;
  val slots: IntList;

  assume Boxed.pack, unpack, slots {
    fn pool_alloc(value: Boxed): Slot {
      let i = slots.length();
      slots.push(value.pack());
      Slot (i)
    }

    fn Slot.fetch(): Boxed { match this { Slot i => unpack(slots.get(i)) } }
  }
}

functor Pool: Std, Boxed, Boxed.pack, unpack -> Handle, alloc, Handle.load {
  bind Handle = Slot;
  bind slots = int_list();
  bind alloc = pool_alloc;
  bind Handle.load = Slot.fetch;
}

# The library: two types, each stored through the allocator.
assume Std {
  type Celsius Int;
  type Mile Int;

  fn print_int(n: Int) {
    if n >= 10 {
      print_int(n / 10);
    }
    putchar((n % 10 + char::digit0.code()).char());
  }

  fn line(n: Int) {
    print_int(n);
    putchar(char::newline);
  }
}

assume Std, Wasm, Alloc {
  fn library() {
    bind Boxed = Celsius;
    bind Boxed.pack = () => match this { Celsius c => c };
    bind unpack = (n) => Celsius (n);
    bind Alloc;
    let warm = alloc(Celsius (21));
    let cold = alloc(Celsius (4));
    bind Boxed = Mile;
    bind Boxed.pack = () => match this { Mile m => m * 2 };
    bind unpack = (n) => Mile (n / 2);
    bind Alloc;
    let trip = alloc(Mile (14));
    match warm.load() {
      Celsius c => line(c),
    }
    match cold.load() {
      Celsius c => line(c),
    }
    match trip.load() {
      Mile m => line(m),
    }
  }
}

assume Std, Wasm {
  fn demo() {
    {
      bind Alloc = Gc;
      library();
    }
    {
      bind Alloc = Pool;
      library();
    }
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
