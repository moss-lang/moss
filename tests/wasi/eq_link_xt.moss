# D90: eq_link_tx.moss with the equation written `X = T`. The two
# spellings give one merge class (PublicEquation.eq_swap_classes), and
# the self-hosted compiler accepts both and exits 0. The oracle merges
# toward the right side, so here `T` represents the class; its pins then
# include `T`, and it rejects G's `bind T = Bool;` (D84 3d), as it rejects
# link-merge-rep-rebind-both.moss in the same orientation. A known oracle
# gap (agreement.rs), not a difference in meaning.
type T;
type X;
tag Concrete;
fn .m();
context Merge = X, T, X = T;
functor F[X]: Merge -> X.m;
functor G: Merge -> X.m { bind T = Bool; bind X.m = () => { }; bind T.m = () => { if this { } }; }
fn main() {
  bind T = Concrete;
  bind F = G;
  Concrete.m();
}
