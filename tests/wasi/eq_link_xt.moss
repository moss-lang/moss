# D90: eq_link_tx.moss with the equation written `X = T`. The two
# spellings give one merge class (PublicEquation.eq_swap_classes), and
# the self-hosted compiler and moss-ref accept both and exit 0. (The old
# oracle merged toward the right side, so here `T` represented the class,
# its pins included `T`, and it rejected G's `bind T = Bool;` (D84 3d): an
# orientation gap, not a difference in meaning. moss-ref's elaborator does
# not depend on the merge's orientation.)
type T;
type X;
tag Concrete;
fn .m();
context Merge = X, T, X = T;
functor F[X]: Merge -> X.m;
functor G: Merge -> X.m { bind T = Bool; bind X.m = () => { }; bind T.m = () => { if this { } }; }
fn main() {
  bind T = Concrete;
  bind F = G;
  Concrete.m();
}
