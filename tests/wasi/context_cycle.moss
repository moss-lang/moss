import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi, proc_exit;

# Two contexts that name each other: the types an assume nesting requires
# are found through contexts to any depth, each context entered once, so a
# cycle requires the union of its contexts' types (Audit note 30). `Box`
# lists `T`, which only the cycle reaches. Exits 2.
type T;
context A = T, B;
context B = A;

assume A {
  tag Box[T](T);
}

assume Wasm, Wasi {
  fn main() {
    let b = Box[T=I32](w::i32_add(w::i32_one, w::i32_one));
    match b { Box(x) => proc_exit(x), }
  }
}
