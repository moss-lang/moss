# Moved from bootstrap/examples/link-output-input-rebind-control.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# realize3 control for tests/errors/link_output_input_rep.moss: ACCEPTED by the oracle and
# native. An input T of F that is also an output, which the linked body G
# rebinds (`bind T = Char`), with no merge. Audit accepts it too: F's key
# T.m has the output role as its receiver, which link_site reads at the body's
# final table (Char.m, which G binds).
# Oracle (ob-sigclose var moss_m2): prints 7. Native (ob-family, seed
# 1h1710x0): prints 7.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;
fn .m();
functor F: T, Std -> T, T.m;
functor G: T, Std -> T, T.m {
  bind T = Char;
  bind T.m = () => { putchar(this); };
}

assume Std {
  fn demo() {
    bind T = Bool;
    bind F = G;
    bind F;
    putchar((7 + char::digit0.code()).char());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
