# Base supplies X and Y through I32. A box made at one member of the
# merge class must dereference at the other.
import "../../lib/wasm.moss" as w use Wasm, Gc, Boxed, .boxed;
type X;
type Y;
assume Wasm, X { tag Phantom[X](w::I32); }
assume Wasm, Gc, X = Y, Y = w::I32 {
  fn main() {
    bind Boxed = Phantom[X=X];
    bind w::Heap;
    let box = Phantom[X=X](w::i32_one).boxed();
    let raw = match box { w::Ref(raw) => raw };
    bind Boxed = Phantom[X=Y];
    bind w::Heap;
    let got = w::StructCast(raw).cast();
    match got.deref() { Phantom(payload) => () };
  }
}
