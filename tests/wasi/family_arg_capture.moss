import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;
import "../../lib/array.moss" use Item, Array, ArrayHandle, Arrays, .arrayed;
import "../../lib/access.moss" use .get, .set;
import "../../lib/size.moss" use Size, Sizes, .size;
import "../../lib/float.moss" use Floats;

# D84 rule 7: a call of a family member on demand is checked as if
# preceded by `bind Arrays;` at the instantiation its receiver names, here
# `Item = Box` with `Box` itself over the caller's `Item`. That application
# is a scope around the provision only: the call's arguments are the
# caller's, so `Box(y)` below is a `Box` over the caller's `Item`, not over
# the `Item` the application binds (which would make it a `Box` of
# `Box`es). Expected: the second element, then the first.
assume Item {
  tag Box(Item);
}

assume Int, zero, one, Size, Sizes, ArrayHandle, Item, Arrays {
  fn boxes(x: Item, y: Item, n: Size): Array[Item=Box] {
    let a = Box(x).arrayed(n);
    a.set(zero.size(), Box(y));
    a
  }
}

assume Std {
  fn digit(n: Int) { putchar((n + char::digit0.code()).char()); }

  fn go() {
    bind Item = Float;
    let a = boxes(3.0, 7.0, 2.size());
    match a.get(0.size()) { Box(v) => digit(v.round()) }
    match a.get(1.size()) { Box(v) => digit(v.round()) }
    putchar(char::newline);
  }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() { bind WasiStd; go(); }
}
