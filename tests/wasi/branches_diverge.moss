import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi, fd_write;
import "../../lib/wasistd.moss" use Branch, i32_bool;

# A branch whose value diverges (D15's `|`) agrees with any other, with
# or without an expected type: a `return` or a `break` as the value of an
# `if` branch or a `match` arm, or a call of a function that returns `|`.
# A branch block that ends in a diverging *statement* still yields `()`,
# as any block without a tail does. Both compilers.

unit Red;
unit Green;
type Colour = | Red | Green;
type Never = |;

assume Wasm, Wasi, Branch {
  fn two(): I32 { w::i32_add(w::i32_one, w::i32_one) }
  fn four(): I32 { w::i32_add(two(), two()) }
  fn eight(): I32 { w::i32_add(four(), four()) }

  fn emit(c: I32) {
    w::i32_store(w::i32_zero, eight());
    w::i32_store(four(), w::i32_one);
    w::i32_store8(eight(), c);
    fd_write(w::i32_one, w::i32_zero, w::i32_one, w::i32_add(eight(), four()));
  }

  fn letter(n: I32) {
    emit(w::i32_add(w::i32_add(w::i32_shl(w::i32_one, w::i32_add(four(), two())), w::i32_one), n));
  }

  fn stop(): Never {
    loop {}
  }

  fn flip(c: Colour): Colour {
    match c {
      Red => Green,
      Green => Red,
    }
  }

  # Nothing expected: the `if` and the `match` take the other branch's
  # type.
  fn bare(c: Colour) {
    let x = if i32_bool(w::i32_zero) { return } else { w::i32_one };
    let y = match c {
      Red => return,
      Green => two(),
    };
    letter(w::i32_add(x, y));
  }

  # Expected by the signature: a diverging branch beside one of the
  # declared type, whether it diverges by its tail or by its last
  # statement.
  fn tail(c: Colour): I32 {
    if i32_bool(w::i32_zero) {
      return w::i32_zero
    } else {
      match c {
        Red => { return four(); },
        Green => four(),
      }
    }
  }

  # A diverging call, in an arm no run takes.
  fn never(c: Colour): I32 {
    match flip(c) {
      Red => stop(),
      Green => eight(),
    }
  }

  fn main() {
    bare(Red);
    bare(Green);
    letter(tail(Red));
    letter(tail(Green));
    letter(never(Red));
    var i = w::i32_zero;
    loop {
      let n = if i32_bool(w::i32_eq(i, two())) { break } else { i };
      letter(n);
      i = w::i32_add(i, w::i32_one);
    }
    emit(w::i32_add(eight(), two()));
  }
}
