# Moved from bootstrap/examples/platform-family-keys.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, Boxed, Ref, Heap, .boxed;
import "../../lib/wasip1.moss" use WasiCore;

# Audit's `Platform.Family` filed a platform family's primitives, and its
# result, under the result's static keys (`mkey`, no instantiation), but
# a caller reads a method provision under its run-time key (`rkey`),
# which carries the instantiation its item was made at. `Ref.deref`
# mentions `Boxed`, one of its requirements, so after `bind Heap;` the
# context's `Ref.deref` is keyed at `[Boxed=Int]`, and the call
# `r.deref()` looks for that key. The model's result held only the bare
# key, so the call was stuck (`e_entry`) and the application did not
# realize its result context (PlatformApplyOk was false). The oracle and
# the native compiler file the platform's items under their instantiated
# keys (Elab.v `platform_fun`, `key_item_at`), and run this program,
# printing nothing and exiting 0; `Platform.Family` now does the same
# (`rkey_of outputs`).

assume Std, Wasm, Heap {
  fn demo(): Int {
    bind Boxed = Int;
    bind Heap;
    let r = 42.boxed();
    r.deref()
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
