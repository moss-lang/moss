import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;

# As result_collide_ab.moss, with `G`'s binds in the other order: the
# oracle and the self-hosted compiler both printed `a` here, each by its
# own convention (the first result position; the last bind). Refused.

type A;
type B;
assume A { fn .m(); }
functor F: Std, A, B -> A.m, B.m;
assume Std {
  functor G: Std, A, B -> A.m, B.m {
    bind B.m = () => putchar(char::b);
    bind A.m = () => putchar(char::a);
  }
}

assume Std, F {
  fn use_it() { bind A = Int; bind B = Int; bind F; one.m(); }
}

assume Wasm, Gc, WasiCore, Branch {
  fn main() { bind WasiStd; bind F = G; use_it(); putchar(char::newline); }
}
