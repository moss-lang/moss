import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" as w use Wasm, Boxed, Ref, Heap, .boxed;
import "../../lib/wasip1.moss" use WasiCore;

# The Base cast recovers the precise GC type from an erased StructRef.
# Recovering Point succeeds. Asking for Int traps before any access.
# Output: 3, 4, then a trap.

assume Std, Wasm {
  tag Point { x: Int, y: Int };

  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind Boxed = Point;
    bind Heap;
    bind Boxed = Int;
    bind Heap;
    let pt = Point { x = 3, y = 4 };
    let p = pt.boxed();
    let s = match p { Ref(s) => s };
    bind Boxed = Point;
    let q = w::StructCast(s).cast();
    print_int(q.deref().x);
    putchar(char::newline);
    print_int(q.deref().y);
    putchar(char::newline);
    bind Boxed = Int;
    let n = w::StructCast(s).cast();
    print_int(n.deref());
    putchar(char::newline);
  }
}
