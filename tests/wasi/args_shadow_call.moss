# Q4 (AUDIT-CHANGES #72), from tests/wasi/args_context_shadow_call.moss:
# `call_n` needs `A.n` at Int, which the family F supplies on demand; the
# application also installs F's `Int.m`, read with U = Bool, but demo
# provides `Int.m` itself with U = Int. A call's arguments are checked in
# the caller's context, so `k.m()` is demo's `Int.m` and the program
# prints 42. The self-hosted compiler used to check them with the demand
# in force and refuse the argument (E72).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;
type A;
type U;
val u0: U;
assume A {
  fn .m(): U;
  fn .n(x: A): A;
}
functor F[A]: U, u0 -> A.m, A.n;
functor G: A, U, u0 -> A.m, A.n {
  bind A.m = () => u0;
  bind A.n = (x) => x;
}
assume Std, A, A.n {
  fn call_n(x: Int) { print_int(x); }
}
assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Int;
    bind U = Int;
    bind Int.m = () => 42;
    bind U = Bool;
    bind u0 = true;
    bind F = G;
    let k: Int = 7;
    call_n(k.m());
    putchar(char::newline);
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; demo(); }
}
