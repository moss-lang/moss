import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# An assumed item is in force at the function's whole ambient
# instantiation, whatever its place in the assume list: `seed` comes
# before `T` below, and `b` still calls `a` — both assume `seed` at the
# same `T`. (Its type does not mention `T`, so D20 lets it come first.)

type T;

assume T {
  val seed: Char;
}

assume Std, seed, T {
  fn a(): Char { seed }
  fn b(): Char { a() }
}

assume Std {
  fn demo() {
    bind T = Int;
    bind seed = char::c;
    putchar(b());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
