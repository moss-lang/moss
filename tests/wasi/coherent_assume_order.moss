import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

# The preceding T instantiates seed even though its signature omits T.
# Both functions see the same provision, so b can call a.

type T;

assume T {
  val seed: Char;
}

assume Std, T, seed {
  fn a(): Char { seed }
  fn b(): Char { a() }
}

assume Std {
  fn demo() {
    bind T = Int;
    bind seed = char::c;
    putchar(b());
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
