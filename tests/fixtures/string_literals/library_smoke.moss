import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm;
import "../../../lib/wasip1.moss" use Wasi;

assume Std {
  fn sample(): String {
    let b = string_begin(2);
    let b = string_write(b, 0, 104);
    let b = string_write(b, 1, 105);
    string_finish(b)
  }
  fn line(value: String) { print(value); putchar(char::newline); }
  fn run() {
    line(sample());
    line(sample().concat(sample()).slice(1, 2));
    let xs = str_list();
    xs.push(sample());
    xs.push(sample().concat(sample()));
    line(xs.get(0));
    line(xs.get(1));
    var i = 0;
    while i < 10 { xs.push(sample()); i = i + 1; }
    if xs.length() != 12 { putchar(char::question); }
    if xs.get(11).length() != 2 { putchar(char::question); }
    let zeroed = string_finish(string_begin(2));
    if zeroed.get(1).code() != 0 { putchar(char::question); }
    let b = string_begin(1);
    let b = string_write(b, 0, 65);
    let frozen = string_finish(b);
    let b = string_write(b, 0, 66);
    line(frozen);
    line(string_finish(b));
    line(arg_at(1));
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; run(); }
}
