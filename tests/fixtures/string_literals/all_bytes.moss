import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch, Num;
import "../../../lib/wasm.moss" as w use Wasm;
import "../../../lib/wasip1.moss" use Wasi;
import "../../../lib/wasibyte.moss" as wb;

# This concrete-provider test deliberately inspects the opaque representations.
# Ordinary Std clients cannot turn arbitrary integers into byte ranges.
assume Wasm {
  type RawByte = wb::RawAscii | wb::RawCont808F | wb::RawCont909F | wb::RawContA0BF | wb::RawLead2 | wb::RawLeadE0 | wb::RawLeadE1EC_EEEF | wb::RawLeadED | wb::RawLeadF0 | wb::RawLeadF1F3 | wb::RawLeadF4 | wb::RawInvalid;
  fn byte_number(value: RawByte): Num {
    match value {
      byte::Ascii(rep) => match rep { wb::OctetAscii(n) => Num(n) },
      byte::Cont808F(rep) => match rep { wb::OctetCont808F(n) => Num(n) },
      byte::Cont909F(rep) => match rep { wb::OctetCont909F(n) => Num(n) },
      byte::ContA0BF(rep) => match rep { wb::OctetContA0BF(n) => Num(n) },
      byte::Lead2(rep) => match rep { wb::OctetLead2(n) => Num(n) },
      byte::LeadE0(rep) => match rep { wb::OctetLeadE0(n) => Num(n) },
      byte::LeadE1EC_EEEF(rep) => match rep { wb::OctetLeadE1EC_EEEF(n) => Num(n) },
      byte::LeadED(rep) => match rep { wb::OctetLeadED(n) => Num(n) },
      byte::LeadF0(rep) => match rep { wb::OctetLeadF0(n) => Num(n) },
      byte::LeadF1F3(rep) => match rep { wb::OctetLeadF1F3(n) => Num(n) },
      byte::LeadF4(rep) => match rep { wb::OctetLeadF4(n) => Num(n) },
      byte::Invalid(rep) => match rep { wb::OctetInvalid(n) => Num(n) },
    }
  }
}
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    let values = int_list();
    values.push(byte_number(byte::x00));
    values.push(byte_number(byte::x01));
