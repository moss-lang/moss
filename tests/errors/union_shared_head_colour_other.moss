import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use WasiCore, proc_exit;

# D15, as in union_shared_head.moss: an A[X=I32] holding 7 would be matched
# by its head and read at the other member's payload type, Colour.
type X;
assume X { tag A[X](X); }
tag Red;
tag Green;
type Colour = Red | Green;

type U = A[X=I32] | A[X=Colour];

assume Wasm, WasiCore {
  fn pick(u: U): I32 {
    let one = w::i32_one;
    match u {
      A(y) => match y {
        Red => w::i32_add(one, one),
        Green => w::i32_add(w::i32_add(one, one), one),
      },
    }
  }

  fn main() {
    let one = w::i32_one;
    let seven = w::i32_add(w::i32_add(w::i32_add(one, one), w::i32_add(one, one)), w::i32_add(w::i32_add(one, one), one));
    let u: U = A[X=I32](seven);
    proc_exit(pick(u));
  }
}
