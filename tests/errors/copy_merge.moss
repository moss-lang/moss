# Moved from bootstrap/examples/copy-merge.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# H's context merges X with Y and F's does not, so `bind F = H;` would let
# an application of F at X = Char, Y = Bool reach a body that reads X as Y.
# The oracle rejects the copy ("input interpretation differs (D78)"); Audit's
# BFunCopy now requires H to read its needs and inputs as F does.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;
val vx: X;
fn .flip(): Y;

assume Std {
  fn run(): Int;
}

# H's context merges X with Y (two readings of A.gimme); F's does not.
context Merge = A, X, Y, A.gimme[Foo=X], A.gimme[Foo=Y], vx, Y.flip;
context Apart = A, X, Y, A.gimme[Foo=X], vx, Y.flip;

functor H: Std, Merge -> run;
functor F: Std, Apart -> run;

functor G: Std, Merge -> run {
  bind run = () => {
    let y: Y = vx;
    let z: Y = y.flip();
    7
  };
}

assume Std, Apart, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind H = G;
    bind F = H;
    bind A = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Bool;
    bind A.gimme = () => this;
    bind vx = char::a;
    bind Y.flip = () => this.not();
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
