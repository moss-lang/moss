import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use Wasi, proc_exit;

# A context cycle is invalid at declaration (Audit note 30).
type T;
context A = T, B;
context B = A;

assume A {
  fn id(x: T): T { x }
}

assume Wasm, Wasi {
  fn main() {
    bind T = I32;
    proc_exit(id(w::i32_one));
  }
}
