# Moved from bootstrap/examples/sameneed-ambiguous-other.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# tests/errors/sameneed_ambiguous.moss with G's two readings of A.gimme in the other
# order (the oracle's representative of {X, Y} in G is then X).
# - Oracle: prints 7 (G's X.m is F's X.m; it does not check that G's merge
#   holds in F). Native: prints 7.
# - Audit before and now: rejects under every orientation (LinkBody's
#   input-reading clause, #11), as in tests/errors/sameneed_ambiguous.moss. Both
#   implementations accept it; this is #11's existing class B divergence,
#   not a change made by #51.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;
fn .m(): Bool;

assume Std {
  fn run(): Int;
}

context Apart = A, X, Y, A.gimme[Foo=X], X.m, Y.m;
context Merge = A, X, Y, A.gimme[Foo=Y], A.gimme[Foo=X], X.m;

functor F: Std, Apart -> run;

functor G: Std, Merge -> run {
  bind run = () => 7;
}

assume Std, Apart, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Char;
    bind A.gimme = () => this;
    bind X.m = () => true;
    bind Y.m = () => false;
    bind F = G;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
