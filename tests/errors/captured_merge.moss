# Moved from bootstrap/examples/captured-merge.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# `bind F = G;` captures G's non-linked needs where it is bound. G's context
# merges X with Y (its two readings of `A.gimme`), and here X = Char and
# Y = Bool, so G's body would call Bool's `not` on a Char. Rejected by both
# implementations (the oracle: D84 3b); Audit now requires the captured
# needs to satisfy G's context at its inputs read here.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;
val vx: X;
fn .flip(): Y;

assume Std {
  fn run(): Int;
}

functor F: Std -> run;

context Merge = A, X, Y, A.gimme[Foo=X], A.gimme[Foo=Y];

functor G: Std, Merge, X, Y, vx, Y.flip -> run {
  bind run = () => {
    let y: Y = vx;
    let z: Y = y.flip();
    7
  };
}

assume Std, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Bool;
    bind A.gimme = () => this;
    bind vx = char::a;
    bind Y.flip = () => this.not();
    bind F = G;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
