# Moved from bootstrap/examples/copy-site-method.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# A copy's method need, keyed by a receiver H's merge identifies with
# another, matched against F's needs by syntax (linkfix finding; criteria.md
# section 2, coherence). H's context merges T with U (two readings of
# A.gimme) and F's does not, but F's brackets are empty and `out` mentions
# T and U, so both are fixed in F and both are Old where F is bound: by
# #96 H's merge holds at every application. H's need `T.m` reads as
# `U.m` or `T.m` depending on which representative H's merge picks, and
# BFunCopy asks `In (canon_item Cu k) nsu`, which only the second meets.
# tests/wasi/copy_site_method_flip.moss lists H's two A.gimme entries in the other
# order and is otherwise identical.
# - Oracle: rejects ("it needs `U.m`, which `F` does not take (D78)").
#   The flipped order is accepted.
# - Native: accepts, in both orders.
# - Audit: accepts (Elaborates chooses the world, so some orientation of
#   H's merge meets the clause), but moss-ref (Ea, one orientation) rejects
#   this order and accepts the other.
type T; type U; type A; type Foo; tag Old;
fn .gimme(): Foo;
fn .m(): Old;
assume T, U { fn out(a: T, b: U); }
functor F[]: T, U, A, A.gimme[Foo=T], T.m -> out;
functor H[]: T, U, A, A.gimme[Foo=T], A.gimme[Foo=U], T.m -> out;
functor G: T, U, A, A.gimme[Foo=T], A.gimme[Foo=U], T.m -> out { bind out = (a, b) => (); }
fn main() { bind T = Old; bind U = Old; bind A = Old; bind Foo = Old; bind A.gimme = () => this; bind T.m = () => this; bind H = G; bind F = H; }
