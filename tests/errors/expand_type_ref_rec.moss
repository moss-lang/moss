# Moved from bootstrap/examples/expand-type-ref-rec.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, both halves).
# A non-regular datatype behind Ref, and functions that build and walk it at
# ever larger T (build/len call themselves at T := Box(T)).
# Oracle (this worktree's moss_m2): accepts and prints 6
# Oracle variant with the check (scratch/expand/variant): rejects: expanding type definition, `Cons` mentions `Cons` at a larger instance
# Native (ob-family moss, seed 1h1710x0): crashes at compile time (call stack exhausted)
import "../../lib/wasm.moss" use Boxed, Ref, Heap, .boxed;
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
tag A;
tag Nil;
assume Std, Wasm, T {
  tag Box(T);
  tag Cons { head: T, tail: Ref[Boxed=Nest[T=Box]] };
  type Nest = Nil | Cons;
}
assume Std, Wasm, Heap, T {
  fn build(x: T, n: Int): Nest {
    if n == 0 { return Nil; }
    let w = Box(x);
    let t = {
      bind T = Box;
      build(w, n - 1).boxed()
    };
    Cons { head = x, tail = t }
  }
  fn len(l: Nest): Int {
    match l {
      Nil => 0,
      Cons { head, tail } => {
        let inner = tail.deref();
        bind T = Box;
        1 + len(inner)
      },
    }
  }
}
assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind T = A;
    print_int(len(build(A, 6))); nl();
  }
}
