# Moved from bootstrap/examples/assume-method-before-type-use.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# As tests/errors/assume_method_before_type.moss, and g calls x.m() (AUDIT-CHANGES #59).
# Audit before: rejects (T.m is filed at the nominal TNom T [], not at x's
# type T, so no method m is in force at x's receiver; argued). Audit now:
# rejects (the assume list does not form; argued).
# Oracle (moss_m2): rejects ("type `T` is not available in the context here").
# Native (ob-family moss, seed 1h1710x0): rejects ("no matching method is
# available for this receiver: `m`").
type T;
fn .m(): This;
assume T.m, T { fn g(x: T): T { x.m() } }
fn main() {}
