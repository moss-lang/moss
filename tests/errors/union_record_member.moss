import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use WasiCore, proc_exit;

# D15: a union's members are nominal. A bare record type is not (it has
# no head for a match arm to name), so it is no member (Audit note 34).
tag P { a: I32 };
tag Red;
type U = { a: I32 } | Red;

assume Wasm, WasiCore {
  fn get(u: U): I32 {
    match u {
      Red => w::i32_one,
      _ => w::i32_zero,
    }
  }

  fn main() { proc_exit(get(Red)); }
}
