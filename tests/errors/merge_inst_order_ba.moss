# Δ4 (D43): `g` assumes `f` twice, at `T = A` (`K1`) and at `T = B`
# (`K2`); merging the two entries of `f` unifies their instantiations,
# so `g`'s context merges `A` with `B`, and `h`, where `A` and `B` are
# distinct, cannot call it. merge_inst_order_ab.moss lists
# the two contexts the other way round; both are refused.

type T;
type A;
type B;
assume T { fn f(); }
context K1 = A, B, f[T=A];
context K2 = A, B, f[T=B];
assume K2, K1 { fn g() { f(); } }
assume K1 { fn h() { g(); } }
fn main() {}
