# Moved from bootstrap/examples/result-collide-family.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# AUDIT-CHANGES #58 (criteria section 2, coherence; D84 rule 7).
# Control: the same collision through a family, which
# FamilyApplication's NoDup (D84 rule 7) already rejects.
# Audit before and now: rejects (argued).
# Oracle (moss_m2): rejects ("`Int.m` is two items of the family `F` here").
# Native (ob-family moss, seed 1h1710x0): rejects ("conflicting method bindings from a family").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type A;
type B;
assume A { fn .m(); }
functor F[A, B]: Std -> A.m, B.m;
assume Std {
  functor G: Std, A, B -> A.m, B.m {
    bind A.m = () => putchar(char::a);
    bind B.m = () => putchar(char::b);
  }
}

assume Std, F {
  fn use_it() { one.m(); }
}

assume Wasm, Gc, WasiCore, Branch {
  fn main() { bind WasiStd; bind F = G; use_it(); putchar(char::newline); }
}
