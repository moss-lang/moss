# Moved from bootstrap/examples/platform-fixed-merge-ix.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# FixedMachinesRead by class (AUDIT-CHANGES #53; criteria section 2, coherence).
# main's context merges the machine type I32 with an abstract X
# (`context Two = X, i32_eqz, i32_eqz[I32 = X]`: the two bindings of i32_eqz are one
# key, so I32 and X are one type). The root context's platform functors fix
# I32, and the platform provides them only at the machine I32.
# tests/errors/platform_fixed_merge_xi.moss lists the merge the other way round.
# Audit before (argued from the rules, not run): this clause passed in the orientation whose representative is I32
# (canon C t = TAbs I32) and failed in the one whose representative is X,
# so the verdict depended on the choice. Audit now: rejected in either
# orientation (I32's class is not I32 alone).
# Oracle (moss_m2): rejects ("platform functor has an incompatible assumed fixed type").
# Oracle variant fixedcls (scratch/oracle/fixedcls, the class form): rejects.
# Native (ob-family moss, seed 1h1710x0): rejects ("incompatible types: `Arrays`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, I32, i32_eqz;
import "../../lib/wasip1.moss" use WasiCore;

type X;

context Two = X, i32_eqz, i32_eqz[I32 = X];

assume Wasm, WasiCore, Branch, Two {
  fn main() {
    bind WasiStd;
    putchar(char::k);
    putchar(char::newline);
  }
}
