# Moved from bootstrap/examples/closure-partial-unbound-xyz.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# BFunClosure 3b: G's merges are checked by class (AUDIT-CHANGES #54; criteria
# section 2, coherence). G merges X (an input F takes, so linked) with Y and Z,
# which only G has (`context Merge = A, X, Y, Z, ...`: the three
# bindings of A.gimme are one key). The other file of the pair, tests/wasi/closure_partial_unbound_zyx.moss,
# lists the merge the other way round.
# At the bind Y is Bool, Z is Char and X (linked) is not in force yet.
# Audit before and now: accepted (argued). Before, X had to be the representative
# (LinkBody), and both equations mention X and were skipped; now the class is not
# wholly in force and is not checked.
# Oracle (moss_m2): rejects ("its linked input interpretation differs (D84)").
# Native (ob-family moss, seed 1h1710x0): prints k.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type A;
type X;
type Y;
type Z;

fn .gimme(): Foo;
assume X { val vx: X; val out: X; }

context Merge = A, X, Y, Z, A.gimme[Foo=X], A.gimme[Foo=Y], A.gimme[Foo=Z];
context FIn = A, X, A.gimme[Foo=X], vx;

functor F: Std, FIn -> out;

functor G: Std, Merge, vx -> out {
  bind out = vx;
}

assume Std, FIn, F {
  fn go(): X { bind F; out }
}

assume Std {
  fn demo() {
    bind A = Bool;
    bind Foo = Bool;
    bind Y = Bool;
    bind Z = Char;
    bind F = G;
    bind X = Bool;
    bind A.gimme = () => this;
    bind vx = true;
    let b: Bool = go();
    if b { putchar(char::k); }
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
