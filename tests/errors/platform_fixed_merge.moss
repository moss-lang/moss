# main's two assumptions of ff identify I32 with Bool. The entry call
# fails because Base supplies I32 as a distinct abstract type.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, I32;
import "../../lib/wasip1.moss" use WasiCore;

assume I32 {
  fn ff(): I32;
}

context Two = ff[I32 = Bool], ff;

assume Wasm, WasiCore, Branch, Two {
  fn main() {
    bind WasiStd;
  }
}
