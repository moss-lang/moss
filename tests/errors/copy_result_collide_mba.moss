# Moved from bootstrap/examples/copy-result-collide-mba.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# AUDIT-CHANGES #58 (criteria section 2, coherence; D84 rule 7).
# As tests/errors/copy_result_collide.moss, with Merge's bindings listed
# C.gimme[Foo=B], C.gimme[Foo=A].
# Audit before: accepts, prints b (argued). Audit now: rejects (argued).
# Oracle (moss_m2): prints a. Oracle variant d7: rejects.
# Native (ob-family moss, seed 1h1710x0): rejects ("... required signature: `B`").
# use_it no longer assumes Foo, which it binds itself: rule B (#60) would
# otherwise reject the call use_it() in main, where Foo is not in force.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type C;
type A;
type B;
fn .gimme(): Foo;
assume A { fn .m(); }
context Merge = C, A, B, C.gimme[Foo=B], C.gimme[Foo=A];
functor H: Std, A, B -> A.m, B.m;
functor F: Std, Merge -> A.m, B.m;
assume Std {
  functor G: Std, A, B -> A.m, B.m {
    bind A.m = () => putchar(char::a);
    bind B.m = () => putchar(char::b);
  }
}

assume Std, H {
  fn use_it() {
    bind F = H;
    bind A = Int; bind B = Int; bind C = Int; bind Foo = Int;
    bind C.gimme = () => 0;
    bind F;
    one.m();
  }
}

assume Wasm, Gc, WasiCore, Branch {
  fn main() { bind WasiStd; bind H = G; use_it(); putchar(char::newline); }
}
