# Moved from bootstrap/examples/unbound-merge-representative.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type Foo;
type A;
type B;
type C;
type D;
type X;
type Y;
type Z;

fn .gimme(): Foo;
fn .w(): Foo;

context Ctx1 = A, B, A.gimme[Foo=B];
context Ctx2 = A, C, A.gimme[Foo=C];
context Ctx3 = A, D, A.gimme[Foo=D];
context K0 = B, C, D, X, Y, Z, B.w[Foo=X], C.w[Foo=Y], D.w[Foo=Z];

assume Std, K0, Ctx1, Ctx2, Ctx3 {
  fn f(x: X): Y { x }
}

assume Std {
  fn giveq(): Char { char::q }

  fn demo() {
    bind Foo = Char;
    bind A = Char;
    bind B = Char;
    bind C = Char;
    bind D = Char;
    bind X = Char;
    bind Y = Bool;
    bind A.gimme = giveq;
    bind C.w = giveq;
    if f(char::k) { putchar(char::t) } else { putchar(char::f) }
    putchar(char::newline);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
