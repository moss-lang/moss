# From the copy that was bootstrap/examples/pin-fixed-disagree.moss (removed; its
# oracle verdicts are the old Rocq oracle's, historical):
# Q6 (AUDIT-CHANGES #71): the unsafe variant of tests/wasi/pin_fixed_agree.moss.
# main binds `Tok = Bool` before `bind MakeTok = CharTok`, so MakeTok's
# fixed reading of Tok is Bool, and every application reads `tok(): Tok`
# as `(): Bool`. But CharTok's body pins `Tok = Char`, and its `tok`
# returns a character. Accepting the bind would read a Char as a Bool.
# Verdicts: Audit rejects (the pin disagrees with the bind site's
# reading; before #71 it was rejected as a pin of M(F));
# oracle rejects ("`CharTok` cannot be bound to `MakeTok` here: it binds
# `Tok` to `Chr[I32=I32]`, and here `Tok` is `Bool`; `MakeTok` is fixed in
# `Tok` (D84)"); native rejects ("the functor does not satisfy the
# required signature: `Tok`", at the bind).
# Q6 (AUDIT-CHANGES #71), from tests/errors/pin_fixed_disagree.moss:
# as tests/wasi/pin_fixed_agree.moss, but `main` binds `Tok = Bool`
# before `bind MakeTok = CharTok`, so CharTok's pin `Tok = Char`
# disagrees with MakeTok's fixed reading of `Tok`; accepting the bind
# would read a Char as a Bool.
type Tok;

assume Std, Tok {
  fn tok(): Tok;
}

functor MakeTok[]: Std -> tok;
functor CharTok: Std -> tok {
  bind Tok = Char;
  bind tok = () => char::q;
}

assume ReferenceBase {
  fn main() {
    bind StdBase;
    bind Tok = Bool;
    bind MakeTok = CharTok;
    bind MakeTok;
    if tok() { putchar(char::t); } else { putchar(char::f); }
    putchar(char::newline);
  }
}
