# Moved from bootstrap/examples/expand-functor-forge.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, InstantiationsBounded).
# Growth through a functor's output, with a cast at the bottom: rec applies F
# (T := G's Box over U = T) and calls itself at the new T.
# Oracle (this worktree's moss_m2): accepts; prints 1, then traps (trap 37)
# Oracle variant with the check (scratch/expand/variant): rejects: expanding cycle
# Native (ob-family moss, seed 1h1710x0): crashes at compile time (call stack exhausted)
import "../../lib/wasm.moss" use Boxed, Ref, Heap, StructCast, StructCasts, .boxed;
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
type U;
type V;
tag A;
assume U { tag Box[U](A); }
assume U, T { fn wrap(x: U): T; }
functor F: U -> T, wrap;
functor G: U -> T, wrap {
  bind T = Box;
  bind wrap = (x) => Box(A);
}
assume Std, Wasm, Heap, StructCasts, U, T, F, V {
  fn rec(x: T, n: Int): Int {
    if n == 0 {
      let r = x.boxed();
      let s = match r { Ref(s) => s };
      let q = StructCast[Boxed=V](s).cast();
      return 1;
    }
    bind U = T;
    bind F;
    rec(wrap(x), n - 1)
  }
}
assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind U = A;
    bind T = Box;
    bind F = G;
    bind V = Box[U=Box[U=Box[U=A]]];
    print_int(rec(Box(A), 2)); nl();
    print_int(rec(Box(A), 3)); nl();
  }
}
