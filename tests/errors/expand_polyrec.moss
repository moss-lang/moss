# Moved from bootstrap/examples/expand-polyrec.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, InstantiationsBounded).
# Polymorphic recursion through a type bind: `nest` binds T = Wrap over the T
# in force and calls itself, so its call θ is T := Wrap(T), a strict edge
# (nest, T) -> (nest, T). Specializing needs nest at A, Wrap[A], Wrap[Wrap[A]], ...
# (D16's Exceptions; the planned resolution of docs/design/semantics.md).
# Oracle (this worktree's moss_m2): accepts and prints 5
# Oracle variant with the check (scratch/expand/variant): rejects: expanding cycle, nest's T grows into nest's T
# Native (ob-family moss, seed 1h1710x0): crashes at compile time (call stack exhausted)
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
tag A;
assume Std, T {
  tag Wrap(T);
  fn nest(x: T, n: Int): Int {
    if n == 0 { return 0; }
    let w = Wrap(x);
    bind T = Wrap;
    1 + nest(w, n - 1)
  }
}
assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind T = A;
    print_int(nest(A, 5)); nl();
  }
}
