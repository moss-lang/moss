# From the copy that was bootstrap/examples/bind-attached-defined.moss (removed; its
# oracle verdicts are the old Rocq oracle's, historical):
# Q3 (semantics.typ, "binding a defined attached method"; AUDIT-CHANGES #70).
# `Meter.describe` on the left of a bind names the attached method, which
# is defined. A call `d.describe()` resolves to the definition (D61 rule 1,
# MCAttachedDefined): the provision wins only for the *detached* method's
# key (D77). So the bind could never be used, and it is rejected.
# Verdicts: Audit rejects (BMethBind: the method item has no body);
# oracle (this branch) rejects ("`Meter.describe` is a defined method ...
# it cannot be bound"); oracle before: prints mm; native: prints mm (accepts; to do).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

# Q3 (AUDIT-CHANGES #70): `Meter.describe` on the left of a bind names the
# attached method, which is defined, and a call `d.describe()` always
# reaches the definition (D61 rule 1); a provision wins only for the
# detached method's key (D77). So the bind could never be used, and is
# refused. The self-hosted compiler used to accept it and print `mm`.

tag Meter(Int);
fn .describe();

assume Std {
  fn Meter.describe() { putchar(char::m); }
}

assume Std {
  fn demo() {
    let d = Meter(3);
    d.describe();
    {
      bind Meter.describe = () => putchar(char::x);
      d.describe();
    }
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
