# Provider merges A with B through seed. Its private captured value
# therefore has target input B, which each Target application supplies.
type P;
type A;
type B;
assume P {
  val seed: P;
  val captured: P;
}
context Left = A, seed[P=A];
context Right = B, seed[P=B];
fn out();
functor Target[B]: B, seed[P=B] -> out;
functor Provider: Left, Right, captured[P=A] -> out {
  bind out = () => {};
}
context Captured = captured[P=A];
assume Left, Right, Captured {
  fn exercise() { bind Target = Provider; }
}
tag Concrete;
fn main() {
  bind P = Concrete;
  bind A = Concrete;
  bind B = Concrete;
  bind seed = Concrete;
  bind captured = Concrete;
  exercise();
}
