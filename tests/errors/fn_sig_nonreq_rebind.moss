# Moved from bootstrap/examples/fn-sig-nonreq-rebind.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# #12b neighbour of tests/wasi/fn_sig_nonreq.moss: U, now a fixed input of F, is rebound
# between `bind F = G;` and `bind F;`, so the application reads it at a
# different meaning (D84 rule 5).
# Verdicts: Audit rejects (BApplyAbstract's rule 5); oracle rejects ("applying
# `F` here reads `U` as `Bool`, but `F` is fixed in it", since #12b; before:
# "type `U` is not available"); native rejects ("the available binding was
# provided at a different type instantiation: `F`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;
type A;
type U;
val u0: U;
assume A {
  fn mk(): U;
}
functor F[A]: Std -> mk;
functor G: A, U, u0, Std -> mk { bind mk = () => u0; }
assume Std {
  fn demo() {
    bind A = Int;
    bind U = Int;
    bind u0 = 7;
    bind F = G;
    bind U = Bool;
    bind F;
    print_int(mk());
    putchar(char::newline);
  }
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; demo(); }
}
