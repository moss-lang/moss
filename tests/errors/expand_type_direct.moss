# Moved from bootstrap/examples/expand-type-direct.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, TypesBounded).
# A non-regular datatype, directly: Cons's payload mentions Nest[T=Box], i.e.
# Cons at T := Box(T), a strict type edge (Cons, T) -> (Cons, T).
# Oracle (this worktree's moss_m2): rejects: "`Box` contains itself, so it has no finite layout (D58)"
# Oracle variant with the check (scratch/expand/variant): rejects (D58, before the check)
# Native (ob-family moss, seed 1h1710x0): crashes at compile time (call stack exhausted)
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
tag A;
tag Nil;
assume T {
  tag Box(T);
  tag Cons { head: T, tail: Nest[T=Box] };
  type Nest = Nil | Cons;
}
assume Std, T {
  fn len(l: Nest): Int {
    match l { Nil => 0, Cons { head, tail } => 1 }
  }
}
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind T = A;
    let l: Nest = Nil;
    print_int(len(l)); nl();
  }
}
