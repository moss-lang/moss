# Moved from bootstrap/examples/copy-bracket-nonfixed.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# copyfresh (scratch/orch/copyfresh-AUDIT.md): REJECTED at `bind F = H`.
# Audit's CopyOutputs now reads every generation of F's inputs that the
# copy substitution sigma does not read (F's non-fixed inputs, here I) as
# a fresh symbol, as the oracle's copy_output_compatible does (@copy):
# F's get is (): TAbs I [I := TAbs I] (Z read at the site), H's is
# (): c_I [I := c_I], so they differ and BFunCopy does not apply.
# Before, sigma = [Z := TAbs I] alone made them equal (ChainRealizeOk
# was false, hunt2-chain/REPORT.md in moss-safety). Original header:
# hunt2-chain t3: COUNTEREXAMPLE to CN.ChainRealizeOk (copy of a linked root).
# Shape: a copy F of H whose fixed bracket target Z reads, at the copy
# site, as the *symbol* I, where I is an input of F (and a polymorphic
# input of H) that F does not fix; I is rebound before `bind F;`.
#
#   functor H[I]: Std, I, vi -> kk, get;          get(): I, I poly in H
#   functor F[]:  Std, I, Z, vi -> kk, get[I = Z]; X(F) = {Z}
#   demo (assume I):  bind Z = I;  bind H = G;  bind F = H;
#                     bind I = Bool; bind vi = true; bind F; get()
#
# Audit (BFunCopy / CopyOutputs): sigma is F's fixed readings at the copy
# site only: [Z := TAbs I]. Read at Cu_F, F's `get` is ProvidedFn ():Z
# [I := Z] and H's is ():I [I := I]; after sigma both are ():I [I := I],
# so CopyOutputs holds (rm = [0, 1]). Every other BFunCopy premise is
# about H's inputs/needs read in F (I, vi: identical) or fixed inputs
# (X(H) = {}, FixedAgreement vacuous). sigma identifies the copy-site
# meaning of I (here: demo's I, i.e. Char) with F's *input* I, which each
# application supplies afresh. The oracle's copy_output_compatible
# instead replaces every non-fixed generation of F by a fresh @copy
# symbol, so get returns @copy_I in H and I in F, and rejects.
# BApplyAbstract at `bind F;`: the fixed clause only asks Z to read as
# recorded (TAbs I = TAbs I, syntactically) and holds; the rebind of I
# changes c_ty I, not Z's reading. θ_F = [I := Bool, Z := TAbs I, ...].
# At the application, H's code (G's body) has I linked, base
# ground d (θ I) = Bool, so get's closure returns `true` (Bool). The
# caller's C' gives get the signature (): TAbs I (Z read at the caller),
# ground Char (demo's I as supplied by main). EnvOkOn fails for the new
# provision IFn get (ChainRealizeOk's conclusion), and main's
# `c.code()` runs Char's primitive on a Bool.
#
# Oracle (ob-sigclose moss_m2): rejects at `bind F = H`, "`H` cannot be
#   copied to `F`: its effective output interpretation differs (D78)".
# Native (ob-family, seed 1h1710x0): rejects at `bind F = H`, "the functor
#   does not satisfy the required signature: `get`".
# Audit: accepts (reasoning above) -> ChainRealizeOk FALSE.
# Repair: compute sigma as the oracle does: solve F's fixed patterns
# against the site, and send every other generation of Cu_F to a fresh
# symbol (or: require sigma's image to avoid F's non-fixed inputs).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

type I;
type Z;
assume { val kk: Int; }

assume I {
  fn get(): I;
  val vi: I;
}

functor H[I]: Std, I, vi -> kk, get;
functor F[]: Std, I, Z, vi -> kk, get[I = Z];
functor G: Std, I, vi -> kk, get {
  bind kk = 1;
  bind get = () => vi;
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std, I {
  fn demo(): I {
    bind Z = I;
    bind H = G;
    bind F = H;
    bind I = Bool;
    bind vi = true;
    bind F;
    get()
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind I = Char;
    let c: Char = demo();
    print_int(c.code());
    putchar(char::newline);
  }
}
