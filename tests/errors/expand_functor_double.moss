# Moved from bootstrap/examples/expand-functor-double.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, InstantiationsBounded).
# As expand-functor-output, with a functor whose output doubles its input
# (Pair { a: U, b: U }), so the instances grow exponentially in size.
# Oracle (this worktree's moss_m2): accepts and prints 12
# Oracle variant with the check (scratch/expand/variant): rejects: expanding cycle
# Native (ob-family moss, seed 1h1710x0): crashes at compile time (out of bounds memory access)
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
type U;
tag A;
assume Std, U { tag Pair { a: U, b: U }; }
assume U, T { fn wrap(x: U): T; }
functor F: U -> T, wrap;
functor G: U -> T, wrap {
  bind T = Pair;
  bind wrap = (x) => Pair { a = x, b = x };
}
assume Std, U, T, F {
  fn rec(x: T, n: Int): Int {
    if n == 0 { return 0; }
    bind U = T;
    bind F;
    1 + rec(wrap(x), n - 1)
  }
}
assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind T = Int;
    bind U = Int;
    bind F = G;
    print_int(rec(7, 12)); nl();
  }
}
