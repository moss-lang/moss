# Rule B, from tests/errors/family_unbound_need.moss: `use_it`
# requires `T` and `T.foo`; `main` does not bind `T`, so the call would
# read `T` as itself, and the family `F` would be applied at a type out
# of force, keying `T.foo` there. Refused: `use_it` needs `T` in force.

type A;
type T;
assume A { fn .foo(); }
functor F[A]: A -> A.foo;
functor G: A -> A.foo { bind A.foo = () => (); }
assume T, T.foo { fn use_it() { } }
fn main() {
  bind F = G;
  use_it();
}
