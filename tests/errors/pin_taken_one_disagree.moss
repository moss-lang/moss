# Moved from bootstrap/examples/pin-taken-one-disagree.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# tests/wasi/pin_taken_one.moss with a bind site that disagrees with the pin
# (AUDIT-CHANGES #95): G takes T and binds it to Old, but main has
# T = New. Every application would read `mk(): T` as `mk(): New`, while
# the body's `mk` returns an Old.
# Verdicts: oracle rejects (D84 3d's agreement); native rejects; Audit
# rejects (BFunClosure: the pin (T, Old) is not T's meaning here, New).
type T;
tag Old;
tag New;
assume T { fn mk(): T; }
functor F[]: T -> mk;
functor G: T -> mk {
  bind T = Old;
  bind mk = () => Old;
}
fn main() {
  bind T = New;
  bind F = G;
  bind F;
  match mk() { New => () };
}
