# Moved from bootstrap/examples/copy-fixed-rebind.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# ChainResultAgrees edge case (scratch/orch/chainagree-STATUS.md): a copy
# F of a platform family whose bracket reads a fixed input (`I32`) as a
# polymorphic input `Y` of F, with the copy site reading `I32` as `Y`,
# so CopyOutputs' substitution equates them; rebinding `Y` afterwards
# would make the caller's run-time key differ from the family's. Not
# reachable: the copy site may not rebind a fixed input of the copied
# functor (Audit BFunCopy's FixedAgreement). The oracle rejects ("copying
# `Arrays` after rebinding its fixed input `I32` changes its
# interpretation (D84)"), native too ("the available binding was provided
# at a different type instantiation: `Arrays`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch, Num, raw;
import "../../lib/wasm.moss" use Wasm, I32, Arrayed, Array, Arrays, .arrayed;
import "../../lib/wasip1.moss" use WasiCore;

type Y;

functor F[Arrayed, Y]: Wasm, Arrayed, Y ->
  Arrayed.arrayed, Array.length[I32 = Y], Array.get, Array.set, Array.fill, Array.copy;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std, Wasm, Arrays, Y, Num {
  fn demo() {
    bind I32 = Y;
    bind F = Arrays;
    bind Y = Int;
    bind Arrayed = Int;
    bind F;
    print_int(7);
  }
}

assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    bind Y = I32;
    demo();
    putchar(char::newline);
  }
}
