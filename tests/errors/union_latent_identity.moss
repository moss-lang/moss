# Moved from bootstrap/examples/union-latent-identity.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# N4 (AUDIT-CHANGES, "Known divergences"): `T | U` over an abstract T, and
# T is later U itself. The value of T is a U, so the U arm catching it is
# consistent; only an instantiation that shares a head at another payload
# (tests/errors/union_latent_overlap.moss) goes wrong.
# Verdicts: oracle rejects (D15, as union-latent-overlap); native accepts
# and exits 2 (the U arm); Audit rejects (TyUnion).
import "../../lib/wasm.moss" as w use Wasm, I32;
import "../../lib/wasip1.moss" use WasiCore, proc_exit;

type T;
tag U;

assume T, Wasm, WasiCore {
  fn pick(u: T | U): I32 {
    let one = w::i32_one;
    match u {
      U => w::i32_add(one, one),
      _ => one,
    }
  }
}

assume Wasm, WasiCore {
  fn main() {
    bind T = U;
    let t: T = U;
    proc_exit(pick(t));
  }
}
