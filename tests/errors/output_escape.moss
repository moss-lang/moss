# Moved from bootstrap/examples/output-escape.moss. Verdicts below credited to the
# oracle are the old Rocq oracle's (moss_m2, removed when moss-ref replaced
# it), so they are historical; the suite checks the current verdicts.
# A value of a functor's output type leaves the block that bound it (D78).
# T is not in force in demo, so `bind F;` installs T as itself rather than
# as a fresh generation; Audit's BApplyAbstract listed only fresh
# generations as made, so BlkE let `{ bind F; v }` (of type T) escape,
# although the application writes T's meaning only inside the block.
# The oracle rejects it: "this block yields `T`, which mentions `T`, a type
# `bind F;` made in it: a value of that type cannot leave the block (D78)".
# Native rejects it too: "a type created by a binding cannot escape its
# block: `T`".
# Audit now counts every output destination as made.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use WasiCore;
type T;
val v: T;
functor F: Std -> T, v;
functor Impl: Std -> T, v { bind T = Int; bind v = 3; }
assume Std {
  fn demo() {
    bind F = Impl;
    let x = { bind F; v };
    let y = x;
  }
}
assume Wasm, WasiCore, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
