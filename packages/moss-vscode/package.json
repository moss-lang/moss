{
  "name": "moss-vscode",
  "displayName": "Moss",
  "version": "0.0.0",
  "publisher": "moss-lang",
  "description": "Syntax highlighting and language configuration for Moss.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moss-lang/moss",
    "directory": "packages/moss-vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "moss",
        "aliases": [
          "Moss",
          "moss"
        ],
        "extensions": [
          ".moss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moss",
        "scopeName": "source.moss",
        "path": "./syntaxes/moss.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "vsce package"
  }
}
