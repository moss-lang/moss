#!/usr/bin/env bash
# Run the bootstrap (Python) Moss compiler: moss-boot {lex|parse|run} FILE [ARGS...]
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -c "
import sys
sys.path.insert(0, '$root/bootstrap')
from mossc.__main__ import main
sys.exit(main())
" "$@"
