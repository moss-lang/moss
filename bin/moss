#!/usr/bin/env bash
# The Moss CLI, backed by the bootstrap compiler. With no subcommand, `run`
# is implied, which is what makes `#!/usr/bin/env moss` shebangs work.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cmd=run
case "${1-}" in
  lex | parse | run | build)
    cmd=$1
    shift
    ;;
esac
PYTHONPATH="$root/bootstrap" exec python3 -m mossc "$cmd" "$@"
