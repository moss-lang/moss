# r1: t3 through a copy of a copy. F1 is H's twin (accepted copy), then F
# (fixed Z, bracket get[I = Z]) copies F1 at a site where Z reads I.
# Expected under the new rule: reject at bind F = F1 (I fresh in F).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type I;
type Z;
assume { val kk: Int; }
assume I { fn get(): I; val vi: I; }
functor H[I]: Std, I, vi -> kk, get;
functor F1[I]: Std, I, vi -> kk, get;
functor F[]: Std, I, Z, vi -> kk, get[I = Z];
functor G: Std, I, vi -> kk, get { bind kk = 1; bind get = () => vi; }
assume Std, I {
  fn demo(): I {
    bind Z = I;
    bind H = G;
    bind F1 = H;
    bind F = F1;
    bind I = Bool;
    bind vi = true;
    bind F;
    get()
  }
}
assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind I = Char;
    let c: Char = demo();
    print_int(c.code());
    putchar(char::newline);
  }
}
