# r4: family copy of a copy (v3 through F1, H's twin). F = F1 at the
# site where Y reads go's A. Expected: reject at bind F = F1 (A fresh).
type A;
type U;
type Y;
tag Concrete;
assume A { fn .m(): U; fn .k(): U; }
val y0: Y;
val a0: A;
functor F[A]: A, Y, y0 -> A.m[U = A], A.k[U = Y];
functor H[A]: A, Y, y0 -> A.m[U = Y], A.k[U = Y];
functor F1[A]: A, Y, y0 -> A.m[U = Y], A.k[U = Y];
functor G: A, Y, y0 -> A.m[U = Y], A.k[U = Y] {
  bind A.m[U = Y] = () => y0;
  bind A.k[U = Y] = () => y0;
}
assume A, Y, y0, F {
  fn use_it() {
    let r: Concrete = Concrete.m();
    match r { Concrete => () };
  }
}
assume A, a0 {
  fn go() {
    bind Y = A;
    bind y0 = a0;
    bind H = G;
    bind F1 = H;
    bind F = F1;
    use_it();
  }
}
fn main() {
  bind A = Bool;
  bind a0 = true;
  go();
}
