# r2: v3 with the brackets swapped: F's A.m[U = Y] (fixed Y), H's
# A.m[U = A] (poly A), copy where Y reads go's A. sigma = [Y := A_site],
# A fresh: F's () -> A_site vs H's () -> c_A. Expected: reject.
type A;
type U;
type Y;
tag Concrete;
assume A { fn .m(): U; fn .k(): U; }
val y0: Y;
val a0: A;
functor F[A]: A, Y, y0 -> A.m[U = Y], A.k[U = Y];
functor H[A]: A, Y, y0 -> A.m[U = A], A.k[U = Y];
functor G: A, Y, y0 -> A.m[U = A], A.k[U = Y] {
  bind A.m[U = A] = () => this;
  bind A.k[U = Y] = () => y0;
}
assume A, Y, y0, F {
  fn use_it() {
    let r: Y = Concrete.m();
  }
}
assume A, a0 {
  fn go() {
    bind Y = A;
    bind y0 = a0;
    bind H = G;
    bind F = H;
    use_it();
  }
}
fn main() {
  bind A = Bool;
  bind a0 = true;
  go();
}
