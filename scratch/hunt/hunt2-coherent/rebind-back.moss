# Oracle: 5 (G's Int.m runs inside the demanded scope), exit 0. Native: 42.
# Audit: accepted; both Int.m are () -> Int at θ [U:=Int]: coherent. Type-safe;
# only the round-1 oracle/native disagreement on which Int.m runs (control-same-u).
# TARGET: rebind a signature type between the caller's provision and the
# family demand, then rebind it back to the same meaning (θ equal again).
import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm;
import "../../../lib/wasip1.moss" use Wasi;
type A;
type U;
val u0: U;
assume A {
  fn .m(): U;
  fn .n(x: A): A;
}
functor F[A]: U, u0 -> A.m, A.n;
functor G: A, U, u0 -> A.m, A.n {
  bind A.m = () => u0;
  bind A.n = (x) => x;
}
assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind U = Int;
    bind Int.m = () => 42;
    bind U = Bool;
    bind u0 = true;
    bind U = Int;
    bind u0 = 5;
    bind F = G;
    let k: Int = 7;
    print_int(k.n(k.m()));
    putchar(char::newline);
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; demo(); }
}
