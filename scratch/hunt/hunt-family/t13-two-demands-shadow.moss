# FamilyLinkNewOk probe (no failure found): two demands of the same family
# at different matchings, inside a lambda; demand of Bool.bar installs
# Bool.foo too, shadowing the caller's own Bool.foo (bound before F); and a
# demand at an unbound declared receiver T (as family-unbound-need.moss).
# Under Audit each install is under the caller's rkey (F's formal key read
# by theta), with the body's closure at the caller's signature.
# Result: oracle prints 0, native prints 0. No failure.
import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm;
import "../../../lib/wasip1.moss" use Wasi;
type A;
type T;
tag Concrete;
assume A { fn .foo(): A; fn .bar(): A; }
functor F[A]: A -> A.foo, A.bar;
functor G: A -> A.foo, A.bar { bind A.foo = () => this; bind A.bar = () => this.foo(); }
context Need = T, T.foo[A=T];
assume Need { fn use_it(x: Concrete) { } }
fn run();
assume Std {
  fn demo() {
    bind Bool.foo[A=Bool] = () => false;
    bind F = G;
    bind run = () => {
      let c: Concrete = Concrete.bar();
      let b: Bool = true.bar();
      if b { putchar(char::digit0.code().char()); } else { putchar((char::digit0.code() + 1).char()); }
      putchar(char::newline);
      use_it(Concrete.foo());
    };
    run();
  }
}
assume Wasm, Wasi, Branch { fn main() { bind WasiStd; demo(); } }
