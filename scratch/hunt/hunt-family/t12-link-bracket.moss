# FamilyLinkNewOk probe: t11 with F bound directly to the linked body G
# (no copy). The linked code installs at F's formal key read by theta
# ([W := Z] -> [W := Z] at use_it), so the caller key matches.
# Result: oracle rejects (G provides A.len at another type than F promises); native 0. Audit: ResultRealizes rejects (no Z in G). Linked families key at F's formal key read by theta, so no mismatch. No failure.
type A;
type W;
type Z;
tag Concrete;
assume W, A { fn .len(): W; fn .wid(): W; }
fn mkw(): W;
functor F[A]: A, W, Z -> A.len[W = Z], A.wid;
functor H[A]: A, W -> A.len, A.wid;
functor G: A, W, mkw -> A.len, A.wid { bind A.len = () => mkw(); bind A.wid = () => mkw(); }
assume W, Z, F { fn use_it() { let y: Z = true.len(); } }
fn main() {
  bind W = Concrete;
  bind Z = Concrete;
  bind mkw = () => Concrete;

  bind F = G;
  use_it();
}
