# Target: FamilyLinkNewOk keys. Family F[X]'s inputs merge X with T (two
# readings of A.gimme). The demand of Concrete.m reads X := Concrete off
# the key, while T is Bool at the caller. F's formal key X.m is spelled
# with the merge's representative; at run time it is read by theta.
# Result: oracle rejects (X and T merged, here Concrete/Bool); native rejects. Audit: Satisfies' merge clause (all formal keys in force at the family context). No failure.
type Foo;
type A;
type T;
type X;
tag Concrete;
fn .gimme(): Foo;
fn .m();
context Merge = A, X, T, A.gimme[Foo=X], A.gimme[Foo=T];
functor F[X]: Merge -> X.m;
functor G: Merge -> X.m { bind X.m = () => (); }
fn main() {
  bind A = Concrete;
  bind T = Bool;
  bind Foo = Bool;
  bind A.gimme = () => true;
  bind F = G;
  Concrete.m();
}
