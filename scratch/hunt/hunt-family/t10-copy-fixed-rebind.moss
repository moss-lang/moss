# Target: FamilyCopyApplyOk realization. H (fixed in S, as A.foo : () -> S
# mentions it) is bound at S = Concrete; S is then rebound to Other and the
# family F (also fixed in S) is bound as a copy of H. A demand of A.foo
# then runs H's body, returning a Concrete where the caller reads Other.
# Result: oracle rejects (copying H after rebinding fixed S); native rejects the demand. Audit: BFunCopy's FixedAgreement W C h. No failure.
type A;
type S;
tag Concrete;
tag Other(Concrete);
assume S, A { fn .foo(): S; }
fn mk(): S;
functor F[A]: A -> A.foo;
functor H[A]: A -> A.foo;
functor G: A, S, mk -> A.foo { bind A.foo = () => mk(); }
fn main() {
  bind S = Concrete;
  bind mk = () => Concrete;
  bind H = G;
  bind S = Other;
  bind F = H;
  let y: Other = true.foo();
  let n = match y { Other(n) => n };
}
