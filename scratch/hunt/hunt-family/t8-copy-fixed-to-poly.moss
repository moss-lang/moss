# Target: FamilyCopyApplyOk. Family F[A] is bound to a copy of H, an
# abstract functor fixed in A (A = Bool at H's bind). A demand of A.foo at
# a Concrete receiver then runs H's code with A = Bool.
# Result: oracle rejects (D84 3b); native rejects. No failure.
type A;
tag Concrete;
assume A { fn .foo(): A; }
fn mk(): A;
functor F[A]: A -> A.foo;
functor H: A -> A.foo;
functor G: A, mk -> A.foo { bind A.foo = () => mk(); }
fn main() {
  bind A = Bool;
  bind mk = () => true;
  bind H = G;
  bind F = H;
  let y: Concrete = Concrete.foo();
  match y { Concrete => () };
}
