# Target: FamilyLinkNewOk signature part. A.foo's signature mentions S,
# which is not listed among F's inputs. Does elaboration accept it?
# Result: oracle 0, native 0. S is an implicit input of F (FunCtx: Mentions), so theta carries S at the caller; consistent. No failure.
type A;
type S;
tag Concrete;
assume S, A { fn .foo(): S; }
fn mk(): S;
functor F[A]: A -> A.foo;
functor G: A, S, mk -> A.foo { bind A.foo = () => mk(); }
fn main() {
  bind S = Concrete;
  bind mk = () => Concrete;
  bind F = G;
  let y: Concrete = true.foo();
}
