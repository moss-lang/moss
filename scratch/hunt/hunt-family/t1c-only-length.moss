# FamilyCopyApplyOk counterexample (platform root). linked-copy-bracket.moss
# with `bind F;` removed: inside G's lambda, `xs.length()` demands family F
# (PrFamily), whose closure is the copy `bind F = Arrays` made in main.
# The caller's key is rkey C' Array.length = IMth Array[Int] length
# [I32 := Z] (Z abstract in G); apply_functor installs Arrays' code's key
# (fc_outputs) read by theta, [I32 := I32]. FamilyNewOk (a) and (b) fail;
# the call misses its key.
# Oracle: stuck (XErr 6), exit 3. Native: rejects ("no matching method is
# available for this receiver: `length`"; native has no demand of F here).
# Audit: accepted (same premises as linked-copy-bracket's `bind F;`, with
# PrFamily: F only family in G producing Array.length; Arrays is in Gc,
# not Wasm). Fixed by caller-keyed install (rs = caller keys).
import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm, I32, Arrayed, Array, Arrays, .arrayed, i32_one, i32_zero;
import "../../../lib/wasip1.moss" use Wasi;

type Z;

functor F[Arrayed]: Wasm, Arrayed, Z ->
  Arrayed.arrayed, Array.length[I32 = Z], Array.get, Array.set, Array.fill, Array.copy;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume { fn run(); }
functor Gf: -> run;

functor G: Wasm, Std, Branch, Z, F -> run {
  bind run = () => {
    bind Arrayed = Int;

    let xs = 42.arrayed(i32_one);
    let l = xs.length();
    print_int(42);
    putchar(char::newline);
  };
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Z = I32;
    bind F = Arrays;
    bind Gf = G;
    bind Gf;
    run();
  }
}
