# Target: FamilyLinkNewOk signature part. A.foo : () -> S, S an implicit
# (fixed) input of family F. G is bound with S = Concrete; the demand is
# in a scope that rebinds S to Other. The body returns a Concrete; if the
# caller reads the result as Other, a match on it is wrong.
# Result: oracle rejects (F fixed in S, D84 rule 5); native rejects the demand. Audit: FixedAgreement rejects. No failure.
type A;
type S;
tag Concrete;
tag Other(Concrete);
assume S, A { fn .foo(): S; }
fn mk(): S;
functor F[A]: A -> A.foo;
functor G: A, S, mk -> A.foo { bind A.foo = () => mk(); }
fn main() {
  bind S = Concrete;
  bind mk = () => Concrete;
  bind F = G;
  {
    bind S = Other;
    let y: Other = true.foo();
    let n = match y { Other(n) => n };
  };
}
