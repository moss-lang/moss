# Target: FamilyLinkNewOk. Fixed input Y read at the bind site as the outer abstract A, which is also
# F's poly symbol name. Caller reads Concrete.m(): A (outer A = Bool); body returns y0 = true.
# Result: oracle 0, native 0. Audit: accepted; linked Y = ground d (TAbs A) = Bool on both sides. No failure.
type A;
type U;
type Y;
tag Concrete;
assume A { fn .m(): U; }
val y0: Y;
val a0: A;
functor F[A]: A, Y, y0 -> A.m[U = Y];
functor G: A, Y, y0 -> A.m[U = Y] {
  bind A.m[U = Y] = () => y0;
}
assume A, a0 {
  fn go(): A {
    bind Y = A;
    bind y0 = a0;
    bind F = G;
    let r: A = Concrete.m();
    r
  }
}
fn main() {
  bind A = Bool;
  bind a0 = true;
  let r: Bool = go();
  let q: Bool = r;
}
