# Target: FamilyLinkNewOk. v3's trick for a link: G captures Y (read as outer A) and y0, provides A.m[U=Y]
# where F promises A.m[U=A].
# Result: oracle rejects (D78 other type); native rejects. Audit: LinkBody's ResultRealizes is in G's own
# terms (Y is TAbs Y in Cb, not A), so rejected. No failure.
type A;
type U;
type Y;
tag Concrete;
assume A { fn .m(): U; }
val y0: Y;
val a0: A;
functor F[A]: A -> A.m[U = A];
functor G: A, Y, y0 -> A.m[U = Y] {
  bind A.m[U = Y] = () => y0;
}
assume A, F {
  fn use_it() {
    let r: Concrete = Concrete.m();
    match r { Concrete => () };
  }
}
assume A, a0 {
  fn go() {
    bind Y = A;
    bind y0 = a0;
    bind F = G;
    use_it();
  }
}
fn main() {
  bind A = Bool;
  bind a0 = true;
  go();
}
