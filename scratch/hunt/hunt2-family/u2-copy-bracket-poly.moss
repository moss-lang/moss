# Target: FamilyCopyRealizeOk, F's item brackets a fixed-in-H symbol with poly A (A.len[W = A]) vs H's A.len.
# Result: oracle rejects (H fixed in W, F poly in W, D84 rule 4); native rejects. Audit: CopyOutputs (W fixed in F, sigma W := Bool, () -> A vs () -> Bool differ). No failure.
type A;
type W;
tag Concrete;
assume W, A { fn .len(): W; }
fn mkw(): W;
functor F[A]: A, W -> A.len[W = A];
functor H[A]: A, W -> A.len;
functor G: A, W, mkw -> A.len { bind A.len = () => mkw(); }
fn main() {
  bind W = Bool;
  bind mkw = () => true;
  bind H = G;
  bind F = H;
  let c: Concrete = Concrete.len();
  match c { Concrete => () };
}
