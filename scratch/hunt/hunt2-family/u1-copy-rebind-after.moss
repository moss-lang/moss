# Target: FamilyCopyRealizeOk, round-1 t11 shape with Z rebound after the copy (so Z /= W at the demand).
# Result: oracle rejects (D62, F at another instantiation); native rejects. Audit: Satisfies/instantiation of F at use_it. No failure.
type A;
type W;
type Z;
tag Concrete;
tag Other(Concrete);
assume W, A { fn .len(): W; fn .wid(): W; }
fn mkw(): W;
functor F[A]: A, W, Z -> A.len[W = Z], A.wid;
functor H[A]: A, W -> A.len, A.wid;
functor G: A, W, mkw -> A.len, A.wid { bind A.len = () => mkw(); bind A.wid = () => mkw(); }
assume W, Z, F { fn use_it(): Z { let y: Z = true.len(); y } }
fn main() {
  bind W = Concrete;
  bind Z = Concrete;
  bind mkw = () => Concrete;
  bind H = G;
  bind F = H;
  bind Z = Other;
  let o: Other = use_it();
  let n = match o { Other(n) => n };
}
