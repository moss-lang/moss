# hunt-coherent control for sig-nonreq-shadow.moss: U stays Int, so the
# two Int.m signatures agree (FamilyCoherent holds). The family's Int.m
# still shadows demo's own Int.m inside the argument of k.n.
# Oracle: prints 7 (G's Int.m), exit 0. Native: prints 42 (demo's Int.m).
# Type-safe, but the two implementations disagree on which Int.m runs.
import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm;
import "../../../lib/wasip1.moss" use Wasi;
type A;
type U;
val u0: U;
assume A {
  fn .m(): U;
  fn .n(x: A): A;
}
functor F[A]: U, u0 -> A.m, A.n;
functor G: A, U, u0 -> A.m, A.n {
  bind A.m = () => u0;
  bind A.n = (x) => x;
}
assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind U = Int;
    bind Int.m = () => 42;
    bind u0 = 7;
    bind F = G;
    let k: Int = 7;
    print_int(k.n(k.m()));
    putchar(char::newline);
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; demo(); }
}
