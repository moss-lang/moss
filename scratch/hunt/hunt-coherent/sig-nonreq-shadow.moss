# hunt-coherent: FamilyCoherentOk (PublicBodySlice) is FALSE, and so is
# type safety for this program as Audit elaborates it.
# .m's signature mentions U, which is not one of .m's requirements (w_reqs
# m = [A], its assumes). So .m's θ (AppOf: requirements the signature
# mentions) is [] and does not record U. demo binds Int.m while U = Int
# (signature () -> Int, θ []), rebinds U = Bool, puts family F in force,
# and calls k.n(k.m()). k.n is demanded from F at A := Int (PrFamily); F's
# result also has Int.m, read with U = Bool: () -> Bool, θ []. Same
# receiver, method and θ, different signature: FamilyCoherent C Cr ks fails
# with C1 = C. PrFamily evaluates the argument k.m() inside the family's
# scope (apply_expression), where run-time key IMth Int m [] is G's closure
# returning u0 = true, while k.m() was typed Int.
# Oracle: elaborates, then "[moss_ref: stuck (XErr 14)]", exit 3.
# Native: prints 42, exit 0 (it uses demo's Int.m).
# Audit: accepted (walk-through in REPORT.md).
import "../../../lib/wasi.moss" use WasiStd;
import "../../../lib/wasistd.moss" use Branch;
import "../../../lib/wasm.moss" use Wasm;
import "../../../lib/wasip1.moss" use Wasi;
type A;
type U;
val u0: U;
assume A {
  fn .m(): U;
  fn .n(x: A): A;
}
functor F[A]: U, u0 -> A.m, A.n;
functor G: A, U, u0 -> A.m, A.n {
  bind A.m = () => u0;
  bind A.n = (x) => x;
}
assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind U = Int;
    bind Int.m = () => 42;
    bind U = Bool;
    bind u0 = true;
    bind F = G;
    let k: Int = 7;
    print_int(k.n(k.m()));
    putchar(char::newline);
  }
}
assume Wasm, Wasi, Branch {
  fn main() { bind WasiStd; demo(); }
}
