# realize2: COUNTEREXAMPLE to CN.ChainRealizeOk (length-zero chain, linked
# root), an observable variant of linknewpf's m7 (kept-output receiver).
# G does not take F's input T. G's body applies Make, whose output T is not
# in force in G, so BApplyAbstract installs it as itself (T is a pin, M(F),
# but pins only stop `bind T`); at run time it means Char. G binds
# T.m = () => print_int(this.num()), num being Make's Char method. F's key
# T.m reads at link_site as T.m, while the caller files it under Bool.m.
# So `true.m()` runs Char's `code` on a Bool.
# Oracle (ob-sigclose var moss_m2): elaborates; the run is stuck (XErr 14).
# Native (ob-family, seed 1h1710x0): rejects at `bind F = G` ("compilation
# failed: `T`"). Control m8-control.moss (caller T = Char): oracle prints 48, 10.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;
fn .m();
fn .num(): Int;
fn done();
functor Make: Std -> T, T.num;
functor Maker: Std -> T, T.num {
  bind T = Char;
  bind T.num = () => this.code();
}
functor F: T, Std -> T.m, done;
functor G: Make, Std -> T.m, done {
  bind Make;
  bind T.m = () => { print_int(this.num()); putchar(char::newline); };
  bind done = () => {};
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std {
  fn demo() {
    bind T = Bool;
    bind Make = Maker;
    bind F = G;
    bind F;
    true.m();
    false.m();
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
