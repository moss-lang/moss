# Control: the linked body rebinds an input of F that F's result does not
# mention (no merges). Do the implementations accept it?
type A;
type T;
tag Concrete;
fn .m();
functor F[A]: A, T -> A.m;
functor G: A, T -> A.m { bind T = Bool; bind A.m = () => { }; }
fn main() {
  bind T = Concrete;
  bind F = G;
  Concrete.m();
}
