# Family F[X] whose inputs merge X with T (two readings of A.gimme).
# The linked body G rebinds T (not mentioned by F's result) and binds the
# method at the rebound representative.
type Foo;
type A;
type T;
type X;
tag Concrete;
fn .gimme(): Foo;
fn .m();
context Merge = A, X, T, A.gimme[Foo=X], A.gimme[Foo=T];
functor F[X]: Merge -> X.m;
functor G: Merge -> X.m { bind T = Bool; bind T.m = () => { if this { } }; }
fn main() {
  bind A = Concrete;
  bind T = Concrete;
  bind Foo = Bool;
  bind A.gimme = () => true;
  bind F = G;
  Concrete.m();
}
