# Linked body G does not take T, an input of F that F's result key's
# receiver mentions. G's body applies Make, whose output T is not in force
# in G, so it is installed as itself (kept): at run time T means Bool and
# Make provides T.flipit as Bool.flip. G binds T.m at that T, calling
# flipit on its receiver. F's key T.m is read at G's site as T.m, while the
# caller files it under its own T (Concrete): Concrete.m() runs Bool.flip
# on a Concrete.
type T;
fn .m();
fn .flipit(): T;
fn done();
tag Concrete;
functor Make: -> T, T.flipit;
functor Maker: -> T, T.flipit { bind T = Bool; bind T.flipit = Bool.flip; }
functor F: T -> T.m, done;
functor G: Make -> T.m, done {
  bind Make;
  bind T.m = () => { this.flipit(); };
  bind done = () => {};
}
fn main() {
  bind T = Concrete;
  bind Make = Maker;
  bind F = G;
  bind F;
  Concrete.m();
}
