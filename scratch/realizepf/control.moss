import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type I;
type Z;
assume { val kk: Int; }

assume I {
  fn get(): I;
  val vi: I;
}
fn show(x: Z);

functor H[I]: Std, I, vi -> kk, get;
functor F[I]: Std, I, Z, vi -> kk, get;
functor G: Std, I, vi -> kk, get {
  bind kk = 1;
  bind get = () => vi;
}
functor K: Std -> Z, show;
functor KB: Std -> Z, show {
  bind Z = Char;
  bind show = (x) => { print_int(x.code()); putchar(char::newline); };
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std {
  fn demo() {
    bind Z = Bool;
    bind K = KB;
    bind K;
    bind H = G;
    bind F = H;
    bind I = Bool;
    bind vi = true;
    bind F;
    let b: Bool = get(); if b { print_int(7); }
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
