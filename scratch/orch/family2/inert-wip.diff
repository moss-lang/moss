+(* A formed table's keys are in scope (each key's entry is itself, merged). *)
+Lemma table_formed_keys_scope : forall Cf, PublicCallRealize.TableFormed Cf ->
+  forall k, In k (map fst (A.c_ty Cf)) -> In k (PublicFormation.scope_gens Cf).
+Proof.
+  intros Cf [Tf _] k Ik. destruct (nlook_some_key _ k _ Ik) as [v L].
+  pose proof (Tf k v L) as Ev. apply (PublicFormation.table_scope Cf k (TAbs k)); [|left; reflexivity].
+  rewrite <- Ev. exact (nlook_in _ _ _ _ L).
+Qed.
