+Lemma lookup_capture_none : forall d K y, ~ In y K -> lookup_subst y (capture_meanings d K) = None.
+Proof.
+  intros d K y. induction K as [|g rest IH]; intros N; [reflexivity|]. cbn.
+  destruct (Nat.eqb_spec y g) as [->|_]; [exfalso; apply N; left; reflexivity|].
+  apply IH. intros I. apply N. right. exact I.
+Qed.
