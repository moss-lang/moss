+(* Capture keeps the grounding of a type whose generations are captured,
+   or declared symbols out of scope (which have no meaning). *)
+Lemma ground_capture_inert : forall d K C t, Inert C d -> incl (PublicFormation.scope_gens C) K ->
+  (forall y, In y (A.gens t) -> In y K \/ A.kind_sym W y = Some A.DKType) ->
+  app_subst (capture_meanings d K) t = ground d t.
+Proof.
+  intros d K C t Ine SK Sc. unfold ground. apply subst_agree_on. intros x Ix. cbn [app_subst].
+  destruct (in_dec Nat.eq_dec x K) as [I|N]; [rewrite (lookup_capture d K x I); reflexivity|].
+  destruct (Sc x Ix) as [I|Kd]; [contradiction|].
+  rewrite (lookup_capture_none d K x N). exact (eq_sym (Ine x Kd (fun I => N (SK x I)))).
+Qed.
