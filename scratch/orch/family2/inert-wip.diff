+Lemma inert_callee : forall Cf d th dc, PublicCallRealize.TableFormed Cf -> map fst th = map fst (A.c_ty Cf) ->
+  Inert Cf (callee_env d th dc).
+Proof.
+  intros Cf d th dc Tf Keys y _ Ny. unfold ground. cbn [app_subst type_meanings callee_env].
+  destruct (lookup_subst y (map (fun q => (fst q, ground d (snd q))) th)) as [u|] eqn:L; [|reflexivity].
+  exfalso. apply Ny. apply (table_formed_keys_scope Cf Tf). rewrite <- Keys.
+  apply lookup_some_key in L. rewrite map_map in L. exact L.
+Qed.
