+Lemma lookup_some_key : forall y s u, lookup_subst y s = Some u -> In y (map fst s).
+Proof.
+  intros y s u. induction s as [|[k v] r IH]; intros L; [discriminate|]. cbn in L |- *.
+  destruct (Nat.eqb_spec y k) as [->|_]; [left; reflexivity|right; exact (IH L)].
+Qed.
+
+Lemma nlook_some_key : forall X k (l : list (nat * X)), In k (map fst l) -> exists v, A.nlook k l = Some v.
+Proof.
+  intros X k l. induction l as [|[k' v] r IH]; intros I; [destruct I|]. cbn.
+  destruct (Nat.eqb_spec k k') as [->|Ne]; [exists v; reflexivity|].
+  destruct I as [E|I]; [cbn in E; congruence|exact (IH I)].
+Qed.
