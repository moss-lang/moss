+(* A declared type symbol out of the context's scope has no meaning (it
+   grounds as itself). Keys and types may mention such a symbol up to
+   declared symbols (PublicFormation.GenScoped): a callee requirement the
+   caller leaves unbound is read at the call site as itself. Meanings are
+   made only for a body's requirements (its table keys), an abstract
+   application's outputs (made table keys), and a lambda's captured
+   generations (in scope where captured). *)
+Definition Inert (C : A.cx) (d : environment) : Prop :=
+  forall y, A.kind_sym W y = Some A.DKType -> ~ In y (PublicFormation.scope_gens C) -> ground d (TAbs y) = TAbs y.
+
