import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;
tag Concrete;
fn mk(): T;

functor F: -> T, mk;
functor FM: -> T, mk { bind T = Concrete; bind mk = () => Concrete; }

val K: () = { bind F = FM; bind F; let y = mk(); };

assume Std {
  fn demo() {
    bind F = FM;
    bind F;
    let z = mk();
    let w = K;
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
