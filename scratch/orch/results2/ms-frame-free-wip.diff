+(* The generations the type table mentions (the table part of
+   context_gens). *)
+Definition table_gens (C : A.cx) : list nat :=
+  flat_map (fun q => (A.gens (snd q) ++ A.gens (A.canon C (snd q)))%list) (A.c_ty C).
+
+(* The environment gives a meaning only to a symbol of the type table or
+   to a fresh generation the table mentions (T16): what an application
+   makes is then free (result_environment's freshness check). Frame-free:
+   fresh generations enter the table only as output destinations
+   (t |-> TAbs g), and the table only grows within a body. *)
+Definition MeaningsScoped (C : A.cx) (d : environment) : Prop :=
+  forall x, lookup_subst x (type_meanings d) <> None ->
+    In x (map fst (A.c_ty C)) \/ (A.Fresh W x /\ In x (table_gens C)).
+
 Definition Pre n F C d types H g st : Prop :=
-  FrameOk F /\ CtxLocals F C d types /\ locals_typed W P H g types /\ state_ok H st /\ Realizes n C d H /\ Formed F C.
+  FrameOk F /\ CtxLocals F C d types /\ locals_typed W P H g types /\ state_ok H st /\ Realizes n C d H /\ Formed F C /\
+  MeaningsScoped C d.
+
+Definition MeaningsKeyed (C : A.cx) (d : environment) : Prop :=
+  forall x, lookup_subst x (type_meanings d) <> None -> In x (map fst (A.c_ty C)).
+
+Lemma ms_keyed : forall C d, MeaningsKeyed C d -> MeaningsScoped C d.
+Proof. intros C d K x L. left. exact (K x L). Qed.
+
+Lemma table_gens_mono : forall C C', A.c_sub C' = A.c_sub C -> incl (A.c_ty C) (A.c_ty C') ->
+  incl (table_gens C) (table_gens C').
+Proof.
+  intros C C' Es Inc x Ix. unfold table_gens in *. apply in_flat_map in Ix as [q [Iq Ix]].
+  apply in_flat_map. exists q. split; [exact (Inc q Iq)|]. unfold A.canon in *. rewrite Es. exact Ix.
+Qed.
+
+Lemma ms_same : forall C C' d d', type_meanings d' = type_meanings d ->
+  incl (map fst (A.c_ty C)) (map fst (A.c_ty C')) -> incl (table_gens C) (table_gens C') ->
+  MeaningsScoped C d -> MeaningsScoped C' d'.
+Proof.
+  intros C C' d d' Em Ik If Ms x L. rewrite Em in L. destruct (Ms x L) as [K|[Fr I]];
+    [left; exact (Ik x K)|right; exact (conj Fr (If x I))].
+Qed.
+
+Lemma ms_grow : forall C C' d d', type_meanings d' = type_meanings d ->
+  A.c_sub C' = A.c_sub C -> incl (A.c_ty C) (A.c_ty C') ->
+  MeaningsScoped C d -> MeaningsScoped C' d'.
+Proof.
+  intros C C' d d' Em Es Inc. apply ms_same; [exact Em| |exact (table_gens_mono C C' Es Inc)].
+  intros x Ix. apply in_map_iff in Ix as [q [<- Iq]]. apply in_map. exact (Inc q Iq).
+Qed.
+
+Lemma ms_keep : forall C C' d d', type_meanings d' = type_meanings d -> A.c_ty C' = A.c_ty C ->
+  A.c_sub C' = A.c_sub C -> MeaningsScoped C d -> MeaningsScoped C' d'.
+Proof. intros C C' d d' Em Et Es. apply ms_grow; [exact Em|exact Es|rewrite Et; intros x I; exact I]. Qed.
+
+(* MeaningsScoped at a context with the same table and merges, and an
+   environment with the same meanings (by conversion). *)
+Ltac ms_tac Ms := match type of Ms with MeaningsScoped ?C ?d => match goal with
+  |- MeaningsScoped ?C' ?d' => exact (ms_keep C C' d d' eq_refl eq_refl eq_refl Ms) end end.
 
