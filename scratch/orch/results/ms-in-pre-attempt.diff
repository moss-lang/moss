+Definition MeaningsScoped (F : A.frame) (C : A.cx) (d : environment) : Prop :=
+  forall x, lookup_subst x (type_meanings d) <> None ->
+    In x (map fst (A.c_ty C)) \/ (A.Fresh W x /\ In x (A.fr_fresh F)).
