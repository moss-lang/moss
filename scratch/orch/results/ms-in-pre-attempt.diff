+Lemma ms_same : forall F F' C C' d d', type_meanings d' = type_meanings d ->
+  incl (map fst (A.c_ty C)) (map fst (A.c_ty C')) -> incl (A.fr_fresh F) (A.fr_fresh F') ->
+  MeaningsScoped F C d -> MeaningsScoped F' C' d'.
+Proof.
+  intros F F' C C' d d' Em Ik If Ms x L. rewrite Em in L. destruct (Ms x L) as [K|[Fr I]];
+    [left; exact (Ik x K)|right; exact (conj Fr (If x I))].
+Qed.
+
+Lemma ms_keep : forall F C C' d d', type_meanings d' = type_meanings d -> A.c_ty C' = A.c_ty C ->
+  MeaningsScoped F C d -> MeaningsScoped F C' d'.
+Proof. intros F C C' d d' Em Et. apply ms_same; [exact Em|rewrite Et; intros x I; exact I|intros x I; exact I]. Qed.
