; The reference implementation's executable (README.md): Extract.v
; extracts the front end, the elaborator, the proved passes and Audit.v's
; interpreter, and driver.ml drives them. The extracted code links Rocq's
; own runtime library for its primitive integers, floats and arrays
; (Uint63, Float64, Parray, from rocq-runtime.kernel).

(rocq.extraction
 (prelude Extract)
 (extracted_modules
  Ascii Audit AuditBase BootstrapRun ProgramCapTrim InterpreterCompiled InterpreterFast ProgramFastPath InterpreterLazy ProgramPrune BinInt BinNat BinNums
  LoadWorld LoadListed BinPos Bool0 Byte Byte0 Datatypes Decimal EaBase
  EaBind EaBudget EaCall EaCtx EaDecide EaDepth EaExpand EaExpr EaFamily EaFunctor EaMain
  EaPlatform EaTypes ElabWorld ExecutionModel
  FloatClass Hexadecimal HTrie IntDef List0 ListDef MossX Nat NatDef NatTrie NMap
  Number Parse PeanoNat PosDef PrimArray PrimFloat PrimInt63 PublicMergePresent PublicWorld
  ReqsSolve ReqsTotal SnapshotLoader Specif String0 Sx Uint63Axioms WorldSound)
 (theories NM Stdlib))

; Flambda honours the `[@inlined]` in Extract.v's `nat_case`, releasing
; each frame's earlier machine-state versions at their last use.
; The full x86 Linux self-compile at 9af8a75 peaked at 2.7 GiB.

(rule
 (target flambda)
 (action
  (progn
   (system
    "test %{ocaml-config:flambda} = true || { echo 'the driver needs a flambda OCaml: without it the interpreter retains every version of linear memory' >&2; exit 1; }")
   (write-file %{target} ""))))

(executable
 (name driver)
 (libraries unix rocq-runtime.kernel zarith)
 (link_deps flambda)
 (flags (:standard -w -a))
 (ocamlopt_flags (:standard -O3 -inline 200 -unsafe)))
