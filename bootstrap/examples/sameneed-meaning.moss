# Cross-context need identity changes meaning (AUDIT-CHANGES.md #51;
# criteria.md section 2, coherence). F[Z] fixes X and Y (run's assumes
# mention them; Z is F's only polymorphic input), so 3b lets G capture a need
# keyed at X. F merges X with Y through A.gimme, G through B.gimme (B is G's
# own), in opposite orders. demo binds X.m to `true`, binds F = G, then
# rebinds X.m to `false` before applying F: linked, G reads the
# application's X.m and prints 2; captured, it reads the bind's and prints 1.
# sameneed-meaning-agree.moss is this program with the orders agreeing.
# - Oracle: prints 1 (G's X.m is not F's Y.m, so it is captured). The
#   agreeing order prints 2.
# - Native: prints 1, in both orders. It also prints 1 with no merge at all,
#   where the oracle and Audit print 2: native captures needs keyed at fixed
#   inputs, a separate divergence this change does not touch.
# - Audit before: accepted under every orientation, with two meanings: 2 when
#   F and G chose the same representative (X.m linked), 1 otherwise (X.m
#   captured, which 3b allows since X is fixed).
# - Audit now: prints 2 under every orientation (X.m is linked).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type B;
type X;
type Y;
type Z;

fn .gimme(): Foo;
fn .m(): Bool;
val vx: X;

assume Std, X, Y {
  fn run(): Int;
}

context MergeF = A, X, Y, A.gimme[Foo=X], A.gimme[Foo=Y], X.m;
context MergeG = B, X, Y, B.gimme[Foo=Y], B.gimme[Foo=X], X.m;

functor F[Z]: Std, MergeF -> run;

functor G: Std, MergeG, vx -> run {
  bind run = () => if vx.m() { 1 } else { 2 };
}

assume Std, MergeF, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind B = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Char;
    bind A.gimme = () => this;
    bind B.gimme = () => this;
    bind vx = char::a;
    bind X.m = () => true;
    bind F = G;
    bind X.m = () => false;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
