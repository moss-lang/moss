import "../../lib/wasm.moss" as w use Wasm, Gc, Boxed, StructRef, .boxed;
type Saved;
assume Wasm, Gc {
 fn main() {
  bind Boxed=w::I32;
  bind w::Heap;
  let integer_ref=w::i32_one.boxed();
  let raw=match integer_ref { w::Ref(raw)=>raw };
  bind Boxed=w::F64;
  bind w::Heap;
  bind Saved=w::F64;
  bind w::F64=w::I32;
  bind Boxed=Saved;
  let bad=w::Ref(raw);
  let y=bad.deref();
  w::f64_add(y,y);
 }
}
