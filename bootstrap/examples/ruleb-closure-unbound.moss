# Rule B for a closure (AUDIT-CHANGES #60): `bind H = P;` captures P's
# input T, which H does not take, and T is not in force where P is bound.
# Audit: rejects (BFunClosure). Oracle: rejects ("binding `H` to `P`
# captures `T`, which is not in force here"); before #60 it accepted.
# Native: accepts (exit 0; needs rule B). Control: ruleb-closure-bound.moss.
type T;
fn run();
functor H: -> run;
functor P: T -> run { bind run = () => (); }
fn main() { bind H = P; bind H; run(); }
