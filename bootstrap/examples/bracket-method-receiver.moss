import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;

assume Std, T {
  tag Box(T);
  fn .m(): Int;
  fn .k(): Int;
}

assume Std, T, T.k {
  fn Box.get(): Int { match this { Box(x) => x.k() } }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind T = Char;
    bind T.k = () => this.code();
    bind Box.m[T=Bool] = Box.get;
    let b = Box[T=Bool](true);
    print_int(b.m());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
