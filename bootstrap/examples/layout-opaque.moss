# D58 (AUDIT-CHANGES #90): an abstract type is a leaf, however it is bound
# later, and a user's own tag over a machine reference type is one scalar.
# - `Link` is abstract, put in force by the context `Links`; `LNode`'s
#   payload mentions it, so it is one scalar of LNode's layout. main binds
#   `Link = LHold` afterwards, a tag holding a `Ref[Boxed=LNode]`: the
#   bind's right-hand side is read at the old meanings (D72), so LHold here
#   is `LHold[Link=LEnd]`, and no bind builds an infinite type.
# - `Handle[Target]` is the program's own phantom wrapper of `StructRef`,
#   so `LTree`, which holds `Handle[Target=LTree]`, has a layout.
# - `LPair[LT]`'s members are abstract, and it is used at `LT = LEnd`.
# Prints 7.
# Verdicts: oracle 7; native 7; Audit accepts (before and after #90).
import "../../lib/wasm.moss" use Wasm, StructRef, Boxed, Ref, Heap, .boxed;
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasip1.moss" use Wasi;

type Link;
type Target;
type LT;
tag LNil;
tag LEnd;
context Links = Link;
assume Std, Links { tag LNode { value: Int, next: LNil | Link }; }
assume Std, Wasm, Links { tag LHold(Ref[Boxed=LNode]); }
assume Target { tag Handle[Target](StructRef); }
tag LTree { left: LNil | Handle[Target=LTree] };
assume LT { tag LBox[LT](LT); tag LPair[LT] { a: LT, b: LBox, c: LNil | LBox }; }
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Link = LEnd;
    let first = LNode { value = 3, next = LEnd };
    bind Boxed = LNode;
    bind Heap;
    bind Link = LHold;
    let second = LNode { value = 4, next = LHold[Link=LEnd](first.boxed()) };
    let t = LTree { left = LNil };
    bind LT = LEnd;
    let p = LPair { a = LEnd, b = LBox(LEnd), c = LNil };
    let n = match second.next {
      LNil => 0,
      LHold(r) => second.value + r.deref().value,
    };
    putchar((n + char::digit0.code()).char());
    putchar(char::newline);
  }
}
