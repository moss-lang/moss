# expand (scratch/orch/expand-AUDIT.md): REJECTED (NoExpandingCycle, InstantiationsBounded), a cost of choice (a).
# CONTROL that choice (a) rejects. As expand-functor-output, but the functor
# G bound to F has a constant output (T = A): specialization is finite, and
# native compiles it. The check does not inspect which body is bound to F,
# so it counts F's output as possibly containing its input T.
# Oracle (this worktree's moss_m2): accepts and prints 5
# Oracle variant with the check (scratch/expand/variant): rejects: expanding cycle
# Native (ob-family moss, seed 1h1710x0): accepts and prints 5
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
type U;
tag A;
assume U { tag Box(U); }
assume U, T { fn wrap(x: U): T; }
functor F: U -> T, wrap;
functor G: U -> T, wrap {
  bind T = A;
  bind wrap = (x) => A;
}
assume Std, U, T, F {
  fn rec(x: T, n: Int): Int {
    if n == 0 { return 0; }
    bind U = T;
    bind F;
    1 + rec(wrap(x), n - 1)
  }
}
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind T = A;
    bind U = A;
    bind F = G;
    print_int(rec(A, 5)); nl();
  }
}
