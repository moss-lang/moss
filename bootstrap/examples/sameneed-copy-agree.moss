# Control for sameneed-copy.moss: F's and H's merges in the same order.
# - Oracle: prints 7. Native: prints 7.
# - Audit before and now: accepts under every orientation (7).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type X;
type Y;

fn .gimme(): Foo;
fn .m(): Bool;

assume Std {
  fn run(): Int;
}

context MergeXY = A, X, Y, A.gimme[Foo=X], A.gimme[Foo=Y], X.m;
context MergeYX = A, X, Y, A.gimme[Foo=Y], A.gimme[Foo=X], X.m;

functor F: Std, MergeXY -> run;
functor H: Std, MergeXY -> run;

functor G: Std, MergeXY -> run {
  bind run = () => 7;
}

assume Std, MergeXY, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Char;
    bind X = Char;
    bind Y = Char;
    bind A.gimme = () => this;
    bind X.m = () => true;
    bind H = G;
    bind F = H;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
