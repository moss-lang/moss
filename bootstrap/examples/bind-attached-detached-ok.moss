# Q3 control (AUDIT-CHANGES #70). The same receiver, but the bind names the
# *detached* method: `Q.describe` with Q abstract names `.describe`, and
# after `bind Q = Meter` its key is `Meter.describe`, which wins over the
# attached method (D77). Method resolution is static, so this bind is the
# detached symbol even though Q turns out to be the tag Meter: still legal.
# Verdicts: Audit accepts; oracle prints mxm; native prints mxm.
tag Meter(Int);
fn .describe();
type Q;

assume Std {
  fn Meter.describe() { putchar(char::m); }
}

assume Base {
  fn main() {
    bind StdBase;
    let d = Meter(3);
    d.describe();
    {
      bind Q = Meter;
      bind Q.describe = () => putchar(char::x);
      d.describe();
    }
    d.describe();
    putchar(char::newline);
  }
}
