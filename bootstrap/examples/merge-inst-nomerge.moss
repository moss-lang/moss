# Δ4 control: two entries of v at T=A and T=B, not relying on A = B.
# Audit and oracle: accept (g's own context merges A with B; nothing calls
# g). Native: accepts.
type T;
type U;
type A;
type B;
assume T, U { val v: U; }
context K1 = U, A, v[T=A];
context K2 = U, B, v[T=B];
assume K1, K2 { fn g() {} }
fn main() {}
