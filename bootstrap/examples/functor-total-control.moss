# Control for FunctorTotal (AUDIT-CHANGES #77): Over binds Scalar and
# Scalar.add by name, and y by applying Inner, whose declared result is y.
# Verdicts: oracle accepts; native accepts; Audit before accepts; now accepts.
import "../../lib/num.moss" use .add;
type Scalar;
tag Num;
assume Scalar { context BaseAdd = Scalar, Scalar.add; }
val x: ();
val y: ();
functor Inner: x -> y { bind y = (); }
functor Over: x -> BaseAdd, y {
  bind Scalar = Num;
  bind Scalar.add = (rhs) => Num;
  bind Inner;
}
assume x {
  fn demo() {
    bind Over;
    let n: Scalar = Num;
    match n + n { Num => () }
  }
}
fn main() { bind x = (); demo(); }
