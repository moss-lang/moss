# expand (D89, AUDIT-CHANGES.md #48, #52 and #55): REJECTED
# (NoExpandingCycle, InstantiationsBounded).
# Polymorphic recursion through a bracket application on a call:
# `nest[T=Wrap](w, n - 1)` is `{ let %arg0 = w; let %arg1 = n - 1;
# bind T = Wrap; nest(%arg0, %arg1) }` (Syntax.call_block), so its call θ
# is T := Wrap(T), a strict edge (nest, T) -> (nest, T), as in
# expand-polyrec.moss with the bind written as a bracket.
# Oracle (moss_m2): accepts and prints 5
# Oracle variant with the check (scratch/expand-variant): rejects: expanding cycle, nest's T grows into nest's T
# Native (with lower::desugar_call_brackets): crashes at compile time (call stack exhausted)
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn nl() { putchar(char::newline); }
}
type T;
tag A;
assume Std, T {
  tag Wrap(T);
  fn nest(x: T, n: Int): Int {
    if n == 0 { return 0; }
    1 + nest[T=Wrap](Wrap(x), n - 1)
  }
}
assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind T = A;
    print_int(nest(A, 5)); nl();
  }
}
