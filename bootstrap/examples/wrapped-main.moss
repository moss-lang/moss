import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;
import "./wrapped-main-root.moss" as o;

assume Std {
  tag Knock(Int);
  fn .m();
}

assume Std, Knock.m {
  fn knock(k: Knock) { k.m(); }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    o::main();
    bind Knock.m = o::main;
    knock(Knock(1));
  }
}
