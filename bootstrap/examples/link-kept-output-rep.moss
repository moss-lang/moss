# realize2 (scratch/orch/realize2-AUDIT.md, second change): REJECTED by
# Audit's LinkBody clause `forall t, In t made -> nlook t (c_ty Cu) = None`.
# (realize2's pin clause in BApplyAbstract, since dropped, did not reject it.) The program was a
# COUNTEREXAMPLE to CN.ChainRealizeOk for a world whose merge for F picks T
# as the representative of X (MostGeneralMerge allows either, and
# w_context is a witness).
# F[X]'s context merges X with T (two readings of A.gimme), so F's key X.m
# reads at F's inputs as T.m. M(F) = {X}, so T is not a pin. G does not
# take T. Its `bind Make;` keeps Make's output T as itself (Char at run
# time), and it binds T.m on it. link_site reads T.m as T.m (T is not in
# G's table), so ResultRealizes held. The caller (X = T = Bool) files it
# under Bool.m, and `true.m()` would run Char's `code` on a Bool.
# Oracle: rejects at `bind F = G` ("does not provide `X.m`"), in either
# context order: its representative is X. Native: rejects ("does not
# satisfy the required signature: `m`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type T;
type X;
tag Concrete;
fn .gimme(): Foo;
fn .m();
fn .num(): Int;
context Merge = A, T, X, A.gimme[Foo=T], A.gimme[Foo=X];
functor Make: Std -> T, T.num;
functor Maker: Std -> T, T.num {
  bind T = Char;
  bind T.num = () => this.code();
}
functor F[X]: Merge, Std -> X.m;
functor G: Make, Std -> T.m {
  bind Make;
  bind T.m = () => { print_int(this.num()); putchar(char::newline); };
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume Std {
  fn demo() {
    bind A = Concrete;
    bind T = Bool;
    bind X = Bool;
    bind Foo = Bool;
    bind A.gimme = () => true;
    bind Make = Maker;
    bind F = G;
    bind F;
    true.m();
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
