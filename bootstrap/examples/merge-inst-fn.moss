# Δ4 (AUDIT-CHANGES #61, D43): as merge-inst-val.moss with a fn f() whose
# signature does not mention T: merging f[T=A] with f[T=B] unifies A with B.
# Audit: accepts (by reading). Oracle: accepts (before: rejects).
# Native: rejects (exit 1; needs the same change).
type T;
type A;
type B;
assume T { fn f(); }
context K1 = A, f[T=A];
context K2 = B, f[T=B];
assume A { fn take(a: A); }
assume K1, K2, take { fn g(b: B) { take(b); } }
fn main() {}
