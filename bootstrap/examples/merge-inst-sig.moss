# Δ4 control (D43's own shape): f's signature mentions T, so A and B
# merge through the signature, before and after #61.
# Audit, oracle and native: accept.
type T;
type A;
type B;
assume T { fn f(): T; }
context K1 = A, f[T=A];
context K2 = B, f[T=B];
assume A { fn take(a: A); }
assume K1, K2, take { fn g(b: B) { take(b); } }
fn main() {}
