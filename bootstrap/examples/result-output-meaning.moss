import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type T;
fn mk(): T;
fn id(x: T): T;

functor F: -> T, mk, id;
functor G: -> T, mk, id { bind T = Bool; bind mk = () => true; bind id = (x) => x; }

assume Std {
  fn demo() {
    bind F = G;
    bind F;
    let v = id(mk());
    putchar(char::digit1);
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
