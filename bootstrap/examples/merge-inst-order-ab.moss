# Δ4 (AUDIT-CHANGES #61, D43): g assumes f twice, at T=A (K1) and at T=B
# (K2), in the order K1, K2; h provides f at T=A only and calls g.
# Merging the two entries of f unifies their instantiations, so g's
# context merges A with B, and h (where A and B are distinct) cannot call
# g. Before, the merged key kept the first entry's instantiation (T=A),
# so this order was accepted and merge-inst-order-ba.moss was rejected.
# Audit: rejects (by reading). Oracle: rejects (before: accepted).
# Native: accepts (exit 0; needs the same change).
type T;
type A;
type B;
assume T { fn f(); }
context K1 = A, B, f[T=A];
context K2 = A, B, f[T=B];
assume K1, K2 { fn g() { f(); } }
assume K1 { fn h() { g(); } }
fn main() {}
