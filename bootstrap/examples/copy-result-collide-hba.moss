# AUDIT-CHANGES #58 (criteria section 2, coherence; D84 rule 7).
# As copy-result-collide.moss, with H's result listed B.m, A.m.
# Audit before: accepts, prints a (argued). Audit now: rejects (argued).
# Oracle (moss_m2): prints b (so the oracle's choice follows H's order).
# Oracle variant d7: rejects.
# Native (ob-family moss, seed 1h1710x0): rejects ("... required signature: `A`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type C;
type A;
type B;
fn .gimme(): Foo;
assume A { fn .m(); }
context Merge = C, A, B, C.gimme[Foo=A], C.gimme[Foo=B];
functor H: Std, A, B -> B.m, A.m;
functor F: Std, Merge -> A.m, B.m;
assume Std {
  functor G: Std, A, B -> B.m, A.m {
    bind A.m = () => putchar(char::a);
    bind B.m = () => putchar(char::b);
  }
}

assume Std, H, Foo {
  fn use_it() {
    bind F = H;
    bind A = Int; bind B = Int; bind C = Int; bind Foo = Int;
    bind C.gimme = () => 0;
    bind F;
    one.m();
  }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() { bind WasiStd; bind H = G; use_it(); putchar(char::newline); }
}
