# BindMergesOk (PublicBodySlice) is false. `bind F = G;` where G's context
# merges Y into Z (its two readings of `A.gimme`, merge Y := Z), F takes
# neither, and Y is not in force where G is bound (only Z is). The captured
# `A.gimme` satisfies G's context there (Satisfies' merge clause only binds
# merges whose symbols are all in force), so Audit, the oracle and native
# accept the program; it prints 7. At an application the body's
# environment reads Y as the bind site does (Y is not in force there) and Z
# as Bool, so it does not absorb G's merge; nothing in the body reads Y.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type Y;
type Z;

fn .gimme(): Foo;

assume Std {
  fn run(): Int;
}

context Merge = A, Y, Z, A.gimme[Foo=Y], A.gimme[Foo=Z];

functor F: Std -> run;

functor G: Std, Merge, Y, Z -> run {
  bind run = () => 7;
}

assume Std, F {
  fn go(): Int { bind F; run() }
}

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
  fn demo() {
    bind A = Char;
    bind Foo = Bool;
    bind Z = Bool;
    bind A.gimme = () => true;
    bind F = G;
    print_int(go());
    putchar(char::newline);
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
