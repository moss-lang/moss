# realize3 (scratch/orch/realize3-AUDIT.md): REJECTED by Audit at `bind F = G`
# since link_site reads F's input symbols at G's own table and only the output
# roles (gen t) at the body's final table. Before that, for a world whose merge
# for F picks T as the representative of X (MostGeneralMerge allows either, and
# w_context is a witness), it was a COUNTEREXAMPLE to CN.ChainRealizeOk at the
# length-zero chain (CCRefl), by hand reading of Audit's rules.
# It is link-kept-output-rep.moss with the write done by `bind T = Char`
# instead of an application's kept output: BTypeBind has made = [], so
# LinkBody's made clause does not see it, and T is not a pin since outputs
# are not in M(F).
# - F[X]'s context merges X with T (two readings of A.gimme). T is both an
#   input of F (through Merge) and an output of F.
# - F's key X.m reads at F's inputs as T.m: the input T, not the output role
#   gen T, since the receiver goes through Cu's table (σ X = T).
# - The old link_site read every output symbol at G's final table Cb, input
#   occurrences included, so the formal T.m read there as Char.m, which G
#   binds. Now the input T reads at G's table as T, and T.m is not bound.
# - The caller (X = T = Bool, T in force, so T's destination is fresh)
#   reads the key X.m at its own table as Bool.m, and files G's Char.m
#   closure under it. `true.m()` would run `putchar` on a Bool.
# Oracle (ob-sigclose var moss_m2): rejects ("functor `G` does not bind
#   `X.m`"): its representative is X. Native (ob-family, seed 1h1710x0):
#   rejects at `bind F = G` ("does not bind every item its result
#   promises: `m`").
# Both implementations accept an input of F that is also an output and that
# G rebinds when no merge is involved (scratch/realize3/inout.moss), so
# forbidding the rebind outright would reject accepted programs.
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type A;
type T;
type X;
tag Concrete;
fn .gimme(): Foo;
fn .m();
context Merge = A, T, X, A.gimme[Foo=T], A.gimme[Foo=X];
functor F[X]: Merge, Std -> T, X.m;
functor G: Merge, Std -> T, X.m {
  bind T = Char;
  bind T.m = () => { putchar(this); putchar(char::newline); };
}

assume Std {
  fn demo() {
    bind A = Concrete;
    bind T = Bool;
    bind X = Bool;
    bind Foo = Bool;
    bind A.gimme = () => true;
    bind F = G;
    bind F;
    true.m();
  }
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    demo();
  }
}
