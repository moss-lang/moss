# Q4 (semantics.typ, "where a direct method call checks its arguments";
# open, see AUDIT-CHANGES "Q4"). `f` and `Meter.g` both need the detached
# `.describe` at Meter (through Q), which only the family `Desc` supplies,
# on demand. The argument `d.describe()` resolves by D77: the provision of
# the detached `.describe` wins over the attached method where the context
# provides it, and a family that would supply it on demand does not count.
# So the argument's meaning depends on whether the call's demand is in
# force for it: in Γ it is the attached method (m), in Γ ⊕ D the family's
# (x). Audit and the oracle check a fn call's arguments in Γ ⊕ D (ExCallD)
# and a defined attached method call's in Γ (MCAttachedDefined).
# Verdicts: Audit xm; oracle xm; native xx.
#   Audit with arguments in Γ at every call (scratch/lang-q/q4-gamma.patch;
#   its oracle variant): mm. With Γ ⊕ D at every call
#   (q4-gamma-plus-D.patch; its oracle variant): xx.
tag Meter(Int);
type Q;
fn .describe(): Char;

assume Std, Q, Q.describe {
  fn f(c: Char) { putchar(c); }
  fn Meter.g(c: Char) { putchar(c); }
}

assume Std {
  fn Meter.describe(): Char { char::m }
}

functor Desc[Q]: Std, Q -> Q.describe;
functor ByX: Std, Q -> Q.describe {
  bind Q.describe = () => char::x;
}

assume Base {
  fn main() {
    bind StdBase;
    bind Desc = ByX;
    bind Q = Meter;
    let d = Meter(3);
    f(d.describe());
    d.g(d.describe());
    putchar(char::newline);
  }
}
