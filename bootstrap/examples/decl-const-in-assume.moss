# DeclsForm (AUDIT-CHANGES #76; criteria section 7): a defined val has no
# assumptions (ExConst; D50), so one inside an assume can never be read.
# Both implementations reject a use of it (Audit and the oracle:
# "constant with assumptions"; native: "no binding provides this item").
# Verdicts: oracle accepts; native accepts; Audit before accepts (nothing
# reads x); now rejects (ConstElab). Class B.
tag A;
type T;
assume T { val x: A = A; }
fn main() {}
