# As copy-fixed-bracket.moss, but F, a copy of Arrays with
# `Array.length[I32 = Z]`, is applied inside a linked body (G's `run`)
# instead of main. In G's context, Z and I32 are distinct symbols. F's
# record there reads Z as itself, so the fixed clause holds trivially.
# The caller's run-time key for `length` carries `I32 = Z`, but Arrays'
# code installs it at θ(I32) = I32: the keys differ syntactically, equal
# only in ground meaning. The oracle elaborates it and its run is stuck
# (XErr 6). Native prints 42. Without the bracket (`Array.length`) the
# oracle prints 42 too.
# This was the counterexample to ChainForwardKeys (chainfwd). Audit now
# installs F's declared result under the caller's keys
# (Audit.result_selection, scratch/orch/callerkeys2-AUDIT.md), so the
# family's primitive is filed under `Array.length[I32 = Z]` and the
# call finds it, as native does (42).
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Wasm, I32, Arrayed, Array, Arrays, .arrayed, i32_one, i32_zero;
import "../../lib/wasip1.moss" use Wasi;

type Z;

functor F[Arrayed]: Wasm, Arrayed, Z ->
  Arrayed.arrayed, Array.length[I32 = Z], Array.get, Array.set, Array.fill, Array.copy;

assume Std {
  fn print_int(n: Int) {
    if n >= 10 { print_int(n / 10); }
    putchar((n % 10 + char::digit0.code()).char());
  }
}

assume { fn run(); }
functor Gf: -> run;

functor G: Wasm, Std, Branch, Z, F -> run {
  bind run = () => {
    bind Arrayed = Int;
    bind F;
    let xs = 42.arrayed(i32_one);
    let l = xs.length();
    print_int(xs.get(i32_zero));
    putchar(char::newline);
  };
}

assume Wasm, Wasi, Branch {
  fn main() {
    bind WasiStd;
    bind Z = I32;
    bind F = Arrays;
    bind Gf = G;
    bind Gf;
    run();
  }
}
