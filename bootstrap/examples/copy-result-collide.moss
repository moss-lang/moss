# AUDIT-CHANGES #58 (criteria section 2, coherence; D84 rule 7).
# A copy: F's inputs merge A and B (context Merge: the two
# bindings of C.gimme are one key), so H's result items A.m and B.m, distinct
# in H, are one key in F's terms, and the copy `bind F = H;` reads one of them.
# copy-result-collide-hba.moss lists H's result the other way, and
# copy-result-collide-mba.moss lists Merge's bindings the other way.
# Audit before: accepts, prints b (CopyOutputs' rm reads the last H position
# with the key; argued). Audit now: rejects (BFunCopy: CollidesOnlyAs ksr ksh
# fails; argued).
# Oracle (moss_m2): prints a. Oracle variant d7: rejects.
# Native (ob-family moss, seed 1h1710x0): rejects at the copy ("the functor does
# not satisfy the required signature: `A`").
import "../../lib/wasi.moss" use WasiStd;
import "../../lib/wasistd.moss" use Branch;
import "../../lib/wasm.moss" use Gc, Wasm;
import "../../lib/wasip1.moss" use Wasi;

type Foo;
type C;
type A;
type B;
fn .gimme(): Foo;
assume A { fn .m(); }
context Merge = C, A, B, C.gimme[Foo=A], C.gimme[Foo=B];
functor H: Std, A, B -> A.m, B.m;
functor F: Std, Merge -> A.m, B.m;
assume Std {
  functor G: Std, A, B -> A.m, B.m {
    bind A.m = () => putchar(char::a);
    bind B.m = () => putchar(char::b);
  }
}

assume Std, H, Foo {
  fn use_it() {
    bind F = H;
    bind A = Int; bind B = Int; bind C = Int; bind Foo = Int;
    bind C.gimme = () => 0;
    bind F;
    one.m();
  }
}

assume Wasm, Gc, Wasi, Branch {
  fn main() { bind WasiStd; bind H = G; use_it(); putchar(char::newline); }
}
