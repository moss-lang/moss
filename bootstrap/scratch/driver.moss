import "../src/collect.moss" as collect;
import "../src/intern.moss" as intern;
import "../src/lex.moss" as lexer;
import "../src/mods.moss" as mods;
import "../src/tree.moss" as tree;

assume Std {
  fn main() {
    bind lexer::at=cell_int();
    bind lexer::mark=cell_int();
    bind tree::kinds=int_list();
    bind tree::starts=int_list();
    bind tree::lens=int_list();
    bind tree::kids=int_list();
    bind tree::name_ids=int_list();
    bind tree::ref_ids=int_list();
    bind tree::imp_texts=str_list();
    bind tree::imp_starts=int_list();
    bind tree::imp_lens=int_list();
    bind tree::imp_names=int_list();
    bind tree::imp_stars=int_list();
    bind intern::ichars=int_list();
    bind intern::istarts=int_list();
    bind intern::ilens=int_list();
    bind mods::mpaths=str_list();
    bind mods::mnodes=int_list();
    bind mods::mrefs=int_list();
    bind mods::mimps=int_list();
    bind mods::mkids=int_list();
    bind mods::mkidlens=int_list();
    bind mods::itargets=int_list();
    collect::run(first_arg());
  }
}
