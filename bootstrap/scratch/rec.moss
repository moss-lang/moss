assume Std {
  type Point { x: Char, y: Char };
  fn Point.show() { putchar(this.x); putchar(this.y); }
  fn flip(p: Point): Point { match p { Point { x, y } => Point { x = y, y = x }, } }
  fn main() {
    let p = Point { x = char::a, y = char::b };
    p.show();
    flip(p).show();
    putchar(char::newline);
  }
}
